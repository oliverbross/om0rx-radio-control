new file mode 100644
index 0000000..b14db16
--- /dev/null
+++ b/MSHV_2762/src/om0rxstationgate.h
@@ -0,0 +1,269 @@
+/* OM0RX station integration. GPL-3.0-or-later; same license as MSHV. */
+#ifndef OM0RXSTATIONGATE_H
+#define OM0RXSTATIONGATE_H
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QTimer>
+#include <QUuid>
+#include <QDateTime>
+#include <QEventLoop>
+#include <functional>
+
+// Additive fail-closed PTT authorization. MSHV remains the owner of its Auto,
+// AutoDX, queue, target and timing state; this class never toggles those.
+class Om0rxStationGate : public QObject {
+public:
+    static constexpr int requestTimeoutMs() { return 75000; }
+    static constexpr int consumeTimeoutMs() { return 1500; }
+    explicit Om0rxStationGate(QObject *parent) : QObject(parent), network(this), timeoutMs(requestTimeoutMs()) {}
+#ifdef OM0RX_STATION_GATE_TESTING
+    explicit Om0rxStationGate(QObject *parent, int testTimeoutMs)
+        : QObject(parent), network(this), timeoutMs(testTimeoutMs > 0 ? testTimeoutMs : 1) {}
+#endif
+    static bool &pending() { static bool value = false; return value; }
+    static unsigned &pendingGeneration() { static unsigned value = 0; return value; }
+    static bool &autoDesired() { static bool value = false; return value; }
+    static int &currentHz() { static int value = 0; return value; }
+    static int &preparedHz() { static int value = 0; return value; }
+    static int &permitHz() { static int value = 0; return value; }
+    static QString &prepareNonce() { static QString value; return value; }
+    static QString &permitNonce() { static QString value; return value; }
+    static qint64 &permitExpiresAt() { static qint64 value = 0; return value; }
+    static QString &lastReason() { static QString value = "not-authorized"; return value; }
+    static unsigned &generation() { static unsigned value = 0; return value; }
+    static int &pttMask() { static int value = 0; return value; }
+    static quint64 &pttRequestSequence() { static quint64 value = 0; return value; }
+    static int &requestedPttMask() { static int value = 0; return value; }
+
+    // The consume request runs a nested Qt event loop so that the legacy PTT
+    // call remains synchronous.  Every requested edge receives a monotonically
+    // increasing sequence.  A re-entrant RX/Stop/QSY/frequency event therefore
+    // makes an earlier TX request observably stale before hardware can be
+    // reached, even when its HTTP approval arrives later.
+    static quint64 notePttRequest(bool transmit, int mask) {
+        const quint64 value = ++pttRequestSequence();
+        if (transmit) requestedPttMask() |= mask;
+        else requestedPttMask() &= ~mask;
+        return value;
+    }
+    static void cancelPttRequests() {
+        ++pttRequestSequence();
+        requestedPttMask() = 0;
+        pttMask() = 0;
+    }
+    static bool pttRequestStillCurrent(quint64 sequence, unsigned permitGeneration,
+                                       int hz, int mask) {
+        return sequence == pttRequestSequence() &&
+            permitGeneration == generation() && hz > 0 && hz == currentHz() &&
+            (requestedPttMask() & mask) == mask;
+    }
+
+    static void invalidate(const QString &reason = "invalidated") {
+        cancelPttRequests();
+        ++generation();
+        preparedHz() = 0;
+        permitHz() = 0;
+        prepareNonce().clear();
+        permitNonce().clear();
+        permitExpiresAt() = 0;
+        lastReason() = reason;
+    }
+    static void invalidateAndNotify(QObject *parent, const QString &reason) {
+        invalidate(reason);
+        (new Om0rxStationGate(parent))->auditEvent(
+            "authorization-invalidated", "Om0rxStationGate::invalidate", reason);
+    }
+    static bool requestPending() { return pending() && pendingGeneration() == generation(); }
+    static bool hasPermit() {
+        return !requestPending() && currentHz() > 0 && currentHz() == permitHz() &&
+            !permitNonce().isEmpty() && QDateTime::currentMSecsSinceEpoch() < permitExpiresAt();
+    }
+    bool consumePermitBlocking(const QString &path) {
+        if (!hasPermit()) {
+            lastReason() = "ptt-edge-permit-unavailable";
+            return false;
+        }
+        // Retire the local copy before starting I/O. A timeout is ambiguous:
+        // the server may have consumed it while the response was lost, so a
+        // retry must obtain a newly prepared permit rather than replaying.
+        const QString nonce = permitNonce();
+        permitNonce().clear();
+        permitHz() = 0;
+        permitExpiresAt() = 0;
+        const QUrl url = endpoint("/api/digital/station-permit/consume");
+        if (!loopback(url)) {
+            lastReason() = "non-loopback-endpoint";
+            return false;
+        }
+        QJsonObject body;
+        body["provider"] = "mshv_auto_dx";
+        body["permit_nonce"] = nonce;
+        body["frequency_hz"] = currentHz();
+        body["mode"] = "DIGU";
+        body["path"] = path;
+        body["authorization_generation"] = static_cast<qint64>(generation());
+        QNetworkReply *reply = network.post(
+            makeRequest(url), QJsonDocument(body).toJson(QJsonDocument::Compact));
+        QEventLoop loop;
+        QTimer timer;
+        timer.setSingleShot(true);
+        connect(&timer, &QTimer::timeout, reply, &QNetworkReply::abort);
+        connect(reply, &QNetworkReply::finished, &loop, &QEventLoop::quit);
+        timer.start(consumeTimeoutMs());
+        loop.exec();
+        timer.stop();
+        const QJsonObject result = QJsonDocument::fromJson(reply->readAll()).object();
+        const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        const bool consumed = reply->error() == QNetworkReply::NoError &&
+            status >= 200 && status < 300 &&
+            result.value("success").isBool() && result.value("success").toBool() &&
+            result.value("reason").toString() == "permit-consumed";
+        lastReason() = consumed ? "permit-consumed"
+                                : result.value("reason").toString("permit-consume-timeout-or-error");
+        reply->deleteLater();
+        return consumed;
+    }
+    static QString bandForFrequency(int hz) {
+        struct Band { int low; int high; const char *name; };
+        static const Band bands[] = {{1800000,2000000,"160m"},{3500000,4000000,"80m"},
+            {5351500,5366500,"60m"},{7000000,7300000,"40m"},{10100000,10150000,"30m"},
+            {14000000,14350000,"20m"},{18068000,18168000,"17m"},{21000000,21450000,"15m"},
+            {24890000,24990000,"12m"},{28000000,29700000,"10m"},{50000000,54000000,"6m"}};
+        for (const Band &band : bands) if (hz >= band.low && hz <= band.high) return band.name;
+        return QString();
+    }
+    static void prefetch(QObject *parent) {
+        const int hz = currentHz();
+        if (hz <= 0 || requestPending() || hasPermit()) return;
+        const QString band = bandForFrequency(hz);
+        if (band.isEmpty() || band == "60m") return;
+        (new Om0rxStationGate(parent))->prepare(hz, band, [parent, hz, band](bool prepared) {
+            if (!prepared || hz != currentHz()) return;
+            (new Om0rxStationGate(parent))->confirm(hz, band, [](bool) {});
+        });
+    }
+    void prepare(int hz, const QString &band, std::function<void(bool)> done) {
+        request(hz, band, "prepare", QString(), done);
+    }
+    void confirm(int hz, const QString &band, std::function<void(bool)> done) {
+        if (preparedHz() != hz || prepareNonce().isEmpty()) {
+            lastReason() = "prepare-required";
+            done(false);
+            deleteLater();
+            return;
+        }
+        const QString nonce = prepareNonce();
+        prepareNonce().clear();
+        preparedHz() = 0;
+        request(hz, band, "final", nonce, done);
+    }
+    void auditRejected(const QString &path, const QString &reason) {
+        QJsonObject body;
+        body["provider"] = "mshv_auto_dx";
+        body["event"] = "ptt-rejected";
+        body["frequency_hz"] = currentHz();
+        body["mode"] = "DIGU";
+        body["path"] = path;
+        body["reason"] = reason;
+        body["authorization_generation"] = static_cast<qint64>(generation());
+        postAudit(body);
+    }
+    void auditEvent(const QString &event, const QString &path, const QString &reason = QString()) {
+        QJsonObject body;
+        body["provider"] = "mshv_auto_dx";
+        body["event"] = event;
+        body["frequency_hz"] = currentHz();
+        body["mode"] = "DIGU";
+        body["path"] = path;
+        body["authorization_generation"] = static_cast<qint64>(generation());
+        if (!reason.isEmpty()) body["reason"] = reason;
+        postAudit(body);
+    }
+private:
+    QUrl endpoint(const QString &path) const {
+        QString base = QString::fromUtf8(qgetenv("OM0RX_API_BASE"));
+        if (base.isEmpty()) base = "http://127.0.0.1:8080";
+        return QUrl(base + path);
+    }
+    bool loopback(const QUrl &url) const {
+        return (url.host() == "127.0.0.1" || url.host() == "localhost") &&
+            (url.scheme() == "http" || url.scheme() == "https");
+    }
+    QNetworkRequest makeRequest(const QUrl &url) const {
+        QNetworkRequest request(url);
+        request.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+        request.setRawHeader("X-OM0RX-Control-Token", qgetenv("OM0RX_CONTROL_TOKEN"));
+        return request;
+    }
+    void postAudit(const QJsonObject &body) {
+        const QUrl url = endpoint("/api/digital/station-audit");
+        if (!loopback(url)) { deleteLater(); return; }
+        QNetworkReply *reply = network.post(makeRequest(url), QJsonDocument(body).toJson(QJsonDocument::Compact));
+        QTimer::singleShot(5000, reply, [reply]() { if (!reply->isFinished()) reply->abort(); });
+        connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+            reply->deleteLater();
+            deleteLater();
+        });
+    }
+    void request(int hz, const QString &band, const QString &phase, const QString &nonce,
+                 std::function<void(bool)> done) {
+        if (requestPending() || hz <= 0) { lastReason() = "request-pending-or-invalid"; done(false); deleteLater(); return; }
+        pending() = true;
+        const unsigned requestGeneration = generation();
+        pendingGeneration() = requestGeneration;
+        const QString id = QUuid::createUuid().toString(QUuid::WithoutBraces);
+        const QUrl url = endpoint("/api/digital/station-ready");
+        if (!loopback(url)) {
+            if (pendingGeneration() == requestGeneration) pending() = false;
+            lastReason() = "non-loopback-endpoint"; done(false); deleteLater(); return;
+        }
+        QJsonObject body;
+        body["provider"] = "mshv_auto_dx";
+        body["request_id"] = id;
+        body["phase"] = phase;
+        body["frequency_hz"] = hz;
+        body["band"] = band.isEmpty() ? bandForFrequency(hz) : band;
+        body["mode"] = "DIGU";
+        body["authorization_generation"] = static_cast<qint64>(requestGeneration);
+        if (!nonce.isEmpty()) body["prepare_nonce"] = nonce;
+        QNetworkReply *reply = network.post(makeRequest(url), QJsonDocument(body).toJson(QJsonDocument::Compact));
+        QTimer::singleShot(timeoutMs, reply, [reply]() { if (!reply->isFinished()) reply->abort(); });
+        connect(reply, &QNetworkReply::finished, this, [this, reply, id, hz, phase, requestGeneration, done]() {
+            const QJsonObject result = QJsonDocument::fromJson(reply->readAll()).object();
+            const int status = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+            const bool baseReady = requestGeneration == generation() &&
+                reply->error() == QNetworkReply::NoError && status >= 200 && status < 300 &&
+                result.value("request_id").toString() == id && result.value("phase").toString() == phase &&
+                result.value("ready").isBool() && result.value("ready").toBool() &&
+                result.value("prepared").isBool() && result.value("prepared").toBool();
+            bool ready = false;
+            if (phase == "prepare") {
+                const QString value = result.value("prepare_nonce").toString();
+                ready = baseReady && result.value("transmit_ready").isBool() &&
+                    !result.value("transmit_ready").toBool() && !value.isEmpty();
+                if (ready) { preparedHz() = hz; prepareNonce() = value; }
+            } else {
+                const QString value = result.value("permit_nonce").toString();
+                const int ttl = result.value("permit_expires_in_ms").toInt();
+                ready = baseReady && result.value("transmit_ready").isBool() &&
+                    result.value("transmit_ready").toBool() && !value.isEmpty() && ttl > 0;
+                if (ready) {
+                    permitHz() = hz;
+                    permitNonce() = value;
+                    permitExpiresAt() = QDateTime::currentMSecsSinceEpoch() + ttl;
+                }
+            }
+            if (pendingGeneration() == requestGeneration) pending() = false;
+            lastReason() = ready ? (phase == "prepare" ? "station-prepared" : "permit-ready")
+                                 : result.value("reason").toString("station-request-failed");
+            done(ready);
+            reply->deleteLater();
+            deleteLater();
+        });
+    }
+    QNetworkAccessManager network;
+    const int timeoutMs;
+};
+#endif

diff --git a/MSHV_2762/src/HvAutoDxer/autodxstatusprovenance.h b/MSHV_2762/src/HvAutoDxer/autodxstatusprovenance.h
new file mode 100644
index 0000000..a65bc3b
--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/autodxstatusprovenance.h
@@ -0,0 +1,85 @@
+#ifndef AUTODXSTATUSPROVENANCE_H
+#define AUTODXSTATUSPROVENANCE_H
+
+#include <QDateTime>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QSaveFile>
+#include <QString>
+
+// Durable proof that a persisted legacy/UDP target was written by native
+// AutoDX. Equality of the two caches is deliberately not ownership evidence.
+class AutoDxStatusProvenance
+{
+public:
+    struct Marker {
+        QString callsign;
+        QString grid;
+        QDateTime writtenUtc;
+    };
+
+    static int maximumAgeSeconds() { return 86400; }
+
+    static bool load(const QString &path, Marker &marker,
+                     const QDateTime &nowUtc = QDateTime::currentDateTimeUtc())
+    {
+        marker = Marker();
+        QFile file(path);
+        if (!file.open(QIODevice::ReadOnly)) return false;
+        QJsonParseError error;
+        const QJsonDocument document = QJsonDocument::fromJson(file.readAll(), &error);
+        if (error.error != QJsonParseError::NoError || !document.isObject()) return false;
+        const QJsonObject object = document.object();
+        if (object.value("schema").toInt() != 1
+                || object.value("owner").toString() != "mshv-native-autodx") return false;
+        const QString callsign = object.value("callsign").toString().trimmed().toUpper();
+        const QString grid = object.value("grid").toString().trimmed().toUpper();
+        QDateTime written = QDateTime::fromString(
+            object.value("written_at_utc").toString(), Qt::ISODateWithMs);
+        if (!written.isValid()) {
+            written = QDateTime::fromString(
+                object.value("written_at_utc").toString(), Qt::ISODate);
+        }
+        written = written.toUTC();
+        const QDateTime now = nowUtc.toUTC();
+        if (callsign.isEmpty() || !written.isValid()
+                || written > now.addSecs(300)
+                || written.secsTo(now) > maximumAgeSeconds()) return false;
+        marker.callsign = callsign;
+        marker.grid = grid;
+        marker.writtenUtc = written;
+        return true;
+    }
+
+    static bool store(const QString &path, const QString &callsign,
+                      const QString &grid,
+                      const QDateTime &nowUtc = QDateTime::currentDateTimeUtc())
+    {
+        const QString normalizedCall = callsign.trimmed().toUpper();
+        if (normalizedCall.isEmpty()) return false;
+        if (!QDir().mkpath(QFileInfo(path).absolutePath())) return false;
+        QJsonObject object;
+        object["schema"] = 1;
+        object["owner"] = "mshv-native-autodx";
+        object["callsign"] = normalizedCall;
+        object["grid"] = grid.trimmed().toUpper();
+        object["written_at_utc"] = nowUtc.toUTC().toString(Qt::ISODateWithMs);
+        QSaveFile file(path);
+        if (!file.open(QIODevice::WriteOnly)) return false;
+        if (file.write(QJsonDocument(object).toJson(QJsonDocument::Compact)) < 0) {
+            file.cancelWriting();
+            return false;
+        }
+        return file.commit();
+    }
+
+    static bool clear(const QString &path)
+    {
+        return !QFileInfo::exists(path) || QFile::remove(path);
+    }
+};
+
+#endif // AUTODXSTATUSPROVENANCE_H

+bool HvDxccTracker::isCqZoneWorked(int zone, int bandIndex) const
+{
+    for (const QString &worked : m_workedDxccByBand) {
+        const QStringList parts = worked.split('_');
+        if (parts.size() == 2 && parts.at(1).toInt() == bandIndex
+                && m_entityById.value(parts.at(0).toInt()).cqZone == zone) return true;
+    }
+    return false;
+}

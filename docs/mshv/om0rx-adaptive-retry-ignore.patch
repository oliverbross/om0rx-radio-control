+    if (stage < 0 || stage > 4 || callsign.trimmed().isEmpty()) return false;
+    int row = LsNow->FindCallOrBaseCallRow(callsign);
+    if (row >= 0) {
+        LsNow->SetItem(row, 7, QString::number(stage));
+        LsNow->SetItem(row, 8,
+            QString::number(QDateTime::currentDateTimeUtc().toTime_t()));
+        gen_msg();
+        return true;
+    }
+    row = LsQueue->FindCallOrBaseCallRow(callsign);
+    if (row >= 0) {
+        LsQueue->SetItem(row, 7, QString::number(stage));
+        return true;
+    }
+    return false;
+}

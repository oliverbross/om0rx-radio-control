+void MainWindow::om0rx_auto_reply_direct_call(DecodedText const& message, QString const& call)
+{
+    auto const normalized_call = om0rx_normalized_call(call);
+    if (normalized_call.isEmpty()) return;
+
+    if (!ui->cbAutoSeq->isChecked()
+        || !(ui->cbAutoCall->isChecked()
+             || ui->cbAutoCQ->isChecked()
+             || ui->cb_autoCallNext->isChecked())) {
+        if (m_zdebug) log("OM0RX direct reply ignored; automation is not active: " + normalized_call);
+        return;
+    }
+
+    bool const idle_or_finished =
+        CALLING == m_QSOProgress || ROGERS == m_QSOProgress || SIGNOFF == m_QSOProgress;
+    if (m_transmitting || ui->autoButton->isChecked() || !idle_or_finished) {
+        if (m_zdebug) log("OM0RX direct reply held; QSO is active: " + normalized_call);
+        return;
+    }
+
+    QTimer::singleShot(0, this, [this, message, normalized_call] {
+        bool const idle_or_finished =
+            CALLING == m_QSOProgress || ROGERS == m_QSOProgress || SIGNOFF == m_QSOProgress;
+        if (m_transmitting || ui->autoButton->isChecked() || !idle_or_finished) {
+            if (m_zdebug) log("OM0RX direct reply skipped after state changed: " + normalized_call);
+            return;
+        }
+
+        m_priorityCall.clear();
+        m_priorityCallPreferCQTarget = false;
+        m_om0rxHuntingPriorityScore = -1;
+        m_om0rxReplyPriorityCall = normalized_call;
+        om0rx_clear_priority_hunt("direct reply to us");
+
+        if (m_zdebug) log("OM0RX direct reply auto-start: " + normalized_call);
+        processMessage(message);
+        if (!ui->dxCallEntry->text().isEmpty()) {
+            auto_tx_mode(true);
+        }
+    });
+}

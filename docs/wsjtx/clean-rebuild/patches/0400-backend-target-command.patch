+void MainWindow::remote_start_target_qso (QString const& payload_json)
+{
+  QJsonParseError parse_error;
+  auto document = QJsonDocument::fromJson (payload_json.toUtf8 (), &parse_error);
+  if (QJsonParseError::NoError != parse_error.error || !document.isObject ())
+    {
+      log ("OM0RX target command rejected: invalid JSON");
+      return;
+    }
+
+  auto root = document.object ();
+  auto target = root.value ("target").toObject ();
+  if (target.isEmpty ()) target = root;
+
+  auto text_value = [&target] (char const * name, QString const& fallback = QString {}) {
+    auto value = target.value (QLatin1String {name});
+    return value.isString () ? value.toString ().trimmed () : fallback;
+  };
+  auto bool_value = [&target] (char const * name, bool fallback) {
+    auto value = target.value (QLatin1String {name});
+    return value.isBool () ? value.toBool () : fallback;
+  };
+  auto uint_value = [&target] (char const * name, quint32 fallback) {
+    auto value = target.value (QLatin1String {name});
+    if (!value.isDouble ()) return fallback;
+    auto number = value.toDouble ();
+    return number >= 0.0 && number <= double (std::numeric_limits<quint32>::max ())
+        ? static_cast<quint32> (number) : fallback;
+  };
+
+  auto call = text_value ("dxCall", text_value ("call")).toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  auto grid = text_value ("dxGrid", text_value ("grid")).toUpper ();
+  auto mode = text_value ("mode", m_mode).toUpper ();
+  auto band = text_value ("band", m_currentBand).toLower ();
+  auto listen_only = bool_value ("listenOnly", false);
+  auto enable_tx = bool_value ("enableTx", true);
+  auto priority_hunt = bool_value ("priorityHunt", false);
+  auto dial_frequency = static_cast<Frequency> (uint_value ("dialFrequency", 0u));
+  auto rx_df = uint_value ("rxDf", quint32_max);
+  auto tx_df = uint_value ("txDf", quint32_max);
+  auto tr_period = uint_value ("trPeriod", quint32_max);
+
+  if (call.isEmpty () && !listen_only)
+    {
+      log ("OM0RX target command rejected: missing call");
+      return;
+    }
+
+  auto active_call = ui->dxCallEntry->text ().trimmed ().toUpper ();
+  active_call.remove ('<');
+  active_call.remove ('>');
+  auto different_active_call = !active_call.isEmpty () && active_call != call;
+  // Stale report/QSO fields can remain after Auto Tx has returned to idle.
+  // They must not block the next backend-selected target once Auto Tx is off.
+  auto exchange_started = m_transmitting || (ui->autoButton->isChecked ()
+      && (m_QSOProgress != CALLING || !m_rptSent.isEmpty ()
+          || !m_rptRcvd.isEmpty () || m_sentFirst73));
+  if (different_active_call && exchange_started)
+    {
+      log (QString {"OM0RX target command held out: active QSO=%1 requested=%2"}
+           .arg (active_call, call));
+      return;
+    }
+
+  if (!band.isEmpty () && !m_currentBand.isEmpty () && band != m_currentBand.toLower ()
+      && !ui->band_hopping_group_box->isChecked ())
+    {
+      log (QString {"OM0RX target command rejected: band hopping disabled %1->%2"}
+           .arg (m_currentBand, band));
+      return;
+    }
+  if (!mode.isEmpty () && mode != m_mode.toUpper () && !ui->cb_autoModeSwitch->isChecked ())
+    {
+      log (QString {"OM0RX target command rejected: mode switching disabled %1->%2"}
+           .arg (m_mode, mode));
+      return;
+    }
+
+  remote_configure (mode, uint_value ("frequencyTolerance", quint32_max),
+                    text_value ("submode").toUpper (), bool_value ("fastMode", false),
+                    tr_period, rx_df, listen_only ? QString {} : call,
+                    listen_only ? QString {} : grid,
+                    listen_only ? false : bool_value ("generateMessages", true));
+
+  if (dial_frequency) setRig (dial_frequency);
+  if (tx_df != quint32_max && ui->TxFreqSpinBox->isVisible ())
+    {
+      ui->TxFreqSpinBox->setValue (tx_df);
+      ui->TxFreqSpinBox->interpretText ();
+      setXIT (ui->TxFreqSpinBox->value ());
+    }
+  auto hold_tx = bool_value ("holdTxFreq", true);
+  if (ui->cbHoldTxFreq->isVisible () && ui->cbHoldTxFreq->isChecked () != hold_tx)
+    ui->cbHoldTxFreq->click ();
+  if (target.contains ("txFirst") && ui->txFirstCheckBox->isVisible ())
+    ui->txFirstCheckBox->setChecked (bool_value ("txFirst", ui->txFirstCheckBox->isChecked ()));
+
+  if (priority_hunt && ui->cbWatchUnconfirmedDXCC->isChecked () && !listen_only)
+    {
+      m_om0rxPriorityHuntActive = true;
+      m_om0rxPriorityHuntCall = call;
+      m_om0rxPriorityHuntBand = band;
+      m_om0rxPriorityHuntMode = mode;
+      m_om0rxPriorityHuntRank = 1000;
+      m_om0rxPriorityHuntWatchdogMinutes = qBound (1, static_cast<int> (
+          uint_value ("watchdogMinutes", 20u)), 120);
+      m_idleMinutes = 0;
+      update_watchdog_label ();
+      log (QString {"OM0RX backend priority hunt armed call=%1 watchdog=%2m reason=%3"}
+           .arg (call).arg (m_om0rxPriorityHuntWatchdogMinutes)
+           .arg (text_value ("huntReason", "DXCC priority")));
+    }
+  else if (!priority_hunt && m_om0rxPriorityHuntActive && m_om0rxPriorityHuntCall != call)
+    {
+      clear_om0rx_priority_hunt ("non-priority backend target selected");
+    }
+
+  if (listen_only)
+    {
+      tx_watchdog (false);
+      return;
+    }
+
+  switch (uint_value ("txMessageNumber", 1u))
+    {
+    case 2: ui->txb2->click (); break;
+    case 3: ui->txb3->click (); break;
+    case 4: ui->txb4->click (); break;
+    case 5: ui->txb5->click (); break;
+    case 6: ui->txb6->click (); break;
+    default: ui->txb1->click (); break;
+    }
+  if (enable_tx && !ui->autoButton->isChecked ())
+    {
+      m_bDoubleClicked = true;
+      ui->autoButton->click ();
+    }
+  tx_watchdog (false);
+  QApplication::alert (this);
+}

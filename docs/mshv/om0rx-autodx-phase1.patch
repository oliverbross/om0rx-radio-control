+++ b/MSHV_2762/src/HvAutoDxer/autodxruntimeconfig.h
@@ -0,0 +1,101 @@
+#ifndef AUTODXRUNTIMECONFIG_H
+#define AUTODXRUNTIMECONFIG_H
+
+#include <QSettings>
+#include <QStringList>
+#include <QRegExp>
+
+// Side-effect-free loader shared by the active core and native fixtures.  It
+// deliberately contains no widgets and opens no network connections.
+struct AutoDxRuntimeConfig
+{
+    bool desiredEnabled;
+    QStringList modes;
+    bool bandSwitchingEnabled;
+    int atnoChaseType;
+    int scarceThreshold;
+    int newDxccWeight;
+    int newBandSlotWeight;
+    int newGridWeight;
+    int callingMeWeight;
+    int cqWeight;
+    int snrWeight;
+    bool gridChaseEnabled;
+    bool gridUsOnly;
+    int minSnr;
+    QString callsign;
+    QString grid;
+    bool rbnEnabled;
+    QString rbnHost;
+    int rbnPort;
+    bool pskrEnabled;
+    int pskrPollInterval;
+    bool dxClusterEnabled;
+    bool usOnly;
+    bool useDefaultServers;
+    QStringList customServers;
+
+    bool modeAllowed(const QString &mode) const
+    {
+        return modes.contains(mode.trimmed().toUpper());
+    }
+
+    bool effectiveEnabled(const QString &mode) const
+    {
+        return desiredEnabled && modeAllowed(mode);
+    }
+
+    static bool acceptsExternalMode(const QString &mode)
+    {
+        return mode.trimmed().compare("FT8", Qt::CaseInsensitive) == 0;
+    }
+
+    static QString explicitDigitalMode(const QString &text)
+    {
+        QRegExp modeRx("(^|[^A-Z0-9])(FT8|FT4)([^A-Z0-9]|$)", Qt::CaseInsensitive);
+        if (modeRx.indexIn(text) < 0) return QString();
+        return modeRx.cap(2).toUpper();
+    }
+
+    static AutoDxRuntimeConfig load(const QString &settingsPath)
+    {
+        QSettings settings(settingsPath + "/autodx.ini", QSettings::IniFormat);
+        AutoDxRuntimeConfig c;
+        c.desiredEnabled = settings.value("AutoDx/Enabled", false).toBool();
+        c.modes.clear();
+        const bool modesConfigured = settings.contains("AutoDx/Modes");
+        const QStringList requested = settings.value("AutoDx/Modes", "FT8")
+            .toString().toUpper().split(",", Qt::SkipEmptyParts);
+        // Phase 1 supports the proven FT8 core only; unknown/FT4 values cannot
+        // expand effective automation merely by editing the INI.
+        if (!modesConfigured || requested.contains("FT8")) c.modes << "FT8";
+        c.bandSwitchingEnabled = settings.value("BandSwitching/Enabled", false).toBool();
+        c.atnoChaseType = qBound(0, settings.value("AutoDx/ATNOChaseType", 3).toInt(), 3);
+        c.scarceThreshold = qBound(0, settings.value("AutoDx/ScarceThreshold", 5).toInt(), 20);
+        c.newDxccWeight = qMax(0, settings.value("TargetPriority/NewDxcc", 10000).toInt());
+        c.newBandSlotWeight = qMax(0, settings.value("TargetPriority/NewBandSlot", 1000).toInt());
+        c.newGridWeight = qMax(1, settings.value("TargetPriority/NewGrid", 500).toInt());
+        c.callingMeWeight = qMax(0, settings.value("TargetPriority/CallingMe", 400).toInt());
+        c.cqWeight = qMax(0, settings.value("TargetPriority/Cq", 200).toInt());
+        c.snrWeight = qMax(0, settings.value("TargetPriority/SnrPerDb", 10).toInt());
+        c.gridChaseEnabled = settings.value("GridChase/Enabled", true).toBool();
+        c.gridUsOnly = settings.value("GridChase/USOnly", false).toBool();
+        c.minSnr = qBound(-30, settings.value("SpotSources/MinSNR", -20).toInt(), 0);
+        c.callsign = settings.value("SpotSources/Callsign", "").toString().trimmed().toUpper();
+        c.grid = settings.value("SpotSources/Grid", "").toString().trimmed().toUpper();
+        c.rbnEnabled = settings.value("SpotSources/RbnEnabled", true).toBool();
+        c.rbnHost = settings.value("SpotSources/RbnHost", "telnet.reversebeacon.net").toString().trimmed();
+        c.rbnPort = qBound(1, settings.value("SpotSources/RbnPort", 7001).toInt(), 65535);
+        c.pskrEnabled = settings.value("SpotSources/PskEnabled", true).toBool();
+        c.pskrPollInterval = qBound(60, settings.value("SpotSources/PskPollInterval", 120).toInt(), 600);
+        c.dxClusterEnabled = settings.value("SpotSources/DxcEnabled", true).toBool();
+        c.usOnly = settings.value("SpotSources/UsOnlyFilter", false).toBool();
+        c.useDefaultServers = settings.value("SpotSources/UseDefaultDxClusterServers", true).toBool();
+        const int count = qBound(0, settings.value("DxClusterServers/Count", 0).toInt(), 16);
+        for (int i = 0; i < count; ++i)
+            c.customServers << settings.value(QString("DxClusterServers/Server%1").arg(i), "").toString();
+        return c;
+    }
+};
+
+#endif // AUTODXRUNTIMECONFIG_H

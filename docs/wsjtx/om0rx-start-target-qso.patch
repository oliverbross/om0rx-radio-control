+          continue;
+        }
+      auto const hour_text = line.section (QChar {':'}, 0, 0).trimmed ();
+      bool ok {false};
+      auto hour = hour_text.toInt (&ok);
+      if (!ok || hour < 0 || hour > 23)
+        {
+          continue;
+        }
+      auto const band_text = line.section (QChar {':'}, 1).trimmed ();
+      QStringList bands;
+      for (auto band: band_text.split (QRegularExpression {R"([,\s]+)"}, Qt::SkipEmptyParts))
+        {
+          band = band.trimmed ().toLower ();
+          if (QRegularExpression {R"(^\d{1,3}m$)"}.match (band).hasMatch ())
+            {
+              bands.append (band);
+            }
+        }
+      if (!bands.isEmpty ())
+        {
+          entries.append ({hour, bands});
+        }
+    }
+
+  if (entries.isEmpty ())
+    {
+      return {};
+    }
+
+  auto const current_hour = QDateTime::currentDateTimeUtc ().time ().hour ();
+  int selected {-1};
+  int selected_delta {24};
+  for (auto index = 0; index < entries.size (); ++index)
+    {
+      auto delta = (current_hour - entries[index].hour + 24) % 24;
+      if (delta < selected_delta)
+        {
+          selected = index;
+          selected_delta = delta;
+        }
+    }
+  return selected >= 0 ? entries[selected].bands : QStringList {};
+}
+
+namespace
+{
+struct Om0rxHuntSlot
+{
+  QString band;
+  QString mode;
+};
+
+qint64 om0rx_hunting_frequency_hz (QString const& band, QString const& mode)
+{
+  auto normalized = band.trimmed ().toLower ();
+  auto normalized_mode = mode.trimmed ().toUpper ();
+
+  if (normalized_mode == "FT4")
+    {
+      if (normalized == "80m") return 3575000;
+      if (normalized == "40m") return 7047500;
+      if (normalized == "30m") return 10140000;
+      if (normalized == "20m") return 14080000;
+      if (normalized == "17m") return 18104000;
+      if (normalized == "15m") return 21140000;
+      if (normalized == "12m") return 24919000;
+      if (normalized == "10m") return 28180000;
+      return 0;
+    }
+
+  if (normalized_mode == "FT8")
+    {
+      if (normalized == "160m") return 1840000;
+      if (normalized == "80m") return 3573000;
+      if (normalized == "60m") return 5357000;
+      if (normalized == "40m") return 7074000;
+      if (normalized == "30m") return 10136000;
+      if (normalized == "20m") return 14074000;
+      if (normalized == "17m") return 18100000;
+      if (normalized == "15m") return 21074000;
+      if (normalized == "12m") return 24915000;
+      if (normalized == "10m") return 28074000;
+      if (normalized == "6m") return 50313000;
+      if (normalized == "2m") return 144174000;
+      if (normalized == "70m" || normalized == "70cm") return 432174000;
+    }
+
+  return 0;
+}
+
+QVector<Om0rxHuntSlot> om0rx_hunting_sequence (QStringList const& plan,
+                                               QString const& current_mode,
+                                               bool mode_switching)
+{
+  QVector<Om0rxHuntSlot> sequence;
+  auto normalized_current_mode = current_mode.trimmed ().toUpper ();
+  if (normalized_current_mode != "FT4")
+    {
+      normalized_current_mode = "FT8";
+    }
+  for (auto band: plan)
+    {
+      band = band.trimmed ().toLower ();
+      if (band.isEmpty ())
+        {
+          continue;
+        }
+      if (mode_switching)
+        {
+          if (om0rx_hunting_frequency_hz (band, "FT8") > 0)
+            {
+              sequence.append ({band, "FT8"});
+            }
+          if (om0rx_hunting_frequency_hz (band, "FT4") > 0)
+            {
+              sequence.append ({band, "FT4"});
+            }
+        }
+      else if (om0rx_hunting_frequency_hz (band, normalized_current_mode) > 0)
+        {
+          sequence.append ({band, normalized_current_mode});
+        }
+    }
+  return sequence;
+}
+}
+
+bool MainWindow::om0rx_qsy_to_band_mode (QString const& band, QString const& mode)
+{
+  auto target_mode = mode.trimmed ().toUpper ();
+  auto const hz = om0rx_hunting_frequency_hz (band, target_mode);
+
+  if (hz <= 0)
+    {
+      return false;
+    }
+
+  if (target_mode == "FT4" && m_mode != "FT4")
+    {
+      on_actionFT4_triggered ();
+    }
+  else if (target_mode == "FT8" && m_mode != "FT8")
+    {
+      on_actionFT8_triggered ();
+    }
+
+  auto const& row = m_config.frequencies ()->best_working_frequency (hz);
+  if (row >= 0)
+    {
+      ui->bandComboBox->setCurrentIndex (row);
+      on_bandComboBox_activated (row);
+    }
+  else
+    {
+      setRig (hz);
+    }
+  return true;
+}
+
+void MainWindow::om0rx_band_hopping_tick ()
+{
+  if (!ui->cbOm0rxBandHopping->isChecked ())
+    {
+      return;
+    }
+  if (m_transmitting || m_tune || ui->tuneButton->isChecked ())
+    {
+      return;
+    }
+  if (!ui->dxCallEntry->text ().trimmed ().isEmpty () || (m_auto && !m_hisCall.trimmed ().isEmpty ()))
+    {
+      return;
+    }
+
+  static QDateTime last_hop_at;
+  static QDateTime last_decode_activity_at;
+  static QDateTime last_workable_seen_at;
+  static QString last_decode_signature;
+  auto const now = QDateTime::currentDateTimeUtc ();
+  auto const interval_seconds = qMax (60, ui->sbOm0rxHopInterval->value () * 60);
+  auto const no_decode_seconds = qMin (interval_seconds, 120);
+  auto const no_workable_seconds = qMin (interval_seconds, 180);
+  auto const decode_signature =
+      (ui->decodedTextBrowser->toPlainText ().right (4096)
+       + ui->decodedTextBrowser2->toPlainText ().right (4096));
+  if (!last_decode_activity_at.isValid () || decode_signature != last_decode_signature)
+    {
+      last_decode_activity_at = now;
+      last_decode_signature = decode_signature;
+    }
+  auto const has_workable_label =
+      decode_signature.contains ("New Call", Qt::CaseInsensitive)
+      || decode_signature.contains ("ATNO", Qt::CaseInsensitive);
+  if (!last_workable_seen_at.isValid () || has_workable_label)
+    {
+      last_workable_seen_at = now;
+    }
+  if (!last_hop_at.isValid ())
+    {
+      last_hop_at = now;
+      return;
+    }
+  auto const fixed_interval_due = last_hop_at.secsTo (now) >= interval_seconds;
+  auto const no_decodes_due =
+      last_decode_activity_at.isValid () && last_decode_activity_at.secsTo (now) >= no_decode_seconds;
+  auto const no_workable_due =
+      last_workable_seen_at.isValid () && last_workable_seen_at.secsTo (now) >= no_workable_seconds;
+  if (!fixed_interval_due && !no_decodes_due && !no_workable_due)
+    {
+      return;
+    }
+
+  auto const plan = om0rx_current_band_plan ();
+  if (plan.isEmpty ())
+    {
+      return;
+    }
+
+  auto current = m_currentBand.trimmed ().toLower ();
+  auto current_mode = m_mode.trimmed ().toUpper ();
+  auto mode_switching = ui->cbOm0rxModeSwitching->isChecked ();
+  auto const sequence = om0rx_hunting_sequence (plan, current_mode, mode_switching);
+  if (sequence.isEmpty ())
+    {
+      last_hop_at = now;
+      return;
+    }
+  auto current_slot_index = -1;
+  for (auto index = 0; index < sequence.size (); ++index)
+    {
+      if (sequence[index].band == current && sequence[index].mode == current_mode)
+        {
+          current_slot_index = index;
+          break;
+        }
+    }
+  auto const target_slot = sequence.value ((current_slot_index + 1 + sequence.size ()) % sequence.size ());
+  if (target_slot.band.isEmpty () || target_slot.mode.isEmpty ())
+    {
+      last_hop_at = now;
+      return;
+    }
+
+  if (om0rx_qsy_to_band_mode (target_slot.band, target_slot.mode))
+    {
+      last_hop_at = now;
+      last_decode_activity_at = now;
+      last_workable_seen_at = now;
+      last_decode_signature = decode_signature;
+      showStatusMessage (tr ("OM0RX hunt hop: %1 %2").arg (target_slot.band, target_slot.mode));
+    }
+}

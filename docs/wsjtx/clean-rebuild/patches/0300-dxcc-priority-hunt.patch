+void MainWindow::clear_om0rx_priority_hunt (QString const& reason)
+{
+  if (m_om0rxPriorityHuntActive && m_zdebug)
+    log ("OM0RX priority hunt cleared: " + reason + " call=" + m_om0rxPriorityHuntCall);
+  m_om0rxPriorityHuntActive = false;
+  m_om0rxPriorityHuntCall.clear ();
+  m_om0rxPriorityHuntBand.clear ();
+  m_om0rxPriorityHuntMode.clear ();
+  m_om0rxPriorityHuntRank = -1;
+  update_watchdog_label ();
+}
+
+void MainWindow::consider_om0rx_priority_hunt (QJsonObject const& status,
+                                                QString const& callsign,
+                                                QString const& band,
+                                                QString const& mode,
+                                                bool is_cq,
+                                                int time_sec,
+                                                QString const& grid,
+                                                QString const& message,
+                                                int audio_frequency)
+{
+  if (!ui->cbWatchUnconfirmedDXCC->isChecked () || !is_cq
+      || !ui->cbAutoCall->isChecked () || ui->autoButton->isChecked ()
+      || m_transmitting || m_tune || m_tx_watchdog)
+    return;
+
+  auto current_band = m_currentBand.trimmed ().toLower ();
+  if (current_band.isEmpty ()) current_band = ui->bandComboBox->currentText ().trimmed ().toLower ();
+  if (band != current_band || mode != m_mode.trimmed ().toUpper ()) return;
+  if (callsign == m_lastCall || callsign == m_hisCall) return;
+  if (!ui->dxCallEntry->text ().isEmpty () && ui->dxCallEntry->text ().trimmed ().toUpper () != callsign) return;
+
+  auto const needed = status.value ("needed").toObject ();
+  auto const needed_on_band = status.value ("needed_on_band").toObject ();
+  auto const dxcc_status = status.value ("dxcc_status").toString ().trimmed ();
+  if (dxcc_status.isEmpty () || dxcc_status == "Unknown") return;
+
+  int rank = -1;
+  if (needed.value ("dxcc").toBool () || dxcc_status == "ATNO") rank = 300;
+  else if (dxcc_status == "Worked" || dxcc_status.startsWith ("W/")) rank = 250;
+  else if (needed_on_band.value ("dxcc").toBool () && needed_on_band.value ("dxcc_mode").toBool ()) rank = 220;
+  else if (needed_on_band.value ("dxcc").toBool ()) rank = 210;
+  else if (needed_on_band.value ("dxcc_mode").toBool ()) rank = 200;
+  if (rank < 0) return;
+
+  if (m_om0rxPriorityHuntActive)
+    {
+      if (m_om0rxPriorityHuntCall == callsign) return;
+      if (rank <= m_om0rxPriorityHuntRank) return;
+    }
+
+  int nmod;
+  if (m_mode == "FT2")
+    {
+      auto period = static_cast<int> (round (static_cast<double> (time_sec) / m_TRperiod));
+      nmod = period % 2;
+    }
+  else
+    {
+      nmod = fmod (static_cast<double> (time_sec), 2.0 * m_TRperiod);
+    }
+  auto const tx_first = (nmod != 0);
+  if (m_TxFirstLock && ui->txFirstCheckBox->isChecked () != tx_first) return;
+
+  DecodedText decoded {message};
+  m_priorityCall = callsign;
+  m_priorityCallPreferCQTarget = false;
+  m_prioFreq = audio_frequency;
+  m_nextRpt = decoded.report ();
+  m_prioTxFirst = tx_first;
+  m_prioGrid = grid;
+  m_om0rxPriorityHuntActive = true;
+  m_om0rxPriorityHuntCall = callsign;
+  m_om0rxPriorityHuntBand = band;
+  m_om0rxPriorityHuntMode = mode;
+  m_om0rxPriorityHuntRank = rank;
+  m_idleMinutes = 0;
+  update_watchdog_label ();
+  log (QString {"OM0RX priority hunt selected call=%1 band=%2 mode=%3 dxcc=%4 watchdog=%5m"}
+       .arg (callsign, band, mode, dxcc_status)
+       .arg (m_om0rxPriorityHuntWatchdogMinutes));
+  QTimer::singleShot (0, this, [this] { ZProcess (); });
+}

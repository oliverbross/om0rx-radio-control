+        && (ui->txrb6->isChecked() || m_ntx == 6)
+        && ui->tx6->text().trimmed().contains(QRegularExpression {"^(CQ|QRZ)(\\s|$)"});
+    if (m_transmitting || (ui && ui->autoButton->isChecked() && !forbidden_autocall_cq)) return false;
+    if (m_QSOProgress != ROGERS && m_QSOProgress != SIGNOFF) return false;
+
+    auto const active_call = om0rx_normalized_call(m_hisCall);
+    auto const dx_entry = ui ? om0rx_normalized_call(ui->dxCallEntry->text()) : QString {};
+    auto const last_logged = om0rx_normalized_call(m_lastCall);
+    if (last_logged.isEmpty()) return false;
+    if (active_call != last_logged && dx_entry != last_logged) return false;
+
+    if (m_zdebug) {
+        log("OM0RX stale logged QSO cleared: " + last_logged + " reason=" + reason);
+    }
+    m_om0rxReplyPriorityCall.clear();
+    m_om0rxPendingDirectReplyLine.clear();
+    m_om0rxPendingDirectReplyValid = false;
+    om0rx_stop_forbidden_autocall_cq("stale logged QSO cleanup");
+    clearDX();
+    return true;
+}
+
+bool MainWindow::om0rx_clear_stale_final_qso_state(QString const& reason)
+{
+    static QString s_seen_key;
+    static QDateTime s_seen_at;
+
+    if (!ui || m_transmitting || ui->autoButton->isChecked()) {
+        s_seen_key.clear();
+        s_seen_at = QDateTime {};
+        return false;
+    }
+    if (!ui->cbAutoCall->isChecked() && !ui->cb_autoCallNext->isChecked() && !ui->cbAutoCQ->isChecked()) {
+        s_seen_key.clear();
+        s_seen_at = QDateTime {};
+        return false;
+    }
+    if (m_QSOProgress != ROGERS && m_QSOProgress != SIGNOFF) {
+        s_seen_key.clear();
+        s_seen_at = QDateTime {};
+        return false;
+    }
+
+    auto const active_call = om0rx_normalized_call(m_hisCall);
+    auto const dx_entry = ui ? om0rx_normalized_call(ui->dxCallEntry->text()) : QString {};
+    if (active_call.isEmpty() && dx_entry.isEmpty()) {
+        s_seen_key.clear();
+        s_seen_at = QDateTime {};
+        return false;
+    }
+
+    auto const last_logged = om0rx_normalized_call(m_lastCall);
+    if (!last_logged.isEmpty() && (active_call == last_logged || dx_entry == last_logged)) {
+        if (m_zdebug) {
+            log("OM0RX stale final state matched logged QSO; clearing: " + last_logged + " reason=" + reason);
+        }
+        s_seen_key.clear();
+        s_seen_at = QDateTime {};
+        clearDX();
+        return true;
+    }
+
+    auto const key = QString {"%1|%2|%3"}.arg(active_call, dx_entry, QString::number(m_QSOProgress));
+    auto const now = QDateTime::currentDateTimeUtc();
+    if (s_seen_key != key || !s_seen_at.isValid()) {
+        s_seen_key = key;
+        s_seen_at = now;
+        return false;
+    }
+
+    int const stale_after = std::max(45, int(m_TRperiod * 3));
+    if (s_seen_at.secsTo(now) < stale_after) {
+        return false;
+    }
+
+    if (m_zdebug) {
+        log("OM0RX stale final QSO state cleared: active=" + active_call
+            + " dx=" + dx_entry
+            + " reason=" + reason);
+    }
+    m_om0rxReplyPriorityCall.clear();
+    m_om0rxPendingDirectReplyLine.clear();
+    m_om0rxPendingDirectReplyValid = false;
+    m_bAutoReply = false;
+    m_bCallingCQ = false;
+    s_seen_key.clear();
+    s_seen_at = QDateTime {};
+    clearDX();
+    return true;
+}
+
+void MainWindow::om0rx_auto_reply_direct_call(DecodedText const& message, QString const& call)
+{
+    auto const normalized_call = om0rx_normalized_call(call);
+    if (normalized_call.isEmpty()) return;
+
+    if (!ui->cbAutoSeq->isChecked()
+        || !(ui->cbAutoCall->isChecked()
+             || ui->cbAutoCQ->isChecked()
+             || ui->cb_autoCallNext->isChecked())) {
+        if (m_zdebug) log("OM0RX direct reply ignored; automation is not active: " + normalized_call);
+        return;
+    }
+
+    om0rx_clear_stale_logged_qso("direct reply precheck");
+    m_om0rxReplyPriorityCall = normalized_call;
+    m_om0rxPendingDirectReplyLine = message.string();
+    m_om0rxPendingDirectReplyValid = true;
+
+    bool const idle_or_finished =
+        CALLING == m_QSOProgress || ROGERS == m_QSOProgress || SIGNOFF == m_QSOProgress;
+    bool const can_interrupt_unanswered_call =
+        CALLING == m_QSOProgress && ui->autoButton->isChecked() && !m_transmitting;
+    if (m_transmitting || (!can_interrupt_unanswered_call && ui->autoButton->isChecked()) || !idle_or_finished) {
+        if (m_zdebug) log("OM0RX direct reply held; QSO is active: " + normalized_call);
+        return;
+    }
+
+    QTimer::singleShot(0, this, [this, message, normalized_call] {
+        om0rx_clear_stale_logged_qso("direct reply start");
+        bool const idle_or_finished =
+            CALLING == m_QSOProgress || ROGERS == m_QSOProgress || SIGNOFF == m_QSOProgress;
+        bool const can_interrupt_unanswered_call =
+            CALLING == m_QSOProgress && ui->autoButton->isChecked() && !m_transmitting;
+        if (m_transmitting || (!can_interrupt_unanswered_call && ui->autoButton->isChecked()) || !idle_or_finished) {
+            if (m_zdebug) log("OM0RX direct reply skipped after state changed: " + normalized_call);
+            return;
+        }
+
+        if (can_interrupt_unanswered_call) {
+            if (m_zdebug) log("OM0RX direct reply interrupts unanswered Auto Call: " + normalized_call);
+            ui->autoButton->setChecked(false);
+            on_autoButton_clicked(false);
+            clearDX();
+        }
+
+        m_priorityCall.clear();
+        m_priorityCallPreferCQTarget = false;
+        m_om0rxHuntingPriorityScore = -1;
+        m_om0rxReplyPriorityCall = normalized_call;
+        m_om0rxPendingDirectReplyLine.clear();
+        m_om0rxPendingDirectReplyValid = false;
+        om0rx_clear_priority_hunt("direct reply to us");
+
+        if (m_zdebug) log("OM0RX direct reply auto-start: " + normalized_call);
+        processMessage(message);
+        if (!ui->dxCallEntry->text().isEmpty()) {
+            auto_tx_mode(true);
+        }
+    });
+}

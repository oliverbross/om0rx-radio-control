@app.post("/api/wsjtx/log-qso")
async def wsjtx_log_qso(req: WSJTXQSORequest):
    """
    Auto-log a QSO from WSJT-X to Wavelog
    Enriches with QRZ data if available
    """
    if not wavelog_client:
        raise HTTPException(status_code=503, detail="Wavelog client not initialized")
    
    try:
        call = req.call.strip().upper()
        
        # Fetch QRZ data if not already provided
        qrz_data = req.qrz_data or {}
        if not qrz_data and qrz_client:
            try:
                logger.info(f"📡 Fetching QRZ data for {call}...")
                qrz_data = await qrz_client.lookup(call) or {}
            except Exception as e:
                logger.warning(f"⚠️  QRZ lookup failed for {call}: {e}")
        
        # Build QSO data from WSJT-X and QRZ
        qso_data = {
            "call": call,
            "band": band_from_khz(req.frequency_hz / 1000) if req.frequency_hz else None,
            "mode": req.mode.upper(),
            "gridsquare": req.grid or qrz_data.get("grid", ""),
            # RST values: keep as-is or use defaults (wavelog_api.py handles conversion)
            "rst_sent": req.rst_sent,
            "rst_received": req.rst_received,
            "operator": req.operator or config.MY_STATION,
            "comments": req.comments or f"Auto-logged from WSJT-X ({req.mode})",
            
            # QRZ-enriched data
            "name": qrz_data.get("fname", ""),
            "qth": qrz_data.get("state", qrz_data.get("country", "")),
            "country": qrz_data.get("country", ""),
            "state": qrz_data.get("state", ""),
            "cq_zone": qrz_data.get("cqzone"),
            "itu_zone": qrz_data.get("ituzone"),
            "continent": qrz_data.get("continent", ""),
            "latitude": qrz_data.get("lat"),
            "longitude": qrz_data.get("lon"),
            "email": qrz_data.get("email", ""),
            "lotw_member": qrz_data.get("lotw", False),
        }
        
        logger.info(f"📝 Auto-logging QSO: {call} on {qso_data['band']} {req.mode}")
        
        # Log to Wavelog
        result = await wavelog_client.create_qso(qso_data)
        
        if result and result.get("success"):
            logger.info(f"✅ QSO logged successfully: {call}")
            return {"success": True, "qso_id": result.get("qso_id")}
        else:
            logger.error(f"❌ Failed to log QSO: {result}")
            raise HTTPException(status_code=500, detail=f"Failed to log QSO: {result}")
    
    except Exception as e:
        logger.error(f"❌ WSJT-X log error: {e}")
        raise HTTPException(status_code=500, detail=str(e))


@app.post("/api/wsjtx/auto-rotate")
async def wsjtx_auto_rotate(req: WSJTXAutoRotateRequest):
    """
    Auto-rotate to DX station based on grid square
    Only rotates if ROTOR_AUTO_ENABLED is True
    """
    if not config.ROTOR_AUTO_ENABLED or not rotor:
        return {"success": False, "reason": "Rotator auto mode not enabled"}
    
    try:
        call = req.call.strip().upper()
        grid = req.grid.strip().upper()
        
        if not grid or len(grid) < 4:
            logger.warning(f"⚠️  Invalid grid square for {call}: {grid}")
            return {"success": False, "reason": "Invalid grid square"}
        
        logger.info(f"🎯 Auto-rotating to {call} ({grid})...")
        
        # Get home station coordinates
        home_lat = config.ROTOR_HOME_LAT
        home_lon = config.ROTOR_HOME_LON
        
        # Get DX station coordinates from grid
        try:
            dx_lat, dx_lon = grid_to_latlon(grid)
        except Exception as e:
            logger.error(f"❌ Failed to convert grid {grid}: {e}")
            return {"success": False, "reason": f"Invalid grid: {grid}"}
        
        # Calculate bearing
        bearing = initial_bearing(home_lat, home_lon, dx_lat, dx_lon)
        
        # Get band from frequency (to check if band-specific override exists)
        band = None
        if req.frequency_hz:
            band = get_band_from_frequency(req.frequency_hz / 1e6)
        
        # Check if this band has a specific bearing offset
        band_offset = 0
        if band and hasattr(config, 'ROTOR_BANDS') and band in config.ROTOR_BANDS:
            band_offset = config.ROTOR_BANDS[band].get("offset", 0)
        
        adjusted_bearing = (bearing + band_offset) % 360
        
        # Send command to rotator
        cmd_result = await rotor.goto_azimuth(int(adjusted_bearing))
        
        if cmd_result:
            logger.info(f"✅ Rotator command sent: {call} on {bearing}° (adjusted: {adjusted_bearing}°)")
            return {
                "success": True,
                "call": call,
                "grid": grid,
                "bearing": bearing,
                "adjusted_bearing": adjusted_bearing,
                "band": band
            }
        else:
            logger.error(f"❌ Rotator command failed: {call}")
            return {"success": False, "reason": "Rotator command failed"}
    
    except Exception as e:
        logger.error(f"❌ Auto-rotate error: {e}")
        raise HTTPException(status_code=500, detail=str(e))



+  layout->addWidget (badge_label);
+
+  auto * matrix_label = new QLabel {tr ("Band/Mode Matrix"), dialog};
+  matrix_label->setObjectName ("om0rxHistoryTitle");
+  layout->addWidget (matrix_label);
+
+  QStringList bands {"160m", "80m", "60m", "40m", "30m", "20m", "17m", "15m", "12m", "10m", "6m", "2m"};
+  QStringList modes {"CW", "FT8", "FT4", "FT2", "RTTY", "SSB", "LSB", "USB"};
+  auto * matrix_table = new QTableWidget {modes.size (), bands.size (), dialog};
+  matrix_table->setHorizontalHeaderLabels (bands);
+  matrix_table->setVerticalHeaderLabels (modes);
+  matrix_table->setEditTriggers (QAbstractItemView::NoEditTriggers);
+  matrix_table->horizontalHeader ()->setSectionResizeMode (QHeaderView::Stretch);

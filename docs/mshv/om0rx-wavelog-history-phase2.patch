+void AutoDxerCore::refreshWavelogHistory()
+{
+    if (m_historyRequestPending || !m_historyNetwork) return;
+    QString base = QString::fromUtf8(qgetenv("OM0RX_API_BASE"));
+    if (base.isEmpty()) base = "http://127.0.0.1:8080";
+    QNetworkRequest request(QUrl(base + "/api/digital/mshv-history"));
+    request.setRawHeader("X-OM0RX-Control-Token", qgetenv("OM0RX_CONTROL_TOKEN"));
+    m_historyRequestPending = true;
+    QNetworkReply *reply = m_historyNetwork->get(request);
+    QTimer::singleShot(4000, reply, [reply]() {
+        if (reply->isRunning()) reply->abort();
+    });
+    connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+        applyWavelogHistoryReply(reply);
+        reply->deleteLater();
+    });
+}
+
+void AutoDxerCore::applyWavelogHistoryReply(QNetworkReply *reply)
+{
+    m_historyRequestPending = false;
+    bool allowed = false;
+    QString status = "unavailable";
+    QJsonObject payload;
+    if (reply && reply->error() == QNetworkReply::NoError) {
+        QJsonParseError error;
+        const QJsonDocument document = QJsonDocument::fromJson(reply->readAll(), &error);
+        if (error.error == QJsonParseError::NoError && document.isObject()) {
+            payload = document.object();
+            allowed = payload.value("historical_novelty_allowed").toBool(false);
+            status = payload.value("status").toString("invalid");
+            const QDateTime generated = QDateTime::fromString(
+                payload.value("generated_at").toString(), Qt::ISODate);
+            const int maxAge = payload.value("max_age_seconds").toInt(0);
+            const qint64 age = generated.isValid()
+                ? generated.secsTo(QDateTime::currentDateTimeUtc()) : -1;
+            if (!generated.isValid() || maxAge <= 0 || maxAge > 30 || age < 0 || age > maxAge) {
+                allowed = false;
+                status = "stale-history-response";
+            }
+        } else {
+            status = "invalid-json";
+        }
+    }
+    if (status != m_historyAuthorityStatus) {
+        emit debugMessage(QString("WAVELOG-HISTORY-SYNC: status=%1 delta-sync=%2")
+                          .arg(status).arg(allowed ? "available" : "deferred"));
+    }
+    m_historyAuthorityStatus = status;
+    if (!allowed) {
+        revokeHistoricalNovelty(status);
+        return;
+    }
+    const QJsonObject deltasObject = payload.value("deltas").toObject();
+    QSet<QString> pendingCalls;
+    const QJsonArray pendingRecords = deltasObject.value("pending_records").toArray();
+    for (const QJsonValue &value : pendingRecords) {
+        if (!value.isObject()) {
+            revokeHistoricalNovelty("invalid-pending-wavelog-row");
+            return;
+        }
+        const QString call = value.toObject().value("call").toString().trimmed().toUpper();
+        if (call.isEmpty()) {
+            revokeHistoricalNovelty("invalid-pending-wavelog-row");
+            return;
+        }
+        pendingCalls.insert(call);
+    }
+    if (!m_hvDxccTracker) {
+        revokeHistoricalNovelty("tracker-unavailable");
+        return;
+    }
+
+    const QString generation = payload.value("snapshot").toObject().value("generation").toString();
+    if (generation.isEmpty()) {
+        revokeHistoricalNovelty("missing-snapshot-generation");
+        return;
+    }
+    if (m_historySnapshotGeneration.isEmpty()) m_historySnapshotGeneration = generation;
+    if (m_historySnapshotGeneration != generation) {
+        revokeHistoricalNovelty("snapshot-generation-mismatch");
+        return;
+    }
+    const QJsonArray records = deltasObject.value("acknowledged_records").toArray();
+    const int baseSequence = deltasObject.value("base_sequence").toInt(0);
+    if (m_appliedHistoryDeltaKeys.isEmpty() && m_historyLastSequence == 0 && baseSequence > 0) {
+        m_historyLastSequence = baseSequence;
+        if (!persistWavelogDeltaState()) {
+            revokeHistoricalNovelty("delta-base-state-persist-failed");
+            return;
+        }
+    }
+    for (const QJsonValue &value : records) {
+        if (!value.isObject()) {
+            revokeHistoricalNovelty("invalid-delta-row");
+            return;
+        }
+        const QJsonObject row = value.toObject();
+        const QString key = row.value("key").toString();
+        if (key.size() != 64) {
+            revokeHistoricalNovelty("invalid-delta-key");
+            return;
+        }
+        const int sequence = row.value("sequence").toInt(0);
+        if (m_appliedHistoryDeltaKeys.contains(key)) {
+            if (sequence > m_historyLastSequence) {
+                revokeHistoricalNovelty("delta-state-sequence-mismatch");
+                return;
+            }
+            continue;
+        }
+        if (sequence != m_historyLastSequence + 1) {
+            revokeHistoricalNovelty("delta-sequence-regression");
+            return;
+        }
+        const QString band = row.value("band").toString().toLower();
+        int bandIndex = -1;
+        if (band == "160m") bandIndex = 3; else if (band == "80m") bandIndex = 4;
+        else if (band == "40m") bandIndex = 6; else if (band == "30m") bandIndex = 7;
+        else if (band == "20m") bandIndex = 8; else if (band == "17m") bandIndex = 9;
+        else if (band == "15m") bandIndex = 10; else if (band == "12m") bandIndex = 11;
+        else if (band == "10m") bandIndex = 12; else if (band == "6m") bandIndex = 14;
+        const QString call = row.value("call").toString().toUpper();
+        const QString mode = row.value("mode").toString().toUpper();
+        const QString date = row.value("qso_date").toString();
+        if (call.isEmpty() || bandIndex < 3 || (mode != "FT8" && mode != "FT4") || date.size() != 8) {
+            revokeHistoricalNovelty("invalid-delta-identity");
+            return;
+        }
+        if (!m_hvDxccTracker->applyWavelogAcknowledgedQso(
+                key, call, row.value("grid").toString().toUpper(), bandIndex, mode, date)) {
+            revokeHistoricalNovelty("tracker-delta-apply-failed");
+            return;
+        }
+        m_appliedHistoryDeltaKeys.insert(key);
+        m_historyLastSequence = sequence;
+        if (!persistWavelogDeltaState()) {
+            revokeHistoricalNovelty("delta-state-persist-failed");
+            return;
+        }
+        emit debugMessage(QString("WAVELOG-HISTORY-DELTA: applied %1 %2 %3").arg(call, band, mode));
+    }
+    m_pendingWavelogCalls = pendingCalls;
+    if (m_targetScorer) {
+        m_targetScorer->setPendingWavelogCalls(m_pendingWavelogCalls);
+        m_targetScorer->setHistoricalNoveltyAllowed(true);
+    }
+    m_historicalNoveltyAllowed = true;
+    cancelPendingWavelogPaths();
+}
+
+bool AutoDxerCore::isPendingWavelogCall(const QString &callsign) const
+{
+    const QString candidate = callsign.trimmed();
+    if (candidate.isEmpty()) return false;
+    for (const QString &pending : m_pendingWavelogCalls) {
+        if (callsignsMatch(candidate, pending)) return true;
+    }
+    return false;
+}
+
+bool AutoDxerCore::historicalActionAllowed(const QString &callsign, bool isCallingMe) const
+{
+    if (isPendingWavelogCall(callsign)) return false;
+    return isCallingMe || m_historicalNoveltyAllowed;
+}
+
+bool AutoDxerCore::cancelPendingWavelogPaths()
+{
+    if (m_queueWidget) {
+        for (const QString &call : m_pendingWavelogCalls) {
+            const bool engagedActiveCall = m_currentTarget.isValid()
+                && (m_targetRespondedToUs || m_currentTarget.isCallingMe)
+                && callsignsMatch(call, m_currentTarget.callsign);
+            if (engagedActiveCall) continue;
+            int row = m_queueWidget->getQueueList()->FindCallOrBaseCallRow(call);
+            if (row >= 0) m_queueWidget->getQueueList()->RemoveRow(row);
+            row = m_queueWidget->getNowList()->FindCallOrBaseCallRow(call);
+            if (row >= 0) m_queueWidget->getNowList()->RemoveRow(row);
+        }
+    }
+    if (m_waitingForSlotAnalysis && isPendingWavelogCall(m_pendingSlotAnalysisTarget.callsign)) {
+        emit debugMessage("WAVELOG-PENDING: cancelled deferred slot target " + m_pendingSlotAnalysisTarget.callsign);
+        m_waitingForSlotAnalysis = false;
+        m_pendingSlotAnalysisTarget = ScoredTarget();
+    }
+    if (isPendingWavelogCall(m_pendingCrossBandCallsign)) {
+        emit debugMessage("WAVELOG-PENDING: cancelled cross-band target " + m_pendingCrossBandCallsign);
+        if (returnFromPendingCrossBandVerification("Wavelog pending identity")) return true;
+    }
+    if (isPendingWavelogCall(m_pendingNonStdCallsign)) {
+        emit debugMessage("WAVELOG-PENDING: cancelled non-standard target " + m_pendingNonStdCallsign);
+        m_pendingNonStdCallsign.clear();
+        m_pendingNonStdDialFreq = 0;
+    }
+    if (m_currentTarget.isValid() && !m_currentTarget.isCallingMe
+            && !m_targetRespondedToUs
+            && isPendingWavelogCall(m_currentTarget.callsign)) {
+        emit requestDisableAuto();
+        emit debugMessage("WAVELOG-PENDING: cancelled active target " + m_currentTarget.callsign);
+        m_currentTarget.clear();
+        m_targetAttemptTimer.invalidate();
+        m_quietBandTimer.invalidate();
+        emit targetChanged(m_currentTarget);
+        setState(Listening);
+    }
+    return false;
+}
+
+void AutoDxerCore::clearPendingCrossBandVerification()
+{
+    m_pendingCrossBandCallsign.clear();
+    m_pendingCrossBandTime = QDateTime();
+    m_pendingCrossBandBand = -1;
+    m_pendingCrossBandReturnBand = -1;
+    m_pendingCrossBandDialFreq = 0;
+    m_pendingCrossBandAudioFreq = 0;
+}
+
+bool AutoDxerCore::returnFromPendingCrossBandVerification(const QString &reason)
+{
+    const int destinationBand = m_pendingCrossBandBand;
+    const int originBand = m_pendingCrossBandReturnBand;
+    const bool safe = !m_pendingCrossBandCallsign.isEmpty()
+        && m_state == Listening && !m_currentTarget.isValid()
+        && !m_targetRespondedToUs && m_currentBandIndex == destinationBand
+        && originBand >= 3 && originBand != destinationBand;
+    if (!safe) {
+        // CAT QSY completion is asynchronous. Preserve destination and origin
+        // while the core still reports the source band so onBandChangeComplete
+        // can perform the requested return safely.
+        if (!m_pendingCrossBandCallsign.isEmpty()
+                && originBand >= 3 && destinationBand >= 3
+                && m_currentBandIndex != destinationBand) {
+            emit debugMessage("CROSSBAND-RETURN-PENDING: " + reason);
+            return true;
+        }
+        clearPendingCrossBandVerification();
+        return false;
+    }
+    clearPendingCrossBandVerification();
+
+    emit requestDisableAuto();
+    if (m_queueWidget) m_queueWidget->clearBothLists();
+    m_waitingForSlotAnalysis = false;
+    m_pendingSlotAnalysisTarget = ScoredTarget();
+    if (m_decodeCache) m_decodeCache->clearBand(destinationBand);
+    m_lastBandSwitchTime = QDateTime::currentDateTimeUtc();
+    emit debugMessage(QString("CROSSBAND-RETURN: %1; returning from %2 to %3")
+                     .arg(reason).arg(bandName(destinationBand)).arg(bandName(originBand)));
+    emit requestBandChange(originBand);
+    return true;
+}
+
+void AutoDxerCore::loadWavelogDeltaState(const QString &settingsPath)
+{
+    m_historyStatePath = QDir(settingsPath).filePath("database/wavelog_delta_state.json");
+    QFile file(m_historyStatePath);
+    if (!file.open(QIODevice::ReadOnly)) return;
+    const QJsonDocument document = QJsonDocument::fromJson(file.readAll());
+    const QJsonObject state = document.object();
+    if (state.value("schema").toInt() != 1) return;
+    m_historySnapshotGeneration = state.value("snapshot_generation").toString();
+    m_historyLastSequence = state.value("last_sequence").toInt(0);
+    for (const QJsonValue &value : state.value("applied_keys").toArray()) {
+        const QString key = value.toString();
+        if (!key.isEmpty()) m_appliedHistoryDeltaKeys.insert(key);
+    }
+}
+
+bool AutoDxerCore::persistWavelogDeltaState()
+{
+    const QString trackerPath = QFileInfo(m_historyStatePath).dir().filePath("worked.db");
+    QFile tracker(trackerPath);
+    if (!tracker.open(QIODevice::ReadOnly)) return false;
+    QCryptographicHash hash(QCryptographicHash::Sha256);
+    if (!hash.addData(&tracker)) return false;
+    QJsonArray keys;
+    QStringList ordered = m_appliedHistoryDeltaKeys.values();
+    ordered.sort();
+    for (const QString &key : ordered) keys.append(key);
+    QJsonObject state;
+    state["schema"] = 1;
+    state["snapshot_generation"] = m_historySnapshotGeneration;
+    state["last_sequence"] = m_historyLastSequence;
+    state["applied_keys"] = keys;
+    state["tracker_sha256"] = QString::fromLatin1(hash.result().toHex());
+    QSaveFile file(m_historyStatePath);
+    if (!file.open(QIODevice::WriteOnly)) return false;
+    if (file.write(QJsonDocument(state).toJson(QJsonDocument::Indented)) < 0) return false;
+    return file.commit();
+}
+
+void AutoDxerCore::revokeHistoricalNovelty(const QString &reason)
+{
+    m_historyAuthorityStatus = reason;
+    m_historicalNoveltyAllowed = false;
+    if (m_targetScorer) m_targetScorer->setHistoricalNoveltyAllowed(false);
+    cancelPendingWavelogPaths();
+    if (!m_pendingCrossBandCallsign.isEmpty()
+            && m_currentBandIndex == m_pendingCrossBandBand
+            && !m_targetRespondedToUs) {
+        returnFromPendingCrossBandVerification("historical authority revoked");
+    }
+    if (m_currentTarget.isValid() && !m_targetRespondedToUs
+            && !m_currentTarget.isCallingMe
+            && (m_currentTargetIsATNO || m_currentTargetIsNewSlot
+                || m_currentTargetIsNewGrid)) {
+        abandonCurrentTarget("historical authority revoked");
+    }
+    emit debugMessage("WAVELOG-HISTORY-BLOCKED: " + reason);
+}

+void AutoDxerCore::noteTransientHistoryFailure(const QString &reason)
+{
+    const QDateTime now = QDateTime::currentDateTimeUtc();
+    if (!m_historyFirstTransientFailureAt.isValid()) {
+        m_historyFirstTransientFailureAt = now;
+        if (m_historyTransientGraceTimer) {
+            m_historyTransientGraceTimer->start(HISTORY_TRANSIENT_GRACE_SECONDS * 1000);
+        }
+    }
+    ++m_historyTransientFailureCount;
+    const int shift = qMin(m_historyTransientFailureCount - 1, 2);
+    const int retrySeconds = qMin<int>(HISTORY_RETRY_MAX_SECONDS,
+                                  HISTORY_RETRY_BASE_SECONDS << shift);
+    m_historyRetryNotBefore = now.addSecs(retrySeconds);
+    m_historyAuthorityStatus = "transient-unavailable";
+    m_historicalNoveltyAllowed = false;
+    if (m_targetScorer) m_targetScorer->setHistoricalNoveltyAllowed(false);
+
+    const bool sustained = m_historyTransientFailureCount >= HISTORY_TRANSIENT_FAILURE_LIMIT
+        || m_historyFirstTransientFailureAt.secsTo(now) >= HISTORY_TRANSIENT_GRACE_SECONDS;
+    if (sustained) {
+        emit debugMessage(QString("WAVELOG-HISTORY-TRANSIENT-TERMINAL: %1 failures=%2")
+                          .arg(reason).arg(m_historyTransientFailureCount));
+        terminalizeTransientHistoryFailure(reason);
+        return;
+    }
+    emit debugMessage(QString("WAVELOG-HISTORY-TRANSIENT: %1 failures=%2 retry=%3s; "
+                              "preserving active verification only")
+                      .arg(reason).arg(m_historyTransientFailureCount).arg(retrySeconds));
+}
+
+void AutoDxerCore::clearTransientHistoryFailure()
+{
+    if (m_historyTransientGraceTimer) m_historyTransientGraceTimer->stop();
+    m_historyTransientFailureCount = 0;
+    m_historyTransientTerminalized = false;
+    m_historyFirstTransientFailureAt = QDateTime();
+    m_historyRetryNotBefore = QDateTime();
+}
+
+void AutoDxerCore::expireTransientHistoryGrace()
+{
+    if (m_historyTransientTerminalized || m_historyTransientFailureCount <= 0
+            || !m_historyFirstTransientFailureAt.isValid()) return;
+    const QDateTime now = QDateTime::currentDateTimeUtc();
+    const QDateTime deadline = m_historyFirstTransientFailureAt.addSecs(
+        HISTORY_TRANSIENT_GRACE_SECONDS);
+    if (now < deadline) {
+        const qint64 remainingMs = now.msecsTo(deadline);
+        if (m_historyTransientGraceTimer) {
+            m_historyTransientGraceTimer->start(
+                static_cast<int>(qMax<qint64>(1, remainingMs)));
+        }
+        return;
+    }
+    emit debugMessage(QString("WAVELOG-HISTORY-TRANSIENT-DEADLINE: failures=%1 grace=%2s")
+                      .arg(m_historyTransientFailureCount)
+                      .arg(HISTORY_TRANSIENT_GRACE_SECONDS));
+    terminalizeTransientHistoryFailure("history-api-grace-expired");
+}
+
+void AutoDxerCore::terminalizeTransientHistoryFailure(const QString &reason)
+{
+    if (m_historyTransientTerminalized || m_historyTransientFailureCount <= 0) return;
+    m_historyTransientTerminalized = true;
+    if (m_historyTransientGraceTimer) m_historyTransientGraceTimer->stop();
+    if (m_historyRequestGeneration > m_historyIgnoreRepliesThroughGeneration) {
+        m_historyIgnoreRepliesThroughGeneration = m_historyRequestGeneration;
+    }
+    if (m_historyActiveReply && m_historyActiveReply->isRunning()) {
+        m_historyActiveReply->abort();
+    }
+    if (!m_pendingCrossBandCallsign.isEmpty()) {
+        m_pendingCrossBandTerminalReason = reason;
+    }
+    revokeHistoricalNovelty(reason);
+}
+
+bool AutoDxerCore::historyReplyIsStale(quint64 requestGeneration) const
+{
+    return requestGeneration > 0
+        && requestGeneration <= m_historyIgnoreRepliesThroughGeneration;
+}

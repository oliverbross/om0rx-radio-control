+void DisplayText::annotate_decode_status (QString const& callsign, QString const& band,
+                                          QString const& mode, QString const& call_status,
+                                          QString const& dxcc_status)
+{
+  auto const key = decode_status_key (callsign, band, mode);
+  for (auto block = document ()->begin (); block.isValid (); block = block.next ())
+    {
+      auto * data = dynamic_cast<DecodeStatusBlockData *> (block.userData ());
+      if (!data || data->key != key) continue;
+
+      auto text = block.text ();
+      auto appendage_start = text.indexOf (QChar::Nbsp);
+      QString appendage;
+      if (appendage_start >= 0)
+        {
+          appendage = text.mid (appendage_start + 1).simplified ();
+          text = text.left (appendage_start).trimmed ();
+        }
+      static QRegularExpression const existing_columns {
+          QStringLiteral (R"(\s{1,}(?:\.\.\.|\?|NC|NB\+M|NB|NM|C|W|ATNO|C/NB\+M|W/NB\+M|C/NB|W/NB|C/NM|W/NM)\s{1,}(?:\.\.\.|\?|NC|NB\+M|NB|NM|C|W|ATNO|C/NB\+M|W/NB\+M|C/NB|W/NB|C/NM|W/NM)\s*$)")};
+      auto match = existing_columns.match (text);
+      if (match.hasMatch ()) text = text.left (match.capturedStart ()).trimmed ();
+
+      QTextCursor cursor {block};
+      cursor.movePosition (QTextCursor::StartOfBlock);
+      cursor.movePosition (QTextCursor::EndOfBlock, QTextCursor::KeepAnchor);
+      cursor.removeSelectedText ();
+      auto separator = cursor.charFormat ();
+      separator.clearBackground ();
+      separator.setFont (char_font_);
+      separator.setForeground (QColor {100, 116, 139});
+      separator.setFontWeight (QFont::Normal);
+      cursor.insertText (text, separator);
+      cursor.insertText (QString {std::max (1, 45 - text.size ()), QChar {' '}}, separator);
+      cursor.insertText (status_cell (call_status), status_format (call_status, char_font_));
+      cursor.insertText (QString {" "}, separator);
+      cursor.insertText (status_cell (dxcc_status), status_format (dxcc_status, char_font_));
+      if (!appendage.isEmpty ()) cursor.insertText (QString {QChar::Nbsp} + appendage, separator);
+    }
 }
 
 

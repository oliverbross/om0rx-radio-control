+void MainWindow::apply_om0rx_decode_status (QString const& callsign, QString const& band,
+                                            QString const& mode, QString const& call_status,
+                                            QString const& dxcc_status)
+{
+  ui->decodedTextBrowser->annotate_decode_status (callsign, band, mode, call_status, dxcc_status);
+  ui->decodedTextBrowser2->annotate_decode_status (callsign, band, mode, call_status, dxcc_status);

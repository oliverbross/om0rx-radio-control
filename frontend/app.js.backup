            },
            
            // UI state
            statusMessage: null,
            currentTime: '',
            
            // Debounce timers for sliders
            sliderDebounceTimers: {},
            
            // Configuration modal
            showConfigModal: false,
            activeConfigTab: 'database',
            configTabs: [
                { id: 'database', name: 'Database' },
                { id: 'station', name: 'Station & Cluster' },
                { id: 'flex', name: 'Flex & UDP' },

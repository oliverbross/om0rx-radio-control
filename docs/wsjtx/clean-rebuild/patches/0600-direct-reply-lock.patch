+bool MainWindow::om0rx_process_pending_direct_reply()
+{
+    if (!m_om0rxPendingDirectReply || m_transmitting) return false;
+
+    auto const locked_base = Radio::base_callsign(m_om0rxDirectReplyCall);
+    auto const current_base = Radio::base_callsign(ui->dxCallEntry->text());
+    bool const progressed_qso = m_QSOProgress != CALLING && !current_base.isEmpty();
+
+    // Auto-sequence may already have consumed this decode before the queued
+    // callback runs. Do not process it twice, and never interrupt a QSO that
+    // has progressed with another station.
+    if (progressed_qso) {
+        m_om0rxPendingDirectReply = false;
+        m_om0rxPendingDirectReplyLine.clear();
+        if (current_base != locked_base) {
+            m_om0rxDirectReplyCall.clear();
+            m_om0rxDirectReplySeen = QDateTime {};
+        }
+        return false;
+    }
+
+    DecodedText message {m_om0rxPendingDirectReplyLine};
+    m_om0rxPendingDirectReply = false;
+    m_om0rxPendingDirectReplyLine.clear();
+    m_bDoubleClicked = true;
+    m_bAutoReply = true;
+    processMessage(message);
+    if (!ui->dxCallEntry->text().isEmpty()) auto_tx_mode(true);
+    return true;
+}

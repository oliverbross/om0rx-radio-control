        // === Previous QSOs Hover Dropdown ===
        
        formatQSODate(dateStr) {
            // Convert YYYYMMDD format to MM/DD/YY
            if (!dateStr || dateStr.length < 8) return dateStr;
            const year = dateStr.substring(0, 4);
            const month = dateStr.substring(4, 6);
            const day = dateStr.substring(6, 8);
            const shortYear = year.substring(2);
            return `${month}/${day}/${shortYear}`;
        },
        
        async loadAllPreviousQSOs(event) {
            const callsign = this.loggingForm.callsign.trim().toUpperCase();
            if (!callsign) {
                this.allPreviousQSOs = [];
                return;
            }
            
            try {
                console.log(`[All Previous QSOs] 🔍 Loading all QSOs for callsign: ${callsign}`);
                
                const response = await fetch('/api/wavelog/recent_qsos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callsign: callsign,
                        limit: 0  // 0 means fetch ALL previous QSOs
                    })
                });
                
                const result = await response.json();
                console.log(`[All Previous QSOs] 📡 Response:`, result);
                
                if (result.success && result.data) {
                    const qsos = Array.isArray(result.data) ? result.data : [];
                    console.log(`[All Previous QSOs] ✅ Received ${qsos.length} QSOs`);
                    this.allPreviousQSOs = qsos;
                    this.showPrevQSOsDropdown = true;
                    
                    // Position the dropdown relative to button using Vue's nextTick
                    this.$nextTick(() => {
                        this.positionPrevQSOsDropdown(event.target);
                    });
                } else {
                    this.allPreviousQSOs = [];
                    this.showPrevQSOsDropdown = false;
                }
            } catch (error) {
                console.error('[All Previous QSOs] ❌ Error loading QSOs:', error);
                this.allPreviousQSOs = [];
                this.showPrevQSOsDropdown = false;
            }
        },
        
        positionPrevQSOsDropdown(buttonElement) {
            const dropdown = document.querySelector('.prev-qsos-dropdown');
            if (!dropdown || !buttonElement) return;
            
            const rect = buttonElement.getBoundingClientRect();
            // Position dropdown above the button, with small gap
            const gapSize = 8;
            dropdown.style.bottom = (window.innerHeight - rect.top + gapSize) + 'px';
            dropdown.style.left = rect.left + 'px';
            dropdown.style.top = 'auto';  // Reset top to use bottom positioning
        },
        
        closePrevQSOsDropdown() {
            // Close the dropdown when X button is clicked
            this.showPrevQSOsDropdown = false;
        },
        
        cancelClosePrevQSOsHover() {
            // Cancel any pending close timeout
            if (this.closeDropdownTimeout) {
                clearTimeout(this.closeDropdownTimeout);
                this.closeDropdownTimeout = null;
            }
        },
        
        closePrevQSOsHover() {
            // Delay closing to prevent flickering when moving between button and dropdown
            this.closeDropdownTimeout = setTimeout(() => {
                this.showPrevQSOsDropdown = false;
            }, 100);
        },
        

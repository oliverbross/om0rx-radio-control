+void MainWindow::show_om0rx_qso_history_popup (QString const& callsign, QJsonObject const& payload)
+{
+  auto qsos = payload.value ("qsos").toArray ();
+  auto summary = payload.value ("summary").toObject ();
+  auto matrix = payload.value ("matrix").toObject ();
+
+  auto * dialog = new QDialog {this};
+  dialog->setAttribute (Qt::WA_DeleteOnClose);
+  dialog->setWindowTitle (tr ("Previous QSOs - %1").arg (callsign));
+  dialog->resize (880, 560);
+  dialog->setStyleSheet (
+      "QDialog { background: #141827; color: #e5e7eb; }"
+      "QLabel { color: #e5e7eb; }"
+      "QLabel#om0rxHistoryTitle { color: #10d59a; font-weight: 700; font-size: 14px; }"
+      "QLabel#om0rxHistorySummary { background: #24233f; border-left: 3px solid #10d59a; padding: 8px; font-weight: 700; }"
+      "QLabel#om0rxHistoryBadges { background: #24233f; padding: 8px; }"
+      "QTableWidget { background: #16172b; color: #e5e7eb; gridline-color: #3b3b4f; selection-background-color: #0d5ea8; }"
+      "QHeaderView::section { background: #0d3f6e; color: #ffffff; border: 0; padding: 4px; font-weight: 700; }"
+      "QPushButton { background: #2f3a44; color: #ffffff; border: 1px solid #465360; padding: 4px 12px; }");
+
+  auto * layout = new QVBoxLayout {dialog};
+  auto * title = new QLabel {tr ("Previous QSOs - %1").arg (callsign), dialog};
+  title->setObjectName ("om0rxHistoryTitle");
+  layout->addWidget (title);
+
+  auto * count = new QLabel {tr ("%1 times worked before").arg (qsos.size ()), dialog};
+  count->setObjectName ("om0rxHistorySummary");
+  layout->addWidget (count);
+
+  auto * qso_table = new QTableWidget {qsos.size (), 7, dialog};
+  qso_table->setHorizontalHeaderLabels ({tr ("Date"), tr ("Callsign"), tr ("Mode"),
+                                         tr ("RST (S)"), tr ("RST (R)"), tr ("Band"), tr ("LoTW")});
+  qso_table->verticalHeader ()->setVisible (false);
+  qso_table->setEditTriggers (QAbstractItemView::NoEditTriggers);
+  qso_table->setSelectionBehavior (QAbstractItemView::SelectRows);
+  qso_table->horizontalHeader ()->setSectionResizeMode (QHeaderView::Stretch);
+  for (auto row = 0; row < qsos.size (); ++row)
+    {
+      auto qso = qsos.at (row).toObject ();
+      auto mode = qso.value ("submode").toString ().trimmed ();
+      if (mode.isEmpty ())
+        {
+          mode = qso.value ("mode").toString ();
+        }
+      QStringList values {
+        qso.value ("time_on").toString (),
+        qso.value ("callsign").toString (),
+        mode,
+        qso.value ("rst_sent").toString (),
+        qso.value ("rst_rcvd").toString (),
+        qso.value ("band").toString (),
+        QString {"S:%1 R:%2"}.arg (qso.value ("lotw_sent").toString ("-"),
+                                   qso.value ("lotw_rcvd").toString ("-"))
+      };
+      for (auto column = 0; column < values.size (); ++column)
+        {
+          auto * item = new QTableWidgetItem {values.at (column)};
+          item->setTextAlignment (Qt::AlignCenter);
+          qso_table->setItem (row, column, item);
+        }
+    }
+  layout->addWidget (qso_table);
+
+  QStringList badges;
+  if (!summary.value ("country").toString ().isEmpty ())
+    {
+      badges << tr ("DXCC %1").arg (summary.value ("country").toString ().toUpper ());
+    }
+  if (!summary.value ("gridsquare").toString ().isEmpty ())
+    {
+      badges << tr ("Gridsquare %1").arg (summary.value ("gridsquare").toString ().toUpper ());
+    }
+  auto * badge_label = new QLabel {badges.isEmpty () ? tr ("No Wavelog summary for %1").arg (callsign) : badges.join ("   "), dialog};
+  badge_label->setObjectName ("om0rxHistoryBadges");
+  layout->addWidget (badge_label);
+
+  auto * matrix_label = new QLabel {tr ("Band/Mode Matrix"), dialog};
+  matrix_label->setObjectName ("om0rxHistoryTitle");
+  layout->addWidget (matrix_label);
+
+  QStringList bands {"160m", "80m", "60m", "40m", "30m", "20m", "17m", "15m", "12m", "10m"};
+  QStringList modes {"CW", "FT8", "FT4", "RTTY", "SSB", "LSB", "USB"};
+  auto * matrix_table = new QTableWidget {modes.size (), bands.size (), dialog};
+  matrix_table->setHorizontalHeaderLabels (bands);
+  matrix_table->setVerticalHeaderLabels (modes);
+  matrix_table->setEditTriggers (QAbstractItemView::NoEditTriggers);
+  matrix_table->horizontalHeader ()->setSectionResizeMode (QHeaderView::Stretch);
+  matrix_table->verticalHeader ()->setSectionResizeMode (QHeaderView::Stretch);
+  for (auto row = 0; row < modes.size (); ++row)
+    {
+      auto mode_matrix = matrix.value (modes.at (row)).toObject ();
+      for (auto column = 0; column < bands.size (); ++column)
+        {
+          auto cell = mode_matrix.value (bands.at (column)).toObject ();
+          auto confirmed = cell.value ("confirmed").toBool ();
+          auto worked = cell.value ("worked").toBool ();
+          auto * item = new QTableWidgetItem {confirmed ? QString {"C"} : worked ? QString {"W"} : QString {"-"}};
+          item->setTextAlignment (Qt::AlignCenter);
+          if (confirmed)
+            {
+              item->setBackground (QColor {26, 188, 126});
+              item->setForeground (QColor {255, 255, 255});
+            }
+          else if (worked)
+            {
+              item->setBackground (QColor {215, 48, 55});
+              item->setForeground (QColor {255, 255, 255});
+            }
+          matrix_table->setItem (row, column, item);
+        }
+    }
+  layout->addWidget (matrix_table);
+
+  auto * buttons = new QDialogButtonBox {QDialogButtonBox::Close, dialog};
+  connect (buttons, &QDialogButtonBox::rejected, dialog, &QDialog::close);
+  layout->addWidget (buttons);
+  dialog->show ();
+}

+    QJsonObject record;
+    record["schema"] = "om0rx.autodx.outcome.v1";
+    record["utc"] = QDateTime::currentDateTimeUtc().toString(Qt::ISODateWithMs);
+    record["call"] = m_currentTarget.callsign;
+    record["band_index"] = m_currentTarget.bandIndex;
+    record["mode"] = m_currentMode;
+    record["outcome"] = outcome;
+    record["reason"] = reason;
+    record["selection_class"] = m_selectionClass;
+    record["selection_reason"] = m_selectionReason;
+    record["selection_score"] = m_selectionScore;
+    record["attempt"] = m_activeAttempt;
+    record["attempt_elapsed_ms"] = static_cast<double>(currentTargetAttemptElapsedMs());
+    record["engaged"] = m_targetRespondedToUs;
+    file.write(QJsonDocument(record).toJson(QJsonDocument::Compact));
+    file.write("\n");
+}

+namespace {
+const int SLOT_OCCUPANCY_MAX_AGE_SECONDS = 45;
+
+bool isRecentlyOccupied(const FrequencySlot& slot, const QDateTime& now)
+{
+    if (slot.usageCount <= 0 || !slot.lastUsed.isValid()) {
+        return false;
+    }
+    const qint64 ageSeconds = slot.lastUsed.secsTo(now);
+    return ageSeconds >= -1 && ageSeconds <= SLOT_OCCUPANCY_MAX_AGE_SECONDS;
+}
+
+int firstAlignedSlot(int minFreq, int slotWidth)
+{
+    return ((minFreq + slotWidth - 1) / slotWidth) * slotWidth;
+}
+
+int lastAlignedSlot(int maxFreq, int slotWidth)
+{
+    return (maxFreq / slotWidth) * slotWidth;
+}
+}

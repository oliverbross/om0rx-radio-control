+  automation.insert ("modeSwitching", ui->cbOm0rxModeSwitching->isChecked ());
+  automation.insert ("currentMode", m_mode);
+  automation.insert ("treat73AsCQ", ui->cbOm0rxTreat73AsCQ->isChecked ());
+  automation.insert ("avoidLogged", ui->cbOm0rxAvoidLogged->isChecked ());
+  automation.insert ("requireHeardBeforeCall", ui->cbOm0rxRequireHeard->isChecked ());
+  automation.insert ("autoLogToWavelog", ui->cbOm0rxAutoLog->isChecked ());
+  automation.insert ("needCall", ui->cbOm0rxNeedCall->isChecked ());
+  automation.insert ("needDxcc", ui->cbOm0rxNeedDxcc->isChecked ());
+  automation.insert ("needBand", ui->cbOm0rxNeedBand->isChecked ());
+  automation.insert ("needMode", ui->cbOm0rxNeedMode->isChecked ());
+  automation.insert ("needGrid", ui->cbOm0rxNeedGrid->isChecked ());
+  QString priority {"last"};
+  if (1 == ui->cbOm0rxPriority->currentIndex ())
+    {
+      priority = "signal";
+    }
+  else if (2 == ui->cbOm0rxPriority->currentIndex ())
+    {
+      priority = "distance";
+    }
+  automation.insert ("priority", priority);
+  automation.insert ("bandPlan", ui->teOm0rxBandPlan->toPlainText ());
+  automation.insert ("ignoreList", ui->teOm0rxIgnoreList->toPlainText ());
+  automation.insert ("force", false);
+  automation.insert ("enableTx", auto_call);
+
+  QJsonObject root;
+  root.insert ("source", "native-wsjtx");
+  root.insert ("automation", automation);
+
+  auto path = planner_tick ? QString {"/api/wsjtx/automation/tick"} : QString {"/api/wsjtx/automation/settings"};
+  QNetworkRequest request {QUrl {QString {"http://127.0.0.1:8080%1"}.arg (path)}};
+  request.setHeader (QNetworkRequest::ContentTypeHeader, "application/json");
+  auto reply = m_network_manager.post (request, QJsonDocument {root}.toJson (QJsonDocument::Compact));
+  connect (reply, &QNetworkReply::finished, this, [this, reply, planner_tick] {
+    auto status_code = reply->attribute (QNetworkRequest::HttpStatusCodeAttribute).toInt ();
+    QString text;
+    QString tooltip_text;
+    if (QNetworkReply::NoError != reply->error ())
+      {
+        text = QString {"OM0RX error: %1"}.arg (reply->errorString ());
+      }
+    else if (planner_tick)
+      {
+        auto doc = QJsonDocument::fromJson (reply->readAll ());
+        auto root = doc.object ();
+        auto action = root.value ("action").toString ("ok");
+        auto reason = root.value ("reason").toString ();
+        text = reason.isEmpty () ? QString {"OM0RX %1"}.arg (action) : QString {"OM0RX %1: %2"}.arg (action, reason);
+        tooltip_text = text;
+        QStringList detail;
+        bool backend_has_active_target {false};
+        QString panel_state;
+        auto automation = root.value ("automation").toObject ();
+        auto panel = automation.value ("reason_panel").toObject ();
+        if (!panel.isEmpty ())
+          {
+            panel_state = panel.value ("state").toString ();
+            detail << QString {"State: %1"}.arg (panel_state);
+            auto target = panel.value ("target").toObject ();
+            auto target_call = target.value ("call").toString ();
+            if (!target_call.isEmpty ())
+              {
+                backend_has_active_target = true;
+                detail << QString {"Target: %1 %2 %3 score %4"}.arg (
+                    target_call,
+                    target.value ("band").toString (),
+                    target.value ("mode").toString (),
+                    QString::number (target.value ("score").toInt ()));
+              }
+            auto why_selected = panel.value ("why_selected").toString ();
+            if (!why_selected.isEmpty ())
+              {
+                detail << QString {"Why selected: %1"}.arg (why_selected);
+              }
+            auto why_not_tx = panel.value ("why_not_tx_now");
+            if (why_not_tx.isString () && !why_not_tx.toString ().isEmpty ())
+              {
+                detail << QString {"Why not TX: %1"}.arg (why_not_tx.toString ());
+              }
+            else if (why_not_tx.isArray ())
+              {
+                QStringList reasons;
+                for (auto const& value: why_not_tx.toArray ())
+                  {
+                    reasons << value.toString ();
+                  }
+                if (!reasons.isEmpty ())
+                  {
+                    detail << QString {"Why not TX: %1"}.arg (reasons.join (", "));
+                  }
+              }
+            auto rejected = panel.value ("eligibility").toObject ().value ("rejected").toObject ();
+            if (!rejected.isEmpty ())
+              {
+                QStringList counts;
+                for (auto const& key: rejected.keys ())
+                  {
+                    counts << QString {"%1=%2"}.arg (key).arg (rejected.value (key).toInt ());
+                  }
+                detail << QString {"Rejected: %1"}.arg (counts.join (", "));
+              }
+          }
+        if (!backend_has_active_target
+            && (ui->cbOm0rxAutoCall->isChecked () || ui->cbOm0rxAutoCQ->isChecked ())
+            && !m_transmitting
+            && !m_tune
+            && !ui->dxCallEntry->text ().trimmed ().isEmpty ()
+            && (panel_state.isEmpty ()
+                || panel_state == "idle"
+                || panel_state == "aborted"
+                || panel_state == "failed"
+                || panel_state == "completed"))
+          {
+            ui->dxCallEntry->clear ();
+            ui->dxGridEntry->clear ();
+          }
+        if (!detail.isEmpty ())
+          {
+            tooltip_text = text + QString {"\n\n%1"}.arg (detail.join ("\n"));
+          }
+      }
+    else
+      {
+        text = status_code >= 200 && status_code < 300 ? "OM0RX policy ok" : QString {"OM0RX HTTP %1"}.arg (status_code);
+      }
+    auto label_width = ui->labOm0rxAutomation->width ();
+    if (label_width < 80)
+      {
+        label_width = 360;
+      }
+    if (tooltip_text.isEmpty ())
+      {
+        tooltip_text = text;
+      }
+    ui->labOm0rxAutomation->setText (ui->labOm0rxAutomation->fontMetrics ().elidedText (text, Qt::ElideRight, label_width - 8));
+    ui->labOm0rxAutomation->setToolTip (tooltip_text);
+    reply->deleteLater ();
+  });
+
+  if (auto_call || auto_cq)
+    {
+      if (!m_om0rx_automation_timer.isActive ())
+        {
+          m_om0rx_automation_timer.start ();
+        }
+    }
+  else
+    {
+      m_om0rx_automation_timer.stop ();
+    }
+}

+QString om0rx_decode_heading (QString const& prefix = QString {})
+{
+  return prefix + QString {"UTC   dB   DT Freq    Message"}.leftJustified (61)
+      + QObject::tr ("CS     DS");
+}
+
+QString om0rx_fast_decode_heading (QString const& prefix = QString {})
+{
+  return prefix + QString {"UTC   dB    T Freq    Message"}.leftJustified (61)
+      + QObject::tr ("CS     DS");
+}
+
+QString om0rx_normalized_call (QString call)
+{
+  call = call.trimmed ().toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  return call;
+}
+
+int om0rx_status_rank_one (QString status)
+{
+  auto normalized = status.trimmed ().toLower ();
+  normalized.replace ('-', ' ');
+  normalized.replace ("_", " ");
+
+  if (normalized.contains ("attno") || normalized.contains ("atno"))
+    {
+      return 10000;
+    }
+
+  auto prefixed = normalized.startsWith ("c/") || normalized.startsWith ("w/");
+  auto new_call = normalized.contains ("new call");
+  auto new_band = normalized.contains ("new band");
+  auto new_mode = normalized.contains ("new mode") || (new_band && normalized.contains ("mode"));
+
+  if (new_call && new_band && new_mode) return 9300;
+  if (new_call && new_band) return 9000;
+  if (new_call) return 8600;
+  if (new_band && new_mode) return prefixed ? 6500 : 8000;
+  if (new_band) return prefixed ? 6200 : 7800;
+  if (new_mode) return prefixed ? 5000 : 7000;
+  if (normalized.contains ("worked")) return 2000;
+  if (normalized.contains ("confirmed")) return 1000;
+  return 0;
+}
+
+int om0rx_status_rank (QString const& call_status, QString const& dxcc_status)
+{
+  return std::max (om0rx_status_rank_one (call_status),
+                   om0rx_status_rank_one (dxcc_status));
+}
+
+int om0rx_logbook_rank (bool callB4, bool callB4onBand, bool countryB4, bool countryB4onBand)
+{
+  if (!countryB4) return 10000;
+  if (!callB4 && !callB4onBand) return 9000;
+  if (!callB4) return 8600;
+  if (!callB4onBand) return 7800;
+  if (!countryB4onBand) return 6200;
+  return 0;
+}
+
+bool om0rx_dxcc_priority_hunt_status (QString status)
+{
+  auto normalized = status.trimmed ().toLower ();
+  normalized.replace ('-', ' ');
+  normalized.replace ("_", " ");
+  return normalized.contains ("attno")
+      || normalized.contains ("atno")
+      || normalized.contains ("new band");
+}

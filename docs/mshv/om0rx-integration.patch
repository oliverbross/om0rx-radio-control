--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/targeteligibility.h
@@ -0,0 +1,26 @@
+/* Pure target-eligibility contract shared by the native scorer and tests. */
+#ifndef TARGETELIGIBILITY_H
+#define TARGETELIGIBILITY_H
+
+struct TargetEligibility
+{
+    bool newDxcc;
+    bool newBandSlot;
+    bool newGrid;
+    bool callingMe;
+
+    TargetEligibility(bool dxcc, bool bandSlot, bool grid, bool calling)
+        : newDxcc(dxcc), newBandSlot(bandSlot), newGrid(grid), callingMe(calling) {}
+
+    bool any() const { return newDxcc || newBandSlot || newGrid || callingMe; }
+
+    int weightedScore(int dxccScore, int bandSlotWeight, int gridWeight,
+                      int callingWeight) const {
+        return (newDxcc ? dxccScore : 0)
+             + (newBandSlot ? bandSlotWeight : 0)
+             + (newGrid ? gridWeight : 0)
+             + (callingMe ? callingWeight : 0);
+    }
+};
+
+#endif // TARGETELIGIBILITY_H

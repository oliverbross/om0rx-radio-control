@app.post("/api/config")
async def update_config(req: ConfigUpdate):
    """Update configuration"""
    try:
        import re as _re
        import config as cfg
        import importlib
        import inspect
        
        # Get config file path
        config_path = os.path.abspath(inspect.getsourcefile(cfg))
        
        # Read current config file
        with open(config_path, 'r', encoding='utf-8') as f:
            txt = f.read()
        
        def _format_py_value(v):
            if isinstance(v, str):
                s = v.replace("\\", "\\\\").replace('"', '\\"')
                return f'"{s}"'
            if isinstance(v, bool):
                return "True" if v else "False"
            if isinstance(v, (int, float)):
                return str(v)
            if isinstance(v, dict):
                items = ", ".join(f'"{k}": "{val}"' if isinstance(val, str) else f'"{k}": {val}' for k, val in v.items())
                return "{" + items + "}"
            return repr(v)
        
        def _replace_block(text, key, new_value_src):
            start_re = _re.compile(rf"^[ \t]*{_re.escape(key)}\s*=", _re.M)
            m = start_re.search(text)
            rep = f"{key} = {new_value_src}"
            if not m:
                if not text.endswith("\n"):
                    text += "\n"
                return text + rep + "\n"
            end_re = _re.compile(r"^([A-Z_][A-Z0-9_]*\s*=)", _re.M)
            m_end = end_re.search(text, pos=m.end())
            if m_end:
                return text[:m.start()] + rep + "\n" + text[m_end.start():]
            else:
                return text[:m.start()] + rep + "\n"
        
        # Update each config value
        for key, value in req.config.items():
            txt = _replace_block(txt, key, _format_py_value(value))
        
        # Write updated config
        with open(config_path, 'w', encoding='utf-8') as f:
            f.write(txt)
        
        # Reload config module (updates in-memory values)
        importlib.reload(cfg)
        

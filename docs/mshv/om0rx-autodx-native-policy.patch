index 0000000..61fbf36
--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/autodxselectionpolicy.h
@@ -0,0 +1,193 @@
+#ifndef AUTODXSELECTIONPOLICY_H
+#define AUTODXSELECTIONPOLICY_H
+
+#include <algorithm>
+#include <QDateTime>
+#include <QList>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+
+// Side-effect-free native policy shared by AutoDxerCore, TargetScorer and the
+// offline fixtures.  It deliberately owns no radio, queue, CAT or PTT state.
+struct AutoDxEligibilityFacts
+{
+    bool newCall;
+    bool newDxcc;
+    bool newContinent;
+    bool newGrid;
+    bool newCqZone;
+    bool newItuZone;
+    bool bandCall;
+    bool bandDxcc;
+    bool bandContinent;
+    bool bandGrid;
+    bool bandCqZone;
+    bool bandItuZone;
+    bool lotwKnown;
+    bool lotwMember;
+    bool directedCaller;
+    int snr;
+    QString continent;
+
+    AutoDxEligibilityFacts()
+        : newCall(false), newDxcc(false), newContinent(false), newGrid(false),
+          newCqZone(false), newItuZone(false), bandCall(false), bandDxcc(false),
+          bandContinent(false), bandGrid(false), bandCqZone(false),
+          bandItuZone(false), lotwKnown(false), lotwMember(false),
+          directedCaller(false), snr(0) {}
+};
+
+struct AutoDxEligibilityResult
+{
+    bool eligible;
+    QString targetClass;
+    QStringList reasons;
+    QStringList blockers;
+    int scoreBoost;
+
+    AutoDxEligibilityResult() : eligible(false), scoreBoost(0) {}
+};
+
+struct AutoDxSelectionConfig
+{
+    bool filterMatrixEnabled;
+    bool filterNewCall;
+    bool filterNewDxcc;
+    bool filterNewContinent;
+    bool filterNewGrid;
+    bool filterNewCqZone;
+    bool filterNewItuZone;
+    bool filterBandCall;
+    bool filterBandDxcc;
+    bool filterBandContinent;
+    bool filterBandGrid;
+    bool filterBandCqZone;
+    bool filterBandItuZone;
+    QSet<QString> enabledContinents;
+    bool lotwOnly;
+    int minSignal;
+    bool preferNonEurope;
+    int nonEuropeBoost;
+    QString selectionOrder;
+    bool treat73AsCq;
+    bool watchUnconfirmedDxcc;
+    int callWindowSeconds;
+    int maxConsecutiveWindows;
+    int sameTargetRetrySeconds;
+    int minimumBandDwellSeconds;
+
+    AutoDxSelectionConfig()
+        : filterMatrixEnabled(false), filterNewCall(true), filterNewDxcc(true),
+          filterNewContinent(false), filterNewGrid(true), filterNewCqZone(false),
+          filterNewItuZone(false), filterBandCall(true), filterBandDxcc(false),
+          filterBandContinent(false), filterBandGrid(true), filterBandCqZone(false),
+          filterBandItuZone(false), lotwOnly(false), minSignal(-20),
+          preferNonEurope(true), nonEuropeBoost(7500), selectionOrder("score"),
+          treat73AsCq(false), watchUnconfirmedDxcc(true), callWindowSeconds(120),
+          maxConsecutiveWindows(1), sameTargetRetrySeconds(120),
+          minimumBandDwellSeconds(180)
+    {
+        enabledContinents << "EU" << "AF" << "OC" << "AS" << "SA" << "NA" << "AN";
+    }
+
+    static bool isCqOr73(const QString &message, bool treat73)
+    {
+        const QString simplified = message.simplified().toUpper();
+        if (simplified.startsWith("CQ ") || simplified == "CQ") return true;
+        if (!treat73) return false;
+        const QString last = simplified.section(' ', -1);
+        return last == "73" || last == "RR73";
+    }
+
+    AutoDxEligibilityResult evaluate(const AutoDxEligibilityFacts &f) const
+    {
+        AutoDxEligibilityResult r;
+        if (f.directedCaller) {
+            r.eligible = true;
+            r.targetClass = "directed-caller";
+            r.reasons << "reply-to-us";
+            return r;
+        }
+        if (f.snr < minSignal) r.blockers << "minimum-signal";
+        const QString continent = f.continent.trimmed().toUpper();
+        if (!continent.isEmpty() && !enabledContinents.contains(continent))
+            r.blockers << "continent-disabled";
+        else if (enabledContinents.size() < 7 && continent.isEmpty())
+            r.blockers << "continent-unknown";
+        // LoTW-only is authoritative only when membership data exists.  An
+        // absent data set cannot silently reject the whole decode stream.
+        if (lotwOnly && f.lotwKnown && !f.lotwMember) r.blockers << "lotw-only";
+        if (!r.blockers.isEmpty()) return r;
+
+        if (!filterMatrixEnabled) {
+            r.eligible = f.newDxcc || f.bandDxcc || f.newGrid || f.directedCaller;
+            r.targetClass = f.newDxcc ? "new-dxcc"
+                          : f.bandDxcc ? "band-dxcc"
+                          : f.newGrid ? "new-grid" : QString();
+        } else {
+            struct Match { bool enabled; bool matched; const char *name; };
+            const Match matches[] = {
+                {filterNewCall, f.newCall, "new-call"},
+                {filterNewDxcc, f.newDxcc, "new-dxcc"},
+                {filterNewContinent, f.newContinent, "new-continent"},
+                {filterNewGrid, f.newGrid, "new-grid"},
+                {filterNewCqZone, f.newCqZone, "new-cq-zone"},
+                {filterNewItuZone, f.newItuZone, "new-itu-zone"},
+                {filterBandCall, f.bandCall, "band-call"},
+                {filterBandDxcc, f.bandDxcc, "band-dxcc"},
+                {filterBandContinent, f.bandContinent, "band-continent"},
+                {filterBandGrid, f.bandGrid, "band-grid"},
+                {filterBandCqZone, f.bandCqZone, "band-cq-zone"},
+                {filterBandItuZone, f.bandItuZone, "band-itu-zone"}
+            };
+            for (const Match &match : matches) {
+                if (match.enabled && match.matched) {
+                    r.eligible = true;
+                    r.reasons << match.name;
+                    if (r.targetClass.isEmpty()) r.targetClass = match.name;
+                }
+            }
+            if (!r.eligible) r.blockers << "not-selected-by-filter-matrix";
+        }
+        if (r.eligible && preferNonEurope && continent != "EU" && !continent.isEmpty()) {
+            r.scoreBoost = nonEuropeBoost;
+            r.reasons << "non-europe-preference";
+        }
+        return r;
+    }
+
+    bool canLeaveBand(qint64 dwellElapsedMs, bool highPriority,
+                      bool directedCaller, bool scheduleOverride) const
+    {
+        return highPriority || directedCaller || scheduleOverride
+            || dwellElapsedMs >= static_cast<qint64>(minimumBandDwellSeconds) * 1000;
+    }
+
+    int totalAttemptBudgetSeconds() const
+    {
+        return callWindowSeconds * maxConsecutiveWindows;
+    }
+};
+
+// Stateless band-level fairness for cross-band verification. Callers pass
+// only bands whose best candidate is in the winning priority class; duplicate
+// calls on a busy band therefore cannot weight that band more heavily.
+struct AutoDxCrossBandFairness
+{
+    static int chooseBand(QList<int> eligibleBands, int cursorBand)
+    {
+        std::sort(eligibleBands.begin(), eligibleBands.end());
+        QList<int> uniqueBands;
+        for (int band : eligibleBands) {
+            if (!uniqueBands.contains(band)) uniqueBands.append(band);
+        }
+        if (uniqueBands.isEmpty()) return -1;
+        for (int band : uniqueBands) {
+            if (band > cursorBand) return band;
+        }
+        return uniqueBands.first();
+    }
+};
+
+#endif // AUTODXSELECTIONPOLICY_H

+void DecodeList::RestoreFtHeaderState()
+{
+    if (m_ftHeaderStateRestored) return;
+    m_ftHeaderStateRestored = true;
+    QSettings settings(QCoreApplication::applicationDirPath() + "/settings/autodx.ini", QSettings::IniFormat);
+    const QByteArray state = QByteArray::fromBase64(settings.value(
+        QString("UI/DecodeHeader%1").arg(s_list_ident)).toByteArray());
+    if (!state.isEmpty()) THvHeader->restoreState(state);
+}

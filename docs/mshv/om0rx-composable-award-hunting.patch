+void AutoDxerCore::pruneAttemptHistory(const QDateTime &now)
+{
+    for (auto it = m_callAttemptUpdated.begin(); it != m_callAttemptUpdated.end(); ) {
+        if (!it.value().isValid() || it.value().secsTo(now) > 86400) {
+            m_callAttemptCounts.remove(it.key());
+            it = m_callAttemptUpdated.erase(it);
+        } else ++it;
+    }
+    while (m_callAttemptUpdated.size() > 1000) {
+        auto oldest = m_callAttemptUpdated.begin();
+        for (auto it = m_callAttemptUpdated.begin(); it != m_callAttemptUpdated.end(); ++it)
+            if (it.value() < oldest.value()) oldest = it;
+        m_callAttemptCounts.remove(oldest.key());
+        m_callAttemptUpdated.erase(oldest);
+    }
+    for (auto it = m_targetRetryAfter.begin(); it != m_targetRetryAfter.end(); )
+        if (!it.value().isValid() || it.value() <= now)
+            it = m_targetRetryAfter.erase(it); else ++it;
+}

+{
+  if (!countryB4) return 10000;
+  if (!callB4 && !callB4onBand) return 9000;
+  if (!callB4) return 8600;
+  if (!callB4onBand) return 7800;
+  if (!countryB4onBand) return 6200;
+  return 0;
+}
+
+bool om0rx_dxcc_priority_hunt_status (QString status)
+{
+  auto normalized = status.trimmed ().toLower ();
+  normalized.replace ('-', ' ');
+  normalized.replace ("_", " ");
+  return normalized.contains ("attno")
+      || normalized.contains ("atno")
+      || normalized.contains ("new band")
+      || normalized.contains ("new mode");
+}
+
+bool om0rx_dxcc_watch_status (QString status)
+{
+  auto normalized = status.trimmed ().toLower ();
+  normalized.replace ('-', ' ');
+  normalized.replace ("_", " ");
+  return om0rx_dxcc_priority_hunt_status (status)
+      || normalized == "w"
+      || normalized == "worked"
+      || normalized.contains ("worked");
+}
+
+bool om0rx_plain_worked_call_status (QString status)
+{
+  auto normalized = status.trimmed ().toLower ();
+  normalized.replace ('-', ' ');
+  normalized.replace ("_", " ");
+  return normalized == "c"
+      || normalized == "w"
+      || normalized == "confirmed"
+      || normalized == "worked";
+}
+
+bool om0rx_status_cache_bool (QStringList const& parts, int index)
+{
+  auto value = parts.value (index).trimmed ().toLower ();
+  return value == "1" || value == "true" || value == "yes";
+}
+
+bool om0rx_status_cache_has_need_flags (QStringList const& parts)
+{
+  return parts.size () >= 12;
+}
+
+bool om0rx_status_cache_call_done_on_band_mode (QStringList const& parts)
+{
+  if (!om0rx_status_cache_has_need_flags (parts))
+    {
+      return false;
+    }
+  auto const call_status = parts.value (0);
+  auto const call_needed = om0rx_status_cache_bool (parts, 6);
+  auto const call_band_needed = om0rx_status_cache_bool (parts, 7);
+  auto const call_mode_needed = om0rx_status_cache_bool (parts, 8);
+  return om0rx_plain_worked_call_status (call_status)
+      && !call_needed
+      && !call_band_needed
+      && !call_mode_needed;
+}
+
+bool om0rx_status_cache_dxcc_hunt_needed (QStringList const& parts)
+{
+  auto const dxcc_status = parts.value (1);
+  if (!om0rx_dxcc_watch_status (dxcc_status))
+    {
+      return false;
+    }
+  if (!om0rx_status_cache_has_need_flags (parts))
+    {
+      return true;
+    }
+  auto normalized = dxcc_status.trimmed ().toLower ();
+  normalized.replace ('-', ' ');
+  normalized.replace ("_", " ");
+  if (normalized == "worked" || normalized.contains ("worked") || normalized.contains ("atno"))
+    {
+      return true;
+    }
+  return om0rx_status_cache_bool (parts, 10) || om0rx_status_cache_bool (parts, 11);
+}
+
+QString om0rx_decode_line_for_selection (QString line)
+{
+  line.replace (QChar::LineSeparator, QLatin1Char {' '});
+  line.replace (QChar::ParagraphSeparator, QLatin1Char {' '});
+
+  QRegularExpression status_columns {
+      QString {R"(\s{1,}(?:\.\.\.|\?|NC|NB\+M|NB|NM|C|W|ATNO|C/NB\+M|W/NB\+M|C/NB|W/NB|C/NM|W/NM)\s{1,}(?:\.\.\.|\?|NC|NB\+M|NB|NM|C|W|ATNO|C/NB\+M|W/NB\+M|C/NB|W/NB|C/NM|W/NM)(?:[\s\x{00a0}]+.+)?$)"}};
+  line.remove (status_columns);
+
+  auto appendage_start = line.indexOf (QChar::Nbsp);
+  if (appendage_start >= 0)
+    {
+      line = line.left (appendage_start);
+    }
+
+  return line.trimmed ().left (61).remove ("TU; ").trimmed ();
+}
+}

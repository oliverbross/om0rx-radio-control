+namespace
+{
+  QTextCharFormat om0rx_status_format (QString const& status)
+  {
+    auto normalized = status.toLower ();
+    QColor foreground {45, 45, 45};
+    if (normalized.contains ("atno") || normalized.contains ("new call"))
+      {
+        foreground = QColor {210, 70, 32};
+      }
+    else if (normalized.contains ("new band") || normalized.contains ("new mode"))
+      {
+        foreground = QColor {0, 104, 178};
+      }
+    else if (normalized.contains ("worked"))
+      {
+        foreground = QColor {74, 85, 104};
+      }
+    else if (normalized.contains ("confirmed"))
+      {
+        foreground = QColor {0, 126, 72};
+      }
+
+    QTextCharFormat format;
+    format.clearBackground ();
+    format.setForeground (foreground);
+    format.setFontWeight (QFont::Normal);
+    return format;
+  }
+
+  QString om0rx_status_label (QString const& status)
+  {
+    auto label = status.trimmed ();
+    auto normalized = label.toLower ();
+    QString prefix;
+    if (normalized.startsWith ("c/") || normalized.startsWith ("w/"))
+      {
+        prefix = normalized.left (1).toUpper () + "/";
+        normalized = normalized.mid (2).trimmed ();
+      }
+
+    if (normalized == "checking")
+      {
+        label = "...";
+      }
+    else if (normalized == "unknown" || normalized.isEmpty ())
+      {
+        label = "?";
+      }
+    else if (normalized == "confirmed")
+      {
+        label = "C";
+      }
+    else if (normalized == "worked")
+      {
+        label = "W";
+      }
+    else if (normalized == "atno")
+      {
+        label = "ATNO";
+      }
+    else if (normalized.contains ("new call"))
+      {
+        label = "NC";
+      }
+    else if (normalized.contains ("new band") && normalized.contains ("mode"))
+      {
+        label = "NB+M";
+      }
+    else if (normalized.contains ("new band"))
+      {
+        label = "NB";
+      }
+    else if (normalized.contains ("new mode"))
+      {
+        label = "NM";
+      }
+
+    if (!prefix.isEmpty () && label != "?" && label != "...")
+      {
+        label = prefix + label;
+      }
+    return label.left (6).leftJustified (6);
+  }
+
+  QString om0rx_status_cell (QString const& status)
+  {
+    return om0rx_status_label (status).left (6).leftJustified (6);
+  }
+}

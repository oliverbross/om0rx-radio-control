+    schedules->addWidget(new QLabel("Band"), 0, 0);
+    schedules->addWidget(new QLabel("Restricted"), 0, 1);
+    schedules->addWidget(new QLabel("Start"), 0, 2);
+    schedules->addWidget(new QLabel("End"), 0, 3);

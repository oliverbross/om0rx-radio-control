+void DisplayText::show_om0rx_context_menu (QPoint const& position)
+{
+  auto * menu = new QMenu {this};
+  auto text_cursor = cursorForPosition (position);
+  auto line = text_cursor.block ().text ();
+  auto offset = text_cursor.position () - text_cursor.block ().position ();
+  auto start = qBound (0, offset, line.size ());
+  auto end = start;
+  while (start > 0 && !line.at (start - 1).isSpace ())
+    {
+      --start;
+    }
+  while (end < line.size () && !line.at (end).isSpace ())
+    {
+      ++end;
+    }
+  auto clicked = line.mid (start, end - start);
+  auto call = om0rx_callsign_from_decode_line (line, clicked);
+  auto my_call = m_config ? normalize_om0rx_clicked_token (m_config->my_callsign ()) : QString {};
+  if (!call.isEmpty () && call != my_call)
+    {
+      auto * previous_qsos = menu->addAction (tr ("Prev QSO's for %1").arg (call));
+      connect (previous_qsos, &QAction::triggered, this, [this, call] {
+          Q_EMIT decodedCallsignClicked (call);
+        });
+      menu->addSeparator ();
+    }
+
+  for (auto * action : actions ())
+    {
+      menu->addAction (action);
+    }
+  if (!actions ().contains (erase_action_))
+    {
+      menu->addSeparator ();
+      menu->addAction (erase_action_);
+    }
+  menu->exec (mapToGlobal (position));
+  delete menu;
+}

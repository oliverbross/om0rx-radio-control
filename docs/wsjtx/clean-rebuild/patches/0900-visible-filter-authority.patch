+void MainWindow::send_om0rx_filter_policy ()
+{
+  QJsonObject filter_new;
+  filter_new.insert ("call", ui->cb_callB4->isChecked ());
+  filter_new.insert ("dxcc", ui->cb_countryB4->isChecked ());
+  filter_new.insert ("continent", ui->cb_continentB4->isChecked ());
+  filter_new.insert ("grid", ui->cb_gridB4->isChecked ());
+  filter_new.insert ("cqZone", ui->cb_CQZoneB4->isChecked ());
+  filter_new.insert ("ituZone", ui->cb_ITUZoneB4->isChecked ());
+
+  QJsonObject filter_band;
+  filter_band.insert ("call", ui->cb_callB4onBand->isChecked ());
+  filter_band.insert ("dxcc", ui->cb_countryB4onBand->isChecked ());
+  filter_band.insert ("continent", ui->cb_continentB4onBand->isChecked ());
+  filter_band.insert ("grid", ui->cb_gridB4onBand->isChecked ());
+  filter_band.insert ("cqZone", ui->cb_CQZoneB4onBand->isChecked ());
+  filter_band.insert ("ituZone", ui->cb_ITUZoneB4onBand->isChecked ());
+
+  QJsonObject continents;
+  continents.insert ("EU", ui->cb_c_EU->isChecked ());
+  continents.insert ("AF", ui->cb_c_AF->isChecked ());
+  continents.insert ("AN", ui->cb_c_AN->isChecked ());
+  continents.insert ("AS", ui->cb_c_AS->isChecked ());
+  continents.insert ("NA", ui->cb_c_NA->isChecked ());
+  continents.insert ("SA", ui->cb_c_SA->isChecked ());
+  continents.insert ("OC", ui->cb_c_OC->isChecked ());
+
+  QString priority {"last"};
+  if (1 == ui->cb_autoCallPriority->currentIndex ()) priority = "signal";
+  else if (2 == ui->cb_autoCallPriority->currentIndex ()) priority = "distance";
+
+  QJsonObject automation;
+  automation.insert ("autoCall", ui->cbAutoCall->isChecked ());
+  automation.insert ("autoCQ", ui->cbAutoCQ->isChecked ());
+  automation.insert ("cqOnly", ui->cbCQonly->isChecked ());
+  automation.insert ("minSignal", ui->sbMindB->value ());
+  automation.insert ("bandHopping", ui->cb_bandHopper->isChecked ());
+  automation.insert ("modeSwitching", ui->cb_autoModeSwitch->isChecked ());
+  automation.insert ("currentBand", m_currentBand);
+  automation.insert ("currentMode", m_mode);
+  automation.insert ("treat73AsCQ", ui->cbCQonlyIncl73->isChecked ());
+  automation.insert ("filterMatrixEnabled", ui->cb_filtering->isChecked ());
+  automation.insert ("filterNew", filter_new);
+  automation.insert ("filterNewOnBand", filter_band);
+  automation.insert ("filterContinents", continents);
+  automation.insert ("lotwOnly", ui->cb_f_LOTW->isChecked ());
+  automation.insert ("ignoreList", ui->pte_IgnoredStations->toPlainText ());
+  automation.insert ("priority", priority);
+  automation.insert ("answerDirectCallers", true);
+
+  QJsonObject root;
+  root.insert ("source", "native-wsjtz-visible-filters");
+  root.insert ("automation", automation);
+  QNetworkRequest request {QUrl {"http://127.0.0.1:8080/api/wsjtx/automation/settings"}};
+  request.setHeader (QNetworkRequest::ContentTypeHeader, "application/json");
+  auto * reply = m_network_manager.post (
+      request, QJsonDocument {root}.toJson (QJsonDocument::Compact));
+  connect (reply, &QNetworkReply::finished, this, [this, reply] {
+    if (QNetworkReply::NoError != reply->error ())
+      {
+        log (QString {"OM0RX visible filter sync failed: %1"}.arg (reply->errorString ()));
+      }
+    reply->deleteLater ();
+  });
+}
+
+bool MainWindow::om0rx_backend_target_passes_visible_filters (
+    QJsonObject const& target, QString * reason)
+{
+  if (!ui->cb_filtering->isChecked ()) return true;
+  if (!m_filterCacheValid) rebuildFilterCache ();
+
+  auto reject = [reason] (QString const& text) {
+    if (reason) *reason = text;
+    return false;
+  };
+  auto call = target.value ("dxCall").toString (
+      target.value ("call").toString ()).trimmed ().toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  if (m_ignoredStationsCache.contains (call)) return reject ("ignored station");
+  if (ui->cb_f_LOTW->isChecked () && !m_config.lotw_users ().user (call))
+    return reject ("LoTW-only filter");
+  auto snr_value = target.value ("snr");
+  if (snr_value.isDouble () && ui->sbMindB->value () > -30
+      && snr_value.toInt () < ui->sbMindB->value ())
+    return reject ("minimum signal filter");
+
+  auto continent = target.value ("continent").toString ().trimmed ().toUpper ();
+  if (continent.isEmpty ())
+    {
+      auto const& looked_up = m_logBook.countries ()->lookup (call);
+      continent = AD1CCty::continent (looked_up.continent);
+    }
+  if (continent == "EU" && !ui->cb_c_EU->isChecked ()) return reject ("Europe filter");
+  if (continent == "AF" && !ui->cb_c_AF->isChecked ()) return reject ("Africa filter");
+  if (continent == "AN" && !ui->cb_c_AN->isChecked ()) return reject ("Antarctica filter");
+  if (continent == "AS" && !ui->cb_c_AS->isChecked ()) return reject ("Asia filter");
+  if (continent == "NA" && !ui->cb_c_NA->isChecked ()) return reject ("North America filter");
+  if (continent == "SA" && !ui->cb_c_SA->isChecked ()) return reject ("South America filter");
+  if (continent == "OC" && !ui->cb_c_OC->isChecked ()) return reject ("Oceania filter");
+  return true;
+}

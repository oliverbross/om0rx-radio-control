+namespace
+{
+  QTextCharFormat om0rx_status_format (QString const& status)
+  {
+    auto normalized = status.toLower ();
+    QColor foreground {45, 45, 45};
+    if (normalized.contains ("atno") || normalized.contains ("new call"))
+      {
+        foreground = QColor {210, 70, 32};
+      }
+    else if (normalized.contains ("new band") || normalized.contains ("new mode"))
+      {
+        foreground = QColor {0, 104, 178};
+      }
+    else if (normalized.contains ("worked"))
+      {
+        foreground = QColor {74, 85, 104};
+      }
+    else if (normalized.contains ("confirmed"))
+      {
+        foreground = QColor {0, 126, 72};
+      }
+
+    QTextCharFormat format;
+    format.clearBackground ();
+    format.setForeground (foreground);
+    format.setFontWeight (QFont::Normal);
+    return format;
+  }
+
+  QString om0rx_status_label (QString const& status)
+  {
+    auto label = status.trimmed ();
+    auto normalized = label.toLower ();
+    QString prefix;
+    if (normalized.startsWith ("c/") || normalized.startsWith ("w/"))
+      {
+        prefix = normalized.left (1).toUpper () + "/";
+        normalized = normalized.mid (2).trimmed ();
+      }
+
+    if (normalized == "checking")
+      {
+        label = "...";
+      }
+    else if (normalized == "unknown" || normalized.isEmpty ())
+      {
+        label = "?";
+      }
+    else if (normalized == "confirmed")
+      {
+        label = "C";
+      }
+    else if (normalized == "worked")
+      {
+        label = "W";
+      }
+    else if (normalized == "atno")
+      {
+        label = "ATNO";
+      }
+    else if (normalized.contains ("new call"))
+      {
+        label = "NC";
+      }
+    else if (normalized.contains ("new band") && normalized.contains ("mode"))
+      {
+        label = "NB+M";
+      }
+    else if (normalized.contains ("new band"))
+      {
+        label = "NB";
+      }
+    else if (normalized.contains ("new mode"))
+      {
+        label = "NM";
+      }
+
+    if (!prefix.isEmpty () && label != "?" && label != "...")
+      {
+        label = prefix + label;
+      }
+    return label.left (6).leftJustified (6);
+  }
+
+  QString om0rx_status_cell (QString const& status)
+  {
+    return om0rx_status_label (status).left (6).leftJustified (6);
+  }
+}
+
+void DisplayText::annotate_callsign (QString const& callsign, QString const& annotation,
+                                     QColor const& fg)
+{
+  Q_UNUSED (fg);
+  if (callsign.trimmed ().isEmpty () || annotation.trimmed ().isEmpty ())
+    {
+      return;
+    }
+
+  auto escaped = callsign.trimmed ().toUpper ();
+  escaped.replace (QLatin1Char {'+'}, QLatin1String {"\\+"})
+      .replace (QLatin1Char {'.'}, QLatin1String {"\\."})
+      .replace (QLatin1Char {'?'}, QLatin1String {"\\?"});
+  QRegularExpression target {QString {"<?%1>?"}.arg (escaped),
+                             QRegularExpression::DontCaptureOption};
+  QRegularExpression status_columns {
+      QString {R"(\s{1,}(?:\.\.\.|\?|NC|NB\+M|NB|NM|C|W|ATNO|C/NB\+M|W/NB\+M|C/NB|W/NB|C/NM|W/NM)\s{1,}(?:\.\.\.|\?|NC|NB\+M|NB|NM|C|W|ATNO|C/NB\+M|W/NB\+M|C/NB|W/NB|C/NM|W/NM)\s*$)"}};
+  QRegularExpression existing_om0rx {QString {R"(\s+\[OM0RX:[^\]]+\])"}};
+  QRegularExpression parsed_status {QString {R"(^\s*([^|]+?)\s*\|\s*([^|]+?)\s*$)"}};
+  auto status_match = parsed_status.match (annotation);
+  auto call_status = status_match.hasMatch () ? status_match.captured (1).trimmed () : annotation.trimmed ();
+  auto dxcc_status = status_match.hasMatch () ? status_match.captured (2).trimmed () : QString {};
+  QTextCharFormat old_format {currentCharFormat ()};
+  QTextCursor cursor {document ()};
+
+  while (!cursor.isNull ())
+    {
+      cursor = document ()->find (target, cursor, QTextDocument::FindWholeWords);
+      if (!cursor.isNull () && cursor.hasSelection ())
+        {
+          QTextCursor line {cursor};
+          line.movePosition (QTextCursor::StartOfLine);
+          line.movePosition (QTextCursor::EndOfLine, QTextCursor::KeepAnchor);
+          auto text = line.selectedText ();
+          auto column_match = status_columns.match (text);
+          auto om0rx_match = existing_om0rx.match (text);
+          auto appendage_start = text.indexOf (QChar::Nbsp);
+          int suffix_start {-1};
+          auto remember_suffix_start = [&suffix_start, &text] (int start) {
+            if (start < 0)
+              {
+                return;
+              }
+            while (start > 0 && text.at (start - 1).isSpace ())
+              {
+                --start;
+              }
+            if (suffix_start < 0 || start < suffix_start)
+              {
+                suffix_start = start;
+              }
+          };
+          if (column_match.hasMatch ())
+            {
+              remember_suffix_start (column_match.capturedStart ());
+            }
+          if (appendage_start >= 0)
+            {
+              remember_suffix_start (appendage_start);
+            }
+          if (om0rx_match.hasMatch ())
+            {
+              remember_suffix_start (om0rx_match.capturedStart ());
+            }
+
+          auto base_length = suffix_start >= 0 ? suffix_start : text.size ();
+          constexpr int status_column = 61;
+          auto status_padding = std::max (1, status_column - base_length);
+          auto call_format = om0rx_status_format (call_status);
+          auto dxcc_format = om0rx_status_format (dxcc_status);
+          call_format.setFont (char_font_);
+          dxcc_format.setFont (char_font_);
+          auto call_label = om0rx_status_cell (call_status);
+          auto dxcc_label = om0rx_status_cell (dxcc_status);
+          QTextCharFormat separator_format {old_format};
+          separator_format.clearBackground ();
+          separator_format.setFont (char_font_);
+          separator_format.setForeground (QColor {100, 116, 139});
+          separator_format.setFontWeight (QFont::Normal);
+
+          QTextCursor suffix {line};
+          if (suffix_start >= 0)
+            {
+              suffix.setPosition (line.selectionStart () + suffix_start);
+              suffix.setPosition (line.selectionEnd (), QTextCursor::KeepAnchor);
+              suffix.removeSelectedText ();
+            }
+          else
+            {
+              suffix.clearSelection ();
+              suffix.movePosition (QTextCursor::EndOfLine);
+            }
+          suffix.insertText (QString {status_padding, QChar {' '}}, separator_format);
+          suffix.insertText (call_label, call_format);
+          suffix.insertText (QString {" "}, separator_format);
+          suffix.insertText (dxcc_label, dxcc_format);
+        }
+    }
+
+  setCurrentCharFormat (old_format);
+}

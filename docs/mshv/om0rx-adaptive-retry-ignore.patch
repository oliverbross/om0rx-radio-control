+void AutoDxerCore::queueOperatorTarget(QStringList decodeData)
+{
+    QString callsign, grid;
+    int snr = 0, freq = 0;
+    bool isCQ = false;
+    parseDecodeMessage(decodeData, callsign, grid, snr, freq, isCQ);
+    callsign = callsign.trimmed().toUpper();
+    if (!m_enabled || callsign.isEmpty() || callsign == m_myCallsign
+            || catTransitionPending() || m_currentBandIndex < 3) {
+        emit debugMessage(QString("CALLERS: unable to queue %1 while Auto DX/band state is unavailable")
+                          .arg(callsign));
+        return;
+    }
+    if (m_currentTarget.isValid()
+            && callsignsMatch(m_currentTarget.callsign, callsign)) {
+        emit debugMessage(QString("CALLERS: %1 is already the active target").arg(callsign));
+        return;
+    }
+
+    const QString key = operatorCallKey(callsign, m_currentBandIndex, m_currentMode);
+    if (operatorCallIndex(key) >= 0) {
+        emit debugMessage(QString("CALLERS: %1 is already queued on %2/%3")
+                          .arg(callsign, bandName(m_currentBandIndex), m_currentMode));
+        return;
+    }
+
+    CachedDecode decode;
+    bool found = false;
+    const QList<CachedDecode> active = m_decodeCache->getActiveDecodes(
+        m_currentBandIndex, m_targetHeardFreshSeconds);
+    for (const CachedDecode &candidate : active) {
+        if (candidate.isLocalDecode && callsignsMatch(candidate.callsign, callsign)) {
+            decode = candidate;
+            found = true;
+            break;
+        }
+    }
+    if (!found) {
+        decode.callsign = callsign;
+        decode.grid = grid;
+        decode.dxccEntity = m_cty ? m_cty->FindCountry(callsign, false) : QString();
+        decode.originalMessage = decodeData.value(4, "");
+        decode.bandIndex = m_currentBandIndex;
+        decode.audioFrequency = freq;
+        decode.dialFrequencyHz = m_currentDialFrequencyHz;
+        decode.snr = snr;
+        decode.timestamp = QDateTime::currentDateTimeUtc();
+        decode.firstSeen = decode.timestamp;
+        decode.decodeCount = 1;
+        decode.isCQ = isCQ;
+        decode.isLocalDecode = true;
+        m_decodeCache->addDecode(callsign, grid, decode.dxccEntity,
+            decode.originalMessage, m_currentBandIndex, freq,
+            m_currentDialFrequencyHz, snr, isCQ);
+    }
+
+    ScoredTarget target = m_targetScorer->scoreTarget(decode);
+    target.callsign = decode.callsign;
+    target.grid = decode.grid;
+    target.dxccEntity = decode.dxccEntity;
+    target.originalMessage = decode.originalMessage;
+    target.bandIndex = m_currentBandIndex;
+    target.audioFrequency = decode.audioFrequency;
+    target.dialFrequencyHz = decode.dialFrequencyHz;
+    target.snr = decode.snr;
+    target.decodedAt = decode.timestamp;
+    target.isLocalDecode = true;
+    target.decodeCount = qMax(1, decode.decodeCount);
+    target.priority = INT_MAX;
+    target.priorityReason = "Operator callers list";
+    target.eligibilityClass = "manual-operator";
+
+    OperatorCallRequest request;
+    request.target = target;
+    request.mode = m_currentMode;
+    request.queuedAt = QDateTime::currentDateTimeUtc();
+    if (m_operatorCallQueue.size() >= 32) m_operatorCallQueue.removeLast();
+    m_operatorCallQueue.append(request);
+    m_operatorTargetHold = false;
+    emit operatorCallQueueChanged();
+    emit debugMessage(QString("CALLERS: queued %1 as position %2 on %3/%4")
+                      .arg(callsign).arg(m_operatorCallQueue.size())
+                      .arg(bandName(m_currentBandIndex), m_currentMode));
+    if (m_state == Listening && !m_currentTarget.isValid()
+            && !postQsoGuardActive() && !lateReplyGuardActive()) {
+        evaluateTargets();
+    }
+}

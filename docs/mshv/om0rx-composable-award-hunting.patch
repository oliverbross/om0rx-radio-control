+void AutoDxerCore::writeOutcomeTelemetry(const QString &outcome, const QString &reason)
+{
+    if (!m_outcomeLearningEnabled || m_outcomeTelemetryPath.isEmpty()
+            || !m_currentTarget.isValid()) return;

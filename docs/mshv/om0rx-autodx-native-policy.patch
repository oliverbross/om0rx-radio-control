+
+bool HvDxccTracker::isCallWorkedAllTime(const QString& callsign)
+{
+    const QString prefix = extractBaseCall(callsign) + "_";
+    for (const QString &worked : m_workedCalls) {
+        if (worked.startsWith(prefix, Qt::CaseInsensitive)) return true;
+    }
+    return false;
+}
+
+bool HvDxccTracker::isContinentWorked(const QString& continent, int bandIndex) const
+{
+    const QString wanted = continent.trimmed().toUpper();
+    for (const QString &worked : m_workedDxccByBand) {
+        const QStringList parts = worked.split('_');
+        if (parts.size() != 2 || parts.at(1).toInt() != bandIndex) continue;
+        if (m_entityById.value(parts.at(0).toInt()).continent.toUpper() == wanted) return true;
+    }
+    return false;
+}
+
+bool HvDxccTracker::isContinentWorkedAllTime(const QString& continent) const
+{
+    const QString wanted = continent.trimmed().toUpper();
+    for (const QString &worked : m_workedDxccAllTime) {
+        if (m_entityById.value(worked.toInt()).continent.toUpper() == wanted) return true;
+    }
+    return false;
+}

+  QString normalize_om0rx_clicked_token (QString token)
+  {
+    token = token.trimmed ().toUpper ();
+    while (token.startsWith ('<') && token.endsWith ('>') && token.size () > 2)
+      {
+        token = token.mid (1, token.size () - 2);
+      }
+    token.remove (QRegularExpression {"^[^A-Z0-9/<]+|[^A-Z0-9/>]+$"});
+    token.remove ('<');
+    token.remove ('>');
+    return token;
+  }
+
+  bool is_om0rx_click_callsign (QString const& raw)
+  {
+    auto token = normalize_om0rx_clicked_token (raw);
+    if (token.size () < 3 || token.size () > 16)
+      {
+        return false;
+      }
+
+    static QSet<QString> const reserved {
+      "CQ", "QRZ", "DE", "DX", "RR73", "73", "RRR", "RR", "R",
+      "FT8", "FT4", "FT2", "JT65", "JT9", "MSK", "MSK144", "Q65",
+      "UTC", "TX", "RX", "WORKED", "CONFIRMED", "CHECKING",
+      "NEW", "CALL", "BAND", "MODE", "DXCC", "STATUS", "CS", "DS"
+    };
+    if (reserved.contains (token))
+      {
+        return false;
+      }
+    if (QRegularExpression {"^[A-R]{2}[0-9]{2}([A-X]{2})?$"}.match (token).hasMatch ())
+      {
+        return false;
+      }
+    if (QRegularExpression {"^R?-?[0-9]{1,2}$"}.match (token).hasMatch ())
+      {
+        return false;
+      }
+    if (QRegularExpression {"^[0-9]+$"}.match (token).hasMatch ())
+      {
+        return false;
+      }
+    if (!QRegularExpression {"[A-Z]"}.match (token).hasMatch ()
+        || !QRegularExpression {"[0-9]"}.match (token).hasMatch ())
+      {
+        return false;
+      }
+    return QRegularExpression {"^[A-Z0-9]+(/[A-Z0-9]+)?$"}.match (token).hasMatch ();
+  }
+
+  QString om0rx_callsign_from_decode_line (QString const& line, QString const& clicked)
+  {
+    if (is_om0rx_click_callsign (clicked))
+      {
+        return normalize_om0rx_clicked_token (clicked);
+      }
+
+    auto words = line.simplified ().split (' ', Qt::SkipEmptyParts);
+    for (auto i = 0; i + 1 < words.size (); ++i)
+      {
+        if (words.at (i).toUpper () != "CQ")
+          {
+            continue;
+          }
+        auto next = i + 1;
+        if (next < words.size () && words.at (next).toUpper () == "DX")
+          {
+            ++next;
+          }
+        if (next < words.size () && is_om0rx_click_callsign (words.at (next)))
+          {
+            return normalize_om0rx_clicked_token (words.at (next));
+          }
+      }
+
+    for (auto const& word : words)
+      {
+        if (is_om0rx_click_callsign (word))
+          {
+            return normalize_om0rx_clicked_token (word);
+          }
+      }
+    return QString {};
+  }
 }

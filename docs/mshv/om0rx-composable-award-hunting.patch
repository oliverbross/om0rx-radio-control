+void HvLogW::SetAutoDxAwardReferences(
+    const QString &callsign, const QStringList &programReferencePairs)
+{
+    const QString call = AwardAdifPolicy::baseCallsign(callsign);
+    if (call.isEmpty()) {
+        if (programReferencePairs.isEmpty()) autoDxAwardReferencesByCall.clear();
+        return;
+    }
+    QList<AwardReferenceMatch> matches;
+    for (int i = 0; i + 1 < programReferencePairs.size(); i += 2) {
+        AwardReferenceMatch match;
+        match.program = programReferencePairs.at(i);
+        match.reference = programReferencePairs.at(i + 1);
+        matches << match;
+    }
+    matches = AwardAdifPolicy::normalized(matches);
+    if (matches.isEmpty()) autoDxAwardReferencesByCall.remove(call);
+    else autoDxAwardReferencesByCall.insert(call, matches);
+}

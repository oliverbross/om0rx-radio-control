+void Main_Ms::SetModeFromAutoDxer(QString mode)
+{
+    const QString normalized = mode.trimmed().toUpper();
+    const int modeIndex = normalized == "FT8" ? 11 : normalized == "FT4" ? 13 : -1;
+    if (modeIndex < 0 || modeIndex >= COUNT_MODE || !rb_mode[modeIndex]) return;
+    if (s_mod_ident == modeIndex) {
+        if (m_autoDxerCore) m_autoDxerCore->setCurrentMode(normalized);
+        return;
+    }
+    if (f_decoder_busy) {
+        const bool newlyQueued = m_pendingAutoDxerMode != normalized;
+        m_pendingAutoDxerMode = normalized;
+        if (!m_autoDxerModeChangeTimer->isActive())
+            m_autoDxerModeChangeTimer->start();
+        if (newlyQueued && m_autoDxerCore)
+            m_autoDxerCore->appendDebugMessage(
+                "FULL-HUNT: mode change to " + normalized
+                + " deferred until decoder idle");
+        return;
+    }
+    m_pendingAutoDxerMode.clear();
+    m_autoDxerModeChangeTimer->stop();
+    Om0rxStationGate::invalidateAndNotify(this, "autodx-mode-qsy");
+    rb_mode[modeIndex]->setChecked(true);
+    if (m_autoDxerCore)
+        m_autoDxerCore->appendDebugMessage("FULL-HUNT: MSHV mode changed to " + normalized);
+}

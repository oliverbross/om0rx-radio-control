+void MainWindow::request_om0rx_decode_status (double freq_hz, QString const& callsign,
+                                              bool, int,
+                                              QString const& grid, QString const& message,
+                                              int snr)
+{
+  auto call = callsign.trimmed ().toUpper ();
+  if (call.isEmpty () || call.startsWith ('<'))
+    {
+      return;
+    }
+  auto active_call = ui->dxCallEntry->text ().trimmed ().toUpper ();
+  auto active_base = Radio::base_callsign (active_call).toUpper ();
+  auto status_base = Radio::base_callsign (call).toUpper ();
+  auto status_is_active_qso = active_call == call
+      || (!active_base.isEmpty () && active_base == status_base);
+  auto band = m_currentBand.trimmed ();
+  auto mode = m_mode.trimmed ().toUpper ();
+  auto cache_key = QString {"%1|%2|%3"}.arg (call, band, mode);
+  if (m_om0rx_status_cache.contains (cache_key))
+    {
+      auto parts = m_om0rx_status_cache.value (cache_key).split ('|');
+      QJsonObject cached;
+      if (parts.size () >= 3)
+        {
+          cached.insert ("call_status", parts.value (0));
+          cached.insert ("dxcc_status", parts.value (1));
+          cached.insert ("country", parts.value (2));
+          if (parts.size () >= 6)
+            {
+              cached.insert ("dxcc_tag", parts.value (3));
+              cached.insert ("cq_zone", parts.value (4));
+              cached.insert ("itu_zone", parts.value (5));
+            }
+      QTimer::singleShot (0, this, [this, call, cached] {
+        apply_om0rx_decode_status (call, cached);
+      });
+    }
+    }
+  QTimer::singleShot (0, this, [this, call] {
+    ui->decodedTextBrowser->annotate_callsign (call, QString {"Checking | Checking"}, QColor {});
+    ui->decodedTextBrowser2->annotate_callsign (call, QString {"Checking | Checking"}, QColor {});
+  });
+  if (m_om0rx_status_inflight.contains (cache_key))
+    {
+      return;
+    }
+  if (status_is_active_qso)
+    {
+      set_om0rx_active_status_pending (call);
+    }
+  m_om0rx_status_inflight.insert (cache_key);
+
+  QJsonObject payload;
+  payload.insert ("call", call);
+  payload.insert ("band", band);
+  payload.insert ("mode", mode);
+  payload.insert ("frequency_hz", static_cast<double> (m_freqNominal));
+  payload.insert ("audioOffset", static_cast<int> (freq_hz));
+  payload.insert ("grid", grid.trimmed ().toUpper ());
+  payload.insert ("message", message.trimmed ());
+  payload.insert ("snr", snr);
+
+  QNetworkRequest request {QUrl {"http://127.0.0.1:8080/api/wsjtx/decode-status"}};
+  request.setHeader (QNetworkRequest::ContentTypeHeader, "application/json");
+  auto reply = m_network_manager.post (request, QJsonDocument {payload}.toJson (QJsonDocument::Compact));
+  connect (reply, &QNetworkReply::finished, this, [this, reply, call, cache_key] {
+    m_om0rx_status_inflight.remove (cache_key);
+    if (QNetworkReply::NoError == reply->error ())
+      {
+        auto doc = QJsonDocument::fromJson (reply->readAll ());
+        auto status = doc.object ();
+        if (status.value ("success").toBool ())
+          {
+            auto call_status = status.value ("call_status").toString ("Unknown");
+            auto dxcc_status = status.value ("dxcc_status").toString ("Unknown");
+            auto country = status.value ("country").toString ();
+            auto dxcc_tag = status.value ("dxcc_tag").toString ();
+            auto cq_zone = status.value ("cq_zone").toString ();
+            auto itu_zone = status.value ("itu_zone").toString ();
+            m_om0rx_status_cache.insert (
+                cache_key,
+                QString {"%1|%2|%3|%4|%5|%6"}.arg (
+                    call_status, dxcc_status, country, dxcc_tag, cq_zone, itu_zone));
+            QTimer::singleShot (0, this, [this, call, status] {
+              apply_om0rx_decode_status (call, status);
+            });
+          }
+      }
+    reply->deleteLater ();
+  });
+}

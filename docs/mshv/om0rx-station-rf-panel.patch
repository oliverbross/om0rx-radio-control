diff --git a/MSHV_2762/src/HvTxW/om0rxstationpanel.h b/MSHV_2762/src/HvTxW/om0rxstationpanel.h
new file mode 100644
index 0000000..12e5a0d
--- /dev/null
+++ b/MSHV_2762/src/HvTxW/om0rxstationpanel.h
@@ -0,0 +1,241 @@
+/* Compact OM0RX station status/control panel.
+ * GPL-3.0-or-later; same license as MSHV.
+ */
+#ifndef OM0RXSTATIONPANEL_H
+#define OM0RXSTATIONPANEL_H
+
+#include <QFrame>
+#include <QHBoxLayout>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QLabel>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QPushButton>
+#include <QTimer>
+#include <QUrl>
+#include <QVBoxLayout>
+
+class Om0rxStationPanel : public QFrame
+{
+public:
+    explicit Om0rxStationPanel(bool darkStyle, QWidget *parent = 0)
+        : QFrame(parent), network(this), dark(darkStyle), requestInFlight(false),
+          actionInFlight(false), allowOperate(false), allowStandby(false),
+          transmitting(false), kpaOperate(false), kpaReady(false)
+    {
+        setFrameShape(QFrame::Panel);
+        setFrameShadow(QFrame::Sunken);
+        setContentsMargins(3,2,3,2);
+        setMaximumWidth(470);
+
+        title = new QLabel(tr("STATION RF - live KPA500 / KAT500"));
+        title->setAlignment(Qt::AlignCenter);
+        title->setStyleSheet(dark
+            ? "QLabel{color:rgb(210,225,245);font-weight:bold;}"
+            : "QLabel{color:rgb(20,55,95);font-weight:bold;}");
+        rf = new QLabel(tr("RF: waiting for station telemetry"));
+        kpa = new QLabel(tr("KPA: unknown"));
+        kat = new QLabel(tr("KAT: unknown"));
+        detail = new QLabel(tr("Guarded controls unavailable"));
+        detail->setWordWrap(true);
+
+        on = new QPushButton(tr("KPA ON"));
+        off = new QPushButton(tr("KPA OFF"));
+        on->setToolTip(tr("Guarded KPA500 OPERATE: verifies the complete RF route first"));
+        off->setToolTip(tr("Guarded KPA500 STANDBY"));
+        on->setStyleSheet("QPushButton:enabled{color:rgb(0,120,0);font-weight:bold;}");
+        off->setStyleSheet("QPushButton:enabled{color:rgb(170,95,0);font-weight:bold;}");
+        on->setEnabled(false);
+        off->setEnabled(false);
+
+        QHBoxLayout *buttons = new QHBoxLayout();
+        buttons->setContentsMargins(0,0,0,0);
+        buttons->setSpacing(3);
+        buttons->addWidget(on);
+        buttons->addWidget(off);
+        QVBoxLayout *layout = new QVBoxLayout(this);
+        layout->setContentsMargins(3,2,3,2);
+        layout->setSpacing(1);
+        layout->addWidget(title);
+        layout->addWidget(rf);
+        layout->addWidget(kpa);
+        layout->addWidget(kat);
+        layout->addLayout(buttons);
+        layout->addWidget(detail);
+
+        connect(on, &QPushButton::clicked, this, [this]() { postAction("operate"); });
+        connect(off, &QPushButton::clicked, this, [this]() { postAction("standby"); });
+        connect(&pollTimer, &QTimer::timeout, this, [this]() { refresh(); });
+        pollTimer.start(1500);
+        QTimer::singleShot(0, this, [this]() { refresh(); });
+    }
+
+private:
+    QUrl endpoint(const QString &path) const
+    {
+        QString base = QString::fromUtf8(qgetenv("OM0RX_API_BASE"));
+        if (base.isEmpty()) base = "http://127.0.0.1:8080";
+        return QUrl(base + path);
+    }
+    bool loopback(const QUrl &url) const
+    {
+        return (url.host() == "127.0.0.1" || url.host() == "localhost") &&
+            (url.scheme() == "http" || url.scheme() == "https");
+    }
+    QNetworkRequest request(const QUrl &url) const
+    {
+        QNetworkRequest req(url);
+        req.setHeader(QNetworkRequest::ContentTypeHeader, "application/json");
+        req.setRawHeader("Accept", "application/json");
+        req.setRawHeader("X-OM0RX-Control-Token", qgetenv("OM0RX_CONTROL_TOKEN"));
+        return req;
+    }
+    static QString number(const QJsonValue &value, int precision = 0)
+    {
+        return value.isDouble() ? QString::number(value.toDouble(), 'f', precision) : QString("--");
+    }
+    void setUnavailable(const QString &message)
+    {
+        rf->setText(tr("RF: unavailable"));
+        kpa->setText(tr("KPA: disconnected"));
+        kat->setText(tr("KAT: disconnected"));
+        detail->setText(message);
+        allowOperate = allowStandby = transmitting = kpaOperate = kpaReady = false;
+        updateButtons();
+    }
+    void updateButtons()
+    {
+        on->setEnabled(!actionInFlight && !transmitting && kpaReady && !kpaOperate && allowOperate);
+        off->setEnabled(!actionInFlight && !transmitting && kpaReady && kpaOperate && allowStandby);
+        if (actionInFlight) detail->setText(tr("Station coordinator is verifying the requested KPA state..."));
+    }
+    void refresh()
+    {
+        if (requestInFlight || actionInFlight) return;
+        const QUrl statusUrl = endpoint("/api/elecraft/status");
+        if (!loopback(statusUrl)) { setUnavailable(tr("Blocked non-loopback station endpoint")); return; }
+        requestInFlight = true;
+        QNetworkReply *reply = network.get(request(statusUrl));
+        QTimer::singleShot(2500, reply, [reply]() { if (!reply->isFinished()) reply->abort(); });
+        connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+            const int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+            const QJsonObject body = QJsonDocument::fromJson(reply->readAll()).object();
+            const bool ok = reply->error() == QNetworkReply::NoError && code >= 200 && code < 300 &&
+                body.value("success").toBool();
+            reply->deleteLater();
+            if (!ok) { requestInFlight = false; setUnavailable(tr("Station telemetry request failed")); return; }
+            renderStatus(body.value("status").toObject());
+            requestState();
+        });
+    }
+    void renderStatus(const QJsonObject &status)
+    {
+        const QJsonObject pa = status.value("kpa500").toObject();
+        const QJsonObject tuner = status.value("kat500").toObject();
+        const QJsonObject path = status.value("path").toObject();
+        const bool paConnected = pa.value("connected").toBool() && pa.value("responsive").toBool();
+        const bool tunerConnected = tuner.value("connected").toBool() && tuner.value("responsive").toBool();
+        const double watts = pa.value("output_power_w").toDouble();
+        transmitting = path.value("mox").toBool() || watts > 0.0 || tuner.value("swr_live").toBool();
+        kpaOperate = pa.value("operate").toBool();
+        kpaReady = paConnected && pa.value("power").toBool() && pa.value("fault").toString("00") == "00";
+
+        rf->setText(QString("RF: %1   OUT %2 W   SWR %3")
+            .arg(transmitting ? tr("TX ACTIVE") : tr("RX"))
+            .arg(number(pa.value("output_power_w")))
+            .arg(number(pa.value("swr"), 2)));
+        rf->setStyleSheet(transmitting
+            ? "QLabel{color:rgb(220,35,55);font-weight:bold;}"
+            : (dark ? "QLabel{color:rgb(130,220,150);font-weight:bold;}"
+                    : "QLabel{color:rgb(0,115,40);font-weight:bold;}"));
+        QString paState = !paConnected ? tr("DISCONNECTED")
+            : !pa.value("power").toBool() ? tr("POWER OFF")
+            : kpaOperate ? tr("OPERATE") : tr("STANDBY");
+        kpa->setText(QString("KPA: %1   %2   TEMP %3 C   FAULT %4")
+            .arg(paState).arg(pa.value("band").toString("--"))
+            .arg(number(pa.value("temperature_c"))).arg(pa.value("fault").toString("--")));
+        QString katState = !tunerConnected ? tr("DISCONNECTED")
+            : tuner.value("tuning").toBool() ? tr("TUNING")
+            : tuner.value("bypass").toBool() ? tr("BYPASS")
+            : tuner.value("mode").toString("--").toUpper();
+        kat->setText(QString("KAT: %1   ANT%2   SWR %3   FAULT %4")
+            .arg(katState).arg(tuner.value("antenna").toInt())
+            .arg(number(tuner.value("swr"), 2)).arg(tuner.value("fault").toString("--")));
+        if (!paConnected || !tunerConnected) detail->setText(tr("One or more station devices are disconnected"));
+        else if (transmitting) detail->setText(tr("Controls locked while RF is active"));
+        else detail->setText(path.value("route_label").toString(tr("Station route connected")));
+    }
+    void requestState()
+    {
+        const QUrl stateUrl = endpoint("/api/station/state");
+        QNetworkReply *reply = network.get(request(stateUrl));
+        QTimer::singleShot(2500, reply, [reply]() { if (!reply->isFinished()) reply->abort(); });
+        connect(reply, &QNetworkReply::finished, this, [this, reply]() {
+            const int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+            const QJsonObject body = QJsonDocument::fromJson(reply->readAll()).object();
+            const bool ok = reply->error() == QNetworkReply::NoError && code >= 200 && code < 300;
+            reply->deleteLater();
+            allowOperate = allowStandby = false;
+            if (ok) {
+                const QJsonArray actions = body.value("station_state").toObject().value("allowed_actions").toArray();
+                for (const QJsonValue &value : actions) {
+                    const QString action = value.toString();
+                    if (action == "operate" || action == "prepare-route") allowOperate = true;
+                    if (action == "standby") allowStandby = true;
+                }
+            }
+            requestInFlight = false;
+            updateButtons();
+        });
+    }
+    void postAction(const QString &action)
+    {
+        if (actionInFlight || transmitting || !kpaReady) return;
+        const QUrl url = endpoint("/api/station/actions/" + action);
+        if (!loopback(url)) { setUnavailable(tr("Blocked non-loopback station endpoint")); return; }
+        actionInFlight = true;
+        updateButtons();
+        QNetworkReply *reply = network.post(request(url), QByteArray("{}"));
+        QTimer::singleShot(75000, reply, [reply]() { if (!reply->isFinished()) reply->abort(); });
+        connect(reply, &QNetworkReply::finished, this, [this, reply, action]() {
+            const int code = reply->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+            const QJsonObject body = QJsonDocument::fromJson(reply->readAll()).object();
+            const bool ok = reply->error() == QNetworkReply::NoError && code >= 200 && code < 300 &&
+                body.value("success").toBool();
+            if (!ok) {
+                QJsonValue reason = body.value("detail");
+                detail->setText(reason.isString() ? reason.toString() : tr("KPA action was rejected"));
+            } else {
+                detail->setText(action == "operate" ? tr("KPA OPERATE confirmed") : tr("KPA STANDBY confirmed"));
+            }
+            reply->deleteLater();
+            actionInFlight = false;
+            requestInFlight = false;
+            updateButtons();
+            QTimer::singleShot(100, this, [this]() { refresh(); });
+        });
+    }
+
+    QNetworkAccessManager network;
+    QTimer pollTimer;
+    bool dark;
+    bool requestInFlight;
+    bool actionInFlight;
+    bool allowOperate;
+    bool allowStandby;
+    bool transmitting;
+    bool kpaOperate;
+    bool kpaReady;
+    QLabel *title;
+    QLabel *rf;
+    QLabel *kpa;
+    QLabel *kat;
+    QLabel *detail;
+    QPushButton *on;
+    QPushButton *off;
+};
+
+#endif

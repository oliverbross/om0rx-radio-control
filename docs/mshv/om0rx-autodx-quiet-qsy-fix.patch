@@ -0,0 +1,17 @@
+#ifndef OM0RX_TX_WATCHDOG_EDGE_H
+#define OM0RX_TX_WATCHDOG_EDGE_H
+
+namespace Om0rxTxWatchdogEdge {
+
+// A normal false edge is completion, never a watchdog fault.  A watchdog may
+// trip only if the same armed rising edge is still current and PTT remains
+// asserted when its deadline callback runs.
+inline bool shouldTrip(bool txActive, unsigned long long armedGeneration,
+                       unsigned long long currentGeneration)
+{
+    return txActive && armedGeneration == currentGeneration;
+}
+
+} // namespace Om0rxTxWatchdogEdge
+
+#endif

+QStringList DecodeList::CompactStatuses(const QString &callsign) const
+{
+    if (!m_dxccTracker || callsign.trimmed().isEmpty()) return QStringList() << "" << "";
+    const QString call = callsign.trimmed().toUpper();
+    const QString key = call + "@" + QString::number(m_dxccTracker->getCurrentBand())
+        + "@" + m_dxccTracker->getCurrentMode().toUpper();
+    if (m_statusCache.contains(key)) return m_statusCache.value(key);
+
+    const int band = m_dxccTracker->getCurrentBand();
+    const QString mode = m_dxccTracker->getCurrentMode().toUpper();
+    const bool callWorked = m_dxccTracker->isCallWorkedAllTime(call);
+    const bool callNewBand = !m_dxccTracker->isCallWorkedOnBand(call, band);
+    const bool callNewMode = !m_dxccTracker->isCallWorkedOnMode(call, mode);
+    QString cs;
+    if (!callWorked) cs = "NC";
+    else if (m_dxccTracker->isCallConfirmedBandMode(call, band, mode)) cs = "C";
+    else if (callNewBand && callNewMode) cs = "NB+NM";
+    else if (callNewBand) cs = "NB";
+    else if (callNewMode) cs = "NM";
+    else cs = "W";
+
+    QString ds;
+    const int entity = m_dxccTracker->getDxccNumber(call);
+    if (entity > 0) {
+        if (!m_dxccTracker->isDxccWorkedAllTime(entity)) ds = "ATNO";
+        else {
+            const bool newBand = !m_dxccTracker->isDxccWorked(entity, band);
+            const bool newMode = !m_dxccTracker->isDxccWorkedOnMode(entity, mode);
+            if (m_dxccTracker->isDxccConfirmedBandMode(entity, band, mode)) ds = "C";
+            else {
+                const QString prefix = m_dxccTracker->isDxccConfirmed(entity) ? "C/" : "W/";
+                if (newBand && newMode) ds = prefix + "NB+NM";
+                else if (newBand) ds = prefix + "NB";
+                else if (newMode) ds = prefix + "NM";
+                else ds = "W";
+            }
+        }
+    }
+    const QStringList result = QStringList() << cs << ds;
+    if (m_statusCache.size() >= 4096) m_statusCache.clear();
+    m_statusCache.insert(key, result);
+    return result;
+}
+
+QColor DecodeList::StatusColor(const QString &status, bool dxcc) const
+{
+    QString full = status;
+    if (status == "NC") full = "New Call";
+    else if (status == "NB") full = "New Band";
+    else if (status == "NM") full = "New Mode";
+    else if (status == "NB+NM") full = "New Band+Mode";
+    else if (status == "C") full = "Confirmed";
+    else if (status == "W") full = "Worked";
+    else if (status.startsWith("C/")) full = "C/New " + status.mid(2).replace("NB", "Band").replace("NM", "Mode");
+    else if (status.startsWith("W/")) full = "W/New " + status.mid(2).replace("NB", "Band").replace("NM", "Mode");
+    QSettings palette(QCoreApplication::applicationDirPath() + "/settings/database/status-colors.ini", QSettings::IniFormat);
+    const QString key = QString("StatusColors/%1").arg(full.replace('/', '_'));
+    const QColor configured(palette.value(key).toString());
+    if (configured.isValid()) return configured;
+    if (full == "Confirmed") return QColor("#10B981");
+    if (full == "Worked") return QColor("#B0B0B0");
+    if (full == "ATNO") return QColor("#FF8C00");
+    if (full == "New Call") return QColor("#FF6B35");
+    if (full.contains("Band+Mode")) return dxcc ? QColor("#9C27B0") : QColor("#E91E63");
+    if (full.contains("Band")) return dxcc ? QColor("#4A9EFF") : QColor("#00BFFF");
+    if (full.contains("Mode")) return dxcc ? QColor("#FFD93D") : QColor("#FFC000");
+    return QColor("#666666");
+}

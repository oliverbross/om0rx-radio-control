+bool HvDxccTracker::applyWavelogAcknowledgedQso(
+    const QString& deltaKey, const QString& callsign, const QString& grid,
+    int bandIndex, const QString& mode, const QString& date)
+{
+    if (deltaKey.isEmpty()) return false;
+    QMutexLocker locker(&m_mutex);
+    if (!m_db.transaction()) return false;
+    QSqlQuery ledger(m_db);
+    ledger.prepare("INSERT OR IGNORE INTO wavelog_applied_deltas (delta_key, applied_utc) VALUES (?, ?)");
+    ledger.addBindValue(deltaKey);
+    ledger.addBindValue(QDateTime::currentDateTimeUtc().toString(Qt::ISODate));
+    if (!ledger.exec()) {
+        m_db.rollback();
+        return false;
+    }
+    if (ledger.numRowsAffected() == 0) {
+        m_db.rollback();
+        return true;
+    }
+
+    // Write the complete worked-state transition in this same transaction.
+    // In-memory sets and signals are updated only after commit, so a failed
+    // statement or rollback cannot advertise a QSO the database did not keep.
+    const int entityNum = getDxccNumber(callsign);
+    const QString call = extractBaseCall(callsign);
+    const QString g = normalizeGrid(grid);
+    const bool newDxcc = entityNum > 0 && !m_workedDxccAllTime.contains(QString::number(entityNum));
+    const bool newGrid = g.length() >= 4 && !m_workedGridsAllTime.contains(g.left(4));
+
+    if (entityNum > 0) {
+        QSqlQuery dxcc(m_db);
+        dxcc.prepare("INSERT INTO worked_dxcc (entity_number, band_index, mode, first_qso_date, first_callsign) "
+                     "VALUES (?, ?, ?, ?, ?) "
+                     "ON CONFLICT(entity_number, band_index, mode) DO UPDATE SET qso_count = qso_count + 1");
+        dxcc.addBindValue(entityNum);
+        dxcc.addBindValue(bandIndex);
+        dxcc.addBindValue(mode);
+        dxcc.addBindValue(date);
+        dxcc.addBindValue(call);
+        if (!dxcc.exec()) {
+            m_db.rollback();
+            emit databaseError("Wavelog delta DXCC write failed: " + dxcc.lastError().text());
+            return false;
+        }
+    }
+    if (g.length() >= 4) {
+        QSqlQuery gridQuery(m_db);
+        gridQuery.prepare("INSERT INTO worked_grids (grid4, grid6, band_index, mode, first_qso_date, first_callsign) "
+                          "VALUES (?, ?, ?, ?, ?, ?) "
+                          "ON CONFLICT(grid4, band_index, mode) DO UPDATE SET qso_count = qso_count + 1");
+        gridQuery.addBindValue(g.left(4));
+        gridQuery.addBindValue(g.length() >= 6 ? g.left(6) : "");
+        gridQuery.addBindValue(bandIndex);
+        gridQuery.addBindValue(mode);
+        gridQuery.addBindValue(date);
+        gridQuery.addBindValue(call);
+        if (!gridQuery.exec()) {
+            m_db.rollback();
+            emit databaseError("Wavelog delta grid write failed: " + gridQuery.lastError().text());
+            return false;
+        }
+    }
+    QSqlQuery workedCall(m_db);
+    workedCall.prepare("INSERT OR IGNORE INTO worked_calls (callsign, band_index, mode, qso_date) VALUES (?, ?, ?, ?)");
+    workedCall.addBindValue(call);
+    workedCall.addBindValue(bandIndex);
+    workedCall.addBindValue(mode);
+    workedCall.addBindValue(date);
+    if (!workedCall.exec()) {
+        m_db.rollback();
+        emit databaseError("Wavelog delta callsign write failed: " + workedCall.lastError().text());
+        return false;
+    }
+    if (!m_db.commit()) {
+        m_db.rollback();
+        return false;
+    }
+
+    if (entityNum > 0) {
+        m_workedDxccAllTime.insert(QString::number(entityNum));
+        m_workedDxccByBand.insert(QString("%1_%2").arg(entityNum).arg(bandIndex));
+        m_workedDxccByBandMode.insert(QString("%1_%2_%3").arg(entityNum).arg(bandIndex).arg(mode));
+    }
+    if (g.length() >= 4) {
+        m_workedGridsAllTime.insert(g.left(4));
+        m_workedGridsByBand.insert(QString("%1_%2").arg(g.left(4)).arg(bandIndex));
+    }
+    m_workedCalls.insert(QString("%1_%2_%3").arg(call).arg(bandIndex).arg(mode));
+    if (newDxcc) emit newDxccWorked(entityNum, getDxccName(call), bandIndex);
+    if (newGrid) emit newGridWorked(g.left(4), bandIndex);
+    emit workedStatusChanged();
+    return true;
+}
+
+void HvDxccTracker::recordQsoUnlocked(const QString& callsign, const QString& grid,
+                                      int bandIndex, const QString& mode, const QString& date)
+{

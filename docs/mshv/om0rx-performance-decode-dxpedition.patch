+
+bool AutoDxerCore::applyUnmodifiedWavelogHistoryReply(QNetworkReply *reply)
+{
+    const QByteArray entityTag = reply ? reply->rawHeader("ETag") : QByteArray();
+    const QByteArray generatedHeader = reply
+        ? reply->rawHeader("X-OM0RX-History-Generated-At") : QByteArray();
+    const QByteArray maxAgeHeader = reply
+        ? reply->rawHeader("X-OM0RX-History-Max-Age") : QByteArray();
+    bool maxAgeOk = false;
+    const int maxAge = QString::fromLatin1(maxAgeHeader).toInt(&maxAgeOk);
+    const QDateTime generated = QDateTime::fromString(
+        QString::fromLatin1(generatedHeader), Qt::ISODate);
+    const qint64 age = generated.isValid()
+        ? generated.secsTo(QDateTime::currentDateTimeUtc()) : -1;
+    const bool tagMatches = AutoDxHistoryConditional::hasExactEntityTag(
+        entityTag, m_historyEntityTag);
+    if (!m_historyCachedAllowed || m_historyEntityTag.isEmpty() || !tagMatches
+            || !generated.isValid() || !maxAgeOk || maxAge <= 0 || maxAge > 30
+            || age < 0 || age > maxAge) {
+        m_historyEntityTag.clear();
+        m_historyRepresentationValidUntil = QDateTime();
+        m_historyCachedAuthorityStatus.clear();
+        m_historyCachedAllowed = false;
+        clearTransientHistoryFailure();
+        revokeHistoricalNovelty("stale-history-response");
+        return false;
+    }
+
+    // The server has revalidated the same semantic representation. Refresh
+    // only its short freshness lease; decoded records/deltas are already in
+    // the tracker and reparsing the large body would be redundant.
+    m_historyRepresentationValidUntil = generated.addSecs(maxAge);
+    clearTransientHistoryFailure();
+    m_historyAuthorityStatus = m_historyCachedAuthorityStatus;
+    if (!m_hvDxccTracker || !m_targetScorer) {
+        revokeHistoricalNovelty("tracker-unavailable");
+        return false;
+    }
+    m_targetScorer->setPendingWavelogCalls(m_pendingWavelogCalls);
+    m_targetScorer->setHistoricalNoveltyAllowed(true);
+    m_historicalNoveltyAllowed = true;
+    cancelPendingWavelogPaths();
+    return true;
 }
 

+void AutoDxerCore::checkRuntimeConfigUpdates()
+{
+    if (m_runtimeConfigReloading) return;
+    const QDateTime iniMtime = QFileInfo(
+        m_settingsPath + "/autodx.ini").lastModified().toUTC();
+    const QDateTime awardMtime = QFileInfo(
+        m_settingsPath + "/database/award_hunting.json").lastModified().toUTC();
+    const bool iniChanged = iniMtime != m_runtimeConfigMtime;
+    const bool awardChanged = awardMtime != m_awardActivationMtime;
+    if (awardChanged) {
+        m_awardActivationIndexValid = m_targetScorer->loadAwardActivationIndex(
+            m_settingsPath + "/database/award_hunting.json");
+        m_awardActivationEntries = m_targetScorer->awardActivationCount();
+        m_awardActivationMtime = awardMtime;
+        QJsonObject fields;
+        fields["award_index_mtime_utc"] = awardMtime.toString(Qt::ISODateWithMs);
+        fields["award_index_valid"] = m_awardActivationIndexValid;
+        fields["award_entries"] = m_awardActivationEntries;
+        auditEvent("award-index-hot-reloaded", fields);
+    }
+    if (!iniChanged && !m_runtimeConfigReloadPending) return;
+    if (m_state == WaitingForQSO || m_currentTarget.isValid()
+            || m_targetRespondedToUs || catTransitionPending()) {
+        m_runtimeConfigReloadPending = true;
+        return;
+    }
+
+    m_runtimeConfigReloading = true;
+    m_runtimeConfigReloadPending = false;
+    reloadRuntimeConfig();
+    m_runtimeConfigMtime = QFileInfo(
+        m_settingsPath + "/autodx.ini").lastModified().toUTC();
+    m_runtimeConfigLastAppliedUtc = QDateTime::currentDateTimeUtc();
+    m_runtimeConfigReloading = false;
+    QJsonObject fields;
+    fields["ini_mtime_utc"] = m_runtimeConfigMtime.toString(Qt::ISODateWithMs);
+    fields["award_index_mtime_utc"] = m_awardActivationMtime.toString(Qt::ISODateWithMs);
+    fields["award_index_valid"] = m_awardActivationIndexValid;
+    fields["award_entries"] = m_awardActivationEntries;
+    auditEvent("runtime-config-hot-reloaded", fields);
+}

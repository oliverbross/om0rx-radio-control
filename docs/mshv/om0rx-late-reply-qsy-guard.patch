+void AutoDxerCore::onLocalTransmission(const QString &message)
+{
+    if (!m_enabled || m_state != WaitingForQSO || !m_currentTarget.isValid()) return;
+    m_lastLocalTransmissionUtc = QDateTime::currentDateTimeUtc();
+
+    // A transmission that was already committed when AUTO was disabled can
+    // cross the timeout edge. Always give that real final TX a complete
+    // 60-second receive window.
+    if (lateReplyGuardActive()
+            && callsignsMatch(m_lateReplyGuardCallsign,
+                              m_currentTarget.callsign)) {
+        m_lateReplyGuardTimer->start(LATE_REPLY_GUARD_MS);
+        QJsonObject fields;
+        fields["call"] = m_currentTarget.callsign;
+        fields["message"] = message.left(40);
+        fields["guard_ms"] = LATE_REPLY_GUARD_MS;
+        auditEvent("late-reply-guard-reanchored", fields);
+    }
+}

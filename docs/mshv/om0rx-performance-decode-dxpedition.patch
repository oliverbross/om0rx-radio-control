+void AutoDxerCore::requestManualTarget(QStringList decodeData)
+{
+    QString callsign, grid;
+    int snr = 0, freq = 0;
+    bool isCQ = false;
+    parseDecodeMessage(decodeData, callsign, grid, snr, freq, isCQ);
+    callsign = callsign.trimmed().toUpper();
+    if (!m_enabled || callsign.isEmpty() || callsign == m_myCallsign) {
+        emit manualTargetStatus(callsign, false, "Auto DX is unavailable for this row");
+        return;
+    }
+    if (!historicalActionAllowed(callsign, false)) {
+        emit manualTargetStatus(callsign, false, "Wavelog history gate blocked the target");
+        return;
+    }
+    cleanupRecentlyWorked();
+    for (const QString &workedCall : m_recentlyWorked) {
+        if (callsignsMatch(workedCall, callsign)) {
+            emit manualTargetStatus(callsign, false, "Recently worked");
+            return;
+        }
+    }
+    if (m_currentTarget.isValid() && callsignsMatch(m_currentTarget.callsign, callsign)) {
+        emit manualTargetStatus(callsign, true, "Already active");
+        return;
+    }
+
+    CachedDecode decode;
+    bool found = false;
+    const QList<CachedDecode> active = m_decodeCache->getActiveDecodes(
+        m_currentBandIndex, m_targetHeardFreshSeconds);
+    for (const CachedDecode &candidate : active) {
+        if (candidate.isLocalDecode && callsignsMatch(candidate.callsign, callsign)) {
+            decode = candidate;
+            found = true;
+            break;
+        }
+    }
+    if (!found) {
+        emit manualTargetStatus(callsign, false, "Local decode is no longer fresh");
+        return;
+    }
+
+    const ScoredTarget target = m_targetScorer->scoreTarget(decode);
+    if (target.priority <= 0) {
+        emit manualTargetStatus(callsign, false,
+            target.priorityReason.isEmpty() ? "Duplicate/history eligibility gate" : target.priorityReason);
+        return;
+    }
+    m_manualTarget = target;
+    emit manualTargetStatus(callsign, true,
+        m_state == WaitingForQSO ? "Queued after active QSO" : "Queued by operator");
+
+    // Never displace an active queue/QSO.  Idle listeners can evaluate the
+    // explicit request immediately; otherwise the next decode-complete cycle
+    // revalidates freshness and history before admission.
+    if (m_state == Listening && !m_currentTarget.isValid()) evaluateTargets();
+}

+void TargetScorer::configureUsStates(bool enabled, int minimumWorked,
+                                     bool requireConfirmation, bool preferLotw,
+                                     int missingConfirmationWeight, int underQuotaWeight,
+                                     const QSet<int> &bands)
+{
+    m_usStatesEnabled = enabled;
+    m_usStatesMinimumWorked = qBound(1, minimumWorked, 10);
+    m_usStatesRequireConfirmation = requireConfirmation;
+    m_usStatesPreferLotw = preferLotw;
+    m_usStatesMissingConfirmationWeight = qMax(0, missingConfirmationWeight);
+    m_usStatesUnderQuotaWeight = qMax(0, underQuotaWeight);
+    m_usStatesBands = bands;
+}
+
+bool TargetScorer::loadUsStateIndex(const QString &path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return false;
+    QHash<QString, QString> stateByCall;
+    QSet<QString> lotwCalls;
+    QHash<QString, QSet<QString> > worked;
+    QHash<QString, QSet<QString> > confirmed;
+    while (!file.atEnd()) {
+        const QString line = QString::fromUtf8(file.readLine()).trimmed();
+        if (line.isEmpty() || line.startsWith('#')) continue;
+        const QStringList fields = line.split('|');
+        if (fields.size() >= 4 && fields.at(0) == "CALL") {
+            const QString call = baseCallsign(fields.at(1));
+            const QString state = fields.at(2).trimmed().toUpper();
+            if (!call.isEmpty() && state.size() == 2) stateByCall.insert(call, state);
+            if (fields.at(3).toInt() != 0) lotwCalls.insert(call);
+        } else if (fields.size() >= 5 && fields.at(0) == "WORKED") {
+            const QString call = baseCallsign(fields.at(1));
+            const QString state = fields.at(2).trimmed().toUpper();
+            const int band = fields.at(3).toInt();
+            const QString key = state + "@" + QString::number(band);
+            if (!call.isEmpty() && state.size() == 2 && band > 0) {
+                worked[key].insert(call);
+                if (fields.at(4).toInt() != 0) confirmed[key].insert(call);
+            }
+        }
+    }
+    m_usStateByCall = stateByCall;
+    m_usStateLotwCalls = lotwCalls;
+    m_usStateWorkedCalls = worked;
+    m_usStateConfirmedCalls = confirmed;
+    return true;
+}
+
+bool TargetScorer::usStateNeeded(const QString &call, int bandIndex) const
+{
+    if (!m_usStatesEnabled || !m_usStatesBands.contains(bandIndex)) return false;
+    const QString state = m_usStateByCall.value(baseCallsign(call));
+    if (state.isEmpty()) return false;
+    const QString key = state + "@" + QString::number(bandIndex);
+    return m_usStateWorkedCalls.value(key).size() < m_usStatesMinimumWorked
+        || (m_usStatesRequireConfirmation && m_usStateConfirmedCalls.value(key).isEmpty());
+}
+
+void TargetScorer::recordUsStateQso(const QString &call, int bandIndex)
+{
+    const QString base = baseCallsign(call);
+    const QString state = m_usStateByCall.value(base);
+    if (!state.isEmpty())
+        m_usStateWorkedCalls[state + "@" + QString::number(bandIndex)].insert(base);
+}
+
+int TargetScorer::usStateCompleteSlots() const
+{
+    int complete = 0;
+    static const char *states[] = {"AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA","HI","ID","IL","IN","IA","KS","KY","LA","ME","MD","MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ","NM","NY","NC","ND","OH","OK","OR","PA","RI","SC","SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"};
+    for (int s = 0; s < 50; ++s) for (int band : m_usStatesBands) {
+        const QString key = QString::fromLatin1(states[s]) + "@" + QString::number(band);
+        if (m_usStateWorkedCalls.value(key).size() >= m_usStatesMinimumWorked
+                && (!m_usStatesRequireConfirmation || !m_usStateConfirmedCalls.value(key).isEmpty()))
+            ++complete;
+    }
+    return complete;
+}

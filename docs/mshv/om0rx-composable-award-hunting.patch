+void HvDxccTracker::ensureWorkedAwardIndex() const
+{
+    if (!m_workedAwardIndexDirty) return;
+    m_workedAwardIndex.clear();
+    const auto add = [this](int entity, int band) {
+        const DxccEntity data = m_entityById.value(entity);
+        const QString suffix = "@" + QString::number(band);
+        if (!data.continent.isEmpty()) m_workedAwardIndex.insert("C:" + data.continent.toUpper() + suffix);
+        if (data.cqZone > 0) m_workedAwardIndex.insert("Q:" + QString::number(data.cqZone) + suffix);
+        if (data.ituZone > 0) m_workedAwardIndex.insert("I:" + QString::number(data.ituZone) + suffix);
+    };
+    for (const QString &entity : m_workedDxccAllTime) add(entity.toInt(), -1);
+    for (const QString &worked : m_workedDxccByBand) {
+        const QStringList parts = worked.split('_');
+        if (parts.size() == 2) add(parts.at(0).toInt(), parts.at(1).toInt());
+    }
+    m_workedAwardIndexDirty = false;
+}
 

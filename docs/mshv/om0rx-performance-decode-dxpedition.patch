+void HvAutoDxSettings::setAutoDxerCore(AutoDxerCore *core)
+{
+    m_autoDxerCore = core;
+    updateDxpeditionCatalogStatus();
+}
+
+void HvAutoDxSettings::updateDxpeditionCatalogStatus()
+{
+    if (!m_dxpeditionCatalogStatus) return;
+    if (!m_autoDxerCore) {
+        m_dxpeditionCatalogStatus->setText("Catalogue: unavailable");
+        return;
+    }
+    const QJsonObject catalog = m_autoDxerCore->autoDxStatus()
+        .value("dxpedition_catalog").toObject();
+    const bool valid = catalog.value("valid").toBool();
+    const int entries = catalog.value("entries").toInt();
+    const QString expires = catalog.value("expires_utc").toString();
+    m_dxpeditionCatalogStatus->setText(valid
+        ? QString("Catalogue: valid, %1 active callsign/band aliases%2")
+              .arg(entries)
+              .arg(expires.isEmpty() ? QString()
+                   : QString("; expires %1 UTC").arg(expires))
+        : "Catalogue: unavailable or expired; conservative rare-prefix fallback is active");
+}
 

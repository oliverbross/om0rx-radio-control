+static int initialQueueStage(const ScoredTarget &target, const QString &myCallsign,
+                             QString *receivedReport)
+{
+    if (receivedReport) receivedReport->clear();
+    const AutoDxParsedMessage parsed = AutoDxMessageParser::parse(target.originalMessage);
+    if (!target.isCallingMe || !parsed.senderResolved
+            || parsed.destination.compare(myCallsign, Qt::CaseInsensitive) != 0
+            || parsed.transmitter.compare(target.callsign, Qt::CaseInsensitive) != 0) {
+        return 0;
+    }
+
+    const QStringList fields = target.originalMessage.simplified().toUpper()
+        .split(' ', Qt::SkipEmptyParts);
+    if (fields.size() < 3) return 1;
+    QString exchange = fields.last();
+    QRegExp plainReport("^[+-][0-9]{2}$");
+    QRegExp acknowledgedReport("^R[+-][0-9]{2}$");
+    if (plainReport.exactMatch(exchange)) {
+        if (receivedReport) *receivedReport = exchange;
+        return 2;
+    }
+    if (acknowledgedReport.exactMatch(exchange)) {
+        exchange.remove(0, 1);
+        if (receivedReport) *receivedReport = exchange;
+        return 3;
+    }
+    if (exchange == "RRR") return 3;
+    if (exchange == "RR73" || exchange == "73") return 4;
+    // A grid or calls-only directed message has already completed Tx1.
+    return 1;
+}
+
+static QString formattedFtReport(int snr)
+{
+    const int bounded = qBound(-30, snr, 30);
+    return QString("%1%2").arg(bounded >= 0 ? "+" : "-")
+        .arg(qAbs(bounded), 2, 10, QChar('0'));
+}

+QRect Main_Ms::CurrentNormalWindowGeometry() const
+{
+    QRect result = normalGeometry();
+    if (!result.isValid() || result.width() <= 0 || result.height() <= 0)
+        result = geometry();
+    return result;
+}
+QRect Main_Ms::ValidatedWindowGeometry(const QRect &savedGeometry) const
+{
+    const QList<QScreen *> screens = QGuiApplication::screens();
+    if (screens.isEmpty()) return savedGeometry;
+
+    QScreen *targetScreen = QGuiApplication::primaryScreen();
+    qint64 largestVisibleArea = 0;
+    for (QScreen *screen : screens)
+    {
+        const QRect intersection = savedGeometry.intersected(screen->availableGeometry());
+        const qint64 visibleArea = static_cast<qint64>(intersection.width()) * intersection.height();
+        if (visibleArea > largestVisibleArea)
+        {
+            largestVisibleArea = visibleArea;
+            targetScreen = screen;
+        }
+    }
+    if (!targetScreen) targetScreen = screens.first();
+
+    const QRect available = targetScreen->availableGeometry();
+    const int boundedWidth = qMin(qMax(savedGeometry.width(), minimumWidth()), available.width());
+    const int boundedHeight = qMin(qMax(savedGeometry.height(), minimumHeight()), available.height());
+    const int boundedX = qBound(available.left(), savedGeometry.x(), available.right() - boundedWidth + 1);
+    const int boundedY = qBound(available.top(), savedGeometry.y(), available.bottom() - boundedHeight + 1);
+    return QRect(boundedX, boundedY, boundedWidth, boundedHeight);
+}
+void Main_Ms::ScheduleWindowStateSave()
+{
+    if (!block_save && isVisible() && window_state_save_timer)
+        window_state_save_timer->start();
+}
+void Main_Ms::moveEvent(QMoveEvent *event)
+{
+    QWidget::moveEvent(event);
+    ScheduleWindowStateSave();
+}
+void Main_Ms::resizeEvent(QResizeEvent *event)
+{
+    QWidget::resizeEvent(event);
+    ScheduleWindowStateSave();
+}
+void Main_Ms::changeEvent(QEvent *event)
+{
+    QWidget::changeEvent(event);
+    if (event->type() == QEvent::WindowStateChange) ScheduleWindowStateSave();
+}

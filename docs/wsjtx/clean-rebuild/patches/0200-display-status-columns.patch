+namespace
+{
+  class DecodeStatusBlockData final : public QTextBlockUserData
+  {
+  public:
+    explicit DecodeStatusBlockData (QString value) : key {std::move (value)} {}
+    QString key;
+  };
+
+  QString normalized_status_call (QString value)
+  {
+    value = value.trimmed ().toUpper ();
+    value.remove ('<');
+    value.remove ('>');
+    return value;
+  }
+
+  bool is_status_callsign (QString const& value)
+  {
+    static QSet<QString> const reserved {"CQ", "CQDX", "QRZ", "DE", "RR73", "73", "RRR"};
+    auto call = normalized_status_call (value);
+    return call.size () >= 3 && call.size () <= 16
+        && !reserved.contains (call)
+        && QRegularExpression {QStringLiteral ("[A-Z]")}.match (call).hasMatch ()
+        && QRegularExpression {QStringLiteral ("[0-9]")}.match (call).hasMatch ()
+        && QRegularExpression {QStringLiteral ("^[A-Z0-9]+(/[A-Z0-9]+)?$")}.match (call).hasMatch ();
+  }
+
+  QString decode_status_key (QString const& call, QString const& band, QString const& mode)
+  {
+    return QString {"%1|%2|%3"}.arg (normalized_status_call (call),
+                                     band.trimmed ().toLower (),
+                                     mode.trimmed ().toUpper ());
+  }
+
+  QTextCharFormat status_format (QString const& status, QFont const& font)
+  {
+    auto normalized = status.trimmed ().toLower ();
+    QColor foreground {45, 45, 45};
+    if (normalized.contains ("atno") || normalized.contains ("new call")) foreground = QColor {210, 70, 32};
+    else if (normalized.contains ("new band") || normalized.contains ("new mode")) foreground = QColor {0, 104, 178};
+    else if (normalized.contains ("worked")) foreground = QColor {74, 85, 104};
+    else if (normalized.contains ("confirmed")) foreground = QColor {0, 126, 72};
+    QTextCharFormat format;
+    format.clearBackground ();
+    format.setForeground (foreground);
+    format.setFont (font);
+    format.setFontWeight (QFont::Normal);
+    return format;
+  }
+
+  QString status_cell (QString status)
+  {
+    auto normalized = status.trimmed ().toLower ();
+    QString prefix;
+    if (normalized.startsWith ("c/") || normalized.startsWith ("w/"))
+      {
+        prefix = normalized.left (1).toUpper () + "/";
+        normalized = normalized.mid (2).trimmed ();
+      }
+    QString label {"?"};
+    if (normalized == "checking") label = "...";
+    else if (normalized == "confirmed") label = "C";
+    else if (normalized == "worked") label = "W";
+    else if (normalized.contains ("atno")) label = "ATNO";
+    else if (normalized.contains ("new call")) label = "NC";
+    else if (normalized.contains ("new band") && normalized.contains ("mode")) label = "NB+M";
+    else if (normalized.contains ("new band")) label = "NB";
+    else if (normalized.contains ("new mode")) label = "NM";
+    if (!prefix.isEmpty () && label != "?" && label != "...") label = prefix + label;
+    return label.left (6).leftJustified (6);
+  }
+}

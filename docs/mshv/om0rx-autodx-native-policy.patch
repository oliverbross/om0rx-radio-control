+    record["state"] = stateString();
+    record["band_index"] = m_currentBandIndex;
+    emit debugMessage("AUTODX-AUDIT " + QString::fromUtf8(
+        QJsonDocument(record).toJson(QJsonDocument::Compact)));
+}

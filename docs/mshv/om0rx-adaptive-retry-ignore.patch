+QString AutoDxerCore::operatorCallKey(const QString &callsign, int bandIndex,
+                                      const QString &mode) const
+{
+    return targetScopeKey(callsign, bandIndex, mode);
+}
+
+int AutoDxerCore::operatorCallIndex(const QString &key) const
+{
+    for (int i = 0; i < m_operatorCallQueue.size(); ++i) {
+        const OperatorCallRequest &request = m_operatorCallQueue.at(i);
+        if (operatorCallKey(request.target.callsign, request.target.bandIndex,
+                            request.mode) == key) return i;
+    }
+    return -1;
+}

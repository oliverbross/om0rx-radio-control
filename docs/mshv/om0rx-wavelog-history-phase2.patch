+    m_bandSwitchCooldownSeconds->setRange(0, 1800);
+    m_bandSwitchCooldownSeconds->setSuffix(" sec");
+    timing->addWidget(new QLabel("Normal call duration:"), 0, 0);
+    timing->addWidget(m_normalCallSeconds, 0, 1);
+    timing->addWidget(new QLabel("Quiet/no-target band dwell:"), 1, 0);
+    timing->addWidget(m_quietBandSeconds, 1, 1);
+    timing->addWidget(new QLabel("Target heard freshness:"), 2, 0);
+    timing->addWidget(m_targetHeardFreshSeconds, 2, 1);
+    timing->addWidget(new QLabel("Cross-band verify timeout:"), 3, 0);
+    timing->addWidget(m_crossBandVerifySeconds, 3, 1);
+    timing->addWidget(new QLabel("Band-switch cooldown:"), 4, 0);
+    timing->addWidget(m_bandSwitchCooldownSeconds, 4, 1);
+    timing->setColumnStretch(2, 1);
+    layout->addLayout(timing);
+
+    m_persistNewDxccWhileHeard = new QCheckBox("Keep calling new DXCC while heard locally");
+    m_persistNewBandSlotWhileHeard = new QCheckBox("Keep calling new band slot while heard locally");
+    layout->addWidget(m_persistNewDxccWhileHeard);
+    layout->addWidget(m_persistNewBandSlotWhileHeard);
+
+    QLabel *scheduleLabel = new QLabel("Allowed local-time windows (system local time, including DST):");
+    scheduleLabel->setStyleSheet("font-weight: bold; margin-top: 6px;");

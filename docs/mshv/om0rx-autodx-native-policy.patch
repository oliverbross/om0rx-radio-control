+void AutoDxerCore::noteSkipped(const QString &reason)
+{
+    const QString normalized = reason.trimmed();
+    if (normalized.isEmpty()) return;
+    m_recentSkippedReasons.removeAll(normalized);
+    m_recentSkippedReasons.append(normalized);
+    while (m_recentSkippedReasons.size() > 12) m_recentSkippedReasons.removeFirst();
+}

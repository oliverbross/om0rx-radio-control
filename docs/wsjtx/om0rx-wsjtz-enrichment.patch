+void MainWindow::remote_start_target_qso (QString const& payload_json)
+{
+  QJsonParseError parse_error;
+  auto doc = QJsonDocument::fromJson (payload_json.toUtf8 (), &parse_error);
+  if (QJsonParseError::NoError != parse_error.error || !doc.isObject ())
+    {
+      qDebug () << "OM0RX start target QSO ignored, invalid JSON:" << parse_error.errorString ();
+      return;
+    }
+
+  auto root = doc.object ();
+  auto target = root.value ("target").toObject ();
+  if (target.isEmpty ())
+    {
+      target = root;
+    }
+
+  auto text_value = [&target] (char const * name, QString const& fallback = QString {}) {
+    auto value = target.value (QLatin1String {name});
+    return value.isString () ? value.toString ().trimmed () : fallback;
+  };
+  auto bool_value = [&target] (char const * name, bool fallback) {
+    auto value = target.value (QLatin1String {name});
+    return value.isBool () ? value.toBool () : fallback;
+  };
+  auto uint_value = [&target] (char const * name, quint32 fallback) {
+    auto value = target.value (QLatin1String {name});
+    if (value.isDouble ())
+      {
+        auto number = value.toDouble ();
+        if (number >= 0.0 && number <= double (quint32_max))
+          {
+            return static_cast<quint32> (number);
+          }
+      }
+    return fallback;
+  };
+  auto frequency_value = [&target] (char const * name, Frequency fallback) {
+    auto value = target.value (QLatin1String {name});
+    if (value.isDouble ())
+      {
+        auto number = value.toDouble ();
+        if (number > 0.0)
+          {
+            return static_cast<Frequency> (number);
+          }
+      }
+    return fallback;
+  };
+
+  auto dx_call = text_value ("dxCall", text_value ("call")).toUpper ();
+  auto dx_grid = text_value ("dxGrid", text_value ("grid")).toUpper ();
+  auto mode = text_value ("mode").toUpper ();
+  auto submode = text_value ("submode").toUpper ();
+  auto frequency_tolerance = uint_value ("frequencyTolerance", quint32_max);
+  auto tr_period = uint_value ("trPeriod", quint32_max);
+  auto rx_df = uint_value ("rxDf", quint32_max);
+  auto tx_df = uint_value ("txDf", quint32_max);
+  auto fast_mode = bool_value ("fastMode", false);
+  auto generate_messages = bool_value ("generateMessages", true);
+  auto hold_tx_freq = bool_value ("holdTxFreq", ui->cbHoldTxFreq->isChecked ());
+  auto enable_tx = bool_value ("enableTx", false);
+  auto listen_only = bool_value ("listenOnly", false);
+  auto priority_hunt = bool_value ("priorityHunt", false);
+  auto return_to_origin = bool_value ("returnToOrigin", false);
+  auto dial_frequency = frequency_value ("dialFrequency", 0u);
+  auto tx_message = uint_value ("txMessageNumber", 1);
+  auto watchdog_minutes = uint_value ("watchdogMinutes", 0);
+
+  if (dx_call.isEmpty () && !listen_only)
+    {
+      qDebug () << "OM0RX start target QSO ignored, missing target call";
+      return;
+    }
+
+  auto const normalized_target = om0rx_normalized_call (dx_call);
+  auto active_call = om0rx_normalized_call (m_hisCall);
+  if (active_call.isEmpty ()) active_call = om0rx_normalized_call (ui->dxCallEntry->text ());
+  if (enable_tx && (m_transmitting || m_tx_when_ready || g_iptt))
+    {
+      qDebug () << "OM0RX start target QSO ignored while Tx is active or pending";
+      return;
+    }
+  if (enable_tx && ui->autoButton->isChecked () && !active_call.isEmpty ()
+      && active_call != normalized_target)
+    {
+      qDebug () << "OM0RX start target QSO ignored; another target is active:" << active_call;
+      return;
+    }
+
+  if (target.contains ("txFirst") && ui->txFirstCheckBox->isVisible ())
+    {
+      ui->txFirstCheckBox->setChecked (bool_value ("txFirst", ui->txFirstCheckBox->isChecked ()));
+    }
+
+  remote_configure (mode, frequency_tolerance, submode, fast_mode, tr_period, rx_df
+                    , listen_only ? QString {} : dx_call
+                    , listen_only ? QString {} : dx_grid
+                    , listen_only ? false : generate_messages);
+
+  if (dial_frequency)
+    {
+      setRig (dial_frequency);
+    }
+
+  if (tx_df != quint32_max && ui->TxFreqSpinBox->isVisible ())
+    {
+      ui->TxFreqSpinBox->setValue (tx_df);
+      ui->TxFreqSpinBox->interpretText ();
+      setXIT (ui->TxFreqSpinBox->value ());
+    }
+
+  if (ui->cbHoldTxFreq->isVisible () && ui->cbHoldTxFreq->isChecked () != hold_tx_freq)
+    {
+      ui->cbHoldTxFreq->click ();
+    }
+
+  if (!listen_only)
+    {
+      setTxMsg (qBound (quint32 {1}, tx_message, quint32 {6}));
+    }
+
+  if (return_to_origin)
+    {
+      om0rx_clear_priority_hunt ("return to origin");
+    }
+
+  if (priority_hunt && !listen_only && !dx_call.isEmpty ())
+    {
+      m_om0rxPriorityHuntPending = false;
+      m_om0rxPriorityHuntActive = true;
+      m_om0rxPriorityHuntCall = om0rx_normalized_call (dx_call);
+      m_om0rxPriorityHuntGrid = dx_grid;
+      m_om0rxPriorityHuntBand = text_value ("band");
+      m_om0rxPriorityHuntMode = mode;
+      m_om0rxPriorityHuntStatus = text_value ("huntReason", text_value ("dxcc_status", "backend"));
+      m_om0rxPriorityHuntWatchdogMinutes = int (qBound (quint32 {1},
+          watchdog_minutes ? watchdog_minutes : quint32 {20}, quint32 {120}));
+      m_om0rxPriorityHuntScore = 1000;
+      m_om0rxPriorityHuntRank = 1000;
+      m_om0rxPriorityHuntFreq = rx_df == quint32_max ? ui->RxFreqSpinBox->value () : int (rx_df);
+      m_om0rxPriorityHuntReport = ui->rptSpinBox->value ();
+      m_om0rxPriorityHuntTxFirst = ui->txFirstCheckBox->isChecked ();
+      m_idleMinutes = 0;
+      update_watchdog_label ();
+      if (m_zdebug)
+        {
+          log ("OM0RX backend priority hunt armed: " + m_om0rxPriorityHuntCall
+               + " watchdog=" + QString::number (m_om0rxPriorityHuntWatchdogMinutes) + "m");
+        }
+    }
+
+  auto const frequency_confirmed = !dial_frequency
+      || (m_rigState.online ()
+          && qAbs (qint64 (m_rigState.frequency ()) - qint64 (dial_frequency)) <= 2);
+  if (enable_tx && !listen_only && !ui->autoButton->isChecked () && frequency_confirmed)
+    {
+      m_bDoubleClicked = true;
+      ui->autoButton->click ();
+    }
+  else if (enable_tx && !listen_only && !frequency_confirmed)
+    {
+      // Never race a requested QSY with PTT. Enable only after the rig reports
+      // the requested dial frequency; otherwise remain safely in RX.
+      QTimer::singleShot (750, this, [this, dial_frequency, normalized_target] {
+          auto const target_still_selected =
+              om0rx_normalized_call (ui->dxCallEntry->text ()) == normalized_target;
+          auto const rig_confirmed = m_rigState.online ()
+              && qAbs (qint64 (m_rigState.frequency ()) - qint64 (dial_frequency)) <= 2;
+          if (target_still_selected && rig_confirmed && !m_transmitting
+              && !m_tx_when_ready && !g_iptt && !ui->autoButton->isChecked ())
+            {
+              m_bDoubleClicked = true;
+              ui->autoButton->click ();
+            }
+          else if (!rig_confirmed)
+            {
+              qDebug () << "OM0RX target QSO left in RX; requested dial frequency was not confirmed";
+            }
+        });
+    }
+
+  qDebug () << "OM0RX start target QSO applied:"
+            << dx_call << "mode" << mode << "dial" << dial_frequency
+            << "rxDf" << rx_df << "txDf" << tx_df
+            << "enableTx" << enable_tx << "listenOnly" << listen_only;
+  QApplication::alert (this);
+}

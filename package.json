{
  "name": "om0rx-radio-control",
  "version": "2.0.0",
  "description": "OM0RX FlexRadio control app with SDC, WSJT-X, Wavelog, QRZ, and rotor integrations",
  "type": "module",
  "main": "bridge/sdc-bridge-server.js",
  "scripts": {
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/maintenance/check_project.ps1",
    "check:frontend": "python tests/smoke/test_frontend_module_contracts.py",
    "check:visual-live": "python -m pytest tests/live/test_visual_globe_browser.py -q",
    "start:sdc": "node bridge/sdc-bridge-server.js",
    "start:sdc:debug": "node --inspect bridge/sdc-bridge-server.js"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "datatables.net": "1.13.11",
    "datatables.net-dt": "1.13.11",
    "jquery": "3.7.1",
    "topojson-client": "3.1.0",
    "vue": "3.5.40",
    "ws": "^8.21.0"
  },
  "keywords": [
    "flexradio",
    "sdc",
    "websocket",
    "cw",
    "skimmer"
  ],
  "author": "",
  "license": "MIT"
}

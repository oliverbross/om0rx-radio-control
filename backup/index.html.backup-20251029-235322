                            <input type="color" :value="configData.COLORS['W/New Band+Mode'].substring(0,7)" 
                                   @input="configData.COLORS['W/New Band+Mode'] = '#FF' + $event.target.value.substring(1).toUpperCase()">
                            <input type="text" v-model="configData.COLORS['W/New Band+Mode']" placeholder="#FFFF5722">
                        </div>
                        <div class="color-picker-field">
                            <label>Unknown (Unresolved DXCC)</label>
                            <input type="color" :value="configData.COLORS['Unknown'].substring(0,7)" 
                                   @input="configData.COLORS['Unknown'] = '#FF' + $event.target.value.substring(1).toUpperCase()">
                            <input type="text" v-model="configData.COLORS['Unknown']" placeholder="#FF666666">
                        </div>
                    </div>
                    
                    <!-- Special Stations Tab -->
                    <div v-if="activeConfigTab === 'specials'" class="config-form">
                        <h4 style="margin-bottom: 12px; font-size: 12px; color: #4a9eff; font-weight: 600;">🎯 Special Stations Configuration</h4>
                        <p style="font-size: 11px; color: #888; margin-bottom: 12px;">
                            Manage which special activities (POTA, WWFF, etc.) you want to see in the spots table and filtering options.
                        </p>
                        
                        <div style="margin-bottom: 16px; padding: 10px; background: #2a2a2a; border-radius: 4px;">
                            <h5 style="font-size: 11px; color: #b0d4ff; margin-bottom: 8px; font-weight: 600;">📍 Active Special Stations:</h5>
                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                <span v-for="special in enabledSpecials" :key="special" 
                                      :class="`special-badge special-${special.toLowerCase()}`"
                                      style="padding: 4px 10px; display: flex; align-items: center; gap: 6px; font-size: 11px; border-radius: 4px;">
                                    {{ special }}
                                    <button @click.stop="removeSpecial(special)" 
                                            style="background: none; border: none; color: inherit; cursor: pointer; padding: 0; font-size: 14px; line-height: 1;">×</button>
                                </span>
                            </div>
                        </div>
                        
                        <div style="margin-bottom: 12px; padding: 10px; background: #2a2a2a; border-radius: 4px;">
                            <h5 style="font-size: 11px; color: #b0d4ff; margin-bottom: 8px; font-weight: 600;">➕ Available Special Stations:</h5>
                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                <span v-for="special in availableSpecialsList.filter(s => !enabledSpecials.includes(s))" 
                                      :key="special"
                                      style="padding: 4px 10px; background: #3a3a3a; color: #999; display: flex; align-items: center; gap: 6px; font-size: 11px; border-radius: 4px; border: 1px dashed #555; cursor: pointer;"
                                      @click="addSpecial(special)">
                                    + {{ special }}
                                </span>
                            </div>
                        </div>
                        
                        <hr style="margin: 12px 0; border: none; border-top: 1px solid #444;">
                        
                        <div style="margin-top: 12px; padding: 10px; background: #1a2a2a; border-left: 3px solid #4a9eff; border-radius: 4px;">
                            <h5 style="font-size: 11px; color: #4a9eff; margin-bottom: 6px; font-weight: 600;">ℹ️ How it works:</h5>
                            <ul style="font-size: 10px; color: #999; margin-left: 16px; line-height: 1.4;">
                                <li>Special stations are detected from comments in DX spots (e.g., "K-1234" for POTA, "XXFF-1234" for WWFF)</li>
                                <li>Multiple specials can be detected in a single spot (e.g., POTA + WWFF)</li>
                                <li>Use filters to show only spots with specific special activities</li>
                                <li>Add or remove activities to customize your display</li>
                            </ul>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer">
                    <button class="btn-secondary" @click="closeConfigDialog">Cancel</button>
                    <button class="btn-primary" @click="saveConfiguration">Save Configuration</button>
                </div>
            </div>
        </div>
        
        <!-- Country Information Modal -->
        <div class="country-info-modal" @click.self="window.CountryModal?.hideModal?.()">
            <div class="country-modal-content">
                <div class="country-modal-header">
                    <h3>🌍 Additional Information</h3>
                    <button class="country-modal-close-btn" @click="window.CountryModal?.hideModal?.()">✕</button>
                </div>
                <div class="country-modal-body">
                    <div class="country-map-container">
                        <canvas id="countryMapCanvas"></canvas>
                        <div class="country-info-overlay"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Local Log Modal -->
        <div class="local-log-modal" @click.self="hideLocalLog">
            <div class="local-log-content">
                <div class="local-log-header">
                    <h2>📋 Local QSO Log</h2>
                    <button class="local-log-close-btn" @click="hideLocalLog">✕</button>
                </div>
                
                <div class="local-log-filters">
                    <div class="filter-group">
                        <label>Callsign:</label>
                        <input type="text" id="filter-callsign" placeholder="Search callsign..." class="filter-input">
                    </div>
                    <div class="filter-group">
                        <label>Mode:</label>
                        <select id="filter-mode" class="filter-input">
                            <option value="">All Modes</option>
                            <option value="CW">CW</option>
                            <option value="SSB">SSB</option>
                            <option value="USB">USB</option>
                            <option value="LSB">LSB</option>
                            <option value="FM">FM</option>
                            <option value="AM">AM</option>
                            <option value="RTTY">RTTY</option>
                            <option value="FT8">FT8</option>
                            <option value="FT4">FT4</option>
                            <option value="JT65">JT65</option>
                            <option value="PSK">PSK</option>
                            <option value="DIGI">DIGI</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Band:</label>
                        <select id="filter-band" class="filter-input">
                            <option value="">All Bands</option>
                            <option value="160m">160m</option>
                            <option value="80m">80m</option>
                            <option value="60m">60m</option>
                            <option value="40m">40m</option>
                            <option value="30m">30m</option>
                            <option value="20m">20m</option>
                            <option value="17m">17m</option>
                            <option value="15m">15m</option>
                            <option value="12m">12m</option>
                            <option value="10m">10m</option>
                            <option value="6m">6m</option>
                            <option value="2m">2m</option>
                            <option value="70cm">70cm</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label>Awards:</label>
                        <select id="filter-awards" class="filter-input">
                            <option value="">All QSOs</option>
                            <option value="POTA">POTA</option>
                            <option value="SOTA">SOTA</option>
                            <option value="WWFF">WWFF</option>
                            <option value="IOTA">IOTA</option>
                        </select>
                    </div>
                </div>
                
                <div class="local-log-table-container">
                    <table class="local-log-table">
                        <thead>
                            <tr>
                                <th class="th-date">Date</th>
                                <th class="th-time">Time (UTC)</th>
                                <th class="th-call">Callsign</th>
                                <th class="th-freq">Freq (MHz)</th>
                                <th class="th-band">Band</th>
                                <th class="th-mode">Mode</th>
                                <th class="th-rst">RST</th>
                                <th class="th-awards">Awards</th>
                                <th class="th-name">Name/QTH</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                
                <div class="local-log-pagination">
                    <div class="pagination-controls">
                        <button @click="localLogPrevPage" class="btn-nav" id="btn-prev-page">← Prev</button>
                        <div class="pagination-info">
                            <span class="local-log-pagination-info">Loading...</span>
                        </div>
                        <button @click="localLogNextPage" class="btn-nav" id="btn-next-page">Next →</button>
                    </div>
                    <div class="pagination-settings">
                        <label>Show per page:</label>
                        <select @change="setLocalLogItemsPerPage($event.target.value)" class="items-per-page-select">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select>
                        <button @click="exportLocalLogAsCSV" class="btn-export" title="Export filtered QSOs as CSV">📥 Export CSV</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Load modular JavaScript files -->
    <script src="js/core.js"></script>
    <script src="js/websocket.js"></script>
    <script src="js/radio-controls.js"></script>
    <script src="js/utils.js"></script>
    <script src="js/dx-spots.js"></script>
    <!-- TopoJSON client for proper arc decompression -->
    <script src="https://unpkg.com/topojson-client@3"></script>
    <script src="js/country-modal.js"></script>
    <script src="js/local-log-modal.js"></script>
    <script src="js/sdc-ticker.js"></script>
    <script src="js/wsjtx-handler.js"></script>
    <script src="js/wsjtx-widget.js"></script>
    <script src="js/app-main.js"></script>
</body>
</html>


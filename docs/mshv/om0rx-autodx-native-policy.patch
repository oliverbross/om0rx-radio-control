diff --git a/MSHV_2762/src/HvAutoDxer/autodxmessageparser.h b/MSHV_2762/src/HvAutoDxer/autodxmessageparser.h
new file mode 100644
index 0000000..7a5d8f3
--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/autodxmessageparser.h
@@ -0,0 +1,111 @@
+#ifndef AUTODXMESSAGEPARSER_H
+#define AUTODXMESSAGEPARSER_H
+
+#include <QRegExp>
+#include <QString>
+#include <QStringList>
+
+struct AutoDxParsedMessage
+{
+    QString destination;
+    QString transmitter;
+    bool isCq;
+    bool senderResolved;
+
+    AutoDxParsedMessage() : isCq(false), senderResolved(false) {}
+};
+
+class AutoDxMessageParser
+{
+public:
+    static AutoDxParsedMessage parse(const QString &message)
+    {
+        AutoDxParsedMessage parsed;
+        const QStringList parts = message.simplified().toUpper()
+            .split(' ', Qt::SkipEmptyParts);
+        if (parts.isEmpty()) return parsed;
+
+        // CQ is a protocol prefix.  Free text containing a later "CQ" token
+        // must not change which station is considered the transmitter.
+        if (parts.first() == "CQ") {
+            parsed.isCq = true;
+            int senderIndex = 1;
+            while (senderIndex < parts.size() && isCqModifier(parts.at(senderIndex))) {
+                ++senderIndex;
+            }
+            if (senderIndex < parts.size()) {
+                parsed.transmitter = resolvedCall(parts.at(senderIndex));
+                parsed.senderResolved = !parsed.transmitter.isEmpty();
+            }
+            return parsed;
+        }
+
+        // Standard FT8 messages are <TO> <FROM> <REPORT/GRID>.  Both call
+        // fields must resolve before FROM can be trusted.  In particular, a
+        // sole recognized destination must never become local-hearing proof.
+        if (parts.size() < 2) return parsed;
+        parsed.destination = resolvedCall(parts.at(0));
+        parsed.transmitter = resolvedCall(parts.at(1));
+        parsed.senderResolved = !parsed.destination.isEmpty()
+            && !parsed.transmitter.isEmpty();
+        if (!parsed.senderResolved) parsed.transmitter.clear();
+        return parsed;
+    }
+
+private:
+    static bool isCqModifier(const QString &token)
+    {
+        return token == "DX" || token == "NA" || token == "EU"
+            || token == "AS" || token == "AF" || token == "SA"
+            || token == "OC" || token == "TEST" || token == "POTA"
+            || token == "SOTA" || token == "QRP" || token.length() <= 2;
+    }
+
+    static QString resolvedCall(QString token)
+    {
+        token = token.trimmed().toUpper();
+        // MSHV may display a resolved hashed callsign in angle brackets.  An
+        // unresolved hash such as <...> remains unusable and fails closed.
+        if (token.startsWith('<') && token.endsWith('>') && token.length() > 2) {
+            token = token.mid(1, token.length() - 2);
+        }
+        if (token.isEmpty() || token.contains('<') || token.contains('>')) {
+            return QString();
+        }
+
+        QRegExp callRx("([A-Z0-9]{1,3}[0-9][A-Z0-9]{0,3}[A-Z])");
+        const QStringList components = token.split('/', Qt::SkipEmptyParts);
+        if (components.isEmpty()) return QString();
+        for (const QString &component : components) {
+            if (callRx.exactMatch(component) && passesValidation(component)) {
+                return token;
+            }
+        }
+        return QString();
+    }
+
+    static bool passesValidation(const QString &call)
+    {
+        if (call.length() < 3) return false;
+        int leadingDigits = 0;
+        while (leadingDigits < call.length() && call.at(leadingDigits).isDigit()) {
+            ++leadingDigits;
+        }
+        if (leadingDigits >= 3) return false;
+
+        bool foundFirstDigit = false;
+        int consecutiveDigits = 0;
+        for (int i = 0; i < call.length(); ++i) {
+            if (call.at(i).isDigit()) {
+                foundFirstDigit = true;
+                ++consecutiveDigits;
+                if (consecutiveDigits > 1 && i > 1) return false;
+            } else if (foundFirstDigit) {
+                consecutiveDigits = 0;
+            }
+        }
+        return true;
+    }
+};
+
+#endif // AUTODXMESSAGEPARSER_H

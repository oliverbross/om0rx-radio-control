+void HvAutoDxSettings::createAwardHuntingGroup()
+{
+    m_awardHuntingGroup = new QGroupBox("Awards, confirmations && campaign");
+    QGridLayout *layout = new QGridLayout(m_awardHuntingGroup);
+    auto addCheck = [&](const QString &key, const QString &label, bool value, int row, int column) {
+        QCheckBox *control = new QCheckBox(label);
+        control->setChecked(value);
+        m_runtimeChecks.insert(key, control);
+        layout->addWidget(control, row, column, 1, 2);
+    };
+    auto addSpin = [&](const QString &key, const QString &label, int value, int minimum,
+                       int maximum, int row, int column) {
+        QSpinBox *control = new QSpinBox;
+        control->setRange(minimum, maximum);
+        control->setValue(value);
+        m_runtimeSpins.insert(key, control);
+        layout->addWidget(new QLabel(label), row, column);
+        layout->addWidget(control, row, column + 1);
+    };
+
+    addCheck("AwardHunting/Enabled", "Enable composable award hunting", true, 0, 0);
+    addCheck("AwardHunting/StackScores", "Stack simultaneous award bonuses", true, 0, 2);
+    addSpin("AwardHunting/NewDxccWeight", "New DXCC (ATNO):", 10000, 0, 100000, 1, 0);
+    addSpin("AwardHunting/NewDxccBandWeight", "New DXCC band slot:", 1000, 0, 100000, 1, 2);
+    addSpin("AwardHunting/UnconfirmedDxccWeight", "Worked, not confirmed DXCC:", 8500, 0, 100000, 2, 0);
+    addSpin("AwardHunting/NewContinentWeight", "New/unconfirmed continent:", 2500, 0, 100000, 2, 2);
+    addSpin("AwardHunting/NewCqZoneWeight", "New/unconfirmed WAZ zone:", 2200, 0, 100000, 3, 0);
+    addSpin("AwardHunting/NewItuZoneWeight", "New/unconfirmed ITU zone:", 2000, 0, 100000, 3, 2);
+    addSpin("AwardHunting/NewGridWeight", "New grid:", 500, 0, 100000, 4, 0);
+
+    layout->addWidget(new QLabel("Campaign preset:"), 5, 0);
+    m_campaignProfile = new QComboBox;
+    m_campaignProfile->addItem("Balanced", "balanced");
+    m_campaignProfile->addItem("DXCC Challenge", "dxcc-challenge");
+    m_campaignProfile->addItem("Five-band DXCC", "five-band-dxcc");
+    m_campaignProfile->addItem("Worked All States", "worked-all-states");
+    m_campaignProfile->addItem("WAZ", "waz");
+    m_campaignProfile->addItem("ITU zones", "itu-zones");
+    m_campaignProfile->addItem("Grids", "grids");
+    m_campaignProfile->addItem("POTA / SOTA / WWFF", "references");
+    m_campaignProfile->addItem("Custom", "custom");
+    layout->addWidget(m_campaignProfile, 5, 1);
+    addSpin("Campaign/DxccWeightPercent", "DXCC %:", 100, 0, 500, 6, 0);
+    addSpin("Campaign/StateWeightPercent", "US states %:", 100, 0, 500, 6, 2);
+    addSpin("Campaign/ZoneWeightPercent", "Zones %:", 100, 0, 500, 7, 0);
+    addSpin("Campaign/GridWeightPercent", "Grids %:", 100, 0, 500, 7, 2);
+    addSpin("Campaign/ReferenceWeightPercent", "References %:", 100, 0, 500, 8, 0);
+
+    connect(m_campaignProfile, QOverload<int>::of(&QComboBox::currentIndexChanged),
+            this, [this](int) {
+        const QString profile = m_campaignProfile->currentData().toString();
+        const QMap<QString, QList<int> > presets = {
+            {"balanced", {100, 100, 100, 100, 100}},
+            {"dxcc-challenge", {175, 75, 100, 75, 75}},
+            {"five-band-dxcc", {200, 50, 75, 50, 50}},
+            {"worked-all-states", {75, 200, 75, 75, 50}},
+            {"waz", {75, 50, 200, 50, 50}},
+            {"itu-zones", {75, 50, 200, 50, 50}},
+            {"grids", {75, 50, 50, 200, 50}},
+            {"references", {75, 50, 50, 50, 200}}
+        };
+        if (!presets.contains(profile)) return;
+        const QList<int> values = presets.value(profile);
+        m_runtimeSpins.value("Campaign/DxccWeightPercent")->setValue(values[0]);
+        m_runtimeSpins.value("Campaign/StateWeightPercent")->setValue(values[1]);
+        m_runtimeSpins.value("Campaign/ZoneWeightPercent")->setValue(values[2]);
+        m_runtimeSpins.value("Campaign/GridWeightPercent")->setValue(values[3]);
+        m_runtimeSpins.value("Campaign/ReferenceWeightPercent")->setValue(values[4]);
+    });
+    const QStringList campaignWeightKeys = QStringList()
+        << "Campaign/DxccWeightPercent" << "Campaign/StateWeightPercent"
+        << "Campaign/ZoneWeightPercent" << "Campaign/GridWeightPercent"
+        << "Campaign/ReferenceWeightPercent";
+    for (const QString &key : campaignWeightKeys) {
+        connect(m_runtimeSpins.value(key), &QSpinBox::editingFinished, this, [this]() {
+            const int customIndex = m_campaignProfile->findData("custom");
+            if (customIndex >= 0) m_campaignProfile->setCurrentIndex(customIndex);
+        });
+    }
+
+    QLabel *help = new QLabel("Awards can be combined: a station may simultaneously satisfy DXCC, band-slot, state, zone, grid and activity-reference goals. Exact call/band/mode duplicates remain blocked.");
+    help->setWordWrap(true);
+    layout->addWidget(help, 9, 0, 1, 4);
+}

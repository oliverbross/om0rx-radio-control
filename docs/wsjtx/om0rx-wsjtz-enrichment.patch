+bool MainWindow::om0rx_stop_forbidden_autocall_cq(QString const& reason)
+{
+    if (!ui || !ui->cbAutoCall->isChecked() || ui->cbAutoCQ->isChecked()) return false;
+
+    auto const tx6 = ui->tx6->text().trimmed();
+    bool const tx6_is_cq = tx6.contains(QRegularExpression {"^(CQ|QRZ)(\\s|$)"});
+    bool const tx6_is_selected = ui->txrb6->isChecked() || m_ntx == 6;
+    if (!tx6_is_cq || (!tx6_is_selected && !m_bCallingCQ)) return false;
+
+    auto const active_call = om0rx_normalized_call(m_hisCall);
+    auto const dx_entry = om0rx_normalized_call(ui->dxCallEntry->text());
+    auto const last_logged = om0rx_normalized_call(m_lastCall);
+    bool const completed_target =
+        !last_logged.isEmpty()
+        && (active_call == last_logged || dx_entry == last_logged
+            || m_QSOProgress == ROGERS || m_QSOProgress == SIGNOFF);
+
+    bool const no_active_target =
+        active_call.isEmpty() || dx_entry.isEmpty() || completed_target || m_QSOProgress == CALLING;
+    if (!no_active_target) return false;
+
+    if (m_zdebug) {
+        log("OM0RX blocked Auto Call CQ: reason=" + reason + " tx6=" + tx6);
+    }
+
+    m_bCallingCQ = false;
+    m_bAutoReply = false;
+    m_bTxTime = false;
+    m_btxok = false;
+    if (ui->autoButton->isChecked()) {
+        auto_tx_mode(false);
+    }
+    if (completed_target || dx_entry.isEmpty()) {
+        clearDX();
+    }
+    return true;

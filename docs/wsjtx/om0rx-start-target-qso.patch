+void MainWindow::apply_om0rx_decode_status (QString const& callsign, QJsonObject const& status)
+{
+  auto display_call = callsign.trimmed ().toUpper ();
+  display_call.remove ('<');
+  display_call.remove ('>');
+  auto call_status = status.value ("call_status").toString ("Unknown");
+  auto dxcc_status = status.value ("dxcc_status").toString ("Unknown");
+  auto country = status.value ("country").toString ();
+  auto dxcc_tag = status.value ("dxcc_tag").toString ();
+  auto cq_zone = status.value ("cq_zone").toString ();
+  auto itu_zone = status.value ("itu_zone").toString ();
+  auto compact_call = call_status;
+  compact_call.replace ("Confirmed", "Cfm");
+  compact_call.replace ("Worked", "Wkd");
+  compact_call.replace ("New Call", "NewCall");
+  compact_call.replace ("New Band", "NewBand");
+  compact_call.replace ("New Mode", "NewMode");
+  auto compact_dxcc = dxcc_status;
+  compact_dxcc.replace ("Confirmed", "Cfm");
+  compact_dxcc.replace ("Worked", "Wkd");
+  compact_dxcc.replace ("New Band", "NewBand");
+  compact_dxcc.replace ("New Mode", "NewMode");
+  auto active_call = ui->dxCallEntry->text ().trimmed ().toUpper ();
+  active_call.remove ('<');
+  active_call.remove ('>');
+  auto active_base = Radio::base_callsign (active_call).toUpper ();
+  auto status_base = Radio::base_callsign (display_call).toUpper ();
+  auto status_is_active_qso = active_call.isEmpty ()
+      || active_call == display_call
+      || (!active_base.isEmpty () && active_base == status_base);
+
+  auto status_colours = [] (QString const& text) {
+    auto normalized = text.toLower ();
+    QColor bg {95, 107, 118};
+    QColor fg {255, 255, 255};
+    if (normalized.contains ("atno") || normalized.contains ("new call"))
+      {
+        bg = QColor {210, 68, 18};
+        fg = QColor {255, 255, 255};
+      }
+    else if (normalized.contains ("new band") || normalized.contains ("new mode"))
+      {
+        bg = QColor {0, 95, 168};
+        fg = QColor {255, 255, 255};
+      }
+    else if (normalized.contains ("worked"))
+      {
+        bg = QColor {92, 95, 102};
+        fg = QColor {255, 231, 117};
+      }
+    else if (normalized.contains ("confirmed"))
+      {
+        bg = QColor {0, 132, 78};
+        fg = QColor {255, 255, 255};
+      }
+    return qMakePair (bg, fg);
+  };
+  auto badge_style = [] (QColor const& bg, QColor const& fg) {
+    auto border = bg.darker (125);
+    return QString {
+        "QLabel {"
+        "background: %1;"
+        "border: 1px solid %2;"
+        "border-radius: 3px;"
+        "color: %3;"
+        "font-weight: 700;"
+        "padding: 3px 8px;"
+        "}"}.arg (bg.name (), border.name (), fg.name ());
+  };
+  auto call_colours = status_colours (call_status);
+  auto dxcc_colours = status_colours (dxcc_status);
+
+  auto entity_text = country;
+  if (entity_text.isEmpty ())
+    {
+      entity_text = dxcc_tag.isEmpty () ? QString {"Entity unknown"} : dxcc_tag;
+    }
+  auto zone_text = QStringList {};
+  if (!cq_zone.isEmpty ())
+    {
+      zone_text << QString {"CQ %1"}.arg (cq_zone);
+    }
+  if (!itu_zone.isEmpty ())
+    {
+      zone_text << QString {"ITU %1"}.arg (itu_zone);
+    }
+  auto entity_summary = zone_text.isEmpty ()
+      ? entity_text
+      : QString {"%1 | %2"}.arg (entity_text, zone_text.join (" / "));
+  auto entity_width = ui->labOm0rxEntityStatus->width ();
+  if (entity_width < 80)
+    {
+      entity_width = 180;
+    }
+  if (status_is_active_qso)
+    {
+      auto status_text = QString {"%1  CALL %2  DXCC %3"}.arg (display_call, compact_call, compact_dxcc);
+      auto label_width = ui->labOm0rxAutomation->width ();
+      if (label_width < 80)
+        {
+          label_width = 360;
+        }
+      ui->labOm0rxAutomation->setText (
+          ui->labOm0rxAutomation->fontMetrics ().elidedText (status_text, Qt::ElideRight, label_width - 8));
+      ui->labOm0rxAutomation->setToolTip (
+          QString {"%1: call %2 | DXCC %3%4%5%6"}.arg (
+              display_call,
+              call_status,
+              dxcc_status,
+              country.isEmpty () ? QString {} : QString {" | %1"}.arg (country),
+              cq_zone.isEmpty () ? QString {} : QString {" | CQ %1"}.arg (cq_zone),
+              itu_zone.isEmpty () ? QString {} : QString {" | ITU %1"}.arg (itu_zone)));
+      ui->labOm0rxCallStatus->setText (QString {"CALL %1"}.arg (compact_call));
+      ui->labOm0rxCallStatus->setToolTip (QString {"%1 call status: %2"}.arg (display_call, call_status));
+      ui->labOm0rxCallStatus->setStyleSheet (badge_style (call_colours.first, call_colours.second));
+      ui->labOm0rxDxccStatus->setText (QString {"DXCC %1"}.arg (compact_dxcc));
+      ui->labOm0rxDxccStatus->setToolTip (QString {"%1 DXCC status: %2"}.arg (display_call, dxcc_status));
+      ui->labOm0rxDxccStatus->setStyleSheet (badge_style (dxcc_colours.first, dxcc_colours.second));
+      ui->labOm0rxEntityStatus->setText (
+          ui->labOm0rxEntityStatus->fontMetrics ().elidedText (entity_summary, Qt::ElideRight, entity_width - 8));
+      ui->labOm0rxEntityStatus->setToolTip (QString {"%1 entity: %2"}.arg (display_call, entity_summary));
+    }
+
+  auto combined = QString {"%1 %2"}.arg (call_status, dxcc_status).toLower ();
+  QColor bg {88, 88, 88};
+  QColor fg {255, 255, 255};
+  if (combined.contains ("atno") || combined.contains ("new call"))
+    {
+      bg = QColor {225, 75, 0};
+      fg = QColor {255, 255, 255};
+    }
+  else if (combined.contains ("new band") || combined.contains ("new mode"))
+    {
+      bg = QColor {0, 100, 255};
+      fg = QColor {255, 255, 255};
+    }
+  else if (combined.contains ("worked"))
+    {
+      bg = QColor {110, 110, 110};
+      fg = QColor {255, 255, 0};
+    }
+  else if (combined.contains ("confirmed"))
+    {
+      bg = QColor {0, 130, 65};
+      fg = QColor {255, 255, 255};
+    }
+
+  ui->decodedTextBrowser->highlight_callsign (display_call, bg, fg, false);
+  ui->decodedTextBrowser2->highlight_callsign (display_call, bg, fg, false);
+  ui->decodedTextBrowser->annotate_callsign (display_call, QString {"%1 | %2"}.arg (call_status, dxcc_status), fg);
+  ui->decodedTextBrowser2->annotate_callsign (display_call, QString {"%1 | %2"}.arg (call_status, dxcc_status), fg);
+}

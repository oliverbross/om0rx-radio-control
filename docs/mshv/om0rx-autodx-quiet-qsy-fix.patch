+void AutoDxerCore::considerCallingMePreemption(const CachedDecode &decode)
+{
+    if (!m_enabled || !m_targetScorer || !decode.isLocalDecode
+            || decode.bandIndex != m_currentBandIndex) return;
+
+    const ScoredTarget caller = m_targetScorer->scoreTarget(decode);
+    if (!caller.isCallingMe || caller.callsign.isEmpty()) return;
+
+    if (m_currentTarget.isValid()
+            && callsignsMatch(caller.callsign, m_currentTarget.callsign)) return;
+
+    // Once reports are being exchanged, finish that QSO. The calling-me flag
+    // also protects a previously selected direct caller from being displaced
+    // by a second caller.
+    if (m_state == WaitingForQSO && m_currentTarget.isValid()
+            && (m_targetRespondedToUs || m_currentTarget.isCallingMe)) {
+        emit debugMessage(QString("CALLING-ME-DEFERRED: %1 while engaged with %2")
+                         .arg(caller.callsign).arg(m_currentTarget.callsign));
+        return;
+    }
+
+    if (m_state != Listening && m_state != WaitingForQSO) return;
+
+    if (m_currentTarget.isValid()) {
+        clearSuspendedTarget();
+        m_suspendedTarget.callsign = m_currentTarget.callsign;
+        m_suspendedTarget.grid = m_currentTarget.grid;
+        m_suspendedTarget.dxccEntity = m_currentTarget.dxccEntity;
+        m_suspendedTarget.bandIndex = m_currentTarget.bandIndex;
+        m_suspendedTarget.audioFrequency = m_currentTarget.audioFrequency;
+        m_suspendedTarget.dialFrequencyHz = m_currentTarget.dialFrequencyHz;
+        m_suspendedTarget.priority = m_currentTarget.priority;
+        m_suspendedTarget.snr = -15;
+        m_suspendedTarget.isLocalDecode = true;
+        m_suspendedTarget.isNewDXCC = m_currentTargetIsATNO;
+        m_suspendedTarget.isNewBandSlot = m_currentTargetIsNewSlot;
+        m_suspendedTarget.isNewGrid = m_currentTargetIsNewGrid;
+        m_suspendedTargetElapsedMs = currentTargetAttemptElapsedMs();
+        m_suspendedTargetIsATNO = m_currentTargetIsATNO;
+        m_suspendedTargetIsNewSlot = m_currentTargetIsNewSlot;
+        m_suspendedTargetIsNewGrid = m_currentTargetIsNewGrid;
+        emit debugMessage(QString("CALLING-ME-SUSPEND: %1 at %2 ms for %3")
+                         .arg(m_currentTarget.callsign)
+                         .arg(m_suspendedTargetElapsedMs)
+                         .arg(caller.callsign));
+    } else if (m_waitingForSlotAnalysis && m_pendingSlotAnalysisTarget.callsign.length() > 0) {
+        clearSuspendedTarget();
+        m_suspendedTarget = m_pendingSlotAnalysisTarget;
+        m_suspendedTargetElapsedMs = 0;
+        m_suspendedTargetIsATNO = m_pendingSlotAnalysisTarget.isNewDXCC;
+        m_suspendedTargetIsNewSlot = m_pendingSlotAnalysisTarget.isNewBandSlot;
+        m_suspendedTargetIsNewGrid = m_pendingSlotAnalysisTarget.isNewGrid;
+        m_waitingForSlotAnalysis = false;
+        m_pendingSlotAnalysisTarget = ScoredTarget();
+    }
+
+    emit requestDisableAuto();
+    if (m_queueWidget) m_queueWidget->clearBothLists();
+    m_currentTarget.clear();
+    m_targetRespondedToUs = false;
+    m_currentTargetIsATNO = false;
+    m_currentTargetIsNewSlot = false;
+    m_currentTargetIsNewGrid = false;
+    m_targetAttemptTimer.invalidate();
+    m_targetAttemptElapsedOffsetMs = 0;
+    setState(Listening);
+
+    feedToQueue(caller, true);
+    if (m_currentTarget.isValid() && m_currentTarget.isCallingMe) {
+        emit debugMessage(QString("CALLING-ME-PREEMPT: %1 selected immediately (score=%2)")
+                         .arg(caller.callsign).arg(caller.priority));
+    }
+}

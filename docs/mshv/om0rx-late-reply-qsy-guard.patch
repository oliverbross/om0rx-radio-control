+bool AutoDxerCore::lateReplyGuardActive() const
+{
+    return m_lateReplyGuardTimer && m_lateReplyGuardTimer->isActive();
+}
+
+bool AutoDxerCore::startLateReplyGuard(const QString &reason)
+{
+    if (!m_currentTarget.isValid() || m_targetRespondedToUs
+            || !m_lastLocalTransmissionUtc.isValid()) return false;
+
+    const qint64 elapsedMs = qMax<qint64>(0,
+        m_lastLocalTransmissionUtc.msecsTo(QDateTime::currentDateTimeUtc()));
+    if (elapsedMs >= LATE_REPLY_GUARD_MS) return false;
+
+    const bool newlyStarted = !lateReplyGuardActive();
+    m_lateReplyGuardCallsign = m_currentTarget.callsign;
+    m_lateReplyTerminalReason = reason;
+    emit requestDisableAuto();
+    if (m_autoOffReconcileTimer) m_autoOffReconcileTimer->stop();
+    m_autoOffPendingCallsign.clear();
+    m_lateReplyGuardTimer->start(
+        static_cast<int>(LATE_REPLY_GUARD_MS - elapsedMs));
+
+    if (newlyStarted) {
+        QJsonObject fields;
+        fields["call"] = m_lateReplyGuardCallsign;
+        fields["elapsed_since_tx_ms"] = static_cast<double>(elapsedMs);
+        fields["remaining_ms"] = m_lateReplyGuardTimer->remainingTime();
+        fields["receive_only"] = true;
+        auditEvent("late-reply-guard-started", fields);
+        emit debugMessage(QString("LATE-REPLY-GUARD: listening for %1 for %2 seconds after final TX")
+                          .arg(m_lateReplyGuardCallsign)
+                          .arg((m_lateReplyGuardTimer->remainingTime() + 999) / 1000));
+    }
+    return true;
+}
+
+void AutoDxerCore::clearLateReplyGuard()
+{
+    if (m_lateReplyGuardTimer) m_lateReplyGuardTimer->stop();
+    m_lateReplyGuardCallsign.clear();
+    m_lateReplyTerminalReason.clear();
+}
+
+void AutoDxerCore::finishLateReplyGuard()
+{
+    const QString callsign = m_lateReplyGuardCallsign;
+    const QString reason = m_lateReplyTerminalReason;
+    clearLateReplyGuard();
+
+    if (!m_enabled || m_state != WaitingForQSO
+            || !m_currentTarget.isValid()
+            || !callsignsMatch(callsign, m_currentTarget.callsign)
+            || m_targetRespondedToUs) return;
+
+    QJsonObject fields;
+    fields["call"] = callsign;
+    fields["guard_ms"] = LATE_REPLY_GUARD_MS;
+    auditEvent("late-reply-guard-complete", fields);
+    emit debugMessage(QString("LATE-REPLY-GUARD: no reply from %1 after final 60-second receive window")
+                      .arg(callsign));
+    terminalClearCurrentTarget(
+        reason.isEmpty() ? QString("late reply receive guard expired") : reason,
+        true);
+}

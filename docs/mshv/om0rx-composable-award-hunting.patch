index 0000000..e43f05b
--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/awardhuntingpolicy.h
@@ -0,0 +1,456 @@
+#ifndef AWARDHUNTINGPOLICY_H
+#define AWARDHUNTINGPOLICY_H
+
+#include <QDateTime>
+#include <QFile>
+#include <QHash>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QList>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+#include <algorithm>
+#include <climits>
+#include "awardadifpolicy.h"
+
+// Side-effect-free native policy helpers.  Every award dimension is additive;
+// disabling one program or assigning it a zero weight never disables another.
+struct AwardHuntingConfig
+{
+    bool enabled;
+    bool stackScores;
+    int newDxccWeight;
+    int newDxccBandWeight;
+    int unconfirmedDxccWeight;
+    int newContinentWeight;
+    int newCqZoneWeight;
+    int newItuZoneWeight;
+    int newGridWeight;
+
+    bool referenceEnabled;
+    bool potaEnabled;
+    bool sotaEnabled;
+    bool wwffEnabled;
+    int potaWeight;
+    int sotaWeight;
+    int wwffWeight;
+    int newReferenceWeight;
+    int newReferenceBandWeight;
+    int newReferenceBandModeWeight;
+    int maxActivationAgeSeconds;
+    bool requireLocalDecode;
+
+    int dxccWeightPercent;
+    int stateWeightPercent;
+    int zoneWeightPercent;
+    int gridWeightPercent;
+    int referenceWeightPercent;
+
+    AwardHuntingConfig()
+        : enabled(true), stackScores(true), newDxccWeight(10000),
+          newDxccBandWeight(1000), unconfirmedDxccWeight(8500),
+          newContinentWeight(2500), newCqZoneWeight(2200),
+          newItuZoneWeight(2000), newGridWeight(500),
+          referenceEnabled(true), potaEnabled(true), sotaEnabled(true),
+          wwffEnabled(true), potaWeight(1800), sotaWeight(1800),
+          wwffWeight(1400), newReferenceWeight(2500),
+          newReferenceBandWeight(1000), newReferenceBandModeWeight(500),
+          maxActivationAgeSeconds(900), requireLocalDecode(true),
+          dxccWeightPercent(100), stateWeightPercent(100),
+          zoneWeightPercent(100), gridWeightPercent(100),
+          referenceWeightPercent(100) {}
+
+    static int scaled(int value, int percent)
+    {
+        return qMax(0, value) * qBound(0, percent, 500) / 100;
+    }
+
+    bool programEnabled(const QString &program) const
+    {
+        const QString p = program.trimmed().toUpper();
+        return referenceEnabled && ((p == "POTA" && potaEnabled)
+            || (p == "SOTA" && sotaEnabled) || (p == "WWFF" && wwffEnabled));
+    }
+
+    int programWeight(const QString &program) const
+    {
+        const QString p = program.trimmed().toUpper();
+        if (p == "POTA") return potaWeight;
+        if (p == "SOTA") return sotaWeight;
+        if (p == "WWFF") return wwffWeight;
+        return 0;
+    }
+
+    void applyCampaignProfile(const QString &profile)
+    {
+        const QString p = profile.trimmed().toLower();
+        if (p == "custom") return;
+        dxccWeightPercent = 100;
+        stateWeightPercent = 100;
+        zoneWeightPercent = 100;
+        gridWeightPercent = 100;
+        referenceWeightPercent = 100;
+        if (p == "dxcc-challenge") {
+            dxccWeightPercent = 175; stateWeightPercent = 75;
+            gridWeightPercent = 75; referenceWeightPercent = 75;
+        } else if (p == "five-band-dxcc") {
+            dxccWeightPercent = 200; stateWeightPercent = 50;
+            zoneWeightPercent = 75; gridWeightPercent = 50;
+            referenceWeightPercent = 50;
+        } else if (p == "worked-all-states") {
+            dxccWeightPercent = 75; stateWeightPercent = 200;
+            zoneWeightPercent = 75; gridWeightPercent = 75;
+            referenceWeightPercent = 50;
+        } else if (p == "waz" || p == "itu-zones") {
+            dxccWeightPercent = 75; stateWeightPercent = 50;
+            zoneWeightPercent = 200; gridWeightPercent = 50;
+            referenceWeightPercent = 50;
+        } else if (p == "grids") {
+            dxccWeightPercent = 75; stateWeightPercent = 50;
+            zoneWeightPercent = 50; gridWeightPercent = 200;
+            referenceWeightPercent = 50;
+        } else if (p == "references") {
+            dxccWeightPercent = 75; stateWeightPercent = 50;
+            zoneWeightPercent = 50; gridWeightPercent = 50;
+            referenceWeightPercent = 200;
+        }
+    }
+};

+    int bestOpportunity = -1;
+    int bestActivity = -1;
+    const QList<int> enabled = m_bandManager->getEnabledBands();
+    for (int band : enabled) {
+        if (band == m_currentBandIndex || !m_bandManager->isBandOpenNow(band)) continue;
+
+        int opportunity = 0;
+        int activity = 0;
+        const QList<ExternalSpot> spots = m_spotAggregator->getSpots(band, 120);
+        for (const ExternalSpot &spot : spots) {
+            if (spot.source != "LOCAL" && !AutoDxRuntimeConfig::acceptsExternalMode(spot.mode)) continue;
+            ++activity;
+            if (!historicalActionAllowed(spot.callsign, false)) continue;
+            const ScoredTarget scored = m_targetScorer->scoreTarget(spotToCachedDecode(spot));
+            opportunity = qMax(opportunity, scored.priority);
+        }
+
+        if (opportunity > bestOpportunity
+                || (opportunity == bestOpportunity && activity > bestActivity)) {
+            bestBand = band;
+            bestOpportunity = opportunity;
+            bestActivity = activity;
+        }
+    }
+
+    // With no fresh activity evidence, keep deterministic round-robin behavior
+    // across only the bands that are enabled and currently inside schedule.
+    if (bestOpportunity <= 0 && bestActivity <= 0) {
+        int candidate = m_bandManager->getNextBand();
+        for (int attempts = 0; attempts < enabled.size(); ++attempts) {
+            if (candidate >= 0 && candidate != m_currentBandIndex
+                    && m_bandManager->isBandOpenNow(candidate)) return candidate;
+            candidate = m_bandManager->getNextBandAfter(candidate);
+        }
+    }
+    return bestBand;
+}
+
+bool AutoDxerCore::targetLocallyFresh(const QString &callsign, int bandIndex,
+                                      int maxAgeSeconds) const
+{
+    if (!m_decodeCache || bandIndex < 3) return false;
+    const QList<CachedDecode> decodes = m_decodeCache->getActiveDecodes(bandIndex, maxAgeSeconds);
+    for (const CachedDecode &decode : decodes) {
+        if (decode.isLocalDecode && callsignsMatch(decode.callsign, callsign)) return true;
+    }
+    return false;
+}
+
+bool AutoDxerCore::currentTargetPersistsWhileHeard() const
+{
+    return AutoDxTimingPolicy::noveltyPersists(
+        m_currentTargetIsATNO, m_currentTargetIsNewSlot, true,
+        m_persistNewDxccWhileHeard, m_persistNewBandSlotWhileHeard,
+        static_cast<int>(m_atnoChaseType));
+}
+
+void AutoDxerCore::abandonCurrentTarget(const QString &reason)
+{
+    if (m_currentTarget.isValid()) {
+        emit debugMessage(QString("TARGET-STOP: %1 (%2)")
+                         .arg(m_currentTarget.callsign).arg(reason));
+    }
+    emit requestDisableAuto();
+    if (m_queueWidget) m_queueWidget->clearBothLists();
+    m_currentTarget.clear();
+    m_targetRespondedToUs = false;
+    m_currentTargetIsATNO = false;
+    m_currentTargetIsNewSlot = false;
+    m_currentTargetIsNewGrid = false;
+    m_scarceTargetMode = false;
+    m_targetAttemptTimer.invalidate();
+    setState(Listening);
+    resetQuietBandTimer();
+    emit targetChanged(m_currentTarget);
+}
+
+void AutoDxerCore::resetQuietBandTimer()
+{
+    if (m_enabled && m_state == Listening && !m_currentTarget.isValid()
+            && !m_targetRespondedToUs && m_pendingCrossBandCallsign.isEmpty()
+            && m_pendingNonStdCallsign.isEmpty() && !m_waitingForSlotAnalysis) {
+        m_quietBandTimer.restart();
+    } else {
+        m_quietBandTimer.invalidate();
+    }
+}

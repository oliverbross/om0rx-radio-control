+void MainWindow::request_om0rx_qso_history_popup (QString const& callsign)
+{
+  auto call = callsign.trimmed ().toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  if (call.isEmpty () || call == m_config.my_callsign ().trimmed ().toUpper ())
+    {
+      return;
+    }
+  if (m_om0rx_history_inflight.contains (call))
+    {
+      return;
+    }
+  m_om0rx_history_inflight.insert (call);
+
+  auto encoded = QString::fromUtf8 (QUrl::toPercentEncoding (call));
+  QNetworkRequest request {
+      QUrl {QString {"http://127.0.0.1:8080/api/wsjtx/qso-history/%1?limit=20"}.arg (encoded)}};
+  auto reply = om0rxNetworkManager->get (request);
+  auto * timeout = new QTimer {reply};
+  timeout->setSingleShot (true);
+  connect (timeout, &QTimer::timeout, reply, &QNetworkReply::abort);
+  timeout->start (15000);
+  connect (reply, &QNetworkReply::finished, this, [this, reply, call] {
+    auto * timeout = reply->findChild<QTimer *> ();
+    if (timeout)
+      {
+        timeout->stop ();
+      }
+    m_om0rx_history_inflight.remove (call);
+    QJsonObject payload;
+    if (QNetworkReply::NoError == reply->error ())
+      {
+        payload = QJsonDocument::fromJson (reply->readAll ()).object ();
+      }
+    else
+      {
+        payload.insert ("success", false);
+        payload.insert ("detail", reply->errorString ());
+      }
+    reply->deleteLater ();
+    show_om0rx_qso_history_popup (call, payload);
+  });
+}

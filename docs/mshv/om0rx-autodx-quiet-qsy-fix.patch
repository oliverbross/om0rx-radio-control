+void HvTxW::SyncAutoDxerStatusTarget(QString callsign, QString grid, bool qsoEngaged,
+                                     bool reconcileIdleStartup)
+{
+    const AutoDxStatusOwnership::Decision decision =
+        m_autoDxStatusOwnership.targetChanged(callsign, grid, qsoEngaged,
+                                              le_his_call->getText(),
+                                              TRadioAndNetW->GetStatusDxCall(),
+                                              reconcileIdleStartup);
+    if (decision.action == AutoDxStatusOwnership::NoChange) return;
+
+    if (decision.action == AutoDxStatusOwnership::SetOwnedTarget) {
+        le_his_call->SetText(decision.callsign);
+        if (!decision.grid.isEmpty()) LeHisLoc->SetText(decision.grid);
+        SetDxParm(decision.callsign, le_rst_tx->getText(), decision.grid);
+        return;
+    }
+
+    if (le_his_call->getText().trimmed().compare(decision.callsign,
+                                                 Qt::CaseInsensitive) == 0) {
+        le_his_call->SetText("");
+    }
+    if (!decision.grid.isEmpty()
+            && LeHisLoc->getText().trimmed().compare(decision.grid,
+                                                     Qt::CaseInsensitive) == 0) {
+        LeHisLoc->SetText("");
+    }
+    // SetDxParm schedules the normal 150 ms WSJT-compatible Status update.
+    SetDxParm("", le_rst_tx->getText(), "");
+}

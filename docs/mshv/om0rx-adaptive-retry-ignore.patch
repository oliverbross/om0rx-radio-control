+QString AutoDxerCore::targetScopeKey(const QString &callsign, int bandIndex,
+                                     const QString &mode) const
+{
+    return QString("%1|%2|%3")
+        .arg(extractBaseCallsign(callsign).trimmed().toUpper())
+        .arg(bandIndex)
+        .arg(mode.trimmed().toUpper());
+}
+
+bool AutoDxerCore::isStationIgnored(const QString &callsign, int bandIndex,
+                                    const QString &mode) const
+{
+    if (callsign.trimmed().isEmpty() || bandIndex < 3) return false;
+    return m_ignoredStations.contains(targetScopeKey(callsign, bandIndex, mode));
+}
+
+QJsonArray AutoDxerCore::ignoredStations() const
+{
+    QList<QJsonObject> rows = m_ignoredStations.values();
+    std::sort(rows.begin(), rows.end(), [](const QJsonObject &a, const QJsonObject &b) {
+        const int bandA = a.value("band_index").toInt();
+        const int bandB = b.value("band_index").toInt();
+        if (bandA != bandB) return bandA < bandB;
+        const QString modeA = a.value("mode").toString();
+        const QString modeB = b.value("mode").toString();
+        if (modeA != modeB) return modeA < modeB;
+        return a.value("callsign").toString() < b.value("callsign").toString();
+    });
+    QJsonArray result;
+    for (const QJsonObject &row : rows) result.append(row);
+    return result;
+}
+
+QJsonArray AutoDxerCore::queuedOperatorCalls() const
+{
+    QJsonArray result;
+    for (int i = 0; i < m_operatorCallQueue.size(); ++i) {
+        const OperatorCallRequest &request = m_operatorCallQueue.at(i);
+        QJsonObject row;
+        row["key"] = operatorCallKey(request.target.callsign,
+                                      request.target.bandIndex, request.mode);
+        row["position"] = i + 1;
+        row["callsign"] = request.target.callsign;
+        row["band_index"] = request.target.bandIndex;
+        row["band"] = bandName(request.target.bandIndex);
+        row["mode"] = request.mode;
+        row["snr"] = request.target.snr;
+        row["queued_utc"] = request.queuedAt.toString(Qt::ISODateWithMs);
+        result.append(row);
+    }
+    return result;
+}
+
+void AutoDxerCore::loadIgnoredStations()
+{
+    m_ignoredStations.clear();
+    QFile file(m_settingsPath + "/database/autodx_ignore.json");
+    if (!file.exists()) return;
+    if (!file.open(QIODevice::ReadOnly)) {
+        emit debugMessage("IGNORE: unable to read persistent ignore list");
+        return;
+    }
+    const QJsonDocument document = QJsonDocument::fromJson(file.readAll());
+    if (!document.isObject()) {
+        emit debugMessage("IGNORE: malformed persistent ignore list ignored");
+        return;
+    }
+    const QJsonArray entries = document.object().value("entries").toArray();
+    for (const QJsonValue &value : entries) {
+        const QJsonObject row = value.toObject();
+        const QString call = row.value("callsign").toString().trimmed().toUpper();
+        const int band = row.value("band_index").toInt(-1);
+        const QString mode = row.value("mode").toString().trimmed().toUpper();
+        if (call.isEmpty() || band < 3 || (mode != "FT8" && mode != "FT4")) continue;
+        QJsonObject normalized = row;
+        normalized["callsign"] = extractBaseCallsign(call).toUpper();
+        normalized["band_index"] = band;
+        normalized["band"] = bandName(band);
+        normalized["mode"] = mode;
+        normalized["key"] = targetScopeKey(call, band, mode);
+        m_ignoredStations.insert(normalized.value("key").toString(), normalized);
+    }
+}
+
+bool AutoDxerCore::saveIgnoredStations() const
+{
+    QDir().mkpath(m_settingsPath + "/database");
+    QSaveFile file(m_settingsPath + "/database/autodx_ignore.json");
+    if (!file.open(QIODevice::WriteOnly)) return false;
+    QJsonObject root;
+    root["schema_version"] = 1;
+    root["entries"] = ignoredStations();
+    file.write(QJsonDocument(root).toJson(QJsonDocument::Indented));
+    return file.commit();
+}
+
+void AutoDxerCore::ignoreDecodedStation(QStringList decodeData)
+{
+    QString callsign, grid;
+    int snr = 0, freq = 0;
+    bool isCQ = false;
+    parseDecodeMessage(decodeData, callsign, grid, snr, freq, isCQ);
+    Q_UNUSED(grid);
+    Q_UNUSED(snr);
+    Q_UNUSED(freq);
+    Q_UNUSED(isCQ);
+    ignoreStation(callsign);
+}
+
+void AutoDxerCore::ignoreStation(QString callsign)
+{
+    callsign = extractBaseCallsign(callsign).trimmed().toUpper();
+    if (callsign.isEmpty() || callsign == m_myCallsign || m_currentBandIndex < 3)
+        return;
+    const QString key = targetScopeKey(callsign, m_currentBandIndex, m_currentMode);
+    QJsonObject row;
+    row["key"] = key;
+    row["callsign"] = callsign;
+    row["band_index"] = m_currentBandIndex;
+    row["band"] = bandName(m_currentBandIndex);
+    row["mode"] = m_currentMode;
+    row["added_utc"] = QDateTime::currentDateTimeUtc().toString(Qt::ISODateWithMs);
+    m_ignoredStations.insert(key, row);
+    if (!saveIgnoredStations()) {
+        m_ignoredStations.remove(key);
+        emit debugMessage(QString("IGNORE: failed to save %1").arg(callsign));
+        return;
+    }
+    emit debugMessage(QString("IGNORE: %1 excluded from Auto DX on %2/%3")
+                      .arg(callsign, bandName(m_currentBandIndex), m_currentMode));
+    emit ignoreListChanged();
+    const int queuedIndex = operatorCallIndex(key);
+    if (queuedIndex >= 0) {
+        m_operatorCallQueue.removeAt(queuedIndex);
+        emit operatorCallQueueChanged();
+    }
+    if (m_currentTarget.isValid()
+            && callsignsMatch(m_currentTarget.callsign, callsign)
+            && m_currentTarget.bandIndex == m_currentBandIndex) {
+        emit requestImmediateStopAndReset();
+        terminalClearCurrentTarget("operator ignored active station", false);
+    }
+}
+
+void AutoDxerCore::removeIgnoredStation(QString key)
+{
+    key = key.trimmed().toUpper();
+    if (!m_ignoredStations.contains(key)) return;
+    const QJsonObject removed = m_ignoredStations.take(key);
+    if (!saveIgnoredStations()) {
+        m_ignoredStations.insert(key, removed);
+        emit debugMessage("IGNORE: failed to persist removal");
+        return;
+    }
+    emit debugMessage(QString("IGNORE: %1 restored for Auto DX on %2/%3")
+                      .arg(removed.value("callsign").toString(),
+                           removed.value("band").toString(),
+                           removed.value("mode").toString()));
+    emit ignoreListChanged();
+}
+
+void AutoDxerCore::clearIgnoredStations()
+{
+    if (m_ignoredStations.isEmpty()) return;
+    const QHash<QString, QJsonObject> previous = m_ignoredStations;
+    m_ignoredStations.clear();
+    if (!saveIgnoredStations()) {
+        m_ignoredStations = previous;
+        emit debugMessage("IGNORE: failed to clear persistent list");
+        return;
+    }
+    emit debugMessage("IGNORE: all Auto DX station exclusions cleared");
+    emit ignoreListChanged();
+}

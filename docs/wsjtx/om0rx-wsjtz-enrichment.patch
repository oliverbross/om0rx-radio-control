+      for (auto column = 0; column < bands.size (); ++column)
+        {
+          auto cell = mode_matrix.value (bands.at (column)).toObject ();
+          auto confirmed = cell.value ("confirmed").toBool ();
+          auto worked = cell.value ("worked").toBool ();
+          auto * item = new QTableWidgetItem {confirmed ? QString {"C"} : worked ? QString {"W"} : QString {"-"}};
+          item->setTextAlignment (Qt::AlignCenter);

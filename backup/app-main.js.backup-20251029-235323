        // Remove special station from enabled list
        removeSpecial(special) {
            const idx = this.enabledSpecials.indexOf(special);
            if (idx > -1) {
                this.enabledSpecials.splice(idx, 1);
                console.log(`✅ Removed special: ${special}`);
            }

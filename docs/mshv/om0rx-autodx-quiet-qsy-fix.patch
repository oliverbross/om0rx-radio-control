diff --git a/MSHV_2762/src/HvAutoDxer/autodxstatusownership.h b/MSHV_2762/src/HvAutoDxer/autodxstatusownership.h
new file mode 100644
index 0000000..e95a7f0
--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/autodxstatusownership.h
@@ -0,0 +1,86 @@
+#ifndef AUTODXSTATUSOWNERSHIP_H
+#define AUTODXSTATUSOWNERSHIP_H
+
+#include <QString>
+
+// Keeps the legacy MSHV/WSJT-compatible DX-call cache in step with the
+// native AutoDX target without giving the cache any control over targeting.
+// The ownership marker prevents an AutoDX clear from erasing a manual QSO.
+class AutoDxStatusOwnership
+{
+public:
+    enum Action {
+        NoChange,
+        SetOwnedTarget,
+        ClearOwnedTarget
+    };
+
+    struct Decision {
+        Action action;
+        QString callsign;
+        QString grid;
+
+        Decision(Action nextAction = NoChange,
+                 const QString &nextCallsign = QString(),
+                 const QString &nextGrid = QString())
+            : action(nextAction), callsign(nextCallsign), grid(nextGrid) {}
+    };
+
+    Decision targetChanged(const QString &callsign, const QString &grid,
+                           bool qsoEngaged, const QString &legacyCall,
+                           const QString &statusCall,
+                           bool reconcileIdleStartup = false)
+    {
+        const QString nextCall = callsign.trimmed().toUpper();
+        const QString currentLegacy = legacyCall.trimmed().toUpper();
+        const QString currentStatus = statusCall.trimmed().toUpper();
+
+        if (!nextCall.isEmpty()) {
+            // targetChanged(non-empty) is the authoritative native ownership
+            // transition. An already engaged exchange remains untouchable.
+            if (qsoEngaged) return Decision();
+            m_ownedCall = nextCall;
+            m_ownedGrid = grid.trimmed().toUpper();
+            return Decision(SetOwnedTarget, m_ownedCall, m_ownedGrid);
+        }
+
+        if (qsoEngaged) return Decision();
+
+        // The in-memory ownership marker intentionally does not survive a
+        // process restart. During the single explicit startup reconciliation,
+        // an enabled native AutoDX core with no target may therefore retire a
+        // persisted legacy/status pair. Requiring both caches to contain the
+        // same call keeps an independently changed manual/foreign field safe;
+        // ordinary empty-target notifications remain ownership-neutral.
+        if (m_ownedCall.isEmpty()) {
+            if (reconcileIdleStartup && !currentLegacy.isEmpty()
+                    && currentLegacy == currentStatus) {
+                return Decision(ClearOwnedTarget, currentLegacy, QString());
+            }
+            return Decision();
+        }
+
+        // Clear only if both observable caches are still empty or still show
+        // the exact target that AutoDX claimed. A manual replacement wins.
+        const bool legacyStillOwned = currentLegacy.isEmpty() || currentLegacy == m_ownedCall;
+        const bool statusStillOwned = currentStatus.isEmpty() || currentStatus == m_ownedCall;
+        if (!legacyStillOwned || !statusStillOwned) {
+            m_ownedCall.clear();
+            m_ownedGrid.clear();
+            return Decision();
+        }
+
+        const Decision clear(ClearOwnedTarget, m_ownedCall, m_ownedGrid);
+        m_ownedCall.clear();
+        m_ownedGrid.clear();
+        return clear;
+    }
+
+    QString ownedCall() const { return m_ownedCall; }
+
+private:
+    QString m_ownedCall;
+    QString m_ownedGrid;
+};
+
+#endif // AUTODXSTATUSOWNERSHIP_H

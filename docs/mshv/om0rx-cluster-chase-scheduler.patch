+
+bool HvDxccTracker::isCqZoneConfirmed(int zone) const
+{
+    if (!m_confirmationDataAvailable || zone <= 0) return false;
+    for (int entity : m_confirmedDxcc)
+        if (m_entityById.value(entity).cqZone == zone) return true;
+    return false;
+}
+
+bool HvDxccTracker::isItuZoneConfirmed(int zone) const
+{
+    if (!m_confirmationDataAvailable || zone <= 0) return false;
+    for (int entity : m_confirmedDxcc)
+        if (m_entityById.value(entity).ituZone == zone) return true;
+    return false;
+}
+
+bool HvDxccTracker::isContinentWorked(const QString& continent, int bandIndex) const
+{
+    const QString wanted = continent.trimmed().toUpper();
+    for (const QString &worked : m_workedDxccByBand) {
+        const QStringList parts = worked.split('_');
+        if (parts.size() != 2 || parts.at(1).toInt() != bandIndex) continue;
+        if (m_entityById.value(parts.at(0).toInt()).continent.toUpper() == wanted) return true;
+    }
+    return false;
+}
+
+bool HvDxccTracker::isContinentWorkedAllTime(const QString& continent) const
+{
+    const QString wanted = continent.trimmed().toUpper();
+    for (const QString &worked : m_workedDxccAllTime) {
+        if (m_entityById.value(worked.toInt()).continent.toUpper() == wanted) return true;
+    }
+    return false;
+}
+
+bool HvDxccTracker::isCqZoneWorked(int zone, int bandIndex) const
+{
+    for (const QString &worked : m_workedDxccByBand) {
+        const QStringList parts = worked.split('_');
+        if (parts.size() == 2 && parts.at(1).toInt() == bandIndex
+                && m_entityById.value(parts.at(0).toInt()).cqZone == zone) return true;
+    }
+    return false;
+}
+
+bool HvDxccTracker::isCqZoneWorkedAllTime(int zone) const
+{
+    for (const QString &worked : m_workedDxccAllTime) {
+        if (m_entityById.value(worked.toInt()).cqZone == zone) return true;
+    }
+    return false;
+}
+
+bool HvDxccTracker::isItuZoneWorked(int zone, int bandIndex) const
+{
+    for (const QString &worked : m_workedDxccByBand) {
+        const QStringList parts = worked.split('_');
+        if (parts.size() == 2 && parts.at(1).toInt() == bandIndex
+                && m_entityById.value(parts.at(0).toInt()).ituZone == zone) return true;
+    }
+    return false;
+}

+
+class AwardActivationIndex
+{
+public:
+    AwardActivationIndex() : m_schemaValid(false), m_historyAuthoritative(false), m_entryCount(0) {}
+
+    bool load(const QString &path)
+    {
+        m_byCall.clear();
+        m_schemaValid = false;
+        m_historyAuthoritative = false;
+        m_entryCount = 0;
+        QFile file(path);
+        if (!file.open(QIODevice::ReadOnly)) return false;
+        QJsonParseError error;
+        const QJsonDocument doc = QJsonDocument::fromJson(file.readAll(), &error);
+        if (error.error != QJsonParseError::NoError || !doc.isObject()) return false;
+        const QJsonObject root = doc.object();
+        if (root.value("schema").toInt() != 1 || !root.value("activations").isArray())
+            return false;
+        m_historyAuthoritative = root.value("history_authoritative").toBool(false);
+        const QJsonArray rows = root.value("activations").toArray();
+        for (const QJsonValue &value : rows) {
+            if (!value.isObject()) continue;
+            const QJsonObject row = value.toObject();
+            AwardActivation a;
+            a.callsign = baseCallsign(row.value("callsign").toString());
+            a.program = row.value("program").toString().trimmed().toUpper();
+            a.reference = row.value("reference").toString().trimmed().toUpper();
+            a.band = row.value("band").toString().trimmed().toLower();
+            a.mode = row.value("mode").toString().trimmed().toUpper();
+            a.frequencyHz = row.value("frequency_hz").toInt();
+            a.spottedAtUtc = parseUtc(row.value("spotted_at_utc").toString());
+            a.expiresAtUtc = parseUtc(row.value("expires_at_utc").toString());
+            a.sourceId = row.value("source_id").toString().trimmed();
+            a.confidence = row.value("confidence").toDouble();
+            a.slotKey = row.value("slot_key").toString().trimmed().toUpper();
+            a.historyStatus = row.value("history_status").toString().trimmed().toLower();
+            const QJsonObject gaps = row.value("gaps").toObject();
+            a.newReference = gaps.value("new_reference").toBool();
+            a.newReferenceOnBand = gaps.value("new_reference_on_band").toBool();
+            a.newReferenceOnBandMode = gaps.value("new_reference_on_band_mode").toBool();
+            if (a.callsign.isEmpty() || a.reference.isEmpty()
+                    || (a.program != "POTA" && a.program != "SOTA" && a.program != "WWFF"))
+                continue;
+            if (a.slotKey.isEmpty())
+                a.slotKey = a.program + ":" + a.reference + "@" + a.band + "@" + a.mode;
+            m_byCall.insert(a.callsign, a);
+            ++m_entryCount;
+        }
+        m_schemaValid = true;
+        return true;
+    }
+
+    AwardReferenceScore score(const QString &callsign, const QString &band,
+                              const QString &mode, bool localDecode,
+                              const QDateTime &nowUtc,
+                              const AwardHuntingConfig &config) const
+    {
+        AwardReferenceScore result;
+        if (!config.enabled || !config.referenceEnabled || !m_historyAuthoritative) return result;
+        QList<AwardActivation> rows = m_byCall.values(baseCallsign(callsign));
+        std::sort(rows.begin(), rows.end(), [](const AwardActivation &left,
+                                               const AwardActivation &right) {
+            if (left.program != right.program) return left.program < right.program;
+            if (left.reference != right.reference) return left.reference < right.reference;
+            if (left.slotKey != right.slotKey) return left.slotKey < right.slotKey;
+            if (left.sourceId != right.sourceId) return left.sourceId < right.sourceId;
+            if (left.spottedAtUtc != right.spottedAtUtc)
+                return left.spottedAtUtc < right.spottedAtUtc;
+            return left.confidence > right.confidence;
+        });
+        QSet<QString> seenSlots;
+        qint64 stackedScore = 0;
+        QStringList programs, references, slotKeys;
+        for (const AwardActivation &a : rows) {
+            if (!config.programEnabled(a.program)) continue;
+            if (a.historyStatus != "authoritative") continue;
+            if (!a.newReference && !a.newReferenceOnBand && !a.newReferenceOnBandMode) continue;
+            if (config.requireLocalDecode && !localDecode) continue;
+            if (!a.band.isEmpty() && a.band != band.trimmed().toLower()) continue;
+            if (!a.mode.isEmpty() && a.mode != mode.trimmed().toUpper()) continue;
+            if (a.spottedAtUtc.isValid()
+                    && a.spottedAtUtc.secsTo(nowUtc) > config.maxActivationAgeSeconds) continue;
+            if (a.expiresAtUtc.isValid() && a.expiresAtUtc < nowUtc) continue;
+            if (seenSlots.contains(a.slotKey)) continue;
+            seenSlots.insert(a.slotKey);
+            int score = config.programWeight(a.program);
+            QStringList reasons;
+            reasons << a.program + " " + a.reference;
+            if (a.newReference) {
+                score += config.newReferenceWeight;
+                reasons << "new reference";
+            }
+            if (a.newReferenceOnBand) {
+                score += config.newReferenceBandWeight;
+                reasons << "new reference band";
+            }
+            if (a.newReferenceOnBandMode) {
+                score += config.newReferenceBandModeWeight;
+                reasons << "new reference band/mode";
+            }
+            score = AwardHuntingConfig::scaled(score, config.referenceWeightPercent);
+            if (score <= 0) continue;
+            if (!config.stackScores && score <= result.score) continue;
+            if (config.stackScores) {
+                stackedScore = qMin<qint64>(INT_MAX, stackedScore + score);
+                result.score = static_cast<int>(stackedScore);
+                if (!programs.contains(a.program)) programs << a.program;
+                references << a.reference;
+                slotKeys << a.slotKey;
+                result.reasons.append(reasons);
+                AwardReferenceMatch match;
+                match.program = a.program;
+                match.reference = a.reference;
+                match.slotKey = a.slotKey;
+                result.matches << match;
+            } else {
+                result.score = score;
+                programs = QStringList() << a.program;
+                references = QStringList() << a.reference;
+                slotKeys = QStringList() << a.slotKey;
+                result.reasons = reasons;
+                result.matches.clear();
+                AwardReferenceMatch match;
+                match.program = a.program;
+                match.reference = a.reference;
+                match.slotKey = a.slotKey;
+                result.matches << match;
+            }
+            result.eligible = true;
+        }
+        result.program = programs.join("+");
+        result.reference = references.join(",");
+        result.slotKey = slotKeys.join(",");
+        return result;
+    }
+
+    bool schemaValid() const { return m_schemaValid; }
+    bool historyAuthoritative() const { return m_historyAuthoritative; }
+    int entryCount() const { return m_entryCount; }
+
+    static QString baseCallsign(const QString &call)
+    {
+        const QString normalized = call.trimmed().toUpper();
+        const QStringList parts = normalized.split('/', Qt::SkipEmptyParts);
+        QString best;
+        for (const QString &part : parts) {
+            bool hasLetter = false, hasDigit = false;
+            for (const QChar &ch : part) {
+                hasLetter = hasLetter || ch.isLetter();
+                hasDigit = hasDigit || ch.isDigit();
+            }
+            if (hasLetter && hasDigit && part.size() > best.size()) best = part;
+        }
+        return best.isEmpty() ? normalized : best;
+    }
+
+private:
+    static QDateTime parseUtc(const QString &value)
+    {
+        QDateTime parsed = QDateTime::fromString(value, Qt::ISODateWithMs);
+        if (!parsed.isValid()) parsed = QDateTime::fromString(value, Qt::ISODate);
+        return parsed.isValid() ? parsed.toUTC() : QDateTime();
+    }
+
+    QMultiHash<QString, AwardActivation> m_byCall;
+    bool m_schemaValid;
+    bool m_historyAuthoritative;
+    int m_entryCount;
+};

+void AutoDxerPanel::refreshIgnoreList()
+{
+    if (!m_ignoreList) return;
+    m_ignoreList->clear();
+    const QJsonArray entries = m_core->ignoredStations();
+    for (const QJsonValue &value : entries) {
+        const QJsonObject row = value.toObject();
+        QListWidgetItem *item = new QListWidgetItem(QString("%1  %2  %3")
+            .arg(row.value("callsign").toString(), -12)
+            .arg(row.value("band").toString(), -5)
+            .arg(row.value("mode").toString()));
+        item->setData(Qt::UserRole, row.value("key").toString());
+        item->setToolTip(QString("Added %1")
+            .arg(row.value("added_utc").toString()));
+        m_ignoreList->addItem(item);
+    }
+    if (entries.isEmpty()) {
+        QListWidgetItem *empty = new QListWidgetItem("No ignored stations");
+        empty->setFlags(empty->flags() & ~Qt::ItemIsSelectable);
+        m_ignoreList->addItem(empty);
+    }
+}
+
+void AutoDxerPanel::removeSelectedIgnore()
+{
+    QListWidgetItem *item = m_ignoreList ? m_ignoreList->currentItem() : nullptr;
+    if (!item) return;
+    const QString key = item->data(Qt::UserRole).toString();
+    if (!key.isEmpty()) m_core->removeIgnoredStation(key);
+}
+
+void AutoDxerPanel::clearIgnoreList()
+{
+    if (m_core->ignoredStations().isEmpty()) return;
+    if (QMessageBox::question(this, "Clear Ignore List",
+            "Remove every per-band/per-mode Auto DX exclusion?",
+            QMessageBox::Yes | QMessageBox::No, QMessageBox::No) == QMessageBox::Yes)
+        m_core->clearIgnoredStations();
+}
+
+void AutoDxerPanel::refreshCallerList()
+{
+    if (!m_callerList) return;
+    m_callerList->clear();
+    const QJsonArray entries = m_core->queuedOperatorCalls();
+    for (const QJsonValue &value : entries) {
+        const QJsonObject row = value.toObject();
+        QListWidgetItem *item = new QListWidgetItem(QString("%1. %2  %3  %4")
+            .arg(row.value("position").toInt(), 2)
+            .arg(row.value("callsign").toString(), -12)
+            .arg(row.value("band").toString(), -5)
+            .arg(row.value("mode").toString()));
+        item->setData(Qt::UserRole, row.value("key").toString());
+        item->setToolTip(QString("Queued %1, SNR %2 dB")
+            .arg(row.value("queued_utc").toString())
+            .arg(row.value("snr").toInt()));
+        m_callerList->addItem(item);
+    }
+    if (entries.isEmpty()) {
+        QListWidgetItem *empty = new QListWidgetItem("No operator-queued callers");
+        empty->setFlags(empty->flags() & ~Qt::ItemIsSelectable);
+        m_callerList->addItem(empty);
+    }
+}
+
+void AutoDxerPanel::removeSelectedCaller()

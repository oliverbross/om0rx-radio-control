+void DecodeList::InsertBandSeparator(QString band)
+{
+    const QString normalized = band.trimmed();
+    if (normalized.isEmpty()) return;
+
+    const QString label = QString("----------------  %1  |  %2 UTC  ----------------")
+        .arg(normalized, QDateTime::currentDateTimeUtc().toString("yyyy-MM-dd HH:mm:ss"));
+    QList<QStandardItem*> row;
+    const int columns = qMax(1, model.columnCount());
+    for (int column = 0; column < columns; ++column) {
+        QStandardItem *item = new QStandardItem(column == 0 ? label : QString());
+        item->setEditable(false);
+        item->setSelectable(false);
+        item->setBackground(QBrush(QColor(37, 76, 120)));
+        item->setForeground(QBrush(Qt::white));
+        QFont markerFont = item->font();
+        markerFont.setBold(true);
+        item->setFont(markerFont);
+        if (column == 0) item->setTextAlignment(Qt::AlignCenter);
+        row << item;
+    }
+    const int rowIndex = model.rowCount();
+    model.appendRow(row);
+    setFirstColumnSpanned(rowIndex, QModelIndex(), true);
+    scrollToBottom();
+}

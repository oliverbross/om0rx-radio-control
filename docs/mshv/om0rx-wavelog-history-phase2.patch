+        QTimeEdit *start = new QTimeEdit(QTime(18, 0));
+        QTimeEdit *end = new QTimeEdit(QTime(6, 0));
+        start->setDisplayFormat("HH:mm");
+        end->setDisplayFormat("HH:mm");
+        schedules->addWidget(new QLabel(names.at(row)), row + 1, 0);
+        schedules->addWidget(restricted, row + 1, 1, Qt::AlignCenter);
+        schedules->addWidget(start, row + 1, 2);
+        schedules->addWidget(end, row + 1, 3);
+        m_bandScheduleRestricted.insert(band, restricted);
+        m_bandScheduleStart.insert(band, start);
+        m_bandScheduleEnd.insert(band, end);
+        connect(restricted, &QCheckBox::toggled, start, &QWidget::setEnabled);
+        connect(restricted, &QCheckBox::toggled, end, &QWidget::setEnabled);
+    }
+    layout->addLayout(schedules);
+}

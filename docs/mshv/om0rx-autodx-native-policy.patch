+AutoDxEligibilityFacts DxccTracker::eligibilityFacts(const QString &callsign,
+                                                      const QString &grid,
+                                                      int bandIndex) const
+{
+    AutoDxEligibilityFacts facts;
+    if (!m_hvDxccTracker) return facts;
+    DxccEntity entity;
+    if (!m_hvDxccTracker->lookupDxcc(callsign, entity)) return facts;
+    facts.continent = entity.continent.toUpper();
+    facts.newCall = !m_hvDxccTracker->isCallWorkedAllTime(callsign);
+    facts.bandCall = !m_hvDxccTracker->isCallWorked(callsign, bandIndex, "FT8");
+    facts.newDxcc = !m_hvDxccTracker->isDxccWorkedAllTime(entity.entityNumber);
+    facts.bandDxcc = !m_hvDxccTracker->isDxccWorked(entity.entityNumber, bandIndex);
+    facts.newContinent = !m_hvDxccTracker->isContinentWorkedAllTime(entity.continent);
+    facts.bandContinent = !m_hvDxccTracker->isContinentWorked(entity.continent, bandIndex);
+    facts.newGrid = grid.length() >= 4 && m_hvDxccTracker->isNewGridAllTime(grid);
+    facts.bandGrid = grid.length() >= 4 && m_hvDxccTracker->isNewGrid(grid, bandIndex);
+    facts.newCqZone = entity.cqZone > 0 && !m_hvDxccTracker->isCqZoneWorkedAllTime(entity.cqZone);
+    facts.bandCqZone = entity.cqZone > 0 && !m_hvDxccTracker->isCqZoneWorked(entity.cqZone, bandIndex);
+    facts.newItuZone = entity.ituZone > 0 && !m_hvDxccTracker->isItuZoneWorkedAllTime(entity.ituZone);
+    facts.bandItuZone = entity.ituZone > 0 && !m_hvDxccTracker->isItuZoneWorked(entity.ituZone, bandIndex);
+    return facts;
+}

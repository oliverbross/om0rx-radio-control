+QSet<int> AutoDxerCore::openPatrolBands() const
+{
+    QSet<int> result;
+    if (!m_bandManager) return result;
+    if (!m_bandSwitchingEnabled) {
+        if (m_bandManager->isBandOpenNow(m_currentBandIndex))
+            result.insert(m_currentBandIndex);
+        return result;
+    }
+    const QList<int> enabled = m_bandManager->getEnabledBands();
+    for (int band : enabled) {
+        if (m_bandManager->isBandOpenNow(band)) result.insert(band);
+    }
+    return result;
+}
+
+bool AutoDxerCore::priorityPatrolComplete() const
+{
+    const QSet<int> openBands = openPatrolBands();
+    if (openBands.isEmpty()) return false;
+    // A band that opened since the last scheduler refresh has not been
+    // checked in this schedule window, even if its identifier remains from
+    // an older cycle.
+    for (int band : openBands) {
+        if (!m_priorityPatrolOpenBands.contains(band)) return false;
+    }
+    for (int band : openBands) {
+        if (!m_priorityPatrolCheckedBands.contains(band)) return false;
+    }
+    return true;
+}
+
+bool AutoDxerCore::hasEligiblePriorityOpportunity() const
+{
+    // checkCrossBandAlerts() populates this queue only after all history,
+    // schedule, mode, source-confidence, duplicate and scope gates pass.
+    // Any row therefore outranks ordinary new-call fallback; DXpeditions are
+    // included and retain their configured score boost.
+    return !m_clusterChaseQueue.isEmpty() || hasEligibleDxpeditionOpportunity();
+}
+
+bool AutoDxerCore::hasEligibleDxpeditionOpportunity() const
+{
+    if (!m_dxpeditionChaseEnabled || !m_spotAggregator || !m_bandManager) return false;
+    const QList<int> enabled = m_bandManager->getEnabledBands();
+    for (int band : enabled) {
+        if (!m_bandManager->isBandOpenNow(band)) continue;
+        const QList<ExternalSpot> spots = m_spotAggregator->getSpots(
+            band, m_dxpeditionMaxSpotAgeSeconds);
+        for (const ExternalSpot &spot : spots) {
+            if (!isDxpeditionTarget(spot.callsign, band)) continue;
+            if (!historicalActionAllowed(spot.callsign, false)) continue;
+            if (spot.source != "LOCAL"
+                    && (!AutoDxRuntimeConfig::acceptsExternalMode(spot.mode)
+                        || spot.mode.trimmed().compare(
+                            m_currentMode, Qt::CaseInsensitive) != 0)) continue;
+            if (spot.spotterCount < qMax(m_clusterChaseMinSpotters,
+                                         m_dxpeditionMinSpotters)) continue;
+            const bool otherwiseNeeded = m_dxccTracker
+                && (m_dxccTracker->isNewDXCCByCall(spot.callsign)
+                    || m_dxccTracker->isNewBandSlotByCall(spot.callsign, band));
+            if (dxpeditionScopeAdmits(spot.callsign, band, otherwiseNeeded)) return true;
+        }
+    }
+    return false;
+}
+
+bool AutoDxerCore::ordinaryNewCallFallbackAllowed() const
+{
+    return priorityPatrolComplete() && !hasEligiblePriorityOpportunity();
+}
+
+void AutoDxerCore::resetPriorityPatrolCycle()
+{
+    m_priorityPatrolCheckedBands.clear();
+    m_priorityPatrolOpenBands = openPatrolBands();
+}
+
+void AutoDxerCore::refreshPriorityPatrolSchedule()
+{
+    const QSet<int> openBands = openPatrolBands();
+    bool newlyOpened = false;
+    for (int band : openBands) {
+        if (!m_priorityPatrolOpenBands.contains(band)) {
+            newlyOpened = true;
+            break;
+        }
+    }
+    if (newlyOpened) m_priorityPatrolCheckedBands.clear();
+    m_priorityPatrolCheckedBands.intersect(openBands);
+    m_priorityPatrolOpenBands = openBands;
+}
+
+void AutoDxerCore::markPriorityPatrolBandChecked(int bandIndex)
+{
+    if (bandIndex < 0) return;
+    const QSet<int> openBands = openPatrolBands();
+    if (openBands.contains(bandIndex)) m_priorityPatrolCheckedBands.insert(bandIndex);
+    // Schedules can change while a patrol is in progress. Keep telemetry and
+    // completion semantics limited to the bands that are open now.
+    m_priorityPatrolCheckedBands.intersect(openBands);
+}

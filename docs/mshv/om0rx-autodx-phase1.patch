+bool AutoDxerCore::isConfiguredMode(const QString &mode) const
+{
+    return m_autoDxModes.contains(mode.trimmed().toUpper());
+}
+
+void AutoDxerCore::setCurrentMode(const QString &mode)
+{
+    const QString normalized = mode.trimmed().toUpper();
+    m_currentMode = normalized;
+    setEnabled(m_desiredEnabled);
+}
+
+void AutoDxerCore::loadRuntimeConfig(const QString &settingsPath)
+{
+    const AutoDxRuntimeConfig config = AutoDxRuntimeConfig::load(settingsPath);
+    m_desiredEnabled = config.desiredEnabled;
+    m_autoDxModes = config.modes;
+    m_bandSwitchingEnabled = config.bandSwitchingEnabled;
+    m_scarceTargetThreshold = config.scarceThreshold;
+    m_atnoChaseType = static_cast<ATNOChaseType>(config.atnoChaseType);
+    m_bandManager->loadSettings(settingsPath);
+
+    m_targetScorer->setTargetWeights(config.newDxccWeight, config.newBandSlotWeight, config.newGridWeight,
+                                     config.callingMeWeight, config.cqWeight, config.snrWeight);
+    m_targetScorer->setPriorityDXCC(config.newDxccWeight > 0);
+    m_targetScorer->setPriorityBandSlot(config.newBandSlotWeight > 0);
+    m_targetScorer->setPriorityGrid(config.gridChaseEnabled && config.newGridWeight > 0);
+    m_targetScorer->setUSGridOnly(config.gridUsOnly);
+    m_targetScorer->setMinSNR(config.minSnr);
+
+    if (!config.callsign.isEmpty()) setCallsign(config.callsign);
+    if (!config.grid.isEmpty()) {
+        setMyGrid(config.grid);
+        m_spotAggregator->setGrid(config.grid);
+    }
+
+    m_runtimeRbnEnabled = config.rbnEnabled;
+    m_runtimePskrEnabled = config.pskrEnabled;
+    m_runtimeDxClusterEnabled = config.dxClusterEnabled;
+    m_runtimeUsOnly = config.usOnly;
+    m_runtimeUseDefaultServers = config.useDefaultServers;
+    m_runtimeCustomServers = config.customServers;
+    m_spotAggregator->setRBNEnabled(m_runtimeRbnEnabled);
+    m_spotAggregator->setRBNHost(config.rbnHost);
+    m_spotAggregator->setRBNPort(config.rbnPort);
+    m_spotAggregator->setPSKREnabled(m_runtimePskrEnabled);
+    m_spotAggregator->setPSKRPollInterval(config.pskrPollInterval);
+    m_spotAggregator->setDxClusterEnabled(m_runtimeDxClusterEnabled);
+    m_spotAggregator->setUSOnly(m_runtimeUsOnly);
+    m_spotAggregator->setUseDefaultServers(m_runtimeUseDefaultServers);
+
+    m_runtimeDxClusterServerCount = 0;
+    if (!m_runtimeUseDefaultServers) {
+        m_spotAggregator->clearDxClusterServers();
+        for (const QString &server : config.customServers) {
+            const QStringList parts = server.split("|");
+            if (parts.size() < 4 || parts.at(3).trimmed().toLower() != "true") continue;
+            bool validPort = false;
+            const int port = parts.at(2).toInt(&validPort);
+            if (!validPort || port < 1 || port > 65535 || parts.at(1).trimmed().isEmpty()) continue;
+            m_spotAggregator->dxClusterClient()->addServer(
+                ClusterServer(parts.at(0).trimmed(), parts.at(1).trimmed(), port));
+            ++m_runtimeDxClusterServerCount;
+        }
+    } else {
+        m_runtimeDxClusterServerCount = m_spotAggregator->dxClusterClient()->totalServerCount();
+    }
+
+    emit debugMessage(QString("AUTODX-RUNTIME-CONFIG: modes=%1 bands=%2 switch=%3 RBN=%4 PSKR=%5 DXC=%6 USOnly=%7")
+                      .arg(m_autoDxModes.join(","))
+                      .arg(m_bandManager->getEnabledBands().size())
+                      .arg(m_bandSwitchingEnabled ? "on" : "off")
+                      .arg(m_runtimeRbnEnabled ? "on" : "off")
+                      .arg(m_runtimePskrEnabled ? "on" : "off")
+                      .arg(m_runtimeDxClusterEnabled ? "on" : "off")
+                      .arg(m_runtimeUsOnly ? "on" : "off"));
+}
+
+QJsonObject AutoDxerCore::runtimeConfigStatus() const
+{
+    QJsonArray modes;
+    for (const QString &mode : m_autoDxModes) modes.append(mode);
+    QJsonArray bands;
+    if (m_bandManager) {
+        for (int band : m_bandManager->getEnabledBands()) bands.append(band);
+    }
+    QJsonObject rbn;
+    rbn["enabled"] = m_runtimeRbnEnabled;
+    rbn["host"] = m_spotAggregator ? m_spotAggregator->rbnHost() : QString();
+    rbn["port"] = m_spotAggregator ? m_spotAggregator->rbnPort() : 0;
+    QJsonObject pskr;
+    pskr["enabled"] = m_runtimePskrEnabled;
+    pskr["poll_interval_seconds"] = m_spotAggregator ? m_spotAggregator->pskrPollInterval() : 0;
+    QJsonObject cluster;
+    cluster["enabled"] = m_runtimeDxClusterEnabled;
+    cluster["use_default_servers"] = m_runtimeUseDefaultServers;
+    cluster["server_count"] = m_runtimeDxClusterServerCount;
+    QJsonArray servers;
+    for (const QString &encoded : m_runtimeCustomServers) {
+        const QStringList parts = encoded.split("|");
+        if (parts.size() < 4) continue;
+        QJsonObject server;
+        server["name"] = parts.at(0).trimmed();
+        server["host"] = parts.at(1).trimmed();
+        server["port"] = parts.at(2).toInt();
+        server["enabled"] = parts.at(3).trimmed().compare("true", Qt::CaseInsensitive) == 0;
+        servers.append(server);
+    }
+    cluster["servers"] = servers;
+    QJsonObject sources;
+    sources["rbn"] = rbn;
+    sources["psk_reporter"] = pskr;
+    sources["dx_cluster"] = cluster;
+    sources["us_only"] = m_runtimeUsOnly;
+    sources["us_only_semantics"] = "preferred_with_rare_dx_exceptions";
+    QJsonObject priority;
+    priority["new_dxcc"] = m_targetScorer->newDxccWeight();
+    priority["new_band_slot"] = m_targetScorer->newBandSlotWeight();
+    priority["new_grid"] = m_targetScorer->newGridWeight();
+    priority["calling_me"] = m_targetScorer->callingMeWeight();
+    priority["cq"] = m_targetScorer->cqWeight();
+    priority["snr_per_db"] = m_targetScorer->snrWeight();
+    QJsonObject eligibility;
+    eligibility["new_dxcc"] = m_targetScorer->priorityDXCCEnabled();
+    eligibility["new_band_slot"] = m_targetScorer->priorityBandSlotEnabled();
+    eligibility["new_grid"] = m_targetScorer->priorityGridEnabled();
+    eligibility["calling_me"] = m_targetScorer->callingMeWeight() > 0;
+    eligibility["random_worked_calls"] = false;
+    QJsonObject result;
+    result["schema_version"] = 1;
+    result["desired_enabled"] = m_desiredEnabled;
+    result["effective_enabled"] = m_enabled;
+    result["current_mode"] = m_currentMode;
+    result["mode_allowed"] = isConfiguredMode(m_currentMode);
+    result["auto_dx_modes"] = modes;
+    result["band_switching_enabled"] = m_bandSwitchingEnabled;
+    result["enabled_bands"] = bands;
+    result["callsign"] = m_myCallsign;
+    result["grid"] = m_myGrid;
+    result["min_snr"] = m_targetScorer->minSNR();
+    result["grid_chase_enabled"] = m_targetScorer->priorityGridEnabled();
+    result["grid_chase_us_only"] = m_targetScorer->isUSGridOnly();
+    result["target_priority"] = priority;
+    result["eligibility"] = eligibility;
+    result["atno_chase_type"] = static_cast<int>(m_atnoChaseType);
+    result["scarce_threshold"] = m_scarceTargetThreshold;
+    result["spot_sources"] = sources;
+    return result;
+}

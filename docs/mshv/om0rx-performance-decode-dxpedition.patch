+bool AutoDxerCore::dxpeditionScopeAdmits(const QString &callsign, int bandIndex,
+                                         bool otherwiseNeeded) const
+{
+    if (otherwiseNeeded) return true;
+    if (!m_dxpeditionChaseEnabled || !m_dxpeditionChaseAnyActive
+            || !isCataloguedDxpedition(callsign, bandIndex)
+            || !m_historicalNoveltyAllowed || !m_dxccTracker) return false;
+    // "Any active" is bounded by Wavelog's call/band novelty.  It broadens
+    // DXCC need, but never knowingly repeats the same expedition on a band.
+    return m_dxccTracker->eligibilityFacts(callsign, QString(), bandIndex).bandCall;
+}

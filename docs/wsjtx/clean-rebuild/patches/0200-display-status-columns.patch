+
+void MainWindow::request_om0rx_decode_status (double freq_hz, QString const& callsign,
+                                              bool is_cq, int time_sec, QString const& decode_band,
+                                              QString const& grid, QString const& message, int snr)
+{
+  Q_UNUSED (is_cq);
+  Q_UNUSED (time_sec);
+  auto call = callsign.trimmed ().toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  if (call.isEmpty ()) return;
+
+  auto band = decode_band.trimmed ().toLower ();
+  if (band.isEmpty ()) band = m_currentBand.trimmed ().toLower ();
+  if (band.isEmpty ()) band = ui->bandComboBox->currentText ().trimmed ().toLower ();
+  auto mode = m_mode.trimmed ().toUpper ();
+  auto cache_key = QString {"%1|%2|%3"}.arg (call, band, mode);
+  if (m_om0rx_status_cache.contains (cache_key))
+    {
+      auto values = m_om0rx_status_cache.value (cache_key).split ('|');
+      apply_om0rx_decode_status (call, band, mode, values.value (0, "Unknown"),
+                                 values.value (1, "Unknown"));
+      return;
+    }
+  if (m_om0rx_status_inflight.contains (cache_key)) return;
+  m_om0rx_status_inflight.insert (cache_key);
+
+  QJsonObject payload;
+  payload.insert ("call", call);
+  payload.insert ("band", band);
+  payload.insert ("mode", mode);
+  payload.insert ("frequency_hz", static_cast<double> (m_freqNominal));
+  payload.insert ("audioOffset", static_cast<int> (freq_hz));
+  payload.insert ("grid", grid.trimmed ().toUpper ());
+  payload.insert ("message", message.trimmed ());
+  payload.insert ("snr", snr);
+
+  QNetworkRequest request {QUrl {"http://127.0.0.1:8765/api/wsjtx/decode-status"}};
+  request.setHeader (QNetworkRequest::ContentTypeHeader, "application/json");
+  auto * reply = networkManager->post (request, QJsonDocument {payload}.toJson (QJsonDocument::Compact));
+  auto * timeout = new QTimer {reply};
+  timeout->setSingleShot (true);
+  connect (timeout, &QTimer::timeout, reply, &QNetworkReply::abort);
+  timeout->start (5000);
+  connect (reply, &QNetworkReply::finished, this,
+           [this, reply, call, band, mode, cache_key] {
+    if (auto * timeout = reply->findChild<QTimer *> ()) timeout->stop ();
+    m_om0rx_status_inflight.remove (cache_key);
+    QString call_status {"Unknown"};
+    QString dxcc_status {"Unknown"};
+    if (QNetworkReply::NoError == reply->error ())
+      {
+        auto status = QJsonDocument::fromJson (reply->readAll ()).object ();
+        if (status.value ("success").toBool ())
+          {
+            call_status = status.value ("call_status").toString ("Unknown");
+            dxcc_status = status.value ("dxcc_status").toString ("Unknown");
+            if (m_om0rx_status_cache.size () >= 4096) m_om0rx_status_cache.clear ();
+            m_om0rx_status_cache.insert (cache_key, call_status + "|" + dxcc_status);
+          }
+      }
+    else if (m_zdebug)
+      {
+        log ("OM0RX decode-status unavailable for " + call + ": " + reply->errorString ());
+      }
+    apply_om0rx_decode_status (call, band, mode, call_status, dxcc_status);
+    reply->deleteLater ();
+  });
+}

+void MainWindow::om0rx_remember_priority_hunt(QString const& call, QString const& grid,
+                                              int report, int freq, bool tx_first,
+                                              int rank, int score, QString const& band,
+                                              QString const& mode, QString const& status)
+{
+  auto normalized_call = om0rx_normalized_call (call);
+  if (normalized_call.isEmpty () || rank < 6200)
+    {
+      return;
+    }
+
+  if (m_om0rxPriorityHuntPending && score < m_om0rxPriorityHuntScore)
+    {
+      return;
+    }
+
+  m_om0rxPriorityHuntPending = true;
+  m_om0rxPriorityHuntCall = normalized_call;
+  m_om0rxPriorityHuntGrid = grid;
+  m_om0rxPriorityHuntBand = band;
+  m_om0rxPriorityHuntMode = mode;
+  m_om0rxPriorityHuntStatus = status;
+  m_om0rxPriorityHuntScore = score;
+  m_om0rxPriorityHuntRank = rank;
+  m_om0rxPriorityHuntFreq = freq;
+  m_om0rxPriorityHuntReport = report;
+  m_om0rxPriorityHuntTxFirst = tx_first;
+
+  if (m_zdebug)
+    {
+      log ("OM0RX priority hunt pending: " + m_om0rxPriorityHuntCall
+           + " rank=" + QString::number (rank)
+           + " score=" + QString::number (score)
+           + " status=" + status);
+    }
+}
+
+bool MainWindow::om0rx_try_start_priority_hunt()
+{
+  if (!m_om0rxPriorityHuntPending)
+    {
+      return false;
+    }
+
+  if (!ui->cbAutoCall->isChecked () || ui->autoButton->isChecked ()
+      || m_transmitting || CALLING != m_QSOProgress)
+    {
+      return false;
+    }
+
+  auto const dx_entry = om0rx_normalized_call (ui->dxCallEntry->text ());
+  if (!dx_entry.isEmpty () && dx_entry != m_om0rxPriorityHuntCall)
+    {
+      return false;
+    }
+
+  auto const active_call = om0rx_normalized_call (m_hisCall);
+  auto const last_logged = om0rx_normalized_call (m_lastCall);
+  if (!active_call.isEmpty () && active_call != m_om0rxPriorityHuntCall
+      && active_call != last_logged)
+    {
+      return false;
+    }
+
+  m_om0rxPriorityHuntPending = false;
+  m_om0rxPriorityHuntActive = true;
+  m_idleMinutes = 0;
+  update_watchdog_label ();
+
+  m_priorityCall = m_om0rxPriorityHuntCall;
+  m_priorityCallPreferCQTarget = false;
+  m_nextCall = m_om0rxPriorityHuntCall;
+  m_nextGrid = m_om0rxPriorityHuntGrid;
+  dxLookup (m_nextCall, m_nextGrid);
+  ui->rptSpinBox->setValue (m_om0rxPriorityHuntReport);
+  ui->txFirstCheckBox->setChecked (m_om0rxPriorityHuntTxFirst);
+  ui->RxFreqSpinBox->setValue (m_om0rxPriorityHuntFreq);
+  if (!ui->cbHoldTxFreq->isChecked ())
+    {
+      ui->TxFreqSpinBox->setValue (m_om0rxPriorityHuntFreq);
+    }
+
+  tx_watchdog (false);
+  useNextCall ();
+  on_txb1_clicked ();
+  auto_tx_mode (true);
+  ui->cb_autoCallNext->setChecked (false);
+  if (m_config.highlightDX ())
+    {
+      ui->decodedTextBrowser->highlight_callsign (m_om0rxPriorityHuntCall,
+                                                  QColor (255, 0, 0),
+                                                  QColor (255, 255, 255), true);
+    }
+
+  if (m_zdebug)
+    {
+      log ("OM0RX priority hunt started: " + m_om0rxPriorityHuntCall
+           + " watchdog=20m status=" + m_om0rxPriorityHuntStatus);
+    }
+  return true;
+}
+
+void MainWindow::om0rx_clear_priority_hunt(QString const& reason)
+{
+  if (m_om0rxPriorityHuntPending || m_om0rxPriorityHuntActive)
+    {
+      if (m_zdebug)
+        {
+          log ("OM0RX priority hunt cleared: " + reason
+               + " call=" + m_om0rxPriorityHuntCall);
+        }
+    }
+
+  m_om0rxPriorityHuntPending = false;
+  m_om0rxPriorityHuntActive = false;
+  m_om0rxPriorityHuntCall.clear ();
+  m_om0rxPriorityHuntGrid.clear ();
+  m_om0rxPriorityHuntBand.clear ();
+  m_om0rxPriorityHuntMode.clear ();
+  m_om0rxPriorityHuntStatus.clear ();
+  m_om0rxPriorityHuntScore = -1;
+  m_om0rxPriorityHuntRank = -1;
+  m_om0rxPriorityHuntFreq = 0;
+  m_om0rxPriorityHuntReport = 0;
+  m_om0rxPriorityHuntTxFirst = false;
+  update_watchdog_label ();
+}

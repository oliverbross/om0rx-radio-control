+void DecodeList::SaveFtHeaderState() const
+{
+    if (!m_ftHeaderStateRestored || !(s_mode == 11 || s_mode == 13 || allq65)) return;
+    QSettings settings(QCoreApplication::applicationDirPath() + "/settings/autodx.ini", QSettings::IniFormat);
+    settings.setValue(QString("UI/DecodeHeader%1").arg(s_list_ident), THvHeader->saveState().toBase64());
+    settings.sync();
+}

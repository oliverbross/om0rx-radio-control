+void DecodeList::ac_ignore_autodx()
+{
+    const QModelIndex index = selectionModel()->currentIndex();
+    if (!index.isValid()) return;
+    QStandardItem *message = model.item(index.row(), FT_MESSAGE_COLUMN);
+    if (!message) return;
+    QString callsign = message->data(CALLSIGN_ROLE).toString().trimmed().toUpper();
+    if (callsign.isEmpty()) callsign = FindHisCall(message->text()).trimmed().toUpper();
+    if (!callsign.isEmpty()) {
+        emit RequestAutoDxIgnoreCall(callsign);
+        return;

diff --git a/MSHV_2762/src/HvAutoDxer/awardadifpolicy.h b/MSHV_2762/src/HvAutoDxer/awardadifpolicy.h
new file mode 100644
index 0000000..0330227
--- /dev/null
+++ b/MSHV_2762/src/HvAutoDxer/awardadifpolicy.h
@@ -0,0 +1,127 @@
+#ifndef AWARDADIFPOLICY_H
+#define AWARDADIFPOLICY_H
+
+#include <QList>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+#include <algorithm>
+
+struct AwardReferenceMatch
+{
+    QString program;
+    QString reference;
+    QString slotKey;
+};
+
+class AwardAdifPolicy
+{
+public:
+    static QString baseCallsign(const QString &call)
+    {
+        const QString normalized = call.trimmed().toUpper();
+        const QStringList parts = normalized.split('/', Qt::SkipEmptyParts);
+        QString best;
+        for (const QString &part : parts) {
+            bool hasLetter = false, hasDigit = false;
+            for (const QChar &ch : part) {
+                hasLetter = hasLetter || ch.isLetter();
+                hasDigit = hasDigit || ch.isDigit();
+            }
+            if (hasLetter && hasDigit && part.size() > best.size()) best = part;
+        }
+        return best.isEmpty() ? normalized : best;
+    }
+
+    static QList<AwardReferenceMatch> normalized(
+        const QList<AwardReferenceMatch> &matches)
+    {
+        QList<AwardReferenceMatch> result;
+        QSet<QString> seen;
+        for (AwardReferenceMatch match : matches) {
+            match.program = match.program.trimmed().toUpper();
+            match.reference = cleanValue(match.reference).toUpper();
+            match.slotKey = match.slotKey.trimmed().toUpper();
+            if ((match.program != "POTA" && match.program != "SOTA"
+                    && match.program != "WWFF") || match.reference.isEmpty()) continue;
+            const QString key = match.program + "\t" + match.reference;
+            if (seen.contains(key)) continue;
+            seen.insert(key);
+            result << match;
+        }
+        std::sort(result.begin(), result.end(), [](const AwardReferenceMatch &left,
+                                                   const AwardReferenceMatch &right) {
+            if (left.program != right.program) return left.program < right.program;
+            if (left.reference != right.reference) return left.reference < right.reference;
+            return left.slotKey < right.slotKey;
+        });
+        return result;
+    }
+
+    static QString encodeProgramReferences(
+        const QList<AwardReferenceMatch> &matches, const QString &program)
+    {
+        QStringList values;
+        const QString wanted = program.trimmed().toUpper();
+        for (const AwardReferenceMatch &match : normalized(matches))
+            if (match.program == wanted) values << match.reference;
+        return values.join('|');
+    }
+
+    static QList<AwardReferenceMatch> fromProgramColumns(
+        const QString &pota, const QString &sota, const QString &wwff)
+    {
+        QList<AwardReferenceMatch> matches;
+        appendColumn(matches, "POTA", pota);
+        appendColumn(matches, "SOTA", sota);
+        appendColumn(matches, "WWFF", wwff);
+        return normalized(matches);
+    }
+
+    static QString adifFields(const QList<AwardReferenceMatch> &matches)
+    {
+        const QList<AwardReferenceMatch> refs = normalized(matches);
+        QString out;
+        for (const AwardReferenceMatch &match : refs) {
+            const QString field = match.program + "_REF";
+            out += '<' + field + ':' + QString::number(match.reference.size())
+                + '>' + match.reference;
+        }
+        // SIG/SIG_INFO is unambiguous only for a single matched reference.
+        // Multi-program QSOs retain every reference in its standard named
+        // field instead of flattening unrelated programs into one value.
+        if (refs.size() == 1) {
+            out += "<SIG:" + QString::number(refs.first().program.size())
+                + ">" + refs.first().program;
+            out += "<SIG_INFO:" + QString::number(refs.first().reference.size())
+                + ">" + refs.first().reference;
+        }
+        return out;
+    }
+
+private:
+    static QString cleanValue(QString value)
+    {
+        value.remove('<');
+        value.remove('>');
+        value.remove('\r');
+        value.remove('\n');
+        value.remove(';');
+        value.remove('|');
+        return value.trimmed();
+    }
+
+    static void appendColumn(QList<AwardReferenceMatch> &matches,
+                             const QString &program, const QString &column)
+    {
+        const QStringList refs = column.split('|', Qt::SkipEmptyParts);
+        for (const QString &reference : refs) {
+            AwardReferenceMatch match;
+            match.program = program;
+            match.reference = reference;
+            matches << match;
+        }
+    }
+};
+
+#endif // AWARDADIFPOLICY_H

+        auto panel = automation.value ("reason_panel").toObject ();
+        if (!panel.isEmpty ())
+          {
+            panel_state = panel.value ("state").toString ();
+            detail << QString {"State: %1"}.arg (panel_state);
+            auto target = panel.value ("target").toObject ();
+            auto target_call = target.value ("call").toString ();
+            if (!target_call.isEmpty ())
+              {
+                backend_has_active_target = true;
+                detail << QString {"Target: %1 %2 %3 score %4"}.arg (
+                    target_call,
+                    target.value ("band").toString (),
+                    target.value ("mode").toString (),
+                    QString::number (target.value ("score").toInt ()));
+              }
+            backend_eligible_count = panel.value ("eligibility").toObject ().value ("eligible").toInt ();
+            auto why_selected = panel.value ("why_selected").toString ();
+            if (!why_selected.isEmpty ())
+              {
+                detail << QString {"Why selected: %1"}.arg (why_selected);
+              }
+            auto why_not_tx = panel.value ("why_not_tx_now");
+            if (why_not_tx.isString () && !why_not_tx.toString ().isEmpty ())
+              {
+                detail << QString {"Why not TX: %1"}.arg (why_not_tx.toString ());
+              }
+            else if (why_not_tx.isArray ())
+              {
+                QStringList reasons;
+                for (auto const& value: why_not_tx.toArray ())
+                  {
+                    reasons << value.toString ();
+                  }
+                if (!reasons.isEmpty ())
+                  {
+                    detail << QString {"Why not TX: %1"}.arg (reasons.join (", "));
+                  }
+              }
+            auto rejected = panel.value ("eligibility").toObject ().value ("rejected").toObject ();
+            if (!rejected.isEmpty ())
+              {
+                QStringList counts;
+                for (auto const& key: rejected.keys ())
+                  {
+                    counts << QString {"%1=%2"}.arg (key).arg (rejected.value (key).toInt ());
+                  }
+                detail << QString {"Rejected: %1"}.arg (counts.join (", "));
+              }
+          }
+        m_om0rx_backend_has_active_target = backend_has_active_target;
+        m_om0rx_backend_eligible_count = backend_eligible_count;
+        m_om0rx_backend_panel_state = panel_state;
+        m_om0rx_backend_reason = reason;
+        m_om0rx_last_backend_planner_at = QDateTime::currentDateTimeUtc ();
+        if (!backend_has_active_target
+            && backend_eligible_count == 0
+            && (reason == "no-eligible-target" || panel_state == "idle"))
+          {
+            if (!m_om0rx_no_eligible_since.isValid ())
+              {
+                m_om0rx_no_eligible_since = m_om0rx_last_backend_planner_at;
+              }
+          }
+        else
+          {
+            m_om0rx_no_eligible_since = QDateTime {};
+          }
+        if (!backend_has_active_target
+            && (ui->cbOm0rxAutoCall->isChecked () || ui->cbOm0rxAutoCQ->isChecked ())
+            && !m_transmitting
+            && !m_tune
+            && !ui->dxCallEntry->text ().trimmed ().isEmpty ()
+            && (panel_state.isEmpty ()
+                || panel_state == "idle"
+                || panel_state == "aborted"
+                || panel_state == "failed"
+                || panel_state == "completed"))
+          {
+            clear_om0rx_target_state ();
+          }
+        if (!detail.isEmpty ())
+          {
+            tooltip_text = text + QString {"\n\n%1"}.arg (detail.join ("\n"));
+          }
+      }
+    else
+      {
+        text = status_code >= 200 && status_code < 300 ? "OM0RX policy ok" : QString {"OM0RX HTTP %1"}.arg (status_code);
+      }
+    auto label_width = ui->labOm0rxAutomation->width ();
+    if (label_width < 80)
+      {
+        label_width = 360;
+      }
+    if (tooltip_text.isEmpty ())
+      {
+        tooltip_text = text;
+      }
+    ui->labOm0rxAutomation->setText (ui->labOm0rxAutomation->fontMetrics ().elidedText (text, Qt::ElideRight, label_width - 8));
+    ui->labOm0rxAutomation->setToolTip (tooltip_text);
+    reply->deleteLater ();
+  });
+
+  if (auto_call || auto_cq)
+    {
+      if (!m_om0rx_automation_timer.isActive ())
+        {
+          m_om0rx_automation_timer.start ();
+        }
+    }
+  else
+    {
+      m_om0rx_automation_timer.stop ();
+    }
+}
+
+void MainWindow::pulse_om0rx_automation ()
+{
+  send_om0rx_automation_policy (true);
+}
+
+void MainWindow::request_om0rx_decode_status (double freq_hz, QString const& callsign,
+                                              bool, int,
+                                              QString const& grid, QString const& message,
+                                              int snr)
+{
+  auto call = callsign.trimmed ().toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  if (call.isEmpty ())
+    {
+      return;
+    }
+  auto active_call = ui->dxCallEntry->text ().trimmed ().toUpper ();
+  active_call.remove ('<');
+  active_call.remove ('>');
+  auto active_base = Radio::base_callsign (active_call).toUpper ();
+  auto status_base = Radio::base_callsign (call).toUpper ();
+  auto status_is_active_qso = active_call == call
+      || (!active_base.isEmpty () && active_base == status_base);
+  auto band = m_currentBand.trimmed ();
+  auto mode = m_mode.trimmed ().toUpper ();
+  auto cache_key = QString {"%1|%2|%3"}.arg (call, band, mode);
+  if (m_om0rx_status_cache.contains (cache_key))
+    {
+      auto parts = m_om0rx_status_cache.value (cache_key).split ('|');
+      QJsonObject cached;
+      if (parts.size () >= 3)
+        {
+          cached.insert ("call_status", parts.value (0));
+          cached.insert ("dxcc_status", parts.value (1));
+          cached.insert ("country", parts.value (2));
+          if (parts.size () >= 6)
+            {
+              cached.insert ("dxcc_tag", parts.value (3));
+              cached.insert ("cq_zone", parts.value (4));
+              cached.insert ("itu_zone", parts.value (5));
+            }
+      QTimer::singleShot (0, this, [this, call, cached] {
+        apply_om0rx_decode_status (call, cached);
+      });
+    }
+    }
+  QTimer::singleShot (0, this, [this, call] {
+    ui->decodedTextBrowser->annotate_callsign (call, QString {"Checking | Checking"}, QColor {});
+    ui->decodedTextBrowser2->annotate_callsign (call, QString {"Checking | Checking"}, QColor {});
+  });
+  if (m_om0rx_status_inflight.contains (cache_key))
+    {
+      return;
+    }
+  if (status_is_active_qso)
+    {
+      set_om0rx_active_status_pending (call);
+    }
+  m_om0rx_status_inflight.insert (cache_key);
+
+  QJsonObject payload;
+  payload.insert ("call", call);
+  payload.insert ("band", band);
+  payload.insert ("mode", mode);
+  payload.insert ("frequency_hz", static_cast<double> (m_freqNominal));
+  payload.insert ("audioOffset", static_cast<int> (freq_hz));
+  payload.insert ("grid", grid.trimmed ().toUpper ());
+  payload.insert ("message", message.trimmed ());
+  payload.insert ("snr", snr);
+
+  QNetworkRequest request {QUrl {"http://127.0.0.1:8080/api/wsjtx/decode-status"}};
+  request.setHeader (QNetworkRequest::ContentTypeHeader, "application/json");
+  auto reply = m_network_manager.post (request, QJsonDocument {payload}.toJson (QJsonDocument::Compact));
+  connect (reply, &QNetworkReply::finished, this, [this, reply, call, cache_key] {
+    m_om0rx_status_inflight.remove (cache_key);
+    if (QNetworkReply::NoError == reply->error ())
+      {
+        auto doc = QJsonDocument::fromJson (reply->readAll ());
+        auto status = doc.object ();
+        if (status.value ("success").toBool ())
+          {
+            auto call_status = status.value ("call_status").toString ("Unknown");
+            auto dxcc_status = status.value ("dxcc_status").toString ("Unknown");
+            auto country = status.value ("country").toString ();
+            auto dxcc_tag = status.value ("dxcc_tag").toString ();
+            auto cq_zone = status.value ("cq_zone").toString ();
+            auto itu_zone = status.value ("itu_zone").toString ();
+            m_om0rx_status_cache.insert (
+                cache_key,
+                QString {"%1|%2|%3|%4|%5|%6"}.arg (
+                    call_status, dxcc_status, country, dxcc_tag, cq_zone, itu_zone));
+            QTimer::singleShot (0, this, [this, call, status] {
+              apply_om0rx_decode_status (call, status);
+            });
+          }
+      }
+    reply->deleteLater ();
+  });
+}
+
+void MainWindow::request_om0rx_qso_history_popup (QString const& callsign)
+{
+  if (!ui->cbOm0rxQsoPopup->isChecked ())
+    {
+      return;
+    }
+
+  auto call = callsign.trimmed ().toUpper ();
+  call.remove ('<');
+  call.remove ('>');
+  if (call.isEmpty () || call == m_config.my_callsign ().trimmed ().toUpper ())
+    {
+      return;
+    }
+  if (m_om0rx_history_inflight.contains (call))
+    {
+      return;
+    }
+  m_om0rx_history_inflight.insert (call);
+
+  auto encoded = QString::fromUtf8 (QUrl::toPercentEncoding (call));
+  QNetworkRequest request {
+      QUrl {QString {"http://127.0.0.1:8080/api/wavelog-log/search/%1?station_id=1&limit=20"}.arg (encoded)}};
+  auto reply = m_network_manager.get (request);
+  connect (reply, &QNetworkReply::finished, this, [this, reply, call] {
+    m_om0rx_history_inflight.remove (call);
+    QJsonObject payload;
+    if (QNetworkReply::NoError == reply->error ())
+      {
+        payload = QJsonDocument::fromJson (reply->readAll ()).object ();
+      }
+    else
+      {
+        payload.insert ("success", false);
+        payload.insert ("detail", reply->errorString ());
+      }
+    reply->deleteLater ();
+    show_om0rx_qso_history_popup (call, payload);
+  });
+}

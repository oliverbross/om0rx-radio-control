+void AutoDxerCore::reloadDxpeditionWatch(bool force)
+{
+    const QString path = m_settingsPath + "/database/dxpedition_watch.json";
+    const QFileInfo info(path);
+    const QDateTime now = QDateTime::currentDateTimeUtc();
+    const QDateTime mtime = info.exists() ? info.lastModified().toUTC() : QDateTime();
+    const qint64 size = info.exists() ? info.size() : -1;
+    const bool fingerprintChanged = mtime != m_dxpeditionWatchMtime
+        || size != m_dxpeditionWatchSize;
+    if (!force && !fingerprintChanged && m_dxpeditionCatalogValid
+            && now < m_dxpeditionCatalogExpiresAt) return;
+
+    QSet<QString> callBandKeys;
+    bool valid = false;
+    QDateTime expiresAt;
+    QFile watchFile(path);
+    if (watchFile.open(QIODevice::ReadOnly)) {
+        QJsonParseError parseError;
+        const QJsonDocument document = QJsonDocument::fromJson(watchFile.readAll(), &parseError);
+        const QJsonObject watch = document.object();
+        const QDateTime generated = QDateTime::fromString(
+            watch.value("generated_at_utc").toString(), Qt::ISODate).toUTC();
+        const int maxAge = qBound(
+            300, watch.value("watch_max_age_seconds").toInt(86400), 172800);
+        expiresAt = generated.addSecs(maxAge);
+        valid = parseError.error == QJsonParseError::NoError
+            && document.isObject() && watch.value("schema").toInt() == 1
+            && generated.isValid() && generated <= now && now <= expiresAt;
+        if (valid) {
+            for (const QJsonValue &value : watch.value("entries").toArray()) {
+                const QJsonObject entry = value.toObject();
+                if (entry.value("status").toString().toUpper() != "ACTIVE") continue;
+                const QJsonArray modes = entry.value("modes").toArray();
+                bool ft8Allowed = modes.isEmpty();
+                for (const QJsonValue &mode : modes) {
+                    if (mode.toString().compare("FT8", Qt::CaseInsensitive) == 0)
+                        ft8Allowed = true;
+                }
+                if (!ft8Allowed) continue;
+                const QDateTime start = QDateTime::fromString(
+                    entry.value("start_utc").toString(), Qt::ISODate).toUTC();
+                const QDateTime end = QDateTime::fromString(
+                    entry.value("end_utc").toString(), Qt::ISODate).toUTC();
+                if ((start.isValid() && start > now) || (end.isValid() && end < now)) continue;
+                QSet<int> bands;
+                for (const QJsonValue &bandValue : entry.value("bands").toArray()) {
+                    const QString wanted = bandValue.toString().trimmed().toLower();
+                    for (int band = 3; band <= 14; ++band) {
+                        if (band != 13 && m_bandManager
+                                && m_bandManager->bandName(band).toLower() == wanted)
+                            bands.insert(band);
+                    }
+                }
+                QStringList aliases;
+                aliases << entry.value("callsign").toString();
+                for (const QJsonValue &alias : entry.value("aliases").toArray())
+                    aliases << alias.toString();
+                for (const QString &alias : aliases) {
+                    const QString base = extractBaseCallsign(alias).toUpper();
+                    if (base.isEmpty()) continue;
+                    if (bands.isEmpty()) callBandKeys.insert(base + "@*");
+                    else for (int band : bands)
+                        callBandKeys.insert(base + "@" + QString::number(band));
+                }
+            }
+        }
+    }
+
+    const bool validityChanged = valid != m_dxpeditionCatalogValid;
+    m_dxpeditionWatchMtime = mtime;
+    m_dxpeditionWatchSize = size;
+    m_dxpeditionCatalogValid = valid;
+    m_dxpeditionCatalogExpiresAt = valid ? expiresAt : QDateTime();
+    m_dxpeditionCatalogEntries = valid ? callBandKeys.size() : 0;
+    if (m_targetScorer)
+        m_targetScorer->setDxpeditionWatch(
+            valid ? callBandKeys : QSet<QString>(), m_dxpeditionBoost);
+    if (force || fingerprintChanged || validityChanged) {
+        QJsonObject fields;
+        fields["valid"] = valid;
+        fields["alias_band_keys"] = m_dxpeditionCatalogEntries;
+        fields["mtime_utc"] = mtime.isValid() ? mtime.toString(Qt::ISODateWithMs) : QString();
+        fields["expires_utc"] = m_dxpeditionCatalogExpiresAt.isValid()
+            ? m_dxpeditionCatalogExpiresAt.toString(Qt::ISODateWithMs) : QString();
+        auditEvent("dxpedition-catalog-reload", fields);
+    }
 }
 

+int AutoDxerCore::scheduleAdaptiveRetry(const QString &callsign, int bandIndex,
+                                        const QString &mode)
+{
+    const QString key = targetScopeKey(callsign, bandIndex, mode);
+    const int burst = m_unansweredBurstCounts.value(key, 0) + 1;
+    m_unansweredBurstCounts.insert(key, burst);
+    static const int delays[] = { 180, 600, 1800, 3600 };
+    const int seconds = delays[qMin(burst - 1, 3)];
+    m_lastStoppedCall = callsign;
+    m_lastRetryAt = QDateTime::currentDateTimeUtc().addSecs(seconds);
+    m_targetRetryAfter.insert(key, m_lastRetryAt);
+    return seconds;
+}
+
+void AutoDxerCore::clearAdaptiveRetry(const QString &callsign, int bandIndex,
+                                      const QString &mode)
+{
+    const QString key = targetScopeKey(callsign, bandIndex, mode);
+    m_unansweredBurstCounts.remove(key);
+    m_targetRetryAfter.remove(key);
+}

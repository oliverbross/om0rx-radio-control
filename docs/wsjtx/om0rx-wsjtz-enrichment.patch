+void MainWindow::record_tx_start ()
+{
+  if (m_transmitting)
+    {
+      return;
+    }
+
+  auto const qso_in_progress = CALLING != m_QSOProgress;
+  m_transmitting = true;
+  auto const current_message = m_currentMessage.trimmed ();
+  if (watchdog () && m_mode!="WSPR" && m_mode!="FST4W"
+      && current_message != m_msgSent0)
+    {
+      tx_watchdog (false);
+      m_msgSent0 = current_message;
+    }
+
+  if (m_mode != "FST4W" && m_mode != "WSPR" && m_mode != "Echo")
+    {
+      if (!m_tune) write_all ("Tx", m_currentMessage);
+      if (m_config.TX_messages () && !m_tune && SpecOp::FOX != m_specOp)
+        {
+          ui->decodedTextBrowser2->displayTransmittedText (
+              current_message, m_mode, ui->TxFreqSpinBox->value (),
+              m_bFastMode, m_TRperiod, m_config.superFox ());
+          if (m_zdebug) log ("TX message: " + current_message);
+        }
+    }
+
+  switch (m_ntx)
+    {
+    case 1: m_QSOProgress = REPLYING; break;
+    case 2: m_QSOProgress = REPORT; break;
+    case 3: m_QSOProgress = ROGER_REPORT; break;
+    case 4: m_QSOProgress = ROGERS; break;
+    case 5: m_QSOProgress = SIGNOFF; break;
+    case 6: m_QSOProgress = CALLING; break;
+    default: break;
+    }
+
+  m_sentFirst73 = m_pendingTxFirst73;
+  if (m_pendingTxIs73)
+    {
+      m_final73TxGuard = true;
+      m_qsoStop = QDateTime::currentDateTimeUtc ().toString ("hhmm");
+      if (m_config.id_after_73 ()) icw[0] = m_ncw;
+      m_final73LogPending =
+          (m_config.prompt_to_log () || m_config.autoLog ()
+           || ui->cbAutoCQ->isChecked () || ui->cbAutoCall->isChecked ())
+          && !m_tune && qso_in_progress;
+
+      // The normal modulator path should release PTT first. If it does not,
+      // force RX shortly after the final waveform and prevent another cycle.
+      auto const final73GuardMs = qMax (
+          1000,
+          int (1000.0 * tx_duration (m_mode, m_TRperiod, m_nsps, m_bFast9)) + 750);
+      QTimer::singleShot (final73GuardMs, this, [this] {
+          if (!m_final73TxGuard) return;
+          auto_tx_mode (false);
+          m_bAutoReply = false;
+          m_bCallingCQ = false;
+          m_btxok = false;
+          if (m_transmitting) stopTx ();
+          g_iptt = 0;
+          m_config.transceiver_ptt (false);
+          complete_final73_tx ();
+          statusUpdate ();
+          if (m_zdebug) log ("OM0RX final-73 safety guard forced RX/PTT release");
+        });
+    }
+
+  m_pendingTxIs73 = false;
+  m_pendingTxFirst73 = false;
+  transmitDisplay (true);
+  statusUpdate ();
+}
+
+void MainWindow::complete_final73_tx ()
+{
+  if (!m_final73TxGuard) return;
+
+  auto const log_qso = m_final73LogPending;
+  m_final73LogPending = false;
+  m_final73TxGuard = false;
+
+  // Only now is it safe to reset QSO/automation state. Doing this at TX start
+  // cancels the final FT8 waveform even though the UI has already logged "Tx".
+  if (SpecOp::FOX != m_specOp)
+    {
+      auto_tx_mode (false);
+      m_bAutoReply = false;
+      m_bCallingCQ = false;
+    }
+
+  bool const auto_sequence = ("FT8"==m_mode || "FT4"==m_mode
+                              || "FT2"==m_mode || "Q65"==m_mode)
+      && ui->cbAutoSeq->isEnabled () && ui->cbAutoSeq->isChecked ();
+  if (m_config.disable_TX_on_73 () || auto_sequence)
+    {
+      m_nextCall.clear ();
+      if (auto_sequence
+          && (!ui->cbAutoCall->isChecked () || ui->cbAutoCQ->isChecked ()))
+        {
+          m_ntx = 6;
+          ui->txrb6->setChecked (true);
+          m_QSOProgress = CALLING;
+          if (m_lastCall == m_hisCall) clearDX ();
+        }
+    }
+
+  if (log_qso) logQSOTimer.start (0);
+  else cease_auto_Tx_after_QSO ();
+}

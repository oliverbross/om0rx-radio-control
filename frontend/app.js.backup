                COLORS: {
                    'ATNO': '#FFFF8C00',
                    'New band': '#FF00BFFF',
                    'New mode': '#FFFFC000',
                    'New band+mode': '#FFE91E63',
                    'Need LoTW': '#FF32CD32',
                    'Worked': '#FFB0B0B0',
                    'Default': '#FFFFFFFF'
                },
            },
            configMessage: null,
            
            // Panel collapse state
            loggingPanelSectionCollapsed: false,
        };
    },
    
    computed: {
        // AGC slider value (0-3 for OFF, SLOW, MED, FAST)
        agcSlider: {
            get() {
                const modes = ['off', 'slow', 'med', 'fast'];
                return modes.indexOf(this.radioStatus.agc_mode || 'med');
            },
            set(value) {
                // This setter is needed for v-model
            }
        },
        
        // Rotator enabled - synced from config
        rotorEnabled() {
            return this.configData.ROTOR_ENABLED === true;
        },
        
        // Current filters based on mode
        currentFilters() {
            const mode = this.radioStatus.mode || 'USB';
            return this.filtersByMode[mode] || this.filtersByMode['USB'];
        },
        
        // Filtered DX spots
        filteredSpots() {
            let spots = this.dxSpots.slice(0, this.maxSpots); // Apply spot count limit first
            
            // Filter by callsign
            if (this.spotsFilter.callsign) {
                const filter = this.spotsFilter.callsign.toUpperCase();
                spots = spots.filter(s => s.callsign && s.callsign.toUpperCase().includes(filter));
            }
            
            // Filter by bands
            if (this.spotsFilter.bands && this.spotsFilter.bands.length > 0) {
                spots = spots.filter(s => this.spotsFilter.bands.includes(s.band));
            }
            
            // Filter by modes
            if (this.spotsFilter.modes && this.spotsFilter.modes.length > 0) {
                spots = spots.filter(s => this.spotsFilter.modes.includes(s.mode));
            }
            
            // Filter by spotter's continent (Spotter from filter)
            if (this.spotsFilter.continents && this.spotsFilter.continents.length > 0) {
                spots = spots.filter(s => s.spotter_continent && this.spotsFilter.continents.includes(s.spotter_continent));
            }
            
            // Filter by CQ zones
            if (this.spotsFilter.cqs && this.spotsFilter.cqs.length > 0) {
                spots = spots.filter(s => {
                    const cq = parseInt(s.cq);
                    return this.spotsFilter.cqs.includes(cq);
                });
            }
            
            // Filter by call status
            if (this.spotsFilter.callStatuses && this.spotsFilter.callStatuses.length > 0) {
                spots = spots.filter(s => this.spotsFilter.callStatuses.includes(s.call_status));
            }
            
            // Filter by DXCC status
            if (this.spotsFilter.dxccStatuses && this.spotsFilter.dxccStatuses.length > 0) {
                // Map UI labels to backend values
                const statusMap = {
                    'Confirmed': 'Confirmed',
                    'Worked': 'Worked',
                    'New Band': 'New band',
                    'New Mode': 'New mode',
                    'Needed': 'ATNO'
                };
                const mappedStatuses = this.spotsFilter.dxccStatuses.map(s => statusMap[s] || s);
                spots = spots.filter(s => mappedStatuses.includes(s.dxcc_status));
            }
            
            // Filter by special tags
            if (this.spotsFilter.specials && this.spotsFilter.specials.length > 0) {
                spots = spots.filter(s => {
                    return s.special && this.spotsFilter.specials.includes(s.special);
                });
            }
            
            return spots;
        },
        
        // Current band display
        currentBand() {
            const freq = this.radioStatus.frequency;
            if (!freq) return '---';
            
            // Find which band we're on
            for (const [band, range] of Object.entries({
                '160M': [1.8, 2.0],
                '80M': [3.5, 4.0],
                '60M': [5.3, 5.4],
                '40M': [7.0, 7.3],
                '30M': [10.1, 10.15],
                '20M': [14.0, 14.35],
                '17M': [18.068, 18.168],
                '15M': [21.0, 21.45],
                '12M': [24.89, 24.99],
                '10M': [28.0, 29.7],
                '6M': [50.0, 54.0],
            })) {
                if (freq >= range[0] && freq <= range[1]) {
                    return band;
                }
            }
            
            return 'OOB'; // Out of band
        },
        
        // Current step display
        currentStep() {
            const mode = this.radioStatus.mode || 'USB';
            const steps = this.stepsByMode[mode] || this.stepsByMode['USB'];
            return steps[this.currentStepIndex] || '10 Hz';
        },
        
        // QRZ QSL options formatting
        qrzQslOptions() {
            if (!this.qrzProfile || !this.qrzProfile.success) return '';
            const options = [];
            if (this.qrzProfile.eqsl === '1') options.push('eQSL');
            if (this.qrzProfile.mqsl === '1') options.push('Paper');
            if (this.qrzProfile.lotw === '1') options.push('LoTW');
            return options.length > 0 ? options.join(' / ') : '';
        }
    },
    
    watch: {
        'loggingForm.callsign': {
            handler(newCallsign, oldCallsign) {
                // When callsign is manually entered/changed, load QRZ profile with delay
                if (newCallsign && newCallsign.trim()) {
                    // Update beaming display to show current callsign
                    this.currentBeamingCallsign = newCallsign;
                    // Reset bearings when new callsign is entered (will be recalculated if needed)
                    this.shortPathBearing = null;
                    this.longPathBearing = null;
                    
                    // Clear any existing timer
                    if (this.dxccLookupTimer) {
                        clearTimeout(this.dxccLookupTimer);
                    }
                    // Debounce: wait 1 second after user stops typing before loading QRZ
                    this.dxccLookupTimer = setTimeout(() => {
                        console.log(`📞 Callsign changed to: ${newCallsign}`);
                        this.loadQRZProfile();
                    }, 1000);
                } else {
                    // Clear beaming display when callsign is cleared
                    this.currentBeamingCallsign = null;
                    this.shortPathBearing = null;
                    this.longPathBearing = null;
                }
            }
        }
    },
    
    mounted() {
        console.log('🚀 FlexRadio Web Control v2.0 starting...');
        this.connectWebSocket();
        this.fetchInitialStatus();
        this.loadConfig();
        this.loadRotorStatus();
        this.loadRotorAutoConfig();
        this.updateClock();
        setInterval(this.updateClock, 1000);
        // Poll rotor status every 5 seconds if enabled
        setInterval(() => {
            if (this.rotorEnabled) {
                this.checkRotorStatus();
            }
        }, 5000);
    },
    
    methods: {
        // === WebSocket Connection ===
        
        connectWebSocket() {
            const wsProtocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsUrl = `${wsProtocol}//${window.location.host}/ws/radio`;
            
            console.log('Connecting to WebSocket:', wsUrl);
            
            try {
                this.ws = new WebSocket(wsUrl);
                
                this.ws.onopen = () => {
                    console.log('✅ WebSocket connected');
                    this.connected = true;
                    this.showStatus('Connected to radio', 'success');
                };
                
                this.ws.onmessage = (event) => {
                    const message = JSON.parse(event.data);
                    console.log('📥 Received:', message.type);
                    
                    if (message.type === 'status') {
                        this.updateRadioStatus(message.data);
                    } else if (message.type === 'spots') {
                        // Accumulate spots instead of replacing
                        const newSpots = message.data;
                        console.log(`📡 Received ${newSpots.length} new spot(s)`);
                        
                        newSpots.forEach(newSpot => {
                            // Check if spot already exists (by callsign and frequency_mhz)
                            // Use frequency_mhz (float) for comparison, not the string
                            const freqMhz = newSpot.frequency_mhz || parseFloat(newSpot.frequency) / 1000;
                            const exists = this.dxSpots.some(s => {
                                const existingFreqMhz = s.frequency_mhz || parseFloat(s.frequency) / 1000;
                                return s.callsign === newSpot.callsign && 
                                       Math.abs(existingFreqMhz - freqMhz) < 0.001;
                            });
                            if (!exists) {
                                this.dxSpots.unshift(newSpot); // Add to beginning
                                console.log(`  ✅ Added: ${newSpot.callsign} ${newSpot.frequency} kHz (from ${newSpot.spotter}@${newSpot.spotter_continent})`);
                            } else {
                                console.log(`  ⏭️ Duplicate: ${newSpot.callsign} ${newSpot.frequency} kHz`);
                            }
                        });
                        
                        // Trim to maxSpots (but keep accumulating)
                        if (this.dxSpots.length > this.maxSpots) {
                            this.dxSpots = this.dxSpots.slice(0, this.maxSpots);
                        }
                        console.log(`📊 Total spots in cache: ${this.dxSpots.length} (max: ${this.maxSpots})`);
                        
                        // Sync to popup window if open
                        if (this.spotsDetached) {
                            this.syncSpotsToWindow();
                        }
                    }
                };
                
                this.ws.onerror = (error) => {
                    console.error('❌ WebSocket error:', error);
                    this.connected = false;
                };
                
                this.ws.onclose = () => {
                    console.log('🔌 WebSocket closed');
                    this.connected = false;
                    this.showStatus('Disconnected from radio', 'error');
                    
                    // Auto-reconnect
                    this.reconnectTimer = setTimeout(() => {
                        console.log('🔄 Reconnecting...');
                        this.connectWebSocket();
                    }, 5000);
                };
            } catch (error) {
                console.error('Failed to create WebSocket:', error);
                this.connected = false;
            }
        },
        
        // === Fetch Initial Status ===
        
        async fetchInitialStatus() {
            try {
                const response = await fetch('/api/status');
                if (response.ok) {
                    const data = await response.json();
                    console.log('📊 Initial status:', data);
                    this.updateRadioStatus(data);
                }
            } catch (error) {
                console.error('Failed to fetch status:', error);
            }
        },
        
        async loadConfig() {
            try {
                const response = await fetch('/api/config');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.config) {
                        console.log('⚙️ Configuration loaded:', data.config);
                        this.configData = { ...this.configData, ...data.config };
                        console.log('✅ ROTOR_ENABLED from config:', this.configData.ROTOR_ENABLED);
                    }
                }
            } catch (error) {
                console.error('Failed to fetch config:', error);
            }
        },
        
        async loadRotorStatus() {
            try {
                const response = await fetch('/api/rotor/status');
                if (response.ok) {
                    const data = await response.json();
                    console.log('🌐 Rotor status:', data);
                    if (data.enabled) {
                        this.rotorConnected = data.azimuth !== null;
                        if (data.azimuth !== null) {
                            this.rotorAzimuth = data.azimuth;
                        }
                        console.log('✅ Rotator connected');
                    } else {
                        this.rotorConnected = false;
                    }
                }
            } catch (error) {
                console.error('Failed to fetch rotor status:', error);
                this.rotorConnected = false;
            }
        },
        
        // === Update Radio Status ===
        
        updateRadioStatus(data) {
            Object.keys(data).forEach(key => {
                // Handle field name aliases from backend
                let actualKey = key;
                
                // Map backend field names to frontend field names
                const fieldMapping = {
                    'freq': 'frequency',           // Handle 'freq' → 'frequency'
                    'rfpower': 'drive',            // Handle 'rfpower' → 'drive'
                    'tunepower': 'tune_power',     // Handle 'tunepower' → 'tune_power'
                    'miclevel': 'mic_level',       // Handle 'miclevel' → 'mic_level'
                    'vox_enable': 'vox_enabled',   // Normalize VOX field name
                };
                
                if (key in fieldMapping) {
                    actualKey = fieldMapping[key];
                }
                
                // Update cluster connection status
                if (key === 'cluster_connected') {
                    this.clusterConnected = data[key];
                    console.log(`🔗 Cluster status: ${data[key] ? '✅ Connected' : '❌ Disconnected'}`);
                }
                
                // Update radioStatus object
                if (actualKey in this.radioStatus) {
                    this.radioStatus[actualKey] = data[key];
                    console.log(`✅ Updated radioStatus.${actualKey} = ${data[key]}`);
                }
                
                // Update TX state
                if (key === 'mox' || actualKey === 'mox') this.txState.mox = data[key];
                if (key === 'tune' || actualKey === 'tune') this.txState.tune = data[key];
                if (key === 'vox_enabled' || key === 'vox_enable' || actualKey === 'vox_enabled') this.txState.vox = data[key];
                if (key === 'break_in' || actualKey === 'break_in') this.txState.breakin = data[key];
                
                // Update control sliders
                if (actualKey === 'volume') this.controls.volume = data[key];
                if (actualKey === 'drive') this.controls.drive = data[key];
                if (actualKey === 'tune_power') this.controls.tunePower = data[key];
                if (actualKey === 'mic_level') this.controls.mic = data[key];
                if (actualKey === 'monitor') this.controls.monitor = data[key];
                if (actualKey === 'agc_threshold' || key === 'agc_threshold') this.controls.agcThreshold = data[key];
                
                // Sync logging form frequency only (not mode)
                // Mode is set when clicking spot or manually entering callsign
                if (actualKey === 'frequency') {
                    this.loggingForm.frequency = data[key]; // Keep full precision
                }
                
                // Update RIT/XIT
                if (actualKey === 'rit_enabled') this.ritEnabled = data[key];
                if (actualKey === 'rit_freq') this.ritValue = data[key];
                if (actualKey === 'xit_enabled') this.xitEnabled = data[key];
                if (actualKey === 'xit_freq') this.xitValue = data[key];
                
                // Update DSP levels
                if (actualKey === 'nb_level') this.dspLevels.nb = data[key];
                if (actualKey === 'nr_level') this.dspLevels.nr = data[key];
                if (actualKey === 'anf_level') this.dspLevels.anf = data[key];
                if (actualKey === 'apf_level') this.dspLevels.apf = data[key];
            });
        },
        
        // === Send Command ===
        
        async sendCommand(endpoint, payload) {
            try {
                const response = await fetch(`/api/${endpoint}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                });
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.detail || 'Command failed');
                }
                
                const result = await response.json();
                console.log(`✅ ${endpoint}:`, result);
                return result;
            } catch (error) {
                console.error(`❌ ${endpoint} failed:`, error);
                this.showStatus(`Error: ${error.message}`, 'error');
                throw error;
            }
        },
        
        // === Band Controls ===
        
        async setBand(band) {
            console.log('Setting band:', band);
            await this.sendCommand('band', { band: band.toLowerCase() });
        },
        
        isActiveBand(band) {
            const freq = this.radioStatus.frequency;
            const bandFreq = this.bandFrequencies[band];
            if (!freq || !bandFreq) return false;
            
            // Check if frequency is within ±5% of band frequency
            const tolerance = bandFreq * 0.05;
            return Math.abs(freq - bandFreq) < tolerance;
        },
        
        // === Mode Controls ===
        
        async setMode(mode) {
            console.log('Setting mode:', mode);
            await this.sendCommand('mode', { mode });
        },
        
        // === Filter Controls ===
        
        async setFilter(lo, hi) {
            console.log('Setting filter:', lo, hi);
            await this.sendCommand('filter', { filter_lo: lo, filter_hi: hi });
        },
        
        isActiveFilter(filter) {
            return this.radioStatus.filter_lo === filter.lo && 
                   this.radioStatus.filter_hi === filter.hi;
        },
        
        // === Slider Controls ===
        
        // Debounced slider helper
        debounceSlider(name, callback, delay = 150) {
            // Clear existing timer for this slider
            if (this.sliderDebounceTimers[name]) {
                clearTimeout(this.sliderDebounceTimers[name]);
            }
            
            // Set new timer
            this.sliderDebounceTimers[name] = setTimeout(callback, delay);
        },
        
        setVolume() {
            this.debounceSlider('volume', async () => {
                await this.sendCommand('volume', { value: this.controls.volume });
            });
        },
        
        setDrive() {
            this.debounceSlider('drive', async () => {
                await this.sendCommand('drive', { value: this.controls.drive });
            });
        },
        
        setTunePower() {
            this.debounceSlider('tunePower', async () => {
                await this.sendCommand('tune_power', { value: this.controls.tunePower });
            });
        },
        
        setMic() {
            this.debounceSlider('mic', async () => {
                await this.sendCommand('mic', { value: this.controls.mic });
            });
        },
        
        setMonitor() {
            this.debounceSlider('monitor', async () => {
                await this.sendCommand('monitor', { value: this.controls.monitor });
            });
        },
        
        setAGCThreshold() {
            this.debounceSlider('agcThreshold', async () => {
                await this.sendCommand('agc_threshold', { value: this.controls.agcThreshold });
            });
        },
        
        // === TX Controls ===
        
        async toggleMox() {
            this.txState.mox = !this.txState.mox;
            await this.sendCommand('mox', { enabled: this.txState.mox });
        },
        
        async toggleTune() {
            this.txState.tune = !this.txState.tune;
            await this.sendCommand('tune', { enabled: this.txState.tune });
        },
        
        async toggleVox() {
            this.txState.vox = !this.txState.vox;
            await this.sendCommand('vox', { enabled: this.txState.vox });
        },
        
        async toggleBreakin() {
            this.txState.breakin = !this.txState.breakin;
            await this.sendCommand('breakin', { enabled: this.txState.breakin });
        },
        
        async setTuningStep() {
            // Convert step text to Hz value
            const stepHz = this.getStepValue();
            await this.sendCommand('step', { step_hz: stepHz });
        },
        
        // === AGC Control ===
        
        async setAGC(mode) {
            console.log('Setting AGC:', mode);
            await this.sendCommand('agc', { mode });
        },
        
        async setAGCFromSlider() {
            const modes = ['off', 'slow', 'med', 'fast'];
            const mode = modes[this.agcSlider];
            if (mode) {
                await this.setAGC(mode);
            }
        },
        
        // === DSP Controls ===
        
        async toggleDSP(control) {
            const key = `${control}_enabled`;
            const newState = !this.radioStatus[key];
            console.log(`Toggling ${control.toUpperCase()}:`, newState);
            await this.sendCommand('dsp', { control, enabled: newState });
            
            // Toggle slider visibility when enabling
            if (newState) {
                this.showDSPSlider[control] = !this.showDSPSlider[control];
            } else {
                this.showDSPSlider[control] = false;
            }
        },
        
        setDSPLevel(control) {
            this.debounceSlider(`dsp_${control}`, async () => {
                const level = this.dspLevels[control];
                console.log(`Setting ${control.toUpperCase()} level:`, level);
                await this.sendCommand('dsp_level', { control: `${control}_level`, value: level });
            });
        },
        
        // === RX2 Control ===
        
        async toggleRX2() {
            const newState = !this.radioStatus.rx2_enabled;
            console.log('Toggling RX2:', newState);
            
            if (newState) {
                // Enable RX2 with frequency offset
                this.subVfoFreq = this.radioStatus.frequency + 0.010;  // +10 kHz
                await this.sendCommand('rx2', { enabled: true, frequency: this.subVfoFreq });
            } else {
                await this.sendCommand('rx2', { enabled: false });
            }
        },
        
        // === SPLIT Control ===
        
        async toggleSplit() {
            const newState = !this.radioStatus.split_enabled;
            console.log('Toggling SPLIT:', newState);
            
            if (newState) {
                // Enable split with TX offset
                const txFreq = this.radioStatus.frequency + 0.005;  // +5 kHz
                this.subVfoFreq = txFreq;
                await this.sendCommand('split', { enabled: true, tx_frequency: txFreq });
            } else {
                await this.sendCommand('split', { enabled: false });
            }
        },
        
        // === DX Spots ===
        
        async tuneToSpot(spot) {
            // Expand panel section when a spot is clicked
            this.loggingPanelSectionCollapsed = false;
            
            // Backend stores frequency_mhz (float MHz) and frequency (string kHz from cluster)
            // Use frequency_mhz for calculations (it's the float MHz version)
            const freqMhz = spot.frequency_mhz || parseFloat(spot.frequency) / 1000;
            if (!freqMhz || isNaN(freqMhz)) {
                console.error('Invalid spot frequency:', spot);
                this.showStatus('Invalid spot frequency', 'error');
                return;
            }
            
            try {
                // Map cluster mode to radio mode
                // For SSB: determine USB (20m and up) or LSB (160-40m bands)
                let radioMode = spot.mode;
                if (spot.mode === 'SSB' || spot.mode === 'ssb') {
                    // LSB for 160m, 80m, 60m, 40m (freq < 14 MHz)
                    // USB for 20m and higher (freq >= 14 MHz)
                    radioMode = freqMhz < 14 ? 'LSB' : 'USB';
                }
                
                console.log('Tuning to spot:', freqMhz, 'Mode:', spot.mode, '→', radioMode);
                this.showStatus(`🎯 Tuning to ${spot.callsign} on ${freqMhz} MHz (${radioMode})...`, 'info');
                
                // Tune radio with full precision
                await this.sendCommand('spots/tune', { frequency: freqMhz, mode: radioMode });
                
                // Add spot to SmartSDR panadapter display
                try {
                    const response = await fetch('/api/spots/add-to-radio', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            callsign: spot.callsign,
                            frequency: freqMhz,
                            mode: spot.mode || 'USB',
                            spotter: spot.spotter || 'Cluster',
                            comment: spot.comment || '',
                            tag: spot.tag
                        })
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        console.log('✨ Spot added to panadapter:', result.message);
                    }
                } catch (e) {
                    console.warn('Could not add spot to panadapter:', e);
                }
                
                this.showStatus(`✅ Tuned to ${spot.callsign} on ${freqMhz} MHz`, 'success');
                
                // === POPULATE LOGGING FORM ===
                // Fill in logging form fields with spot data
                this.loggingForm.callsign = spot.callsign || '';
                // Display frequency uses the string (kHz with full precision), but use MHz for the frequency field
                this.loggingForm.frequency = freqMhz; // Use MHz for radio control
                
                // Set current UTC time
                const now = new Date();
                const utcHours = String(now.getUTCHours()).padStart(2, '0');
                const utcMinutes = String(now.getUTCMinutes()).padStart(2, '0');
                const utcSeconds = String(now.getUTCSeconds()).padStart(2, '0');
                this.loggingForm.time_off = `${utcHours}:${utcMinutes}:${utcSeconds}`;
                
                // When clicking a spot, use spot mode (not radio mode)
                // This avoids mismatch between spot "SSB" vs radio "USB", or spot "FT8" vs radio "DIGU"
                this.loggingForm.mode = spot.mode || '';
                
                // Auto-populate RST based on mode
                this.autoPopulateRST();
                
                // Extract POTA/SOTA/IOTA/WWFF from comments
                if (spot.comment) {
                    const comment = spot.comment.toLowerCase();
                    
                    // Try to extract POTA reference
                    const potaMatch = comment.match(/k-\d{4}|us-\d{4}|[a-z]{1,2}-\d{4}/i);
                    if (potaMatch) this.loggingForm.pota = potaMatch[0].toUpperCase();
                    
                    // Try to extract SOTA reference
                    const sotaMatch = comment.match(/[a-z]{1,2}\/[a-z]{2}-\d{3}/i);
                    if (sotaMatch) this.loggingForm.sota = sotaMatch[0].toUpperCase();
                    
                    // Try to extract IOTA reference
                    const iotaMatch = comment.match(/af-\d{3}|an-\d{3}|as-\d{3}|eu-\d{3}|na-\d{3}|oc-\d{3}|sa-\d{3}/i);
                    if (iotaMatch) this.loggingForm.iota = iotaMatch[0].toUpperCase();
                    
                    // Try to extract WWFF reference
                    const wwffMatch = comment.match(/[a-z]{2}ff-\d{4}/i);
                    if (wwffMatch) this.loggingForm.wwff = wwffMatch[0].toUpperCase();
                    
                    // Store full comment in notes
                    this.loggingForm.notes = spot.comment;
                }
                
                // Load QRZ profile and DXCC status
                this.loadQRZProfile();
                this.loadDXCCStatus();
                
                // === TRIGGER ROTOR AUTO IF ENABLED ===
                // Convert frequency to kHz for rotor AUTO
                const frequencyKhz = freqMhz * 1000;
                const gridsquare = spot.gridsquare || null;
                const latitude = spot.latitude || null;
                const longitude = spot.longitude || null;
                
                if (this.rotorAutoEnabled && this.rotorEnabled) {
                    console.log(`🤖 AUTO rotor triggered for ${spot.callsign} on ${freqMhz} MHz`);
                    this.rotorAutoGoto(spot.callsign, frequencyKhz, gridsquare, latitude, longitude);
                } else if (this.rotorEnabled && (gridsquare || (latitude && longitude))) {
                    // Even if AUTO is disabled, calculate and display SP/LP bearings
                    // This allows manual rotor control via SP/LP GO buttons
                    try {
                        const response = await fetch('/api/rotor/auto/bearing', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                callsign: spot.callsign,
                                frequency_khz: frequencyKhz,
                                gridsquare: gridsquare,
                                latitude: latitude,
                                longitude: longitude
                            })
                        });
                        
                        if (response.ok) {
                            const data = await response.json();
                            if (data.ok) {
                                // Update beaming display with bearing info
                                this.currentBeamingCallsign = spot.callsign;
                                this.shortPathBearing = Math.round(data.bearing * 10) / 10;
                                this.longPathBearing = (this.shortPathBearing + 180) % 360;
                                this.lastBeamingTime = new Date();
                                console.log(`📡 Bearing calculated for ${spot.callsign}: SP ${this.shortPathBearing}° / LP ${this.longPathBearing}°`);
                            }
                        }
                    } catch (e) {
                        console.warn('Could not calculate bearing:', e);
                    }
                }
                
            } catch (e) {
                console.error('Tune to spot failed:', e);
                this.showStatus(`❌ Failed to tune to spot: ${e.message}`, 'error');
            }
        },
        
        formatSpotFreq(freqKhz) {
            const mhz = freqKhz / 1000;
            // Keep full precision - don't truncate to 3 decimals
            return mhz.toString();
        },
        
        // Get color for spot based on DXCC status
        getSpotRowClass(spot) {
            const tag = spot.tag || spot.dxcc_status;
            const classMap = {
                'ATNO': 'spot-atno',
                'New band': 'spot-new-band',
                'New mode': 'spot-new-mode',
                'New band+mode': 'spot-new-bandmode',
                'Need LoTW': 'spot-need-lotw',
                'Worked': 'spot-worked',
                'Confirmed': 'spot-confirmed'
            };
            return classMap[tag] || '';
        },
        
        // Dropdown management
        toggleDropdown(name) {
            this.openDropdown = this.openDropdown === name ? null : name;
        },
        
        // Toggle filter selection
        toggleFilterItem(filterArray, value) {
            const index = filterArray.indexOf(value);
            if (index === -1) {
                filterArray.push(value);
            } else {
                filterArray.splice(index, 1);
            }
        },
        
        // Select all items in a filter
        selectAllInFilter(filterArray, allItems) {
            filterArray.splice(0, filterArray.length, ...allItems);
        },
        
        // Clear specific filter
        clearFilter(filterArray) {
            filterArray.splice(0, filterArray.length);
        },
        
        // Clear all filters
        clearAllFilters() {
            this.spotsFilter.callsign = '';
            this.spotsFilter.bands = [];
            this.spotsFilter.modes = [];
            this.spotsFilter.continents = [];
            this.spotsFilter.cqs = [];
            this.spotsFilter.callStatuses = [];
            this.spotsFilter.dxccStatuses = [];
            this.spotsFilter.specials = [];
            this.openDropdown = null;
        },
        
        // === Detachable Spots Section (Popup Window) ===
        
        toggleSpotsDetached() {
            if (this.spotsDetached) {
                // Close the popup window
                this.closeSpotsWindow();
            } else {
                // Open spots in new window
                this.openSpotsWindow();
            }
        },
        
        openSpotsWindow() {
            // Create BroadcastChannel for communication
            if (!this.spotsChannel) {
                this.spotsChannel = new BroadcastChannel('spots_sync');
                this.spotsChannel.onmessage = (event) => {
                    if (event.data.type === 'tuneToSpot') {
                        this.tuneToSpot(event.data.spot);
                    } else if (event.data.type === 'filterUpdate') {
                        this.spotsFilter = event.data.filter;
                        this.maxSpots = event.data.maxSpots;
                    } else if (event.data.type === 'windowClosed') {
                        this.spotsDetached = false;
                        this.spotsWindow = null;
                    }
                };
            }
            
            // Create HTML content as Blob
            const html = this.getSpotsWindowHTML();
            const blob = new Blob([html], { type: 'text/html' });
            const blobUrl = URL.createObjectURL(blob);
            
            // Open popup window with blob URL
            const width = 1400;
            const height = 800;
            const left = window.screenX + 100;
            const top = window.screenY + 100;
            
            this.spotsWindow = window.open(
                blobUrl,
                'DXSpots',
                `width=${width},height=${height},left=${left},top=${top},resizable=yes,scrollbars=yes`
            );
            
            if (!this.spotsWindow) {
                alert('Popup blocked! Please allow popups for this site.');
                URL.revokeObjectURL(blobUrl); // Clean up
                return;
            }
            
            this.spotsDetached = true;
            
            // Send initial data after window loads
            this.spotsWindow.addEventListener('load', () => {
                setTimeout(() => {
                    this.syncSpotsToWindow();
                    URL.revokeObjectURL(blobUrl); // Clean up blob URL after loading
                }, 300);
            });
            
            // Handle popup closing
            const checkClosed = setInterval(() => {
                if (this.spotsWindow && this.spotsWindow.closed) {
                    clearInterval(checkClosed);
                    this.spotsDetached = false;
                    this.spotsWindow = null;
                }
            }, 500);
            
            console.log('📤 Spots window opened');
        },
        
        closeSpotsWindow() {
            if (this.spotsWindow && !this.spotsWindow.closed) {
                this.spotsWindow.close();
            }
            this.spotsDetached = false;
            this.spotsWindow = null;
            console.log('📌 Spots window closed');
        },
        
        syncSpotsToWindow() {
            if (!this.spotsWindow || this.spotsWindow.closed) return;
            
            this.spotsChannel.postMessage({
                type: 'spotsUpdate',
                spots: this.dxSpots,
                filter: this.spotsFilter,
                maxSpots: this.maxSpots,
                availableBands: this.availableBands,
                availableModes: this.availableModes,
                availableSpotters: this.availableSpotters,
                availableContinents: this.availableContinents,
                availableCQs: this.availableCQs,
                availableCallStatuses: this.availableCallStatuses,
                availableDxccStatuses: this.availableDxccStatuses,
                availableSpecials: this.availableSpecials,
                availableSpotCounts: this.availableSpotCounts,
            });
        },
        
        getSpotsWindowHTML() {
            return `
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DX Spots - FlexRadio Control</title>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #fff;
            padding: 20px;
            min-height: 100vh;
        }
        
        .spots-container {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        
        .spots-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid rgba(255, 255, 255, 0.2);
        }
        
        .spots-header h2 {
            font-size: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .filters-row {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            align-items: center;
        }
        
        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        
        .filter-group label {
            font-size: 12px;
            opacity: 0.8;
            font-weight: 500;
        }
        
        input[type="text"], select {
            padding: 8px 12px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.1);
            color: #fff;
            font-size: 14px;
            min-width: 150px;
        }
        
        input::placeholder { color: rgba(255, 255, 255, 0.5); }
        
        .multiselect {
            position: relative;
        }
        
        .multiselect-button {
            padding: 8px 12px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            min-width: 150px;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .multiselect-button:hover {
            background: rgba(255, 255, 255, 0.15);
        }
        
        .multiselect-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            margin-top: 5px;
            background: #2a5298;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            padding: 8px;
            z-index: 1000;
            max-height: 250px;
            overflow-y: auto;
            min-width: 200px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
        }
        
        .multiselect-option {
            padding: 6px 10px;
            cursor: pointer;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .multiselect-option:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        
        .multiselect-option input[type="checkbox"] {
            margin: 0;
            min-width: auto;
        }
        
        button {
            padding: 8px 16px;
            background: rgba(74, 144, 226, 0.8);
            border: none;
            border-radius: 6px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.3s;
        }
        
        button:hover {
            background: rgba(74, 144, 226, 1);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(74, 144, 226, 0.4);
        }
        
        .spots-table-container {
            max-height: calc(100vh - 300px);
            overflow-y: auto;
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.2);
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        
        thead {
            position: sticky;
            top: 0;
            background: rgba(42, 82, 152, 0.95);
            z-index: 10;
        }
        
        th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid rgba(255, 255, 255, 0.3);
            white-space: nowrap;
        }
        
        td {
            padding: 10px 12px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        tbody tr {
            cursor: pointer;
            transition: background 0.2s;
        }
        
        tbody tr:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            margin-right: 4px;
        }
        
        .badge-pota { background: #ff6b6b; }
        .badge-sota { background: #4ecdc4; }
        .badge-wwff { background: #95e1d3; color: #333; }
        .badge-iota { background: #f38181; }
        .badge-contest { background: #aa96da; }
        .badge-lh { background: #fcbad3; color: #333; }
        
        .status-new-call { color: #4ade80; font-weight: 600; }
        .status-new-band { color: #60a5fa; font-weight: 600; }
        .status-worked { color: #fbbf24; }
        .status-confirmed { color: #94a3b8; }
        
        ::-webkit-scrollbar { width: 10px; height: 10px; }
        ::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 5px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }
    </style>
</head>
<body>
    <div id="app">
        <div class="spots-container">
            <div class="spots-header">
                <h2>🎯 DX Spots</h2>
                <div>
                    <span style="opacity: 0.7; margin-right: 15px;">Total: {{ filteredSpots.length }}</span>
                    <button @click="clearFilters">Clear Filters</button>
                </div>
            </div>
            
            <div class="filters-row">
                <div class="filter-group">
                    <label>Callsign</label>
                    <input type="text" v-model="filter.callsign" placeholder="Search callsign...">
                </div>
                
                <div class="filter-group">
                    <label>Max Spots</label>
                    <select v-model.number="maxSpots" @change="notifyFilterChange">
                        <option v-for="count in availableSpotCounts" :key="count" :value="count">{{ count }}</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <label>Bands</label>
                    <div class="multiselect">
                        <div class="multiselect-button" @click="toggleDropdown('bands')">
                            <span>{{ filter.bands.length ? filter.bands.length + ' selected' : 'All Bands' }}</span>
                            <span>▼</span>
                        </div>
                        <div v-if="openDropdown === 'bands'" class="multiselect-dropdown">
                            <div v-for="band in availableBands" :key="band" class="multiselect-option" @click.stop="toggleFilterItem('bands', band)">
                                <input type="checkbox" :checked="filter.bands.includes(band)" @click.stop>
                                <span>{{ band }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="filter-group">
                    <label>Modes</label>
                    <div class="multiselect">
                        <div class="multiselect-button" @click="toggleDropdown('modes')">
                            <span>{{ filter.modes.length ? filter.modes.length + ' selected' : 'All Modes' }}</span>
                            <span>▼</span>
                        </div>
                        <div v-if="openDropdown === 'modes'" class="multiselect-dropdown">
                            <div v-for="mode in availableModes" :key="mode" class="multiselect-option" @click.stop="toggleFilterItem('modes', mode)">
                                <input type="checkbox" :checked="filter.modes.includes(mode)" @click.stop>
                                <span>{{ mode }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="filter-group">
                    <label>Continents</label>
                    <div class="multiselect">
                        <div class="multiselect-button" @click="toggleDropdown('continents')">
                            <span>{{ filter.continents.length ? filter.continents.length + ' selected' : 'All Continents' }}</span>
                            <span>▼</span>
                        </div>
                        <div v-if="openDropdown === 'continents'" class="multiselect-dropdown">
                            <div v-for="cont in availableContinents" :key="cont.id" class="multiselect-option" @click.stop="toggleFilterItem('continents', cont.id)">
                                <input type="checkbox" :checked="filter.continents.includes(cont.id)" @click.stop>
                                <span>{{ cont.name }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="filter-group">
                    <label>Specials</label>
                    <div class="multiselect">
                        <div class="multiselect-button" @click="toggleDropdown('specials')">
                            <span>{{ filter.specials.length ? filter.specials.length + ' selected' : 'All' }}</span>
                            <span>▼</span>
                        </div>
                        <div v-if="openDropdown === 'specials'" class="multiselect-dropdown">
                            <div v-for="special in availableSpecials" :key="special" class="multiselect-option" @click.stop="toggleFilterItem('specials', special)">
                                <input type="checkbox" :checked="filter.specials.includes(special)" @click.stop>
                                <span>{{ special }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="spots-table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Frequency</th>
                            <th>Callsign</th>
                            <th>Country</th>
                            <th>Mode</th>
                            <th>SNR</th>
                            <th>Status</th>
                            <th>Special</th>
                            <th>Spotter</th>
                            <th>Comments</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="spot in filteredSpots" :key="spot.id" @click="tuneToSpot(spot)">
                            <td>{{ formatTime(spot.time) }}</td>
                            <td><strong>{{ formatFrequency(spot.frequency) }}</strong></td>
                            <td><strong>{{ spot.callsign }}</strong></td>
                            <td>{{ spot.country || '-' }}</td>
                            <td>{{ spot.mode || '-' }}</td>
                            <td>{{ spot.snr || '-' }}</td>
                            <td :class="getStatusClass(spot.call_status)">{{ spot.call_status || '-' }}</td>
                            <td>
                                <span v-if="spot.pota" class="badge badge-pota">POTA</span>
                                <span v-if="spot.sota" class="badge badge-sota">SOTA</span>
                                <span v-if="spot.wwff" class="badge badge-wwff">WWFF</span>
                                <span v-if="spot.iota" class="badge badge-iota">IOTA</span>
                                <span v-if="spot.lighthouse" class="badge badge-lh">LH</span>
                                <span v-if="spot.contest" class="badge badge-contest">Contest</span>
                            </td>
                            <td>{{ spot.spotter || '-' }}</td>
                            <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                {{ spot.comment || '-' }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <script>
        const { createApp } = Vue;
        
        const app = createApp({
            data() {
                return {
                    spots: [],
                    filter: {
                        callsign: '',
                        bands: [],
                        modes: [],
                        spotters: [],
                        continents: [],
                        cqs: [],
                        callStatuses: [],
                        dxccStatuses: [],
                        specials: [],
                    },
                    maxSpots: 100,
                    availableBands: [],
                    availableModes: [],
                    availableSpotters: [],
                    availableContinents: [],
                    availableCQs: [],
                    availableCallStatuses: [],
                    availableDxccStatuses: [],
                    availableSpecials: [],
                    availableSpotCounts: [],
                    openDropdown: null,
                    channel: null,
                };
            },
            
            computed: {
                filteredSpots() {
                    let filtered = this.spots;
                    
                    if (this.filter.callsign) {
                        filtered = filtered.filter(s => 
                            s.callsign.toLowerCase().includes(this.filter.callsign.toLowerCase())
                        );
                    }
                    
                    if (this.filter.bands.length) {
                        filtered = filtered.filter(s => this.filter.bands.includes(s.band));
                    }
                    
                    if (this.filter.modes.length) {
                        filtered = filtered.filter(s => this.filter.modes.includes(s.mode));
                    }
                    
                    if (this.filter.spotters.length) {
                        filtered = filtered.filter(s => s.spotter && this.filter.spotters.includes(s.spotter));
                    }
                    
                    if (this.filter.continents.length) {
                        filtered = filtered.filter(s => this.filter.continents.includes(s.continent));
                    }
                    
                    if (this.filter.specials.length) {
                        filtered = filtered.filter(s => {
                            return this.filter.specials.some(special => {
                                if (special === 'POTA') return s.pota;
                                if (special === 'SOTA') return s.sota;
                                if (special === 'WWFF') return s.wwff;
                                if (special === 'IOTA') return s.iota;
                                if (special === 'LH') return s.lighthouse;
                                if (special === 'Contest') return s.contest;
                                return false;
                            });
                        });
                    }
                    
                    return filtered.slice(0, this.maxSpots);
                },
            },
            
            mounted() {
                // Setup BroadcastChannel
                this.channel = new BroadcastChannel('spots_sync');
                this.channel.onmessage = (event) => {
                    if (event.data.type === 'spotsUpdate') {
                        this.spots = event.data.spots;
                        this.filter = event.data.filter;
                        this.maxSpots = event.data.maxSpots;
                        this.availableBands = event.data.availableBands;
                        this.availableModes = event.data.availableModes;
                        this.availableContinents = event.data.availableContinents;
                        this.availableCQs = event.data.availableCQs;
                        this.availableCallStatuses = event.data.availableCallStatuses;
                        this.availableDxccStatuses = event.data.availableDxccStatuses;
                        this.availableSpecials = event.data.availableSpecials;
                        this.availableSpotCounts = event.data.availableSpotCounts;
                    }
                };
                
                // Close dropdowns when clicking outside
                document.addEventListener('click', (e) => {
                    if (!e.target.closest('.multiselect')) {
                        this.openDropdown = null;
                    }
                });
                
                // Notify main window when this window closes
                window.addEventListener('beforeunload', () => {
                    this.channel.postMessage({ type: 'windowClosed' });
                });
            },
            
            methods: {
                tuneToSpot(spot) {
                    this.channel.postMessage({
                        type: 'tuneToSpot',
                        spot: spot
                    });
                },
                
                toggleDropdown(name) {
                    this.openDropdown = this.openDropdown === name ? null : name;
                },
                
                toggleFilterItem(filterName, value) {
                    const index = this.filter[filterName].indexOf(value);
                    if (index > -1) {
                        this.filter[filterName].splice(index, 1);
                    } else {
                        this.filter[filterName].push(value);
                    }
                    this.notifyFilterChange();
                },
                
                clearFilters() {
                    this.filter = {
                        callsign: '',
                        bands: [],
                        modes: [],
                        continents: [],
                        cqs: [],
                        callStatuses: [],
                        dxccStatuses: [],
                        specials: [],
                    };
                    this.notifyFilterChange();
                },
                
                notifyFilterChange() {
                    this.channel.postMessage({
                        type: 'filterUpdate',
                        filter: this.filter,
                        maxSpots: this.maxSpots
                    });
                },
                
                formatTime(timestamp) {
                    if (!timestamp) return '-';
                    const date = new Date(timestamp * 1000);
                    return date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
                },
                
                formatFrequency(freq) {
                    if (!freq) return '-';
                    // Display frequency exactly as cluster provides it (string kHz with full precision)
                    // If it's a string, return it directly; if it's a number, format it
                    if (typeof freq === 'string') {
                        return freq + ' kHz';  // Add unit to match cluster display format
                    }
                    const numFreq = parseFloat(freq);
                    // Fallback: Convert to string and show up to 6 decimal places, removing trailing zeros
                    const formatted = numFreq.toFixed(6).replace(/\.?0+$/, '');
                    return formatted + ' kHz';
                },
                
                getStatusClass(status) {
                    if (!status) return '';
                    const s = status.toLowerCase();
                    if (s.includes('new call')) return 'status-new-call';
                    if (s.includes('new band')) return 'status-new-band';
                    if (s.includes('worked')) return 'status-worked';
                    if (s.includes('confirmed')) return 'status-confirmed';
                    return '';
                },
            },
        });
        
        app.mount('#app');
    </script>
</body>
</html>
            `;
        },
        
        // Set maximum spots to display
        setMaxSpots(count) {
            this.maxSpots = count;
            // Trim existing spots if needed
            if (this.dxSpots.length > this.maxSpots) {
                this.dxSpots = this.dxSpots.slice(0, this.maxSpots);
            }
            this.openDropdown = null;
            console.log(`📊 Max spots set to: ${this.maxSpots}`);
        },
        
        // Check if filter is active
        isFilterActive(filterName) {
            const f = this.spotsFilter;
            switch(filterName) {
                case 'bands': return f.bands.length > 0;
                case 'modes': return f.modes.length > 0;
                case 'spotters': return f.spotters.length > 0;
                case 'continents': return f.continents.length > 0;
                case 'zones': return f.cqs.length > 0;
                case 'callStatus': return f.callStatuses.length > 0;
                case 'dxccStatus': return f.dxccStatuses.length > 0;
                case 'special': return f.specials.length > 0;
                case 'call': return f.callsign !== '';
                default: return false;
            }
        },
        
        formatSpotTime(timestamp) {
            if (!timestamp) return '';
            const date = new Date(timestamp);
            return date.toISOString().substr(11, 8);
        },
        
        // === Status Color Styling ===
        
        getCallStatusStyle(status) {
            const colors = {
                'New Call': '#FF6B35',        // Orange-Red (exciting new contact!)
                'New Band': '#4A9EFF',        // Bright Blue  
                'New Mode': '#FFD93D',        // Yellow
                'New Band+Mode': '#E91E63',   // Pink (special combo!)
                'Worked': '#B0B0B0',          // Gray
                'Confirmed': '#10B981'        // Green
            };
            const color = colors[status] || '#fff';
            return `font-size: 13px; font-weight: bold; color: ${color};`;
        },
        
        getDxccStatusStyle(status) {
            const colors = {
                'ATNO': '#FF6B35',            // Orange-Red (All Time New One - HUGE!)
                'C/New Band': '#4A9EFF',      // Bright Blue (confirmed country, new band)
                'C/New Mode': '#FFD93D',      // Yellow (confirmed country, new mode)
                'C/New Band+Mode': '#9C27B0', // Purple (confirmed country, new combo)
                'W/New Band': '#00BCD4',      // Cyan (worked country, new band)
                'W/New Mode': '#FFA726',      // Orange (worked country, new mode)
                'W/New Band+Mode': '#FF5722', // Deep Orange (worked country, new combo)
                'Worked': '#B0B0B0',          // Gray
                'Confirmed': '#10B981',       // Green
                'Unknown': '#666666'          // Dark Gray (unresolved DXCC)
            };
            const color = colors[status] || '#fff';
            return `font-size: 13px; font-weight: bold; color: ${color};`;
        },
        
        // === Utility Functions ===
        
        formatFrequency(freq) {
            if (!freq) return '----.------';
            
            // Format as MHz: 014.074.000
            const mhz = freq.toFixed(6);
            const parts = mhz.split('.');
            const intPart = parts[0].padStart(3, '0');
            const decPart = parts[1] || '000000';
            
            return `${intPart}.${decPart.substring(0, 3)}.${decPart.substring(3, 6)}`;
        },
        
        showStatus(text, type = 'success') {
            this.statusMessage = { text, type };
            setTimeout(() => {
                this.statusMessage = null;
            }, 3000);
        },
        
        updateClock() {
            const now = new Date();
            this.currentTime = now.toISOString().substr(11, 8);
            
            // Also update the logging form's UTC time if form is visible/open
            if (this.loggingForm && !this.loggingPanelSectionCollapsed) {
                const h = String(now.getUTCHours()).padStart(2, '0');
                const m = String(now.getUTCMinutes()).padStart(2, '0');
                const s = String(now.getUTCSeconds()).padStart(2, '0');
                this.loggingForm.time_off = `${h}:${m}:${s}`;
            }
        },
        
        // === RIT/XIT Controls ===
        
        async toggleRIT() {
            this.ritEnabled = !this.ritEnabled;
            console.log('RIT:', this.ritEnabled);
            await this.sendCommand('rit', { enabled: this.ritEnabled, freq_hz: this.ritValue });
        },
        
        async adjustRIT(direction) {
            // Adjust by current step
            const step = this.getStepValue();
            this.ritValue += direction * step;
            
            // Auto-enable RIT when adjusting
            if (!this.ritEnabled) {
                this.ritEnabled = true;
            }
            
            console.log('RIT adjusted to:', this.ritValue);
            await this.sendCommand('rit', { enabled: true, freq_hz: Math.round(this.ritValue) });
        },
        
        async toggleXIT() {
            this.xitEnabled = !this.xitEnabled;
            console.log('XIT:', this.xitEnabled);
            await this.sendCommand('xit', { enabled: this.xitEnabled, freq_hz: this.xitValue });
        },
        
        async adjustXIT(direction) {
            // Adjust by current step
            const step = this.getStepValue();
            this.xitValue += direction * step;
            
            // Auto-enable XIT when adjusting
            if (!this.xitEnabled) {
                this.xitEnabled = true;
            }
            
            console.log('XIT adjusted to:', this.xitValue);
            await this.sendCommand('xit', { enabled: true, freq_hz: Math.round(this.xitValue) });
        },
        
        // === Rotator Control ===
        
        async rotorGoto() {
            if (!this.rotorEnabled) {
                alert('Rotator not enabled');
                return;
            }
            
            if (this.rotorAzimuth === '' || this.rotorAzimuth === null || isNaN(this.rotorAzimuth)) {
                alert('Please enter a valid azimuth (0-359)');
                return;
            }
            
            const az = Math.round(this.rotorAzimuth);
            if (az < 0 || az > 359) {
                alert('Azimuth must be 0-359 degrees');
                return;
            }
            
            try {
                const response = await fetch('/api/rotor/goto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ azimuth: az })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    console.log('Rotor GOTO:', data);
                    this.rotorAzimuth = az;
                } else {
                    alert('Rotor command failed: ' + response.statusText);
                }
            } catch (error) {
                console.error('Rotor GOTO error:', error);
                alert('Error: ' + error.message);
            }
        },
        
        validateAzimuth(event) {
            // Only accept numeric input, strip everything else
            let input = event.target.value;
            let numeric = input.replace(/[^0-9]/g, '');
            
            // If empty, allow it
            if (numeric === '') {
                this.rotorAzimuth = '';
                return;
            }
            
            // Convert to number and clamp to 0-359
            let value = parseInt(numeric, 10);
            if (value > 359) {
                value = 359;
            }
            
            this.rotorAzimuth = value;
        },
        
        async rotorDirection(direction) {
            if (!this.rotorEnabled) {
                alert('Rotator not enabled');
                return;
            }
            
            // Map direction to azimuth
            const azimuths = { 'N': 0, 'E': 90, 'S': 180, 'W': 270 };
            const az = azimuths[direction];
            
            if (this.rotorPreset === 'shortpath') {
                // Short path: same direction
                // Do nothing extra
            } else if (this.rotorPreset === 'longpath') {
                // Long path: opposite direction (add 180°)
                // For now, just use normal direction
            }
            
            try {
                const response = await fetch('/api/rotor/direction', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ direction: direction })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    console.log('Rotor direction:', data);
                    this.rotorAzimuth = az;
                } else {
                    alert('Rotor command failed: ' + response.statusText);
                }
            } catch (error) {
                console.error('Rotor direction error:', error);
                alert('Error: ' + error.message);
            }
        },
        
        async checkRotorStatus() {
            if (!this.rotorEnabled) {
                return;
            }
            
            try {
                const response = await fetch('/api/rotor/status');
                if (response.ok) {
                    const data = await response.json();
                    this.rotorConnected = data.enabled && data.azimuth !== null;
                    // Only update if input is NOT focused (not typing)
                    if (data.azimuth !== null && !this.rotorInputFocused) {
                        this.rotorAzimuth = data.azimuth;
                    }
                }
            } catch (error) {
                console.error('Rotor status error:', error);
                this.rotorConnected = false;
            }
        },
        
        async handleDirectorToggle() {
            if (!this.rotorEnabled) {
                return;
            }
            
            if (!this.rotorPreset || this.rotorPreset === '') {
                return;
            }
            
            // Get current azimuth and toggle by 180 degrees
            let newAz = this.rotorAzimuth + 180;
            if (newAz >= 360) {
                newAz = newAz - 360;
            }
            
            console.log(`🌐 Director toggle: ${this.rotorPreset} at ${this.rotorAzimuth}° → ${Math.round(newAz)}°`);
            
            try {
                const response = await fetch('/api/rotor/goto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ azimuth: Math.round(newAz) })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    this.rotorAzimuth = Math.round(newAz);
                    console.log('✅ Rotor director toggled:', data);
                } else {
                    alert('Rotor command failed: ' + response.statusText);
                }
            } catch (error) {
                console.error('Rotor director toggle error:', error);
                alert('Error: ' + error.message);
            }
        },
        
        // === Rotor AUTO Control ===
        
        async loadRotorAutoConfig() {
            try {
                const response = await fetch('/api/rotor/auto/status');
                if (response.ok) {
                    const data = await response.json();
                    this.rotorAutoEnabled = data.auto_enabled || false;
                    this.rotorHomeGrid = data.home_grid || 'JN88TQ';
                    this.rotorHomeLat = data.home_lat || 48.17;
                    this.rotorHomeLon = data.home_lon || 17.08;
                    this.rotorBands = data.bands || {};
                    console.log('✅ Rotor AUTO config loaded:', { grid: this.rotorHomeGrid, auto: this.rotorAutoEnabled });
                }
            } catch (error) {
                console.error('Failed to load rotor AUTO config:', error);
            }
        },
        
        async saveRotorAutoConfig() {
            if (!this.rotorEnabled) {
                alert('Rotator not enabled');
                return;
            }
            
            try {
                const response = await fetch('/api/rotor/auto/config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        home_grid: this.rotorHomeGrid.toUpperCase().trim(),
                        home_lat: parseFloat(this.rotorHomeLat),
                        home_lon: parseFloat(this.rotorHomeLon),
                        bands: this.rotorBands,
                        auto_enabled: this.rotorAutoEnabled
                    })
                });
                
                if (response.ok) {
                    const data = await response.json();
                    console.log('✅ Rotor AUTO config saved:', data);
                    this.showStatus('Rotor AUTO config updated', 'success');
                } else {
                    alert('Failed to save rotor AUTO config');
                }
            } catch (error) {
                console.error('Rotor AUTO config save error:', error);
                alert('Error: ' + error.message);
            }
        },
        
        toggleRotorAuto() {
            if (!this.rotorEnabled) {
                alert('Rotator not enabled');
                return;
            }
            
            this.rotorAutoEnabled = !this.rotorAutoEnabled;
            console.log(`🤖 Rotor AUTO ${this.rotorAutoEnabled ? 'ENABLED' : 'DISABLED'}`);
            this.saveRotorAutoConfig();
        },
        
        cancelRotorAuto() {
            if (this.rotorAutoTimer) {
                clearTimeout(this.rotorAutoTimer);
                this.rotorAutoTimer = null;
            }
            this.rotorAutoPending = null;
            console.log('⏸️  Rotor AUTO action cancelled');
        },
        
        async rotorAutoGoto(callsign, frequency_khz, gridsquare, latitude, longitude) {
            // Only proceed if AUTO is enabled
            if (!this.rotorAutoEnabled || !this.rotorEnabled) {
                return;
            }
            
            // Cancel any pending AUTO action
            this.cancelRotorAuto();
            
            // Set pending info
            this.rotorAutoPending = { callsign, frequency_khz, gridsquare, latitude, longitude };
            const delayMs = (this.configData.ROTOR_AUTO_DELAY_SEC || 2.0) * 1000;
            console.log(`⏱️  Rotor AUTO pending: ${callsign} - waiting ${delayMs/1000}s for cancellation`);
            
            // 2-second delay before actually moving
            this.rotorAutoTimer = setTimeout(async () => {
                if (this.rotorAutoPending === null) {
                    return; // Already cancelled
                }
                
                try {
                    const response = await fetch('/api/rotor/auto/goto', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            callsign: callsign,
                            frequency_khz: frequency_khz,
                            gridsquare: gridsquare,
                            latitude: latitude,
                            longitude: longitude
                        })
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        if (data.ok) {
                            console.log(`✅ AUTO rotor moved to ${data.bearing}°: ${callsign}`);
                            this.showStatus(`🤖 Rotor → ${data.bearing}° for ${callsign}`, 'success');
                            
                            // Update beaming display with SP/LP info
                            this.currentBeamingCallsign = callsign;
                            this.shortPathBearing = Math.round(data.bearing * 10) / 10;
                            this.longPathBearing = (this.shortPathBearing + 180) % 360;
                            this.lastBeamingTime = new Date();
                        } else {
                            console.log(`ℹ️  Rotor AUTO not executed: ${data.message}`);
                        }
                    } else {
                        console.error('Rotor AUTO GOTO failed:', response.statusText);
                    }
                } catch (error) {
                    console.error('Rotor AUTO GOTO error:', error);
                } finally {
                    this.rotorAutoTimer = null;
                    this.rotorAutoPending = null;
                }
            }, delayMs);
        },
        
        // Manual rotor GO for short path bearing
        async rotorGotoShortPath() {
            if (this.shortPathBearing === null) {
                alert('No short path bearing available');
                return;
            }
            this.rotorAzimuth = this.shortPathBearing;
            await this.rotorGoto();
        },
        
        // Manual rotor GO for long path bearing
        async rotorGotoLongPath() {
            if (this.longPathBearing === null) {
                alert('No long path bearing available');
                return;
            }
            this.rotorAzimuth = this.longPathBearing;
            await this.rotorGoto();
        },
        
        // === Step Controls ===
        
        cycleStep() {
            const mode = this.radioStatus.mode || 'USB';
            const steps = this.stepsByMode[mode] || this.stepsByMode['USB'];
            this.currentStepIndex = (this.currentStepIndex + 1) % steps.length;
            console.log('Step changed to:', this.currentStep);
        },
        
        getStepValue() {
            // Convert step string to Hz value
            const stepStr = this.currentStep;
            if (stepStr.includes('kHz')) {
                return parseFloat(stepStr) * 1000;
            } else {
                return parseFloat(stepStr);
            }
        },
        
        // === AGC Cycling ===
        
        cycleAGC() {
            const modes = ['off', 'slow', 'med', 'fast'];
            const currentIndex = modes.indexOf(this.radioStatus.agc_mode || 'med');
            const nextIndex = (currentIndex + 1) % modes.length;
            this.setAGC(modes[nextIndex]);
        },
        
        // === Frequency Controls ===
        
        async adjustFrequency(direction) {
            // Adjust frequency by current step
            const step = this.getStepValue();
            const stepMhz = step / 1000000; // Convert Hz to MHz
            const newFreq = this.radioStatus.frequency + (direction * stepMhz);
            
            // Bounds check (0.5 MHz to 54 MHz)
            if (newFreq >= 0.5 && newFreq <= 54.0) {
                console.log(`Adjusting frequency by ${direction * stepMhz} MHz to ${newFreq.toFixed(6)} MHz`);
                await this.sendCommand('frequency', { frequency: newFreq });
            }
        },
        
        handleFrequencyKeydown(event) {
            // Handle arrow keys for frequency adjustment
            if (event.key === 'ArrowUp' || event.key === 'ArrowRight') {
                event.preventDefault();
                this.adjustFrequency(1);
            } else if (event.key === 'ArrowDown' || event.key === 'ArrowLeft') {
                event.preventDefault();
                this.adjustFrequency(-1);
            }
        },
        
        handleFrequencyWheel(event) {
            // Handle mouse wheel for frequency adjustment
            event.preventDefault();
            const direction = event.deltaY < 0 ? 1 : -1;
            this.adjustFrequency(direction);
        },
        
        // === Configuration Dialog ===
        
        async showConfigDialog() {
            console.log('Opening configuration dialog...');
            this.configMessage = null;
            this.activeConfigTab = 'database';
            
            // Load current configuration
            try {
                const response = await fetch('/api/config');
                const data = await response.json();
                
                if (data.success) {
                    this.configData = { ...this.configData, ...data.config };
                    console.log('Configuration loaded:', this.configData);
                }
            } catch (error) {
                console.error('Failed to load configuration:', error);
                this.configMessage = {
                    type: 'error',
                    text: 'Failed to load configuration: ' + error.message
                };
            }
            
            this.showConfigModal = true;
        },
        
        closeConfigDialog() {
            console.log('Closing configuration dialog');
            this.showConfigModal = false;
            this.configMessage = null;
        },
        
        async saveConfiguration() {
            console.log('Saving configuration...', this.configData);
            this.configMessage = null;
            
            try {
                const response = await fetch('/api/config', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ config: this.configData })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    this.configMessage = {
                        type: 'success',
                        text: data.message || 'Configuration saved successfully! Please restart the application for changes to take effect.'
                    };
                    console.log('✅ Configuration saved successfully');
                    
                    // Auto-close after 3 seconds
                    setTimeout(() => {
                        if (this.showConfigModal) {
                            this.closeConfigDialog();
                        }
                    }, 3000);
                } else {
                    this.configMessage = {
                        type: 'error',
                        text: 'Failed to save configuration: ' + (data.message || 'Unknown error')
                    };
                }
            } catch (error) {
                console.error('Failed to save configuration:', error);
                this.configMessage = {
                    type: 'error',
                    text: 'Failed to save configuration: ' + error.message
                };
            }
        },
        
        // === QSO Logging Methods ===
        
        async autoPopulateForm() {
            // Auto-populate from DX spots when callsign is entered manually
            const callsign = this.loggingForm.callsign.toUpperCase();
            
            // Look for matching spot
            const spot = this.dxSpots.find(s => s.callsign === callsign);
            if (spot) {
                // Found matching spot - use spot data with full precision
                this.loggingForm.frequency = spot.frequency;
                this.loggingForm.mode = spot.mode || '';
                
                // Auto-populate from comments if available (POTA/SOTA/etc)
                if (spot.comment) {
                    this.loggingForm.notes = spot.comment;
                }
            } else {
                // No matching spot - use current radio frequency/mode with full precision
                this.loggingForm.mode = this.radioStatus.mode || '';
                this.loggingForm.frequency = this.radioStatus.frequency || 0;
            }
            
            // Auto-populate RST based on mode
            this.autoPopulateRST();
            
            // Load QRZ profile and DXCC status
            await this.loadQRZProfile();
            await this.loadDXCCStatus();
        },
        
        async loadQRZProfile() {
            const callsign = this.loggingForm.callsign.trim().toUpperCase();
            if (!callsign) return;
            
            this.qrzLoading = true;
            try {
                const encodedCallsign = encodeURIComponent(callsign);
                const response = await fetch(`/api/qrz/profile/${encodedCallsign}`);
                this.qrzProfile = await response.json();
                
                if (this.qrzProfile.success) {
                    // ✅ IMPORTANT: Clear fields that might not be in QRZ profile to avoid retaining previous values
                    this.loggingForm.name = '';
                    this.loggingForm.qth = '';
                    this.loggingForm.gridsquare = '';
                    this.loggingForm.country = '';
                    this.loggingForm.state = '';
                    this.loggingForm.continent = '';
                    this.loggingForm.cq_zone = '';
                    this.loggingForm.itu_zone = '';
                    this.loggingForm.email = '';  // ✅ CRITICAL FIX: Always clear email to prevent retention from previous QSO
                    
                    // Station Tab - Auto-populate from QRZ
                    if (this.qrzProfile.name) {
                        this.loggingForm.name = this.qrzProfile.name;
                    }
                    if (this.qrzProfile.state || this.qrzProfile.country) {
                        // Build location string from state and country
                        const locParts = [];
                        if (this.qrzProfile.state) locParts.push(this.qrzProfile.state);
                        if (this.qrzProfile.country) locParts.push(this.qrzProfile.country);
                        if (locParts.length > 0) {
                            this.loggingForm.qth = locParts.join(', ');
                        }
                    }
                    
                    // General Tab - Auto-populate from QRZ
                    if (this.qrzProfile.country) {
                        this.loggingForm.country = this.qrzProfile.country;
                    }
                    if (this.qrzProfile.state) {
                        this.loggingForm.state = this.qrzProfile.state;
                    }
                    if (this.qrzProfile.cont) {
                        this.loggingForm.continent = this.qrzProfile.cont;
                    }
                    if (this.qrzProfile.cqzone) {
                        this.loggingForm.cq_zone = this.qrzProfile.cqzone;
                    }
                    if (this.qrzProfile.ituzone) {
                        this.loggingForm.itu_zone = this.qrzProfile.ituzone;
                    }
                    if (this.qrzProfile.grid) {
                        this.loggingForm.gridsquare = this.qrzProfile.grid;
                    }
                    if (this.qrzProfile.email) {
                        this.loggingForm.email = this.qrzProfile.email;
                    }
                    
                    // Load Wavelog data to fill in any missing fields
                    await this.loadWavelogProfile();
                    
                    // Trigger AUTO rotor if enabled
                    const gridsquare = this.qrzProfile.grid || null;
                    const frequency_khz = this.loggingForm.frequency * 1000;  // Convert MHz to kHz
                    this.rotorAutoGoto(callsign, frequency_khz, gridsquare, null, null);
                    
                    // Also load history
                    const histResponse = await fetch(`/api/qrz/history/${encodedCallsign}?limit=8`);
                    const histData = await histResponse.json();
                    this.qrzHistory = histData.data || [];
                }
            } catch (error) {
                console.error('QRZ profile error:', error);
                this.qrzProfile = { success: false };
            } finally {
                this.qrzLoading = false;
            }
        },
        
        async loadWavelogProfile() {
            // Use Wavelog private_lookup to get additional data
            const callsign = this.loggingForm.callsign.trim().toUpperCase();
            if (!callsign) return;
            
            try {
                const response = await fetch('/api/wavelog/private_lookup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callsign: callsign,
                        band: this.freqToBand(this.loggingForm.frequency) || '20m',
                        mode: this.loggingForm.mode || 'SSB'
                    })
                });
                
                const data = await response.json();
                if (data && typeof data === 'object') {
                    // Fill in missing fields from Wavelog
                    if (data.gridsquare && !this.loggingForm.gridsquare) {
                        this.loggingForm.gridsquare = data.gridsquare;
                    }
                    if (data.cont && !this.loggingForm.continent) {
                        this.loggingForm.continent = data.cont;
                    }
                    if (data.cqz && !this.loggingForm.cq_zone) {
                        this.loggingForm.cq_zone = data.cqz;
                    }
                    if (data.ituz && !this.loggingForm.itu_zone) {
                        this.loggingForm.itu_zone = data.ituz;
                    }
                    if (data.state && !this.loggingForm.state) {
                        this.loggingForm.state = data.state;
                    }
                    if (data.county && !this.loggingForm.us_county) {
                        this.loggingForm.us_county = data.county;
                    }
                    if (data.name && !this.loggingForm.name) {
                        this.loggingForm.name = data.name;
                    }
                    if (data.qsl_manager && !this.loggingForm.qsl_manager) {
                        this.loggingForm.qsl_manager = data.qsl_manager;
                    }
                }
            } catch (error) {
                console.error('Wavelog lookup error:', error);
                // Silently fail - this is optional enhancement
            }
        },
        
        async loadDXCCStatus() {
            const callsign = this.loggingForm.callsign.trim().toUpperCase();
            if (!callsign) return;
            
            this.dxccLoading = true;
            try {
                // Use private_lookup API with optional band and mode parameters
                const band = this.loggingForm.frequency ? this.freqToBand(this.loggingForm.frequency) : null;
                const mode = this.loggingForm.mode || null;
                
                const response = await fetch('/api/wavelog/private_lookup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callsign: callsign,
                        band: band || '20m',
                        mode: mode || 'SSB'
                    })
                });
                this.dxccStatus = await response.json();
                
                // Parse private_lookup data
                if (this.dxccStatus.success && this.dxccStatus.data) {
                    this.dxccBands = this.parseDXCCData(this.dxccStatus.data);
                }
            } catch (error) {
                console.error('DXCC status error:', error);
                this.dxccStatus = { success: false };
            } finally {
                this.dxccLoading = false;
            }
            
            // Load previous QSOs
            this.loadPreviousQSOs();
        },
        
        async loadPreviousQSOs() {
            const callsign = this.loggingForm.callsign.trim().toUpperCase();
            if (!callsign) {
                this.previousQSOs = [];
                return;
            }
            
            this.previousQSOsLoading = true;
            try {
                console.log(`[Previous QSOs] 🔍 Loading for callsign: ${callsign}`);
                
                const response = await fetch('/api/wavelog/recent_qsos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        callsign: callsign,
                        limit: 5
                    })
                });
                
                const result = await response.json();
                console.log(`[Previous QSOs] 📡 Full response:`, result);
                
                if (result.success && result.data) {
                    // Handle both array and object responses
                    const qsos = Array.isArray(result.data) ? result.data : [];
                    console.log(`[Previous QSOs] ✅ Received ${qsos.length} QSOs`);
                    
                    if (qsos.length > 0) {
                        console.log(`[Previous QSOs] 📋 First QSO:`, JSON.stringify(qsos[0], null, 2));
                        console.log(`[Previous QSOs] 📋 All QSOs:`, JSON.stringify(qsos, null, 2));
                    } else {
                        console.warn(`[Previous QSOs] ⚠️ Response marked success but no QSOs found`);
                    }
                    
                    this.previousQSOs = qsos.slice(0, 5);  // Ensure max 5 QSOs
                    console.log(`[Previous QSOs] ✅ Set previousQSOs array (length: ${this.previousQSOs.length})`);
                } else {
                    console.warn(`[Previous QSOs] ❌ No success or data in response for ${callsign}. Result:`, result);
                    this.previousQSOs = [];
                }
            } catch (error) {
                console.error('[Previous QSOs] ❌ Error loading:', error);
                console.error('[Previous QSOs] Stack:', error.stack);
                this.previousQSOs = [];
            } finally {
                this.previousQSOsLoading = false;
            }
        },
        
        autoPopulateRST() {
            // Auto-populate RST values based on current mode
            const mode = this.loggingForm.mode || this.radioStatus.mode || '';
            
            // Voice modes get 2-digit RST (59)
            const voiceModes = ['SSB', 'USB', 'LSB', 'AM', 'FM', 'NFM', 'SAM', 'DFM'];
            
            // CW and digital modes get 3-digit RST (599)
            const digitalModes = ['CW', 'RTTY', 'DIGL', 'DIGU', 'PSK', 'FT8', 'FT4', 'JT65', 'DIGI'];
            
            if (voiceModes.includes(mode.toUpperCase())) {
                this.loggingForm.rst_sent = 59;
                this.loggingForm.rst_received = 59;
            } else if (digitalModes.includes(mode.toUpperCase()) || mode.toUpperCase() === 'CW') {
                this.loggingForm.rst_sent = 599;
                this.loggingForm.rst_received = 599;
            } else {
                // Default to 599 for unknown modes
                this.loggingForm.rst_sent = 599;
                this.loggingForm.rst_received = 599;
            }
        },
        
        freqToBand(frequency) {
            // Convert frequency in MHz to band designation
            if (!frequency) return null;
            const freq = parseFloat(frequency);
            if (freq >= 1.8 && freq < 2) return '160m';
            if (freq >= 3.5 && freq < 4) return '80m';
            if (freq >= 5.3 && freq < 5.4) return '60m';
            if (freq >= 7 && freq < 7.3) return '40m';
            if (freq >= 10.1 && freq < 10.15) return '30m';
            if (freq >= 14 && freq < 14.35) return '20m';
            if (freq >= 18.068 && freq < 18.168) return '17m';
            if (freq >= 21 && freq < 21.45) return '15m';
            if (freq >= 24.89 && freq < 24.99) return '12m';
            if (freq >= 28 && freq < 29.7) return '10m';
            if (freq >= 50 && freq < 54) return '6m';
            if (freq >= 144 && freq < 148) return '2m';
            if (freq >= 430 && freq < 450) return '70cm';
            return null;
        },
        
        parseDXCCData(data) {
            // Parse DXCC data from private_lookup response
            // With the new private_lookup API, data is already in the right format
            // and displayed directly in the HTML, so we don't need a matrix structure
            // Return empty object as dxccBands is no longer used with new display format
            return {};
        },
        
        getDXCCStatus(mode, band) {
            // Return CSS class for DXCC cell
            const status = this.dxccBands[mode]?.[band] || 'notworked';
            return {
                'confirmed': status === 'confirmed' || status === 'C',
                'worked': status === 'worked' || status === 'W',
                'needed': status === 'needed',
                'notworked': status === 'notworked' || status === '-'
            };
        },
        
        getDXCCText(mode, band) {
            // Return text for DXCC cell
            const status = this.dxccBands[mode]?.[band] || 'notworked';
            const textMap = {
                'confirmed': 'C',
                'worked': 'W',
                'needed': 'N',
                'notworked': '-',
                'C': 'C',
                'W': 'W',
                '-': '-'
            };
            return textMap[status] || '-';
        },
        
        formatDate(dateStr) {
            if (!dateStr) return '';
            try {
                const date = new Date(dateStr);
                return date.toLocaleDateString();
            } catch {
                return dateStr;
            }
        },
        
        async submitQSO() {
            // Ensure RST values are populated based on mode
            this.autoPopulateRST();
            
            // Validate required fields
            if (!this.loggingForm.callsign.trim()) {
                this.showLoggingStatus('error', '❌ Callsign is required');
                return;
            }
            
            if (!this.loggingForm.frequency || this.loggingForm.frequency <= 0) {
                this.showLoggingStatus('error', '❌ Valid frequency is required');
                return;
            }
            
            if (!this.loggingForm.mode) {
                this.showLoggingStatus('error', '❌ Mode is required');
                return;
            }
            
            // Ensure RST values are valid integers
            const rstSent = parseInt(this.loggingForm.rst_sent) || 599;
            const rstRcvd = parseInt(this.loggingForm.rst_received) || 599;
            
            if (rstSent < 1 || rstSent > 999) {
                this.showLoggingStatus('error', '❌ RST Sent must be 1-999');
                return;
            }
            
            if (rstRcvd < 1 || rstRcvd > 999) {
                this.showLoggingStatus('error', '❌ RST Received must be 1-999');
                return;
            }
            
            this.loggingStatus = { type: 'loading', message: '⏳ Logging QSO...' };
            
            try {
                // Prepare QSO data with uppercase callsign and proper frequency format (3 decimal places)
                const frequency = parseFloat(this.loggingForm.frequency);
                const qsoData = {
                    ...this.loggingForm,
                    callsign: this.loggingForm.callsign.trim().toUpperCase(),
                    frequency: parseFloat(frequency),  // Keep full precision
                    rst_sent: rstSent,
                    rst_received: rstRcvd
                };
                
                const response = await fetch('/api/qso/log', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(qsoData)
                });
                
                const data = await response.json();
                
                if (data.success || data.wavelog?.success) {
                    this.showLoggingStatus('success', `✅ QSO logged: ${qsoData.callsign}`);
                    
                    // === TRIGGER ROTOR AUTO IF ENABLED (for manually logged QSO) ===
                    if (this.rotorAutoEnabled && this.rotorEnabled) {
                        const frequencyKhz = qsoData.frequency * 1000;
                        const gridsquare = qsoData.gridsquare || null;
                        const latitude = qsoData.latitude || null;
                        const longitude = qsoData.longitude || null;
                        console.log(`🤖 AUTO rotor triggered for manual QSO: ${qsoData.callsign} on ${qsoData.frequency} MHz`);
                        this.rotorAutoGoto(qsoData.callsign, frequencyKhz, gridsquare, latitude, longitude);
                    }
                    
                    // Clear form after successful submission
                    setTimeout(() => this.clearLoggingForm(), 2000);
                } else {
                    const errorMsg = data.message || data.wavelog?.message || 'Failed to log QSO';
                    this.showLoggingStatus('error', `❌ ${errorMsg}`);
                }
            } catch (error) {
                console.error('QSO submission error:', error);
                this.showLoggingStatus('error', `❌ Error: ${error.message}`);
            }
        },
        
        showLoggingStatus(type, message) {
            this.loggingStatus = { type, message };
            
            // Auto-clear after 5 seconds
            if (type !== 'loading') {
                setTimeout(() => {
                    if (this.loggingStatus?.type === type) {
                        this.loggingStatus = null;
                    }
                }, 5000);
            }
        },
        
        clearLoggingForm() {
            // Get current UTC time
            const now = new Date();
            const utcHours = String(now.getUTCHours()).padStart(2, '0');
            const utcMinutes = String(now.getUTCMinutes()).padStart(2, '0');
            const utcSeconds = String(now.getUTCSeconds()).padStart(2, '0');
            const currentUtcTime = `${utcHours}:${utcMinutes}:${utcSeconds}`;
            
            this.loggingForm = {
                // Station Tab
                callsign: '',
                date: new Date().toISOString().split('T')[0],
                time_off: currentUtcTime,
                frequency: this.radioStatus.frequency || null,
                mode: this.radioStatus.mode || 'SSB',  // Default to SSB if no mode
                rst_sent: 599,  // Default RST values
                rst_received: 599,
                name: '',
                qth: '',
                gridsquare: '',
                pota: '',
                sota: '',
                wwff: '',
                iota: '',
                notes: '',
                
                // General Tab
                continent: '',
                cq_zone: '',
                itu_zone: '',
                region: '',
                country: '',
                state: '',
                us_county: '',
                tx_pwr: '',
                ant: '',
                
                // QSL Tab
                qsl_rcvd: 'N',
                qsl_sent: 'N',
                lotw_member: false,
                qsl_manager: '',
                email: '',
                
                // SAT Tab
                prop_mode: '',
                ant_path: '',
                sat_name: '',
                sat_mode: '',
                freq_rx: '',
                mode_rx: '',
            };
            this.qrzProfile = {};
            this.activeLogTab = 'station';
            this.qrzHistory = [];
            this.dxccStatus = {};
            this.dxccBands = {};
            this.previousQSOs = [];
            this.loggingStatus = null;
        },
        
        onCallsignChange() {
            // Debounced callsign change handler - fetch DXCC and QRZ data
            if (this.dxccLookupTimer) {
                clearTimeout(this.dxccLookupTimer);
            }
            
            const callsign = this.loggingForm.callsign.trim();
            
            // Update beaming display immediately with callsign
            if (callsign.length >= 2) {
                this.currentBeamingCallsign = callsign.toUpperCase();
                this.shortPathBearing = null;  // Reset bearings, will be calculated on spot click
                this.longPathBearing = null;
            } else {
                // Clear beaming display if callsign is too short
                this.currentBeamingCallsign = null;
                this.shortPathBearing = null;
                this.longPathBearing = null;
                this.dxccStatus = {};
                this.qrzProfile = {};
                this.previousQSOs = [];
                return;
            }
            
            // Debounce 500ms to avoid too many API calls while typing
            this.dxccLookupTimer = setTimeout(() => {
                this.loadDXCCStatus();
                this.loadQRZProfile();
                this.loadPreviousQSOs();
            }, 500);
        },
        
        formatFrequency(freq) {
            // Format frequency with full precision, ensuring at least 3 decimal places
            // Example: 18.1 → "18.100", 18.145 → "18.145"
            if (!freq || freq === null || freq === undefined) return '';
            
            const freqNum = parseFloat(freq);
            if (isNaN(freqNum)) return '';
            
            // Use toLocaleString to avoid scientific notation, then format
            const freqStr = freqNum.toString();
            
            // If it has a decimal point, ensure at least 3 decimals
            if (freqStr.includes('.')) {
                const parts = freqStr.split('.');
                const decimals = parts[1];
                
                if (decimals.length < 3) {
                    // Pad with zeros to 3 decimal places
                    return freqNum.toFixed(3);
                }
                return freqStr;
            } else {
                // No decimal, add .000
                return freqNum.toFixed(3);
            }
        },
        
        formatQSODate(qsoDate) {
            // Format ADIF date (YYYYMMDD) with optional time to readable format
            if (!qsoDate) return '-';
            
            // Handle format: YYYYMMDD or YYYYMMDD HHMMSS
            const parts = qsoDate.trim().split(' ');
            const dateStr = parts[0];
            const timeStr = parts[1];
            
            if (dateStr.length === 8) {
                const year = dateStr.substring(0, 4);
                const month = dateStr.substring(4, 6);
                const day = dateStr.substring(6, 8);
                
                let result = `${month}/${day}/${year}`;
                
                if (timeStr && timeStr.length === 6) {
                    const hour = timeStr.substring(0, 2);
                    const min = timeStr.substring(2, 4);
                    result += ` ${hour}:${min}`;
                }
                
                return result;
            }
            
            return qsoDate;
        },
    },
}).mount('#app');

console.log('✅ Vue app mounted successfully');
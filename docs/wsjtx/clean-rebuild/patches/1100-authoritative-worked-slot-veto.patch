+bool MainWindow::om0rx_status_blocks_auto_call (QJsonObject const& status) const
+{
+  return status.value ("worked_same_band_mode").toBool (false);
+}
+
+void MainWindow::enforce_om0rx_authoritative_status (QJsonObject const& status,
+                                                      QString const& callsign)
+{
+  if (!om0rx_status_blocks_auto_call (status)) return;
+
+  auto const blocked_base = Radio::base_callsign (callsign);
+  auto const direct_base = Radio::base_callsign (m_om0rxDirectReplyCall);
+  auto const current_base = Radio::base_callsign (ui->dxCallEntry->text ());
+  if (blocked_base.isEmpty () || direct_base == blocked_base) return;
+
+  bool const selected = Radio::base_callsign (m_priorityCall) == blocked_base
+      || current_base == blocked_base;
+  if (!selected || (current_base == blocked_base && om0rx_qso_exchange_has_progressed ()))
+    return;
+
+  m_priorityCall.clear ();
+  m_priorityCallPreferCQTarget = false;
+  if (m_om0rxPriorityHuntActive
+      && Radio::base_callsign (m_om0rxPriorityHuntCall) == blocked_base)
+    clear_om0rx_priority_hunt ("authoritative worked band/mode veto");
+
+  if (current_base == blocked_base)
+    {
+      auto_tx_mode (false);
+      ui->stopTxButton->click ();
+      clearDX ();
+    }
+  log ("OM0RX authoritative worked band/mode veto released automatic target " + callsign);
+}

+struct PropagationAdaptationConfig
+{
+    bool enabled;
+    int windowSeconds;
+    int uniqueDecodeWeight;
+    int distantDecodeWeight;
+    int successfulQsoWeight;
+    int maxBandBoost;
+    PropagationAdaptationConfig() : enabled(true), windowSeconds(900),
+        uniqueDecodeWeight(20), distantDecodeWeight(40),
+        successfulQsoWeight(250), maxBandBoost(1500) {}
+};
+
+class BandProductivityTracker
+{
+public:
+    void observeDecode(int band, const QString &call, bool distant, const QDateTime &utc)
+    {
+        const QString key = QString::number(band) + "@" + AwardActivationIndex::baseCallsign(call);
+        m_lastDecode.insert(key, utc);
+        if (distant) m_lastDistantDecode.insert(key, utc);
+    }
+    void observeSuccessfulQso(int band, const QDateTime &utc) { m_lastSuccess.insert(band, utc); }
+    void prune(const QDateTime &now, int windowSeconds)
+    {
+        const int boundedWindow = qBound(60, windowSeconds, 86400);
+        for (auto it = m_lastDecode.begin(); it != m_lastDecode.end(); )
+            if (!it.value().isValid() || it.value().secsTo(now) > boundedWindow)
+                it = m_lastDecode.erase(it); else ++it;
+        for (auto it = m_lastDistantDecode.begin(); it != m_lastDistantDecode.end(); )
+            if (!it.value().isValid() || it.value().secsTo(now) > boundedWindow)
+                it = m_lastDistantDecode.erase(it); else ++it;
+        for (auto it = m_lastSuccess.begin(); it != m_lastSuccess.end(); )
+            if (!it.value().isValid() || it.value().secsTo(now) > boundedWindow)
+                it = m_lastSuccess.erase(it); else ++it;
+    }
+    int score(int band, const QDateTime &now, const PropagationAdaptationConfig &c) const
+    {
+        if (!c.enabled) return 0;
+        int unique = 0, distant = 0;
+        const QString prefix = QString::number(band) + "@";
+        for (auto it = m_lastDecode.constBegin(); it != m_lastDecode.constEnd(); ++it)
+            if (it.key().startsWith(prefix) && it.value().secsTo(now) <= c.windowSeconds) ++unique;
+        for (auto it = m_lastDistantDecode.constBegin(); it != m_lastDistantDecode.constEnd(); ++it)
+            if (it.key().startsWith(prefix) && it.value().secsTo(now) <= c.windowSeconds) ++distant;
+        qint64 value = static_cast<qint64>(unique) * c.uniqueDecodeWeight
+            + static_cast<qint64>(distant) * c.distantDecodeWeight;
+        if (m_lastSuccess.contains(band)
+                && m_lastSuccess.value(band).secsTo(now) <= c.windowSeconds)
+            value += c.successfulQsoWeight;
+        return static_cast<int>(qBound<qint64>(0, value, c.maxBandBoost));
+    }
+private:
+    QHash<QString, QDateTime> m_lastDecode;
+    QHash<QString, QDateTime> m_lastDistantDecode;
+    QHash<int, QDateTime> m_lastSuccess;
+};
+
+class OutcomeLearningIndex
+{
+public:
+    OutcomeLearningIndex() : m_enabled(false) {}
+
+    bool load(const QString &path, bool enabled)
+    {
+        m_scores.clear();
+        m_enabled = enabled;
+        if (!enabled) return true;
+        QFile file(path);
+        if (!file.open(QIODevice::ReadOnly | QIODevice::Text)) return false;
+        const qint64 tailBytes = 2 * 1024 * 1024;
+        if (file.size() > tailBytes) {
+            file.seek(file.size() - tailBytes);
+            file.readLine();
+        }
+        while (!file.atEnd()) {
+            const QJsonDocument doc = QJsonDocument::fromJson(file.readLine().trimmed());
+            if (!doc.isObject()) continue;
+            const QJsonObject row = doc.object();
+            if (row.value("schema").toString() != "om0rx.autodx.outcome.v1") continue;
+            const QString call = AwardActivationIndex::baseCallsign(row.value("call").toString());
+            if (call.isEmpty()) continue;
+            const bool completed = row.value("outcome").toString() == "completed";
+            record(call, completed);
+        }
+        return true;
+    }
+
+    void record(const QString &callsign, bool completed)
+    {
+        if (!m_enabled) return;
+        const QString call = AwardActivationIndex::baseCallsign(callsign);
+        if (call.isEmpty()) return;
+        if (!m_scores.contains(call) && m_scores.size() >= 5000) return;
+        m_scores.insert(call, qBound(-250, m_scores.value(call)
+            + (completed ? 75 : -25), 500));
+    }
+
+    int adjustment(const QString &callsign) const
+    {
+        return m_enabled
+            ? m_scores.value(AwardActivationIndex::baseCallsign(callsign), 0) : 0;
+    }
+    int callCount() const { return m_scores.size(); }
+
+private:
+    bool m_enabled;
+    QHash<QString, int> m_scores;
+};
+
+struct PileupStrategyConfig
+{
+    bool enabled;
+    QList<int> audioOffsetsHz;
+    int rotateAfterAttempts;
+    int revisitDelaySeconds;
+    PileupStrategyConfig() : enabled(true), rotateAfterAttempts(2), revisitDelaySeconds(120)
+    { audioOffsetsHz << 0 << -120 << 120 << -240 << 240; }
+
+    int audioFrequency(int baseHz, int attempt) const
+    {
+        if (!enabled || audioOffsetsHz.isEmpty()) return qBound(300, baseHz, 2700);
+        const int index = qMax(0, attempt) / qMax(1, rotateAfterAttempts);
+        return qBound(300, baseHz + audioOffsetsHz.at(index % audioOffsetsHz.size()), 2700);
+    }
+};

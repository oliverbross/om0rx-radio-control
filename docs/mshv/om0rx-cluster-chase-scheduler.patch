+
+void HvDxccTracker::loadConfirmedDxcc()
+{
+    m_confirmedDxcc.clear();
+    m_confirmedDxccBandMode.clear();
+    m_confirmedCalls.clear();
+    m_confirmedCallsBandMode.clear();
+    QFile file(m_appPath + "/settings/database/confirmed-dxcc.txt");
+    m_confirmationDataAvailable = file.open(QIODevice::ReadOnly | QIODevice::Text);
+    if (!m_confirmationDataAvailable) return;
+    while (!file.atEnd()) {
+        const QString line = QString::fromUtf8(file.readLine()).trimmed().toUpper();
+        if (line.isEmpty() || line.startsWith('#')) continue;
+        const QStringList fields = line.split('|');
+        if (fields.size() == 2 && fields.at(0) == "DXCC") {
+            bool ok = false;
+            const int entity = fields.at(1).toInt(&ok);
+            if (ok && entity > 0) m_confirmedDxcc.insert(entity);
+        } else if (fields.size() == 2 && fields.at(0) == "CALL") {
+            const QString call = extractBaseCall(fields.at(1));
+            if (!call.isEmpty()) m_confirmedCalls.insert(call);
+        } else if (fields.size() == 4 && fields.at(0) == "DXCC_BAND_MODE") {
+            bool entityOk = false, bandOk = false;
+            const int entity = fields.at(1).toInt(&entityOk);
+            const int band = fields.at(2).toInt(&bandOk);
+            if (entityOk && bandOk && entity > 0 && band > 0)
+                m_confirmedDxccBandMode.insert(QString("%1_%2_%3").arg(entity).arg(band).arg(fields.at(3)));
+        } else if (fields.size() == 4 && fields.at(0) == "CALL_BAND_MODE") {
+            bool bandOk = false;
+            const int band = fields.at(2).toInt(&bandOk);
+            const QString call = extractBaseCall(fields.at(1));
+            if (bandOk && band > 0 && !call.isEmpty())
+                m_confirmedCallsBandMode.insert(QString("%1_%2_%3").arg(call).arg(band).arg(fields.at(3)));
+        } else if (fields.size() == 1) {
+            // Backward compatibility with the original one-country-name-per-line
+            // file. New launches publish stable ADIF entity IDs from Wavelog.
+            for (auto it = m_entityById.constBegin(); it != m_entityById.constEnd(); ++it) {
+                if (it.value().name.trimmed().toUpper() == line) {
+                    m_confirmedDxcc.insert(it.key());
+                    break;
+                }
+            }
+        }
+    }
+}
+
+bool HvDxccTracker::isDxccConfirmed(int entityNum) const
+{
+    return m_confirmationDataAvailable && m_confirmedDxcc.contains(entityNum);
+}
+
+bool HvDxccTracker::isDxccConfirmedBandMode(int entityNum, int bandIndex, const QString& mode) const
+{
+    return m_confirmationDataAvailable && m_confirmedDxccBandMode.contains(
+        QString("%1_%2_%3").arg(entityNum).arg(bandIndex).arg(mode.trimmed().toUpper()));
+}
+
+bool HvDxccTracker::isCallConfirmed(const QString& callsign) const
+{
+    return m_confirmationDataAvailable && m_confirmedCalls.contains(extractBaseCall(callsign));
+}
+
+bool HvDxccTracker::isCallConfirmedBandMode(const QString& callsign, int bandIndex, const QString& mode) const
+{
+    return m_confirmationDataAvailable && m_confirmedCallsBandMode.contains(
+        QString("%1_%2_%3").arg(extractBaseCall(callsign)).arg(bandIndex).arg(mode.trimmed().toUpper()));
+}
+
+bool HvDxccTracker::isContinentConfirmed(const QString& continent) const
+{
+    if (!m_confirmationDataAvailable) return false;
+    const QString wanted = continent.trimmed().toUpper();
+    for (int entity : m_confirmedDxcc)
+        if (m_entityById.value(entity).continent.toUpper() == wanted) return true;

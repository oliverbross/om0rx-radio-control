+bool AutoDxerCore::isCataloguedDxpedition(const QString &callsign,
+                                          int bandIndex) const
+{
+    const QString base = extractBaseCallsign(callsign).toUpper();
+    return m_dxpeditionCallBands.contains(base + "@" + QString::number(bandIndex))
+        || m_dxpeditionCallBands.contains(base + "@*");
+}
